    private async Task HandleAddFolder()
    {
        if (_folderManager == null) return;

        if (_folderManager.Folders.Count >= _folderManager.MaxFolders)
        {
            Console.WriteLine($"Maximum {_folderManager.MaxFolders} folders reached");
            return;
        }

        // Auto-generate folder name based on count (no user prompt)
        var folderName = $"Folder {_folderManager.Folders.Count + 1}";

        // Store pending folder name and show template selector
        _pendingFolderName = folderName;
        _isCreatingNewFolder = true;
        _showFolderSelector = false; // Close folder selector
        _showTemplateSelector = true; // Show template selector
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleRemoveFolder()
    {
        if (_folderManager == null || _activeFolder == null) return;

        if (_folderManager.Folders.Count <= 1)
        {
            Console.WriteLine("Cannot remove last folder");
            return;
        }

        // Show confirmation dialog
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Delete folder '{_activeFolder.Name}' and all its roadmaps?");
        if (!confirmed)
        {
            return;
        }

        StorageService.RemoveFolder(_folderManager, _activeFolder.Id);
        _activeFolder = StorageService.GetActiveFolder(_folderManager);

        if (_activeFolder != null)
        {
            _sessionManager = _activeFolder.SessionManager;
            _activeTab = StorageService.GetActiveTab(_sessionManager);

            if (_activeTab != null)
            {
                _data = _activeTab.Data;
                _currentJson = JsonSerializer.Serialize(_data, new JsonSerializerOptions { WriteIndented = true });

                // Update editor
                if (_editor != null && _editorReady)
                {
                    await _editor.SetValue(_currentJson);
                }
            }
        }

        // Save folder manager
        if (_folderManager != null)
        {
            await StorageService.SaveFolderManagerAsync(_folderManager);
        }
        SelectionState.Clear();
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleMoveFolderLeft(string folderId)
    {
        if (_folderManager == null) return;

        var folderIndex = _folderManager.Folders.FindIndex(f => f.Id == folderId);
        if (folderIndex <= 0) return; // Already at leftmost position

        // Swap with the folder to the left
        var folder = _folderManager.Folders[folderIndex];
        _folderManager.Folders.RemoveAt(folderIndex);
        _folderManager.Folders.Insert(folderIndex - 1, folder);

        // Update colors for all folders based on new positions
        UpdateFolderColorsByPosition();

        // Save folder manager
        await StorageService.SaveFolderManagerAsync(_folderManager);
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleMoveFolderRight(string folderId)
    {
        if (_folderManager == null) return;

        var folderIndex = _folderManager.Folders.FindIndex(f => f.Id == folderId);
        if (folderIndex < 0 || folderIndex >= _folderManager.Folders.Count - 1) return; // Already at rightmost position

        // Swap with the folder to the right
        var folder = _folderManager.Folders[folderIndex];
        _folderManager.Folders.RemoveAt(folderIndex);
        _folderManager.Folders.Insert(folderIndex + 1, folder);

        // Update colors for all folders based on new positions
        UpdateFolderColorsByPosition();

        // Save folder manager
        await StorageService.SaveFolderManagerAsync(_folderManager);
        await InvokeAsync(StateHasChanged);
    }

    private void UpdateFolderColorsByPosition()
    {
        if (_folderManager == null) return;

        // Update colors based on position: Mustard, Coral, Pink
        var colors = new[] { "#E6B800", "#F88379", "#EC4899" };
        for (int i = 0; i < _folderManager.Folders.Count; i++)
        {
            _folderManager.Folders[i].Color = colors[i % colors.Length];
        }
    }

    private async Task HandleRenameFolder()
    {
        if (_folderManager == null || _activeFolder == null) return;

        // Prompt for new name
