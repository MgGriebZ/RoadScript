    // === Template Application Handler ===

    private async Task ApplyTemplate(TemplateService.TemplateType templateType)
    {
        if (_data == null || _activeTab == null || _sessionManager == null) return;

        // Get template name for confirmation
        var templateName = templateType switch
        {
            TemplateService.TemplateType.ScrumSprintCycle => "Daily Planning",
            TemplateService.TemplateType.ProjectTimelines => "Project Timelines",
            TemplateService.TemplateType.AnnualRoadmap => "Milestone Map",
            TemplateService.TemplateType.Weekly7Days => "Weekly (7 Days)",
            TemplateService.TemplateType.Monthly4Weeks => "Monthly (4 Weeks)",
            TemplateService.TemplateType.Quarterly4Quarters => "Quarterly (4 Quarters)",
            TemplateService.TemplateType.Yearly12Months => "Yearly (12 Months)",
            _ => "Custom"
        };

        // Get tab name suffix
        var tabNameSuffix = templateType switch
        {
            TemplateService.TemplateType.ScrumSprintCycle => "Daily Planning",
            TemplateService.TemplateType.ProjectTimelines => "Project Timelines",
            TemplateService.TemplateType.AnnualRoadmap => "Milestone Map",
            TemplateService.TemplateType.Weekly7Days => "Weekly Roadmap",
            TemplateService.TemplateType.Monthly4Weeks => "Monthly Roadmap",
            TemplateService.TemplateType.Quarterly4Quarters => "Quarterly Roadmap",
            TemplateService.TemplateType.Yearly12Months => "Yearly Roadmap",
            _ => "Roadmap"
        };

        // Show confirmation dialog
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
            $"Do you want to start a new {templateName} roadmap?\n\nThis will replace the current content and cannot be undone.");

        if (!confirmed) return;

        // Apply template to current data
        TemplateService.ApplyTemplate(_data, templateType, DateTime.Now);

        // Update tab name to reflect template
        _activeTab.Name = tabNameSuffix;
        _activeTab.LastModified = DateTime.UtcNow;

        // Update editor and save
        _currentJson = JsonSerializer.Serialize(_data, new JsonSerializerOptions { WriteIndented = true });

        if (_editor != null && _editorReady)
        {
            await _editor.SetValue(_currentJson);
        }

        // Update active folder's last modified time
        if (_activeFolder != null)
        {
            _activeFolder.LastModified = DateTime.UtcNow;
        }

        // Save to storage
        if (_folderManager != null)
        {
            await StorageService.SaveFolderManagerAsync(_folderManager);
        }

        await InvokeAsync(StateHasChanged);
    }

