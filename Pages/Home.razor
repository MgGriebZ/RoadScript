    private async Task HandleRoadmapMoveFromManager(RoadmapManager.RoadmapMoveData moveData)
    {
        if (_folderManager == null) return;

        // Get source and target folders
        var sourceFolder = _folderManager.Folders.FirstOrDefault(f => f.Id == moveData.SourceFolderId);
        var targetFolder = _folderManager.Folders.FirstOrDefault(f => f.Id == moveData.TargetFolderId);

        if (sourceFolder == null || targetFolder == null) return;

        // Get the roadmap being moved
        var sourceTab = sourceFolder.SessionManager.Tabs.FirstOrDefault(t => t.Id == moveData.SourceTabId);
        if (sourceTab == null) return;

        // Check if it's just reordering within the same folder
        if (moveData.SourceFolderId == moveData.TargetFolderId && moveData.TargetTabId != null)
        {
            // Reorder within same folder
            var currentIndex = sourceFolder.SessionManager.Tabs.IndexOf(sourceTab);
            var targetIndex = moveData.TargetIndex;

            if (currentIndex != targetIndex && targetIndex >= 0 && targetIndex < sourceFolder.SessionManager.Tabs.Count)
            {
                sourceFolder.SessionManager.Tabs.RemoveAt(currentIndex);

                // Adjust target index if moving down
                if (currentIndex < targetIndex)
                {
                    targetIndex--;
                }

                sourceFolder.SessionManager.Tabs.Insert(targetIndex, sourceTab);
                sourceFolder.LastModified = DateTime.UtcNow;

                await DebouncedSave();
                await InvokeAsync(StateHasChanged);
            }
            return;
        }

        // Moving between folders - check for dependencies
        _pendingMoveData = moveData;
        _movingRoadmapName = sourceTab.Name;
        _moveSourceFolderName = sourceFolder.Name;
        _moveTargetFolderName = targetFolder.Name;

        // Analyze dependencies
        _dependencyAnalysisResult = _dependencyService.FindDependencies(
            _folderManager,
            moveData.SourceFolderId,
            moveData.SourceTabId
        );

        // Show confirmation modal
        _showDependencyModal = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ConfirmRoadmapMove()
    {
        if (_folderManager == null || _pendingMoveData == null) return;

        var moveData = _pendingMoveData;
        var sourceFolder = _folderManager.Folders.FirstOrDefault(f => f.Id == moveData.SourceFolderId);
        var targetFolder = _folderManager.Folders.FirstOrDefault(f => f.Id == moveData.TargetFolderId);

        if (sourceFolder == null || targetFolder == null) return;

        var sourceTab = sourceFolder.SessionManager.Tabs.FirstOrDefault(t => t.Id == moveData.SourceTabId);
        if (sourceTab == null) return;

        // Check if target folder has space
        if (targetFolder.SessionManager.Tabs.Count >= targetFolder.SessionManager.MaxTabs)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Target folder '{targetFolder.Name}' is full (max {targetFolder.SessionManager.MaxTabs} roadmaps).");
            _showDependencyModal = false;
            _pendingMoveData = null;
            await InvokeAsync(StateHasChanged);
            return;
        }

        // Update all dependencies BEFORE moving
        _dependencyService.UpdateReferences(
            _folderManager,
            moveData.SourceFolderId,
            moveData.SourceTabId,
            moveData.TargetFolderId,
            moveData.SourceTabId // Tab ID stays the same
        );

        // Remove from source folder
        sourceFolder.SessionManager.Tabs.Remove(sourceTab);
        sourceFolder.LastModified = DateTime.UtcNow;

        // Add to target folder at specified position
        if (moveData.TargetIndex >= 0 && moveData.TargetIndex < targetFolder.SessionManager.Tabs.Count && moveData.TargetTabId != null)
        {
            // Insert at specific position
            targetFolder.SessionManager.Tabs.Insert(moveData.TargetIndex, sourceTab);
        }
        else
        {
            // Append to end
            targetFolder.SessionManager.Tabs.Add(sourceTab);
        }

        targetFolder.LastModified = DateTime.UtcNow;

        // Update source folder's active tab if needed
        if (sourceFolder.SessionManager.ActiveTabId == sourceTab.Id && sourceFolder.SessionManager.Tabs.Count > 0)
        {
            sourceFolder.SessionManager.ActiveTabId = sourceFolder.SessionManager.Tabs[0].Id;
        }

        // Update active folder/tab if the moved roadmap was active
        if (_activeFolder?.Id == sourceFolder.Id && _activeTab?.Id == sourceTab.Id)
        {
            _activeFolder = targetFolder;
            _folderManager.ActiveFolderId = targetFolder.Id;
            targetFolder.SessionManager.ActiveTabId = sourceTab.Id;
            _sessionManager = targetFolder.SessionManager;
            _activeTab = sourceTab;
            _data = sourceTab.Data;
            _currentJson = JsonSerializer.Serialize(_data, new JsonSerializerOptions { WriteIndented = true });

            // Update URL
            await UrlNavigation.UpdateUrl(targetFolder.Id, sourceTab.Id);
        }

        await DebouncedSave();

        // Close modal and clear state
        _showDependencyModal = false;
        _pendingMoveData = null;
        await InvokeAsync(StateHasChanged);
    }

