    private async Task HandleRemoveElement((string ElementType, string JsonPath) args)
    {
        try
        {
            if (_data == null) return;

            SaveHistorySnapshot();

            var (elementType, jsonPath) = args;

            switch (elementType)
            {
                case "lane":
                    var laneIndex = ExtractIndexFromPath(jsonPath, "lanes");
                    if (_data.Lanes.Count > 1 && laneIndex < _data.Lanes.Count)
                    {
                        _data.Lanes.RemoveAt(laneIndex);
                    }
                    break;

                case "item":
                    var itemPath = jsonPath.Split(".items[")[0];
                    var itemLaneIndex = ExtractIndexFromPath(itemPath, "lanes");
                    var itemIndex = ExtractIndexFromPath(jsonPath, "items");
                    if (_data.Lanes[itemLaneIndex].Items.Count > 0 && itemIndex < _data.Lanes[itemLaneIndex].Items.Count)
                    {
                        _data.Lanes[itemLaneIndex].Items.RemoveAt(itemIndex);
                    }
                    break;

                case "column":
                    var columnIndex = ExtractIndexFromPath(jsonPath, "columns");
                    if (_data.Columns.Count > 1 && columnIndex < _data.Columns.Count)
                    {
                        _data.Columns.RemoveAt(columnIndex);
                    }
                    break;

                case "milestone":
                    var milestoneIndex = ExtractIndexFromPath(jsonPath, "milestones");
                    if (_data.Milestones.Count > 0 && milestoneIndex < _data.Milestones.Count)
                    {
                        _data.Milestones.RemoveAt(milestoneIndex);
                    }
                    break;
            }

            var updatedJson = JsonSerializer.Serialize(_data, new JsonSerializerOptions { WriteIndented = true });

            _currentJson = updatedJson;
            ParseJson(updatedJson);

            SelectionState.Clear();

            if (_editor != null)
            {
                await _editor.SetValue(updatedJson);
            }

            if (_error == null && _sessionManager != null && _activeTab != null)
            {
                _activeTab.Data = _data;
                _activeTab.LastModified = DateTime.UtcNow;
                if (_folderManager != null)
                {
                    await DebouncedSave();
                }
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error removing element: {ex.Message}");
        }
    }

    private int ExtractIndexFromPath(string jsonPath, string arrayName)
    {
        var pattern = $@"{arrayName}\[(\d+)\]";
        var match = System.Text.RegularExpressions.Regex.Match(jsonPath, pattern);
        return match.Success ? int.Parse(match.Groups[1].Value) : 0;
    }

    private object? GetElementByPath(string jsonPath, string elementType)
    {
        if (_data == null) return null;

        try
        {
            return elementType switch
            {
                "item" => GetItemByPath(jsonPath),
                "lane" => GetLaneByPath(jsonPath),
                "column" => GetColumnByPath(jsonPath),
                "milestone" => GetMilestoneByPath(jsonPath),
                "title" => _data,
                _ => null
            };
        }
        catch
        {
            return null;
        }
    }

    private Item? GetItemByPath(string jsonPath)
    {
        var laneIndex = ExtractIndexFromPath(jsonPath, "lanes");
        var itemIndex = ExtractIndexFromPath(jsonPath, "items");
        if (laneIndex < _data!.Lanes.Count && itemIndex < _data.Lanes[laneIndex].Items.Count)
        {
            return _data.Lanes[laneIndex].Items[itemIndex];
        }
        return null;
    }

    private Lane? GetLaneByPath(string jsonPath)
    {
        var laneIndex = ExtractIndexFromPath(jsonPath, "lanes");
        if (laneIndex < _data!.Lanes.Count)
        {
