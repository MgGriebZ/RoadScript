    private async Task JumpToJsonLocation(string jsonPath)
    {
        try
        {
            var position = await JSRuntime.InvokeAsync<JsonPosition?>(
                "RoadScriptInterop.findJsonPosition",
                _currentJson,
                jsonPath
            );

            if (position != null && _jsonTextArea.Id != null)
            {
                await JSRuntime.InvokeVoidAsync(
                    "RoadScriptInterop.scrollTextareaToLine",
                    _jsonTextArea,
                    position.Line - 1
                );
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error jumping to JSON location: {ex.Message}");
        }
    }

    private async Task JumpToJsonSection(string jsonPath)
    {
        try
        {
            // Find the line number in the JSON that contains this path
            var lines = _currentJson.Split('\n');
            int targetLine = -1;

            // Convert JSON path (e.g., "lanes[0].items[1]") to search terms
            var searchTerm = jsonPath
                .Replace("lanes[", "\"lanes\"")
                .Replace("].items[", "")
                .Replace("[", "")
                .Replace("]", "")
                .Trim();

            // Simple search for the JSON path
            for (int i = 0; i < lines.Length; i++)
            {
                if (jsonPath.StartsWith("lanes["))
                {
                    // For lanes, look for the lane definition
                    if (lines[i].Contains("\"title\"") && i > 0)
                    {
                        var laneMatch = System.Text.RegularExpressions.Regex.Match(jsonPath, @"lanes\[(\d+)\]");
                        if (laneMatch.Success)
                        {
                            int laneIndex = int.Parse(laneMatch.Groups[1].Value);
                            int currentLane = 0;
                            for (int j = 0; j < lines.Length; j++)
                            {
                                if (lines[j].Trim().StartsWith("\"title\""))
                                {
                                    if (currentLane == laneIndex)
                                    {
                                        targetLine = j;
                                        break;
                                    }
                                    currentLane++;
                                }
                            }
                        }
                    }
                }
                else if (jsonPath == "title")
                {
                    if (lines[i].Contains("\"title\"") && i < 10) // Title is near the top
                    {
                        targetLine = i;
                        break;
                    }
                }
                else if (jsonPath.StartsWith("columns["))
                {
                    if (lines[i].Contains("\"columns\""))
                    {
                        targetLine = i;
                        break;
                    }
                }
                else if (jsonPath.StartsWith("milestones["))
                {
                    if (lines[i].Contains("\"milestones\""))
                    {
                        targetLine = i;
                        break;
                    }
                }
            }

            if (targetLine >= 0)
            {
                // Scroll to the line using JS interop
                await JSRuntime.InvokeVoidAsync("RoadScriptInterop.scrollTextareaToLine", _jsonTextArea, targetLine);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error jumping to JSON section: {ex.Message}");
        }
    }

