    private string FooterBarStyle()
    {
        if (_isVibeMode)
        {
            return "background: rgba(30, 30, 46, 0.95); padding: 12px 20px; border-top: 1px solid #3a3a4e; " +
                   "box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.3); margin-top: 8px; border-radius: 6px;";
        }
        return "background: rgba(255, 255, 255, 0.98); padding: 12px 20px; border-top: 1px solid #d1d5db; " +
               "box-shadow: 0 -1px 4px rgba(0, 0, 0, 0.1); margin-top: 8px; border-radius: 6px;";
    }

