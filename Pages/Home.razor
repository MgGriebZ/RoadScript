    private async Task HandleFolderImport(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;

            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024); // 5MB limit
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();

            var options = new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true,
                AllowTrailingCommas = true
            };

            var importedFolder = JsonSerializer.Deserialize<Folder>(json, options);
            if (importedFolder == null)
            {
                Console.WriteLine("Failed to deserialize folder");
                await JSRuntime.InvokeVoidAsync("alert", "Failed to import folder. Invalid file format.");
                return;
            }

            if (_folderManager == null || _folderManager.Folders.Count >= 3)
            {
                Console.WriteLine("Cannot import: folder limit reached");
                await JSRuntime.InvokeVoidAsync("alert", "Cannot import folder. Maximum limit of 3 folders reached.");
                return;
            }

            // Regenerate folder ID to prevent conflicts
            importedFolder.Id = Guid.NewGuid().ToString();
            importedFolder.LastModified = DateTime.UtcNow;

            // CRITICAL FIX: Regenerate all tab IDs to prevent collisions if same folder imported twice
            foreach (var tab in importedFolder.SessionManager.Tabs)
            {
                tab.Id = $"tab-{Guid.NewGuid().ToString("N")[..8]}";
                tab.LastModified = DateTime.UtcNow;
            }

            // Ensure ActiveTabId references the new regenerated ID
            if (importedFolder.SessionManager.Tabs.Count > 0)
            {
                importedFolder.SessionManager.ActiveTabId = importedFolder.SessionManager.Tabs[0].Id;
            }

            _folderManager.Folders.Add(importedFolder);
            _folderManager.ActiveFolderId = importedFolder.Id;
            _activeFolder = importedFolder;
            _sessionManager = _activeFolder.SessionManager;
            _activeTab = StorageService.GetActiveTab(_sessionManager);

            if (_activeTab != null)
            {
                _data = _activeTab.Data;
                _currentJson = JsonSerializer.Serialize(_data, new JsonSerializerOptions { WriteIndented = true });
            }

            // Use immediate save for import operation (critical)
            await SaveState();
            SelectionState.Clear();

            // Force UI refresh
            await InvokeAsync(StateHasChanged);

            // Small delay to ensure render completes
            await Task.Delay(100);

            // Second refresh to ensure CommandCenter updates
            await InvokeAsync(StateHasChanged);

            // Show success notification
            var tabCount = importedFolder.SessionManager.Tabs.Count;
            await JSRuntime.InvokeVoidAsync("alert",
                $"✅ Folder imported successfully!\n\n" +
                $"📁 Folder: {importedFolder.Name}\n" +
                $"📄 Roadmaps: {tabCount}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error importing folder: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"❌ Error importing folder:\n{ex.Message}");
        }
    }

