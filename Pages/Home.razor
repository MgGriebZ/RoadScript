    private async Task HandleAllDataImport(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;

            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10MB limit for all data
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();

            var options = new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true,
                AllowTrailingCommas = true
            };

            var importedFolderManager = JsonSerializer.Deserialize<FolderManager>(json, options);
            if (importedFolderManager == null)
            {
                Console.WriteLine("Failed to deserialize folder manager");
                await JSRuntime.InvokeVoidAsync("alert", "Failed to import session data. Invalid file format.");
                return;
            }

            // Build ID mapping and regenerate all IDs to prevent conflicts
            var idMapping = new Dictionary<string, string>();

            foreach (var folder in importedFolderManager.Folders)
            {
                var oldFolderId = folder.Id;
                var newFolderId = Guid.NewGuid().ToString();
                folder.Id = newFolderId;
                folder.LastModified = DateTime.UtcNow;

                // Add folder ID to mapping
                idMapping[oldFolderId] = newFolderId;

                foreach (var tab in folder.SessionManager.Tabs)
                {
                    var oldTabId = tab.Id;
                    var newTabId = $"tab-{Guid.NewGuid().ToString("N")[..8]}";
                    tab.Id = newTabId;
                    tab.LastModified = DateTime.UtcNow;

                    // Add tab ID to mapping
                    idMapping[oldTabId] = newTabId;
                }

                // Update active tab ID to first tab if tabs exist
                if (folder.SessionManager.Tabs.Count > 0)
                {
                    folder.SessionManager.ActiveTabId = folder.SessionManager.Tabs[0].Id;
                }
            }

            // Remap all linkedRoadmapId values in all roadmap data
            foreach (var folder in importedFolderManager.Folders)
            {
                foreach (var tab in folder.SessionManager.Tabs)
                {
                    RemapLinkedRoadmapIds(tab.Data, idMapping);
                }
            }

            // Set active folder to first folder if folders exist
            if (importedFolderManager.Folders.Count > 0)
            {
                importedFolderManager.ActiveFolderId = importedFolderManager.Folders[0].Id;
            }

            // Replace the entire folder manager
            _folderManager = importedFolderManager;
            _activeFolder = _folderManager.Folders.FirstOrDefault();
            _sessionManager = _activeFolder?.SessionManager;
            _activeTab = StorageService.GetActiveTab(_sessionManager);

            if (_activeTab != null)
            {
                _data = _activeTab.Data;
                _currentJson = JsonSerializer.Serialize(_data, new JsonSerializerOptions { WriteIndented = true });
            }

            // Use immediate save for import operation (critical)
            await SaveState();
            SelectionState.Clear();

            // Force UI refresh
            await InvokeAsync(StateHasChanged);

            // Small delay to ensure render completes
            await Task.Delay(100);

            // Second refresh to ensure CommandCenter updates
            await InvokeAsync(StateHasChanged);

            // Show success notification
            var folderCount = _folderManager.Folders.Count;
            var totalTabs = _folderManager.Folders.Sum(f => f.SessionManager.Tabs.Count);
            await JSRuntime.InvokeVoidAsync("alert",
                $"✅ Session data imported successfully!\n\n" +
                $"📁 Folders: {folderCount}\n" +
                $"📄 Total Roadmaps: {totalTabs}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error importing session data: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"❌ Error importing session data:\n{ex.Message}");
        }
    }

