    private async Task HandleFolderRenameFromManager(string folderId)
    {
        if (_folderManager == null) return;

        var folder = _folderManager.Folders.FirstOrDefault(f => f.Id == folderId);
        if (folder == null) return;

        var newName = await JSRuntime.InvokeAsync<string>("prompt", $"Rename folder '{folder.Name}':", folder.Name);
        if (!string.IsNullOrWhiteSpace(newName) && newName != folder.Name)
        {
            StorageService.RenameFolder(_folderManager, folder.Id, newName.Trim());
            folder.LastModified = DateTime.UtcNow;
            await DebouncedSave();
            await InvokeAsync(StateHasChanged);
        }
    }

