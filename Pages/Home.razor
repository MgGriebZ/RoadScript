@page "/"
@using BlazorMonaco.Editor
@using System.Text.Json
@using RoadScript.Models

<div class="container-fluid vh-100 d-flex p-0">
    @* Editor Pane *@
    <div class="editor-pane" style="width: 30%; border-right: 1px solid #ccc; display: flex; flex-direction: column;">
        <div style="background: #1e1e1e; padding: 12px 16px; font-weight: 600; color: #fff; border-bottom: 1px solid #333; display: flex; justify-content: space-between; align-items: center;">
            <span>RoadScript <span style="font-size: 0.75em; color: #888; font-weight: 400;">v1.0</span></span>
            <span style="font-size: 0.7em; color: #666;">JSON Editor</span>
        </div>
        <div style="background: #252526; padding: 8px 12px; border-bottom: 1px solid #333; display: flex; gap: 8px; align-items: center;">
            <button @onclick="UpdatePreview"
                    style="background: #0e639c; color: #fff; border: none; padding: 6px 16px; border-radius: 4px; font-size: 13px; font-weight: 500; cursor: pointer; transition: background 0.2s;"
                    onmouseover="this.style.background='#1177bb'"
                    onmouseout="this.style.background='#0e639c'">
                Update Preview
            </button>
            <button @onclick="ResetToDefault"
                    style="background: #3c3c3c; color: #ccc; border: 1px solid #555; padding: 6px 16px; border-radius: 4px; font-size: 13px; font-weight: 500; cursor: pointer; transition: all 0.2s;"
                    onmouseover="this.style.background='#505050'"
                    onmouseout="this.style.background='#3c3c3c'">
                Reset
            </button>
            @if (_isUpdating)
            {
                <span style="color: #4ec9b0; font-size: 12px; margin-left: auto;">● Updating...</span>
            }
            else if (_lastUpdateSuccess && !_error)
            {
                <span style="color: #4ec9b0; font-size: 12px; margin-left: auto;">✓ Valid JSON</span>
            }
            else if (_error != null)
            {
                <span style="color: #f48771; font-size: 12px; margin-left: auto;">✗ Invalid JSON</span>
            }
        </div>
        <StandaloneCodeEditor @ref="_editor"
                              Id="json-editor"
                              ConstructionOptions="EditorConstructionOptions"
                              CssClass="h-100" />
    </div>

    @* Preview Pane *@
    <div class="preview-pane" style="width: 70%; background: #e8eaed; overflow: auto; padding: 24px; display: flex; justify-content: center; align-items: flex-start;">
        @if (_data != null)
        {
            <div class="roadmap" style="@RoadmapContainerStyle()">
                @* Header *@
                <div style="margin-bottom: 20px;">
                    <h1 style="margin: 0; font-size: 32px; font-weight: 700; color: #1a1a2e; letter-spacing: -0.5px;">
                        @_data.Title
                    </h1>
                    <p style="margin: 2px 0 0; font-size: 15px; color: #6b7280; font-weight: 500;">
                        @_data.Subtitle
                    </p>
                </div>

                @* Grid *@
                <div style="display: flex; height: calc(100% - 70px);">
                    @* Lane Labels *@
                    <div style="width: 190px; flex-shrink: 0; padding-top: 52px; padding-right: 16px;">
                        @foreach (var lane in _data.Lanes)
                        {
                            <div style="@LaneLabelWrapStyle()">
                                <div style="display: flex; align-items: flex-start; gap: 12px;">
                                    <div style="@LaneBarStyle(lane.Color)"></div>
                                    <div style="display: flex; flex-direction: column; gap: 6px;">
                                        <span style="font-size: 15px; font-weight: 700; color: #374151; line-height: 1.3;">
                                            @((MarkupString)lane.Title.Replace("&", "&amp;<br/>"))
                                        </span>
                                        @if (lane.History != null)
                                        {
                                            <div style="display: flex; flex-direction: column; gap: 2px;">
                                                <div style="@HistoryBarContainerStyle()">
                                                    <div style="@HistoryPastStyle(lane.Color, lane.History.PastPct)"></div>
                                                    <div style="@HistoryCurrentStyle(lane.Color, lane.History.PastPct)"></div>
                                                </div>
                                                <div style="display: flex; justify-content: space-between; width: 90px;">
                                                    <span style="font-size: 9px; color: #9ca3af; font-weight: 500;">@lane.History.StartYear</span>
                                                    <span style="font-size: 9px; color: #9ca3af; font-weight: 500;">@lane.History.EndYear</span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @* Timeline *@
                    <div style="flex: 1; display: flex; flex-direction: column;">
                        @* Column Headers *@
                        <div style="display: flex; height: 52px; border-bottom: 2px solid #e5e7eb; position: relative;">
                            @for (int i = 0; i < _data.Columns.Count; i++)
                            {
                                var col = _data.Columns[i];
                                <div style="@ColumnHeaderStyle(i)">
                                    <span style="font-size: 17px; font-weight: 700; color: #1f2937;">@col.Label</span>
                                    <span style="font-size: 12px; color: #9ca3af; font-weight: 500;">@col.Sub</span>
                                </div>
                            }

                            @* Milestones *@
                            @foreach (var milestone in _data.Milestones)
                            {
                                <div style="@MilestoneStyle(milestone.Position)">
                                    <div style="width: 14px; height: 14px; background: #1f2937; transform: rotate(45deg); border: 2px solid #fafbfc;"></div>
                                    <span style="position: absolute; top: 18px; left: 50%; transform: translateX(-50%); font-size: 10px; font-weight: 600; color: #6b7280; white-space: nowrap;">
                                        @milestone.Label
                                    </span>
                                </div>
                            }
                        </div>

                        @* Lanes Container *@
                        <div style="flex: 1; position: relative;">
                            @* Grid Columns Background *@
                            <div style="position: absolute; inset: 0; display: flex; pointer-events: none;">
                                @for (int i = 0; i < _data.Columns.Count; i++)
                                {
                                    <div style="@GridColumnStyle(i)"></div>
                                }
                            </div>

                            @* Lane Rows *@
                            @for (int li = 0; li < _data.Lanes.Count; li++)
                            {
                                var lane = _data.Lanes[li];
                                <div style="@LaneRowStyle(li)">
                                    @foreach (var item in lane.Items)
                                    {
                                        <div style="@ItemStyle(item, lane.Color)">
                                            <h4 style="margin: 0 0 8px 0; font-size: 16px; font-weight: 700; color: #1f2937; line-height: 1.2;">
                                                @item.Title
                                            </h4>
                                            <ul style="margin: 0; padding: 0; list-style: none;">
                                                @if (item.Details != null)
                                                {
                                                    @foreach (var detail in item.Details)
                                                    {
                                                        <li style="@DetailItemStyle(detail)">
                                                            <div style="@DetailTextStyle(lane.Color)">
                                                                <span style="@BulletStyle(lane.Color)">•</span>
                                                                @detail.Text
                                                            </div>
                                                            @if (detail.Subs != null && detail.Subs.Count > 0)
                                                            {
                                                                <ul style="margin: 2px 0 4px 0; padding: 0; list-style: none;">
                                                                    @foreach (var sub in detail.Subs)
                                                                    {
                                                                        <li style="font-size: 11px; color: #6b7280; line-height: 1.4; padding-left: 22px; position: relative; margin-bottom: 1px;">
                                                                            <span style="position: absolute; left: 12px; color: #9ca3af;">–</span>
                                                                            @sub
                                                                        </li>
                                                                    }
                                                                </ul>
                                                            }
                                                        </li>
                                                    }
                                                }
                                            </ul>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (_error != null)
        {
            <div style="background: #fee2e2; border: 1px solid #fca5a5; color: #b91c1c; padding: 16px; border-radius: 8px; max-width: 600px;">
                <strong>JSON Error:</strong> @_error
            </div>
        }
    </div>
</div>

@code {
