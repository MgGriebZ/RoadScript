    private StandaloneEditorConstructionOptions EditorConstructionOptions(StandaloneCodeEditor editor)
    {
        return new StandaloneEditorConstructionOptions
        {
            Language = "json",
            Value = _defaultJson,
            Theme = "vs-dark",
            Minimap = new EditorMinimapOptions { Enabled = false },
            AutomaticLayout = true,
            FontSize = 13,
            LineNumbers = "on",
            ScrollBeyondLastLine = false,
            WordWrap = "on",
            TabSize = 2
        };
    }

    protected override void OnInitialized()
    {
        _currentJson = _defaultJson;
        ParseJson(_defaultJson);
    }

    private async Task UpdatePreview()
    {
        _isUpdating = true;
        StateHasChanged();

        try
        {
            await Task.Delay(100); // Brief delay for visual feedback
            var value = await _editor.GetValue();
            _currentJson = value;
            ParseJson(value);
            _lastUpdateSuccess = _error == null;
        }
        finally
        {
            _isUpdating = false;
            StateHasChanged();
        }
    }

    private async Task ResetToDefault()
    {
        await _editor.SetValue(_defaultJson);
        _currentJson = _defaultJson;
        ParseJson(_defaultJson);
        _lastUpdateSuccess = true;
        StateHasChanged();
    }

    private void ParseJson(string json)
    {
        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            _data = JsonSerializer.Deserialize<RoadmapData>(json, options);
            _error = null;
        }
        catch (Exception ex)
        {
            _data = null;
            _error = ex.Message;
        }
    }

    // === Style Helper Methods ===

    private string RoadmapContainerStyle() =>
        "width: 100%; max-width: 1400px; aspect-ratio: 16/9; background: #fafbfc; " +
        "font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; " +
        "padding: 28px 36px; border: 1px solid #d1d5db; position: relative;";

    private string LaneLabelWrapStyle()
    {
        var laneCount = _data?.Lanes.Count ?? 1;
        return $"height: {100.0 / laneCount}%; display: flex; align-items: center;";
    }

    private string LaneBarStyle(string color) =>
        $"width: 5px; min-height: 44px; border-radius: 2px; margin-top: 2px; background: {color};";

    private string HistoryBarContainerStyle() =>
        "display: flex; height: 5px; border-radius: 3px; overflow: hidden; width: 90px; background: #e5e7eb;";

    private string HistoryPastStyle(string color, int pastPct)
    {
        // Create striped pattern effect using a gradient
        return $"width: {pastPct}%; background: repeating-linear-gradient(90deg, {color} 0px, {color} 3px, transparent 3px, transparent 6px); opacity: 0.45;";
    }

    private string HistoryCurrentStyle(string color, int pastPct) =>
        $"width: {100 - pastPct}%; background: {color};";

    private string ColumnHeaderStyle(int index)
    {
        var bg = index % 2 == 0 ? "#f8f9fa" : "#fff";
        var border = index > 0 ? "border-left: 1px solid #e5e7eb;" : "";
        return $"flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; {border} background: {bg};";
    }

    private string MilestoneStyle(double position) =>
        $"position: absolute; bottom: -8px; left: {position}%; transform: translateX(-50%); z-index: 10;";

    private string GridColumnStyle(int index)
    {
        var bg = index % 2 == 0 ? "#f8f9fa" : "#fff";
        var border = index > 0 ? "border-left: 1px solid #e5e7eb;" : "";
        return $"flex: 1; {border} background: {bg};";
    }

    private string LaneRowStyle(int index)
    {
        var laneCount = _data?.Lanes.Count ?? 1;
        var border = index < laneCount - 1 ? "border-bottom: 1px solid #e5e7eb;" : "";
        return $"height: {100.0 / laneCount}%; position: relative; {border}";
    }

    private string ItemStyle(Item item, string color)
    {
        var cols = _data?.Columns.Count ?? 4;
        var leftPct = (item.Start / cols) * 100;
        var widthPct = (item.Span / cols) * 100;

        var borderStyle = item.Spanning
            ? $"border: 2px dashed {color}50; border-left: 5px solid {color};"
            : $"border: 1px solid {color}30; border-left: 5px solid {color};";

        var shadow = item.Spanning ? "" : "box-shadow: 0 1px 4px rgba(0,0,0,0.08);";

        return $"position: absolute; left: calc({leftPct}% + 6px); top: 6px; bottom: 6px; " +
               $"width: calc({widthPct}% - 12px); background: #fff; border-radius: 6px; " +
               $"padding: 10px 14px; overflow: hidden; {borderStyle} {shadow}";
    }

    private string DetailItemStyle(Detail detail) =>
        detail.Subs != null && detail.Subs.Count > 0 ? "margin-bottom: 2px;" : "margin-bottom: 3px;";

    private string DetailTextStyle(string color) =>
        $"font-size: 13px; color: #4b5563; line-height: 1.45; padding-left: 12px; position: relative;";

    private string BulletStyle(string color) =>
        $"position: absolute; left: 0; color: {color}; font-weight: 700;";
}