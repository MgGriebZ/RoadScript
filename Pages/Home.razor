    private ShareModal.RoadmapStatsModel? GetRoadmapStats()
    {
        if (_data == null) return null;

        var itemCount = 0;
        if (_data.Lanes != null)
        {
            foreach (var lane in _data.Lanes)
            {
                if (lane.Items != null)
                {
                    itemCount += lane.Items.Count;
                }
            }
        }

        return new ShareModal.RoadmapStatsModel
        {
            ColumnCount = _data.Columns?.Count ?? 0,
            LaneCount = _data.Lanes?.Count ?? 0,
            ItemCount = itemCount
        };
    }

    private ShareModal.SessionStatsModel? GetSessionStats()
    {
        if (_folderManager == null) return null;

        var totalLinks = 0;
        foreach (var folder in _folderManager.Folders)
        {
            foreach (var tab in folder.SessionManager.Tabs)
            {
                var data = tab.Data;
                // Count title link
                if (!string.IsNullOrEmpty(data.LinkedRoadmapId)) totalLinks++;

                // Count lane links
                if (data.Lanes != null)
                {
                    foreach (var lane in data.Lanes)
                    {
                        if (!string.IsNullOrEmpty(lane.LinkedRoadmapId)) totalLinks++;

                        // Count item links
                        if (lane.Items != null)
                        {
                            totalLinks += lane.Items.Count(i => !string.IsNullOrEmpty(i.LinkedRoadmapId));
                        }
                    }
                }
            }
        }

        return new ShareModal.SessionStatsModel
        {
            FolderCount = _folderManager.Folders.Count,
            TotalRoadmaps = _folderManager.Folders.Sum(f => f.SessionManager.Tabs.Count),
            TotalLinks = totalLinks
        };
    }

