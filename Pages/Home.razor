    private async Task ApplyTemplate(TemplateService.TemplateType templateType)
    {
        if (_data == null || _activeTab == null || _sessionManager == null) return;

        var templateName = templateType switch
        {
            TemplateService.TemplateType.ScrumSprintCycle => "Daily Planning",
            TemplateService.TemplateType.ProjectTimelines => "Projects",
            TemplateService.TemplateType.AnnualRoadmap => "Milestones",
            TemplateService.TemplateType.ScrumBoard => "Flows",
            TemplateService.TemplateType.Retrospective => "Retro",
            _ => "Roadmap"
        };

        var tabNameSuffix = templateType switch
        {
            TemplateService.TemplateType.ScrumSprintCycle => "Daily Planning",
            TemplateService.TemplateType.ProjectTimelines => "Projects",
            TemplateService.TemplateType.AnnualRoadmap => "Milestones",
            TemplateService.TemplateType.ScrumBoard => "Flows",
            TemplateService.TemplateType.Retrospective => "Retro",
            _ => "Roadmap"
        };

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
            $"Do you want to start a new {templateName} roadmap?\n\nThis will replace the current content and cannot be undone.");

        if (!confirmed) return;

        TemplateService.ApplyTemplate(_data, templateType);

        // Note: Seasonal theme randomization removed - theme can be changed manually via cycle button

        _activeTab.Name = tabNameSuffix;
        _activeTab.TemplateType = GetTemplateTypeString(templateType);
        _activeTab.LastModified = DateTime.UtcNow;

        _currentJson = JsonSerializer.Serialize(_data, new JsonSerializerOptions { WriteIndented = true });

        if (_editor != null && _editorReady)
        {
            await _editor.SetValue(_currentJson);
        }

        if (_activeFolder != null)
        {
            _activeFolder.LastModified = DateTime.UtcNow;
        }

        if (_folderManager != null)
        {
            await DebouncedSave();
        }

        await InvokeAsync(StateHasChanged);
    }

    private string? GetTemplateTypeString(TemplateService.TemplateType templateType)
    {
        return templateType switch
        {
            TemplateService.TemplateType.ScrumSprintCycle => "Daily",
            TemplateService.TemplateType.ProjectTimelines => "Project",
            TemplateService.TemplateType.AnnualRoadmap => "Milestone",
            TemplateService.TemplateType.ScrumBoard => "Energy",
            TemplateService.TemplateType.Retrospective => "Retro",
            _ => null
        };
    }

    /// <summary>
    /// Clears all linkedRoadmapId values in roadmap data.
    /// Used when importing a singular roadmap where the linked roadmaps don't exist in the target session.
    /// </summary>
    /// <param name="data">The roadmap data to process</param>
    private void ClearLinkedRoadmapIds(RoadmapData data)
    {
        if (data == null) return;

        // Clear title linked roadmap
        data.LinkedRoadmapId = null;

        // Clear lane linked roadmaps
        if (data.Lanes != null)
        {
            foreach (var lane in data.Lanes)
            {
                lane.LinkedRoadmapId = null;

                // Clear item linked roadmaps
                if (lane.Items != null)
                {
                    foreach (var item in lane.Items)
                    {
                        item.LinkedRoadmapId = null;
                    }
                }
            }
        }
    }

    /// <summary>
    /// Remaps linkedRoadmapId values in roadmap data using the provided ID mapping.
    /// Handles both old format (tabId) and new format (folderId/tabId).
    /// </summary>
    /// <param name="data">The roadmap data to process</param>
    /// <param name="idMapping">Dictionary mapping old IDs to new IDs (both folder and tab IDs)</param>
    private void RemapLinkedRoadmapIds(RoadmapData data, Dictionary<string, string> idMapping)
    {
        if (data == null) return;

        // Remap title linked roadmap
        if (!string.IsNullOrEmpty(data.LinkedRoadmapId))
        {
            data.LinkedRoadmapId = RemapSingleId(data.LinkedRoadmapId, idMapping);
        }

        // Remap lane linked roadmaps
        if (data.Lanes != null)
        {
            foreach (var lane in data.Lanes)
            {
                if (!string.IsNullOrEmpty(lane.LinkedRoadmapId))
                {
                    lane.LinkedRoadmapId = RemapSingleId(lane.LinkedRoadmapId, idMapping);
                }

                // Remap item linked roadmaps
                if (lane.Items != null)
                {
                    foreach (var item in lane.Items)
                    {
                        if (!string.IsNullOrEmpty(item.LinkedRoadmapId))
                        {
                            item.LinkedRoadmapId = RemapSingleId(item.LinkedRoadmapId, idMapping);
                        }
                    }
                }
            }
        }
    }

    /// <summary>
    /// Remaps a single linkedRoadmapId using the provided mapping.
    /// Returns null if the ID cannot be remapped.
    /// </summary>
    private string? RemapSingleId(string linkedId, Dictionary<string, string> idMapping)
    {
        if (string.IsNullOrEmpty(linkedId)) return null;

        // Check if it's new format (folderId/tabId)
        if (linkedId.Contains("/"))
        {
            var parts = linkedId.Split('/');
            if (parts.Length == 2)
            {
                var oldFolderId = parts[0];
                var oldTabId = parts[1];

                // Try to remap both IDs
                var newFolderId = idMapping.ContainsKey(oldFolderId) ? idMapping[oldFolderId] : null;
                var newTabId = idMapping.ContainsKey(oldTabId) ? idMapping[oldTabId] : null;

                // If both IDs can be remapped, return the new format
                if (newFolderId != null && newTabId != null)
                {
                    return $"{newFolderId}/{newTabId}";
                }
            }
        }
        else
        {
            // Old format (just tabId) - try to remap
            if (idMapping.ContainsKey(linkedId))
            {
                return idMapping[linkedId];
            }
        }

        // If we can't remap, return null to break the link
        return null;
    }

