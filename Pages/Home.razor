        }
        return null;
    }

    private async Task HandleMoveItem((string Direction, string JsonPath) args)
    {
        try
        {
            if (_data == null) return;

            SaveHistorySnapshot();

            var (direction, jsonPath) = args;
            var laneIndex = ExtractIndexFromPath(jsonPath, "lanes");
            var itemIndex = ExtractIndexFromPath(jsonPath, "items");

            if (laneIndex < 0 || laneIndex >= _data.Lanes.Count) return;
            var lane = _data.Lanes[laneIndex];

            if (direction == "up" && itemIndex > 0)
            {
                // Swap with previous item in same lane
                (lane.Items[itemIndex], lane.Items[itemIndex - 1]) = (lane.Items[itemIndex - 1], lane.Items[itemIndex]);
                // Update selection to follow the moved item
                SelectionState.Select($"lanes[{laneIndex}].items[{itemIndex - 1}]", "item", lane.Items[itemIndex - 1]);
            }
            else if (direction == "down" && itemIndex < lane.Items.Count - 1)
            {
                // Swap with next item in same lane
                (lane.Items[itemIndex], lane.Items[itemIndex + 1]) = (lane.Items[itemIndex + 1], lane.Items[itemIndex]);
                // Update selection to follow the moved item
                SelectionState.Select($"lanes[{laneIndex}].items[{itemIndex + 1}]", "item", lane.Items[itemIndex + 1]);
            }

            // Update JSON
            _currentJson = JsonSerializer.Serialize(_data, new JsonSerializerOptions
            {
                WriteIndented = true,
                PropertyNamingPolicy = JsonNamingPolicy.CamelCase
            });

            if (_editor != null)
            {
                await _editor.SetValue(_currentJson);
            }

            if (_error == null && _sessionManager != null && _activeTab != null)
            {
                _activeTab.Data = _data;
                _activeTab.LastModified = DateTime.UtcNow;
                if (_folderManager != null)
                {
                    await DebouncedSave();
                }
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error moving item: {ex.Message}");
        }
    }

    private async Task HandleMoveLane((string Direction, string JsonPath) args)
    {
        try
        {
            if (_data == null) return;

            SaveHistorySnapshot();

            var (direction, jsonPath) = args;
            var laneIndex = ExtractIndexFromPath(jsonPath, "lanes");
            var itemIndex = ExtractIndexFromPath(jsonPath, "items");

            if (laneIndex < 0 || laneIndex >= _data.Lanes.Count) return;
            var sourceLane = _data.Lanes[laneIndex];
            if (itemIndex < 0 || itemIndex >= sourceLane.Items.Count) return;

            var item = sourceLane.Items[itemIndex];
            int targetLaneIndex = -1;

            if (direction == "up" && laneIndex > 0)
            {
                targetLaneIndex = laneIndex - 1;
            }
            else if (direction == "down" && laneIndex < _data.Lanes.Count - 1)
            {
                targetLaneIndex = laneIndex + 1;
            }

            if (targetLaneIndex >= 0 && targetLaneIndex < _data.Lanes.Count)
            {
                // Remove item from source lane
                sourceLane.Items.RemoveAt(itemIndex);

                // Add item to end of target lane
                var targetLane = _data.Lanes[targetLaneIndex];
                targetLane.Items.Add(item);
                var newItemIndex = targetLane.Items.Count - 1;

                // Update selection to follow the moved item
                SelectionState.Select($"lanes[{targetLaneIndex}].items[{newItemIndex}]", "item", item);
            }

            // Update JSON
            _currentJson = JsonSerializer.Serialize(_data, new JsonSerializerOptions
            {
                WriteIndented = true,
                PropertyNamingPolicy = JsonNamingPolicy.CamelCase
            });

            if (_editor != null)
            {
                await _editor.SetValue(_currentJson);
            }

            if (_error == null && _sessionManager != null && _activeTab != null)
            {
                _activeTab.Data = _data;
                _activeTab.LastModified = DateTime.UtcNow;
                if (_folderManager != null)
                {
                    await DebouncedSave();
                }
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error moving item to different lane: {ex.Message}");
        }
    }

