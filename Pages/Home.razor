    private async Task HandleNavigation(string direction)
    {
        if (_data == null || !SelectionState.IsSelected) return;

        try
        {
            var selectedPath = SelectionState.SelectedPath;
            var elementType = SelectionState.ElementType;

            if (elementType == "item" && selectedPath != null)
            {
                var laneIndex = ExtractIndexFromPath(selectedPath, "lanes");
                var itemIndex = ExtractIndexFromPath(selectedPath, "items");

                int newLaneIndex = laneIndex;
                int newItemIndex = itemIndex;

                switch (direction)
                {
                    case "Left":
                        newItemIndex = itemIndex > 0 ? itemIndex - 1 : itemIndex;
                        break;
                    case "Right":
                        newItemIndex = itemIndex < _data.Lanes[laneIndex].Items.Count - 1 ? itemIndex + 1 : itemIndex;
                        break;
                    case "Up":
                        newLaneIndex = laneIndex > 0 ? laneIndex - 1 : laneIndex;
                        newItemIndex = Math.Min(newItemIndex, _data.Lanes[newLaneIndex].Items.Count - 1);
                        break;
                    case "Down":
                        newLaneIndex = laneIndex < _data.Lanes.Count - 1 ? laneIndex + 1 : laneIndex;
                        newItemIndex = Math.Min(newItemIndex, _data.Lanes[newLaneIndex].Items.Count - 1);
                        break;
                }

                if (newLaneIndex != laneIndex || newItemIndex != itemIndex)
                {
                    var newItem = _data.Lanes[newLaneIndex].Items[newItemIndex];
                    var newPath = $"lanes[{newLaneIndex}].items[{newItemIndex}]";
                    SelectionState.Select(newPath, "item", newItem);
                    await InvokeAsync(StateHasChanged);
                }
            }
            else if (elementType == "lane" && selectedPath != null)
            {
                var laneIndex = ExtractIndexFromPath(selectedPath, "lanes");
                int newLaneIndex = laneIndex;

                switch (direction)
                {
                    case "Up":
                        newLaneIndex = laneIndex > 0 ? laneIndex - 1 : laneIndex;
                        break;
                    case "Down":
                        newLaneIndex = laneIndex < _data.Lanes.Count - 1 ? laneIndex + 1 : laneIndex;
                        break;
                }

                if (newLaneIndex != laneIndex)
                {
                    var newLane = _data.Lanes[newLaneIndex];
                    var newPath = $"lanes[{newLaneIndex}]";
                    SelectionState.Select(newPath, "lane", newLane);
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error during navigation: {ex.Message}");
        }
    }

    [JSInvokable]
    public void StartResize(int laneIndex, int itemIndex, string edge, double clientX)
    {
        if (_data == null || StateManager.IsPreviewMode) return;

        SaveHistorySnapshot();

        _isResizing = true;
        _resizingLaneIndex = laneIndex;
        _resizingItemIndex = itemIndex;
        _resizingEdge = edge;
        _resizeStartX = clientX;

        var item = _data.Lanes[laneIndex].Items[itemIndex];
        _resizeOriginalStart = item.Start;
        _resizeOriginalLength = item.Length;
    }

    [JSInvokable]
    public async Task UpdateResize(double clientX)
    {
        if (!_isResizing || _data == null) return;

        try
        {
            var item = _data.Lanes[_resizingLaneIndex].Items[_resizingItemIndex];
            var columnCount = _data.Columns.Count;
            var deltaX = clientX - _resizeStartX;

            // Convert pixel delta to column percentage (approximate)
            // Assuming the roadmap container width represents 100% of columns
            var percentPerColumn = 100.0 / columnCount;
            var deltaPercent = (deltaX / 3000.0) * percentPerColumn; // 3x slower for larger deliberate strokes

            if (_resizingEdge == "left")
            {
                // Moving left edge: adjust start position only
                var newStart = Math.Max(0, _resizeOriginalStart + deltaPercent);
                var snappedStart = RoundToQuarter(newStart);
                var newLength = _resizeOriginalLength - (snappedStart - _resizeOriginalStart);

                // Ensure item doesn't exceed column boundaries
                if (newLength > 0.25 && snappedStart + newLength <= columnCount)
                {
                    item.Start = snappedStart;
                    item.Length = RoundToQuarter(newLength);
                }
            }
            else if (_resizingEdge == "right")
            {
                // Moving right edge: adjust length only
                var newLength = Math.Max(0.25, _resizeOriginalLength + deltaPercent);
                var snappedLength = RoundToQuarter(newLength);

                // Ensure item doesn't exceed column boundaries
                if (item.Start + snappedLength <= columnCount)
                {
                    item.Length = snappedLength;
                }
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error during resize: {ex.Message}");
        }
    }

    private double RoundToQuarter(double value)
    {
        // Round to nearest 0.25 increment
        return Math.Round(value * 4) / 4;
    }

    [JSInvokable]
    public async Task EndResize()
    {
        if (!_isResizing) return;

        _isResizing = false;

        // Update the JSON and save to storage
        if (_data != null)
        {
            var updatedJson = JsonSerializer.Serialize(_data, new JsonSerializerOptions
            {
                WriteIndented = true,
                PropertyNamingPolicy = JsonNamingPolicy.CamelCase
            });

            _currentJson = updatedJson;

            // Sync to editor if it's open
            if (_editor != null)
            {
                await _editor.SetValue(updatedJson);
            }

            // Always save to storage regardless of editor state
            if (_sessionManager != null && _activeTab != null && _folderManager != null)
            {
                _activeTab.Data = _data;
                _activeTab.LastModified = DateTime.UtcNow;
                await DebouncedSave();
            }
        }

        await InvokeAsync(StateHasChanged);
    }

