    private async Task HandleTabSwitch(string tabId)
    {
        if (_sessionManager == null || _folderManager == null) return;

        _sessionManager.ActiveTabId = tabId;
        _activeTab = StorageService.GetActiveTab(_sessionManager);

        if (_activeTab != null)
