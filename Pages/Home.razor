    private StandaloneEditorConstructionOptions EditorConstructionOptions(StandaloneCodeEditor editor)
    {
        return new StandaloneEditorConstructionOptions
        {
            Language = "json",
            Value = DefaultJson,
            Theme = "vs-dark",
            Minimap = new EditorMinimapOptions { Enabled = false },
            AutomaticLayout = true,
            FontSize = 13,
            LineNumbers = "on",
            ScrollBeyondLastLine = false,
            WordWrap = "on",
            TabSize = 2,
            FormatOnPaste = true,
            FormatOnType = true
        };
    }

    private async Task EditorOnDidInit()
    {
        _editorReady = true;

        // Only initialize session if not already loaded
        if (_sessionManager == null || _activeTab == null)
        {
            await InitializeFolderManagerAsync();
        }

        // Set editor value
        if (_editor != null && _activeTab != null)
        {
            _currentJson = JsonSerializer.Serialize(_activeTab.Data, new JsonSerializerOptions { WriteIndented = true });
            await _editor.SetValue(_currentJson);
        }

        // Parse JSON if not already parsed (data could be null if editor loads before OnInitializedAsync completes)
        if (_data == null && !string.IsNullOrEmpty(_currentJson))
        {
            ParseJson(_currentJson);
        }

        _lastUpdateSuccess = _error == null;
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        // Load or initialize folder manager
        await InitializeFolderManagerAsync();

        // Parse the JSON immediately so the UI displays even if editor hasn't loaded
        if (_data != null && !string.IsNullOrEmpty(_currentJson))
        {
            ParseJson(_currentJson);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task InitializeFolderManagerAsync()
    {
        // Load folder manager from storage
        _folderManager = await StorageService.LoadFolderManagerAsync();

        if (_folderManager == null || _folderManager.Folders.Count == 0)
        {
            // Create default folder manager with one folder containing one tab
            var defaultRoadmap = TemplateService.GetScrumSprintCycleTemplate();

            _folderManager = new FolderManager
            {
                ActiveFolderId = "folder-1",
                Folders = new List<Folder>
                {
                    new Folder
                    {
                        Id = "folder-1",
                        Name = "Project Folder",
                        Icon = "folder",
                        Color = "#667eea",
                        SessionManager = new SessionManager
                        {
                            ActiveTabId = "tab-1",
                            Tabs = new List<TabSession>
                            {
                                new TabSession
                                {
                                    Id = "tab-1",
                                    Name = defaultRoadmap.Title,
                                    LastModified = DateTime.UtcNow,
                                    Data = defaultRoadmap
                                }
                            },
                            MaxTabs = 5
                        },
                        LastModified = DateTime.UtcNow
                    }
                },
                MaxFolders = 3
            };

            await StorageService.SaveFolderManagerAsync(_folderManager);
        }

        // Get active folder and session
        _activeFolder = StorageService.GetActiveFolder(_folderManager);
        if (_activeFolder != null)
        {
            _sessionManager = _activeFolder.SessionManager;
            // Ensure MaxTabs is set to 5
            _sessionManager.MaxTabs = 5;

            // Get active tab
            _activeTab = StorageService.GetActiveTab(_sessionManager);
            if (_activeTab != null)
            {
                _data = _activeTab.Data;
                _currentJson = JsonSerializer.Serialize(_data, new JsonSerializerOptions { WriteIndented = true });
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("RoadScriptInterop.setupKeyboardShortcuts", _dotNetRef);
        }
    }

    [JSInvokable]
    public async Task HandleKeyboardShortcut(string action)
    {
        switch (action)
        {
            case "TogglePreview":
                ToggleViewMode();
                break;
            case "ToggleTheme":
                ToggleTheme();
                break;
            case "ClearSelection":
                SelectionState.Clear();
                await InvokeAsync(StateHasChanged);
                break;
        }
    }

    private async Task ExportAsPng()
    {
        try
        {
            var filename = $"roadmap-{DateTime.Now:yyyy-MM-dd}.png";
            await JSRuntime.InvokeVoidAsync("RoadScriptInterop.exportAsPng", ".roadmap-container", filename);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error exporting PNG: {ex.Message}");
        }
    }

    private async Task DownloadJson()
    {
        try
        {
            if (_editor == null || !_editorReady) return;

            var jsonContent = await _editor.GetValue();
            var filename = $"roadmap-{DateTime.Now:yyyy-MM-dd}.json";
            await JSRuntime.InvokeVoidAsync("RoadScriptInterop.downloadJson", jsonContent, filename);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error downloading JSON: {ex.Message}");
        }
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
        JSRuntime.InvokeVoidAsync("RoadScriptInterop.removeKeyboardShortcuts");
    }

    private async Task UpdatePreview()
    {
        if (_editor == null || !_editorReady) return;

        _isUpdating = true;
        StateHasChanged();

        try
        {
            await Task.Delay(50); // Brief delay for visual feedback
            var value = await _editor.GetValue();
            _currentJson = value;
            ParseJson(value);
            _lastUpdateSuccess = _error == null;

            // Save to storage if parsing was successful
            if (_error == null && _sessionManager != null && _activeTab != null)
            {
                _activeTab.Data = _data!;
                _activeTab.LastModified = DateTime.UtcNow;
                if (_folderManager != null)
                {
                    await StorageService.SaveFolderManagerAsync(_folderManager);
                }
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to read editor: {ex.Message}";
            _lastUpdateSuccess = false;
        }
        finally
        {
            _isUpdating = false;
            StateHasChanged();
        }
    }

    private async Task ResetToDefault()
    {
        if (_editor == null || !_editorReady) return;

        try
        {
            await _editor.SetValue(DefaultJson);
            _currentJson = DefaultJson;
            ParseJson(DefaultJson);
            _lastUpdateSuccess = true;

            // Clear storage and create fresh session
            await StorageService.ClearStorageAsync();
            await InitializeFolderManagerAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to reset editor: {ex.Message}";
        }

        StateHasChanged();
    }

    private void ToggleTheme(ChangeEventArgs? e = null)
    {
        _isVibeMode = !_isVibeMode;
        StateHasChanged();
    }

    private void ToggleViewMode(ChangeEventArgs? e = null)
    {
        _isPreviewMode = !_isPreviewMode;
        // Auto-hide properties panel in preview mode, show in edit mode
        _showProperties = !_isPreviewMode;
        // Auto-hide Command Center only when entering preview mode (don't auto-show when exiting)
        if (_isPreviewMode)
        {
            _showControlPanel = false;
        }
        StateHasChanged();
    }

    private void ToggleControlPanel()
    {
        _showControlPanel = !_showControlPanel;
        StateHasChanged();
    }

    private void ToggleAdvancedSection()
    {
        _showAdvancedSection = !_showAdvancedSection;
        StateHasChanged();
    }

    private void ToggleProperties()
    {
        _showProperties = !_showProperties;
        StateHasChanged();
    }

    private void ParseJson(string json)
    {
        try
        {
            var options = new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true,
                AllowTrailingCommas = true,
                ReadCommentHandling = JsonCommentHandling.Skip
            };
            _data = JsonSerializer.Deserialize<RoadmapData>(json, options);
            _error = null;
        }
        catch (JsonException ex)
        {
            _data = null;
            _error = $"Line {ex.LineNumber}, Position {ex.BytePositionInLine}: {ex.Message}";
        }
        catch (Exception ex)
        {
            _data = null;
            _error = ex.Message;
        }
    }

