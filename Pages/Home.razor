    // === Vibe Mode Color Helpers ===

    private string GetVibeColor(string hexColor) =>
        hexColor.ToLower() switch
        {
            "#45b69c" => "#00ffcc",
            "#4a90d9" => "#4da6ff",
            "#d4a520" => "#ffd700",
            "#9b7ed9" => "#b794f6",
            _ => "#00e5ff"
        };

    private string GetVibeGradient(string hexColor) =>
        hexColor.ToLower() switch
        {
            "#45b69c" => "background: linear-gradient(135deg, rgba(0, 255, 204, 0.15) 0%, rgba(0, 229, 255, 0.1) 100%);",
            "#4a90d9" => "background: linear-gradient(135deg, rgba(77, 166, 255, 0.15) 0%, rgba(102, 126, 234, 0.1) 100%);",
            "#d4a520" => "background: linear-gradient(135deg, rgba(255, 215, 0, 0.15) 0%, rgba(255, 165, 0, 0.1) 100%);",
            "#9b7ed9" => "background: linear-gradient(135deg, rgba(183, 148, 246, 0.15) 0%, rgba(118, 75, 162, 0.1) 100%);",
            _ => "background: linear-gradient(135deg, rgba(0, 229, 255, 0.15) 0%, rgba(102, 126, 234, 0.1) 100%);"
        };

    // === Interactive Editing Methods ===

    private string GetElementClass(string jsonPath)
    {
        // Don't add clickable classes in preview mode
        if (_isPreviewMode) return "";

        var baseClass = "clickable-element";
        if (SelectionState.SelectedPath == jsonPath)
        {
            baseClass += " selected-element";
        }
        return baseClass;
    }

    private async Task HandleItemClick(int laneIndex, int itemIndex, Item item)
    {
        var jsonPath = $"lanes[{laneIndex}].items[{itemIndex}]";
        SelectionState.Select(jsonPath, "item", item);

        await EditorInterop.NavigateToJsonPath(
            "roadscript-json-editor",
            _currentJson,
            jsonPath,
            highlight: true
        );
    }

    private async Task HandleElementClick(string jsonPath, string elementType, object element)
    {
        SelectionState.Select(jsonPath, elementType, element);

        await EditorInterop.NavigateToJsonPath(
            "roadscript-json-editor",
            _currentJson,
            jsonPath,
            highlight: true
        );
    }

    private async Task HandlePropertyChange((string JsonPath, string PropertyName, object Value) change)
    {
        try
        {
            var updatedJson = await EditorInterop.UpdateJsonValue(
                _currentJson,
                $"{change.JsonPath}.{change.PropertyName}",
                change.Value
            );

            if (updatedJson != null && _editor != null)
            {
                await _editor.SetValue(updatedJson);
                _currentJson = updatedJson;
                ParseJson(updatedJson);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating property: {ex.Message}");
        }
    }
}