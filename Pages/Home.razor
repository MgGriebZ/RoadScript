@page "/"
@using BlazorMonaco
@using BlazorMonaco.Editor
@using System.Text.Json
@using System.Text.Json.Serialization
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Web
@using RoadScript.Components
@using RoadScript.Models
@using RoadScript.Services
@inject IJSRuntime JSRuntime
@inject EditorInteropService EditorInterop
@inject SelectionState SelectionState
@inject StorageService StorageService
@inject UrlNavigationService UrlNavigation
@inject ThemeService ThemeService
@inject RoadmapStateManager StateManager
@implements IDisposable

<div class="container-fluid vh-100 d-flex p-0">
    @* Collapsed Command Center - Always visible (60px) *@
    <CommandCenter FolderManager="_folderManager"
                   SessionManager="_sessionManager"
                   ActiveTab="_activeTab"
                   IsPreviewMode="@StateManager.IsPreviewMode"
                   CurrentTheme="@ThemeService.CurrentTheme"
                   OnToggleFolderSelector="ToggleFolderSelector"
                   OnTabDelete="HandleCollapsedTabDelete"
                   OnTabSwitch="HandleTabSwitch"
                   OnTabRename="HandleTabRename"
                   OnFolderClick="HandleFolderClick"
                   OnTabAdd="HandleTabAdd"
                   OnExportPng="ExportAsPng"
                   OnToggleViewMode="@(async () => await ToggleViewMode(null))"
                   OnCycleTheme="CycleSeasonalTheme"
                   OnTemplateApply="ApplyTemplate" />

    <div class="preview-pane" style="@ThemeService.PreviewPaneStyle()">
        @if (_data != null)
        {
            <RoadmapRenderer Data="@_data"
                           IsPreviewMode="@StateManager.IsPreviewMode"
                           ActiveTab="@_activeTab"
                           SessionManager="@_sessionManager"
                           AvailableRoadmaps="@AllRoadmapsAcrossFolders"
                           OnElementClick="@HandleElementClick"
                           OnItemClick="@HandleItemClick"
                           OnMilestoneJumpToStart="@JumpMilestoneToStart"
                           OnMilestoneJumpToEnd="@JumpMilestoneToEnd"
                           OnMilestoneAdjustPosition="@((args) => AdjustMilestonePosition(args.MilestoneIndex, args.Delta))"
                           OnMilestoneAdjustByColumn="@((args) => AdjustMilestoneByColumn(args.MilestoneIndex, args.Direction))"
                           OnRoadmapLinkClick="@HandleRoadmapLinkClick"
                           OnTitleClick="@HandleTitleClick" />

            <RoadmapFooter ActiveTab="@_activeTab"
                          Data="@_data"
                          IsPreviewMode="@StateManager.IsPreviewMode"
                          OnShareClick="@HandleQuickShare"
                          OnImportClick="@HandleFooterImportClick" />
        }
        else if (_error != null)
        {
            <div style="background: #fee2e2; border: 1px solid #fca5a5; color: #b91c1c; padding: 16px; border-radius: 8px; max-width: 600px;">
                <strong>JSON Error:</strong> @_error
            </div>
        }
    </div>

    @* Hidden file input for folder import *@
    <InputFile @ref="_folderImportInput" OnChange="HandleFolderImport" accept=".json" style="display: none;" />

    @* Hidden file input for all data import *@
    <InputFile @ref="_allDataImportInput" OnChange="HandleAllDataImport" accept=".json" style="display: none;" />

    @* Right Sidebar: Properties Panel OR JSON Editor *@
    @if (!StateManager.IsJsonEditorMode)
    {
        @* Properties Mode: Standard property editing panel *@
        <PropertyPanel OnPropertyChange="HandlePropertyChange"
                      OnAddElement="HandleAddElement"
                      OnRemoveElement="HandleRemoveElement"
                      OnDuplicateElement="HandleDuplicateElement"
                      OnMoveItem="HandleMoveItem"
                      OnMoveLane="HandleMoveLane"
                      OnHidePanel="ToggleProperties"
                      OnToggleJsonEditor="ToggleJsonEditorMode"
                      OnSelectTitle="HandleSelectTitle"
                      IsCollapsed="@(!StateManager.ShowProperties)"
                      ColumnCount="@(_data?.Columns.Count ?? 4)"
                      LaneCount="@(_data?.Lanes.Count ?? 1)"
                      MilestoneCount="@(_data?.Milestones.Count ?? 0)"
                      ItemIndex="@GetSelectedItemIndex()"
                      ItemCount="@GetSelectedItemCount()"
                      LaneIndex="@GetSelectedLaneIndex()"
                      AvailableRoadmaps="@AllRoadmapsAcrossFolders" />
    }
    else
    {
        @* JSON Editor Mode: Advanced JSON editor in right sidebar *@
        <div class="property-panel" style="width: 27%; min-width: 320px; max-width: 450px; background: #1e1e2f; border-left: 1px solid #3a3a4e; display: flex; flex-direction: column; transition: all 0.3s ease; height: 100%;">
            <div style="display: flex; align-items: center; gap: 8px; padding: 12px 16px; background: #252538; border-bottom: 1px solid #3a3a4e;">
                <Icon IconType="atom" Size="20" Color="#00D9FF" />
                <span style="font-size: 14px; font-weight: 600; color: #00D9FF;">JSON Editor</span>

                <button @onclick="ToggleJsonEditorMode"
                        title="Switch to Properties Mode"
                        style="margin-left: auto; background: linear-gradient(135deg, #764ba2 0%, #667eea 100%); color: #fff; border: none; padding: 10px 18px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.2s; box-shadow: 0 2px 8px rgba(118, 75, 162, 0.3);">
                    Properties
                </button>
            </div>

            @* JSON Textarea - Full Height *@
            <textarea @ref="_jsonTextArea"
                      @bind="_currentJson"
                      @bind:event="oninput"
                      @bind:after="MarkJsonDirty"
                      style="flex: 1; background: #252538; color: #e0e7ff; border: none; padding: 12px; font-family: 'Courier New', monospace; font-size: 11px; line-height: 1.5; resize: none; overflow-y: auto;"
                      spellcheck="false"
                      placeholder="Enter your roadmap JSON here..."></textarea>

            @* Update Button - Directly below JSON content *@
            <div style="padding: 12px 16px; background: #1e1e2f; border-top: 1px solid #3a3a4e;">
                <button @onclick="UpdateFromJson"
                        disabled="@_isUpdating"
                        style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border: none; padding: 10px 16px; border-radius: 6px; cursor: pointer; font-size: 13px; font-weight: 600; transition: all 0.2s; opacity: @(_isUpdating ? "0.5" : "1"); width: 100%; box-shadow: 0 2px 8px rgba(102, 126, 234, 0.3);">
                    @if (_isUpdating)
                    {
                        <span>⏳ Updating...</span>
                    }
                    else if (_lastUpdateSuccess)
                    {
                        <span>✓ Update Roadmap</span>
                    }
                    else
                    {
                        <span>🔄 Update Roadmap</span>
                    }
                </button>
            </div>

            @* Export/Import Actions *@
            <div style="display: flex; flex-direction: column; gap: 12px; padding: 16px; background: #1a1a2e; border-top: 1px solid #3a3a4e;">
                @* Current Roadmap Section *@
                <div style="display: flex; flex-direction: column; gap: 6px;">
                    <div style="font-size: 11px; font-weight: 600; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px;">
                        Current Roadmap
                    </div>
                    <button @onclick="SaveJson"
                            style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; border: none; padding: 8px 12px; border-radius: 5px; cursor: pointer; font-size: 12px; font-weight: 600; transition: all 0.2s; width: 100%; box-shadow: 0 2px 6px rgba(16, 185, 129, 0.2);">
                        💾 Save Roadmap
                    </button>
                </div>

                @* All Session Data Section *@
                <div style="display: flex; flex-direction: column; gap: 6px;">
                    <div style="font-size: 11px; font-weight: 600; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px;">
                        All Session Data
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 6px;">
                        <button @onclick="ExportAllData"
                                style="background: linear-gradient(135deg, #ec4899 0%, #db2777 100%); color: white; border: none; padding: 8px 10px; border-radius: 5px; cursor: pointer; font-size: 11px; font-weight: 600; transition: all 0.2s; box-shadow: 0 2px 6px rgba(236, 72, 153, 0.2);">
                            📦 Export Session Data
                        </button>
                        <button @onclick="ImportAllData"
                                style="background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%); color: white; border: none; padding: 8px 10px; border-radius: 5px; cursor: pointer; font-size: 11px; font-weight: 600; transition: all 0.2s; box-shadow: 0 2px 6px rgba(6, 182, 212, 0.2);">
                            📥 Import Session Data
                        </button>
                    </div>
                    <div style="font-size: 10px; color: #6b7280; line-height: 1.3; margin-top: 2px;">
                        Export/import all folders and roadmaps
                    </div>
                </div>
            </div>

            @* Error Display *@
            @if (!string.IsNullOrEmpty(_error))
            {
                <div style="background: rgba(239, 68, 68, 0.1); border-top: 1px solid #ef4444; padding: 8px 12px; color: #ef4444; font-size: 11px;">
                    <strong>Error:</strong> @_error
                </div>
            }
        </div>
    }

    @if (_folderManager != null)
    {
        <RoadmapManager IsVisible="@StateManager.ShowRoadmapManager"
                       Folders="@_folderManager.Folders"
                       ActiveFolderId="@_folderManager.ActiveFolderId"
                       MaxFolders="@_folderManager.MaxFolders"
                       OnClose="CloseRoadmapManager"
                       OnFolderRename="HandleFolderRenameFromManager"
                       OnDeleteFolder="HandleDeleteFolderFromManager"
                       OnColorChange="HandleColorChangeFromManager"
                       OnIconChange="HandleIconChangeFromManager"
                       OnAddFolder="HandleAddFolder"
                       OnAddRoadmap="HandleAddRoadmapToFolder"
                       OnRoadmapClick="HandleRoadmapClickFromManager"
                       OnRoadmapOpen="HandleRoadmapOpenFromManager"
                       OnRoadmapRename="HandleRoadmapRenameFromManager"
                       OnRoadmapDuplicate="HandleRoadmapDuplicateFromManager"
                       OnRoadmapDelete="HandleRoadmapDeleteFromManager"
                       OnRoadmapMove="HandleRoadmapMoveFromManager" />

        <DependencyConfirmationModal IsVisible="@_showDependencyModal"
                                    RoadmapName="@_movingRoadmapName"
                                    SourceFolderName="@_moveSourceFolderName"
                                    TargetFolderName="@_moveTargetFolderName"
                                    AnalysisResult="@_dependencyAnalysisResult"
                                    OnConfirm="ConfirmRoadmapMove"
                                    OnCancel="CancelRoadmapMove" />

        <FolderSelector IsVisible="@StateManager.ShowFolderSettings"
                       Folders="@_folderManager.Folders"
                       ActiveFolderId="@_folderManager.ActiveFolderId"
                       MaxFolders="@_folderManager.MaxFolders"
                       OnClose="CloseFolderSettings"
                       OnFolderSelect="HandleFolderSelect"
                       OnAddFolder="HandleAddFolder"
                       OnRemoveFolder="HandleRemoveFolder"
                       OnRenameFolder="HandleRenameFolder"
                       OnMoveFolderLeft="HandleMoveFolderLeft"
                       OnMoveFolderRight="HandleMoveFolderRight"
                       OnColorChange="HandleFolderColorChange"
                       OnIconChange="HandleFolderIconChange" />
    }

    <ShareModal IsVisible="@StateManager.ShowShareModal"
               ShareUrl="@StateManager.ShareUrl"
               ErrorMessage="@StateManager.ShareError"
               RoadmapStats="@GetRoadmapStats()"
               SessionStats="@GetSessionStats()"
               OnClose="CloseShareModal"
               OnExportSession="HandleExportSessionFromShareModal" />

    <ImportModal IsVisible="@StateManager.ShowImportModal"
                RoadmapData="@StateManager.ImportRoadmapData"
                AvailableFolders="@(_folderManager?.Folders ?? new())"
                OnClose="CloseImportModal"
                OnImport="HandleImportSharedRoadmap" />

    <TemplateSelector IsVisible="@StateManager.ShowTemplateSelector"
                     OnClose="CloseTemplateSelector"
                     OnTemplateSelect="HandleTemplateSelect" />
</div>

