    private StandaloneEditorConstructionOptions EditorConstructionOptions(StandaloneCodeEditor editor)
    {
        return new StandaloneEditorConstructionOptions
        {
            Language = "json",
            Value = DefaultJson,
            Theme = "vs-dark",
            Minimap = new EditorMinimapOptions { Enabled = false },
            AutomaticLayout = true,
            FontSize = 13,
            LineNumbers = "on",
            ScrollBeyondLastLine = false,
            WordWrap = "on",
            TabSize = 2,
            FormatOnPaste = true,
            FormatOnType = true
        };
    }

    private async Task EditorOnDidInit()
    {
        _editorReady = true;

        if (_sessionManager == null || _activeTab == null)
        {
            await InitializeFolderManagerAsync();
        }

        if (_editor != null && _activeTab != null)
        {
            _currentJson = JsonSerializer.Serialize(_activeTab.Data, new JsonSerializerOptions { WriteIndented = true });
            await _editor.SetValue(_currentJson);
        }

        if (_data == null && !string.IsNullOrEmpty(_currentJson))
        {
            ParseJson(_currentJson);
        }

        _lastUpdateSuccess = _error == null;
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        await InitializeFolderManagerAsync();

        // Subscribe to service state changes
        StateManager.OnStateChanged += HandleStateChanged;
        ThemeService.OnThemeChanged += HandleThemeChanged;

        // Handle URL-based navigation and sharing
        await HandleUrlNavigation();

        if (_data != null && !string.IsNullOrEmpty(_currentJson))
        {
            ParseJson(_currentJson);
            await InvokeAsync(StateHasChanged);
        }
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void HandleThemeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task HandleUrlNavigation()
    {
        try
        {
            var hash = await UrlNavigation.GetCurrentHash();
            var (folderId, tabId, shareCode) = UrlNavigation.ParseHash(hash);

            if (!string.IsNullOrEmpty(shareCode))
            {
                // Handle share URL - show import modal
                var sharedData = ShareService.ParseShareUrl(shareCode);
                if (sharedData != null)
                {
                    StateManager.ShowImportDialog(sharedData);
                }
            }
            else if (!string.IsNullOrEmpty(folderId) && !string.IsNullOrEmpty(tabId) && _folderManager != null)
            {
                // Handle navigation URL - switch to specified folder/tab
                var folder = _folderManager.Folders.FirstOrDefault(f => f.Id == folderId);
                if (folder != null)
                {
                    _folderManager.ActiveFolderId = folderId;
                    _activeFolder = folder;
                    _sessionManager = folder.SessionManager;

                    var tab = folder.SessionManager.Tabs.FirstOrDefault(t => t.Id == tabId);
                    if (tab != null)
                    {
                        folder.SessionManager.ActiveTabId = tabId;
                        _activeTab = tab;
                        _data = tab.Data;
                        _currentJson = JsonSerializer.Serialize(_data, new JsonSerializerOptions { WriteIndented = true });
                        await DebouncedSave();
                    }
                }
            }
        }
        catch (Exception)
        {
            // Silently fail if URL parsing fails
        }
    }

    private async Task InitializeFolderManagerAsync()
    {
        _folderManager = await StorageService.LoadFolderManagerAsync();

        if (_folderManager == null || _folderManager.Folders.Count == 0)
        {
            var defaultRoadmap = TemplateService.GetScrumSprintCycleTemplate();

            _folderManager = new FolderManager
            {
                ActiveFolderId = "folder-1",
                Folders = new List<Folder>
                {
                    new Folder
                    {
                        Id = "folder-1",
                        Name = "Project Folder",
                        Icon = "folder",
                        Color = "#667eea",
                        SessionManager = new SessionManager
                        {
                            ActiveTabId = "tab-1",
                            Tabs = new List<TabSession>
                            {
                                new TabSession
                                {
                                    Id = "tab-1",
                                    Name = defaultRoadmap.Title,
                                    LastModified = DateTime.UtcNow,
                                    Data = defaultRoadmap
                                }
                            },
                            MaxTabs = 5
                        },
                        LastModified = DateTime.UtcNow
                    }
                },
                MaxFolders = 3
            };

            await DebouncedSave();
        }

        _activeFolder = StorageService.GetActiveFolder(_folderManager);
        if (_activeFolder != null)
        {
            _sessionManager = _activeFolder.SessionManager;
            _sessionManager.MaxTabs = 5;
            _activeTab = StorageService.GetActiveTab(_sessionManager);
            if (_activeTab != null)
            {
                _data = _activeTab.Data;
                _currentJson = JsonSerializer.Serialize(_data, new JsonSerializerOptions { WriteIndented = true });
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("RoadScriptInterop.setupKeyboardShortcuts", _dotNetRef);
        }

        // Setup resize/move handlers for all items (runs on every render to handle new items)
        if (!StateManager.IsPreviewMode && _dotNetRef != null && _data != null)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("RoadScriptInterop.setupAllItemResize", _dotNetRef);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error setting up item resize: {ex.Message}");
            }
        }
    }

    [JSInvokable]
    public async Task HandleKeyboardShortcut(string action)
    {
        switch (action)
        {
            case "TogglePreview":
                await ToggleViewMode();
                break;
            case "ClearSelection":
                SelectionState.Clear();
                await InvokeAsync(StateHasChanged);
                break;
            case "Undo":
                await HandleUndo();
                break;
            case "Redo":
                await HandleRedo();
                break;
            case "Duplicate":
                await HandleDuplicateShortcut();
                break;
            case "Delete":
                await HandleDeleteShortcut();
                break;
            case "NavigateLeft":
            case "NavigateRight":
            case "NavigateUp":
            case "NavigateDown":
                await HandleNavigation(action.Replace("Navigate", ""));
                break;
        }
    }

    private void SaveHistorySnapshot()
    {
        if (!string.IsNullOrEmpty(_currentJson))
        {
            SelectionState.PushHistory(_currentJson);
        }
    }

    private async Task HandleUndo()
    {
        try
        {
            var previousJson = SelectionState.Undo();
            if (previousJson != null && _editor != null)
            {
                _currentJson = previousJson;
                ParseJson(previousJson);
                await _editor.SetValue(previousJson);

                if (_error == null && _sessionManager != null && _activeTab != null)
                {
                    _activeTab.Data = _data!;
                    _activeTab.LastModified = DateTime.UtcNow;
                    if (_folderManager != null)
                    {
                        // Use immediate save for undo (critical state change)
                        await SaveState();
                    }
                }

                SelectionState.Clear();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error during undo: {ex.Message}");
        }
    }

    private async Task HandleRedo()
    {
        try
        {
            var nextJson = SelectionState.Redo();
            if (nextJson != null && _editor != null)
            {
                _currentJson = nextJson;
                ParseJson(nextJson);
                await _editor.SetValue(nextJson);

                if (_error == null && _sessionManager != null && _activeTab != null)
                {
                    _activeTab.Data = _data!;
                    _activeTab.LastModified = DateTime.UtcNow;
                    if (_folderManager != null)
                    {
                        // Use immediate save for redo (critical state change)
                        await SaveState();
                    }
                }

                SelectionState.Clear();
                await InvokeAsync(StateHasChanged);
            }
        }
