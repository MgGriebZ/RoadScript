@page "/"
@using BlazorMonaco
@using BlazorMonaco.Editor
@using System.Text.Json
@using Microsoft.JSInterop
@using RoadScript.Components
@using RoadScript.Services
@inject IJSRuntime JSRuntime
@inject EditorInteropService EditorInterop
@inject SelectionState SelectionState
@inject StorageService StorageService
@implements IDisposable

<div class="container-fluid vh-100 d-flex p-0">
    @* Control Center Panel - Always visible *@
    <div class="@(_showControlPanel ? "control-panel control-panel-expanded" : "control-panel control-panel-collapsed")">
        @if (_showControlPanel)
        {
            @* Expanded Control Center *@
            <div style="background: #1e1e1e; padding: 12px 16px; font-weight: 600; color: #fff; border-bottom: 1px solid #333; display: flex; justify-content: space-between; align-items: center;">
                <div style="display: flex; flex-direction: column; gap: 2px;">
                    <span style="font-size: 18px; font-weight: 700; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">RoadScript</span>
                    <span style="font-size: 11px; color: #666; font-weight: 400;">Control Center</span>
                </div>
                <button @onclick="ToggleControlPanel"
                        title="Collapse Control Panel"
                        style="background: #3c3c3c; color: #ccc; border: 1px solid #555; padding: 4px 10px; border-radius: 4px; font-size: 11px; font-weight: 500; cursor: pointer; transition: all 0.2s;">
                    ◀
                </button>
            </div>

            <div style="flex: 1; overflow-y: auto; padding: 16px; background: #252526;">
                @* Tab Management Section *@
                <div style="margin-bottom: 20px;">
                    <h3 style="color: #e0e7ff; font-size: 13px; font-weight: 600; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px;">Tab Management</h3>
                    @if (_sessionManager != null)
                    {
                        <TabBar Tabs="@_sessionManager.Tabs"
                               ActiveTabId="@_sessionManager.ActiveTabId"
                               MaxTabs="3"
                               OnTabSwitch="HandleTabSwitch"
                               OnTabAdd="HandleTabAdd"
                               OnTabDelete="HandleTabDelete"
                               OnTabRename="HandleTabRename" />
                    }
                </div>

                @* Quick Templates Section *@
                <div style="margin-bottom: 20px;">
                    <h3 style="color: #e0e7ff; font-size: 13px; font-weight: 600; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px;">Quick Templates</h3>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                        <button @onclick="@(() => ApplyTemplate(TemplateService.TemplateType.Weekly7Days))"
                                style="background: #3c3c3c; color: #ccc; border: 1px solid #555; padding: 8px 12px; border-radius: 4px; font-size: 12px; font-weight: 500; cursor: pointer; transition: all 0.2s;">
                            Weekly (7 Days)
                        </button>
                        <button @onclick="@(() => ApplyTemplate(TemplateService.TemplateType.Monthly4Weeks))"
                                style="background: #3c3c3c; color: #ccc; border: 1px solid #555; padding: 8px 12px; border-radius: 4px; font-size: 12px; font-weight: 500; cursor: pointer; transition: all 0.2s;">
                            Monthly (4 Weeks)
                        </button>
                        <button @onclick="@(() => ApplyTemplate(TemplateService.TemplateType.Quarterly4Quarters))"
                                style="background: #3c3c3c; color: #ccc; border: 1px solid #555; padding: 8px 12px; border-radius: 4px; font-size: 12px; font-weight: 500; cursor: pointer; transition: all 0.2s;">
                            Quarterly (4 Quarters)
                        </button>
                        <button @onclick="@(() => ApplyTemplate(TemplateService.TemplateType.Yearly12Months))"
                                style="background: #3c3c3c; color: #ccc; border: 1px solid #555; padding: 8px 12px; border-radius: 4px; font-size: 12px; font-weight: 500; cursor: pointer; transition: all 0.2s;">
                            Yearly (12 Months)
                        </button>
                    </div>
                </div>

                @* View Modes Section *@
                <div style="margin-bottom: 20px;">
                    <h3 style="color: #e0e7ff; font-size: 13px; font-weight: 600; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px;">View Modes</h3>
                    <div style="display: flex; flex-direction: column; gap: 10px;">
                        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; color: #ccc; font-size: 13px;">
                            <input type="checkbox" checked="@_isPreviewMode" @onchange="ToggleViewMode" style="width: 16px; height: 16px; cursor: pointer;" />
                            <span>@(_isPreviewMode ? "👁️ Preview Mode" : "📝 Edit Mode")</span>
                        </label>
                        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; color: #ccc; font-size: 13px;">
                            <input type="checkbox" checked="@_isVibeMode" @onchange="ToggleTheme" style="width: 16px; height: 16px; cursor: pointer;" />
                            <span>@(_isVibeMode ? "🌙 Vibe Mode" : "☀️ Lite Mode")</span>
                        </label>
                    </div>
                </div>

                @* Export PNG Button *@
                <div style="margin-bottom: 20px;">
                    <button @onclick="ExportAsPng"
                            style="width: 100%; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; border: none; padding: 12px 16px; border-radius: 6px; font-size: 14px; font-weight: 600; cursor: pointer; transition: all 0.2s; box-shadow: 0 2px 8px rgba(102, 126, 234, 0.3);">
                        📷 Export as PNG
                    </button>
                </div>

                @* Advanced Section (Collapsible JSON Editor) *@
                <div style="border-top: 1px solid #3a3a4e; padding-top: 16px;">
                    <button @onclick="ToggleAdvancedSection"
                            style="width: 100%; background: #2a2a3e; color: #ccc; border: 1px solid #3a3a4e; padding: 10px 12px; border-radius: 4px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.2s; display: flex; justify-content: space-between; align-items: center;">
                        <span>⚙️ Advanced JSON Editor</span>
                        <span style="transform: rotate(@(_showAdvancedSection ? "180deg" : "0deg")); transition: transform 0.2s;">▼</span>
                    </button>

                    @if (_showAdvancedSection)
                    {
                        <div style="margin-top: 12px;">
                            <div style="background: #1e1e1e; padding: 8px 12px; border-radius: 4px; border: 1px solid #3a3a4e; display: flex; gap: 8px; align-items: center; margin-bottom: 8px;">
                                <button @onclick="UpdatePreview"
                                        disabled="@(!_editorReady)"
                                        style="@UpdateButtonStyle()">
                                    Update
                                </button>
                                <button @onclick="ResetToDefault"
                                        disabled="@(!_editorReady)"
                                        style="background: #3c3c3c; color: #ccc; border: 1px solid #555; padding: 6px 12px; border-radius: 4px; font-size: 12px; font-weight: 500; cursor: pointer; transition: all 0.2s;">
                                    Reset
                                </button>
                                <button @onclick="DownloadJson"
                                        disabled="@(!_editorReady)"
                                        style="background: #3c3c3c; color: #ccc; border: 1px solid #555; padding: 6px 8px; border-radius: 4px; font-size: 12px; font-weight: 500; cursor: pointer; transition: all 0.2s;">
                                    💾
                                </button>

                                @if (!_editorReady)
                                {
                                    <span style="color: #888; font-size: 11px;">⏳</span>
                                }
                                else if (_isUpdating)
                                {
                                    <span style="color: #4ec9b0; font-size: 11px;">●</span>
                                }
                                else if (_lastUpdateSuccess && _error == null)
                                {
                                    <span style="color: #4ec9b0; font-size: 11px;">✓</span>
                                }
                                else if (_error != null)
                                {
                                    <span style="color: #f48771; font-size: 11px;">✗</span>
                                }
                            </div>
                            <div style="height: 300px; border: 1px solid #3a3a4e; border-radius: 4px; overflow: hidden;">
                                <StandaloneCodeEditor @ref="_editor"
                                                      Id="roadscript-json-editor"
                                                      ConstructionOptions="EditorConstructionOptions"
                                                      OnDidInit="EditorOnDidInit"
                                                      CssClass="h-100" />
                            </div>
                        </div>
                    }
                    else
                    {
                        @* Hidden editor - always rendered for initialization *@
                        <div style="position: absolute; visibility: hidden; width: 0; height: 0; overflow: hidden;">
                            <StandaloneCodeEditor @ref="_editor"
                                                  Id="roadscript-json-editor"
                                                  ConstructionOptions="EditorConstructionOptions"
                                                  OnDidInit="EditorOnDidInit"
                                                  CssClass="h-100" />
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            @* Collapsed Control Panel Button *@
            <button @onclick="ToggleControlPanel"
                    title="Expand Control Panel"
                    style="background: #3c3c3c; color: #ccc; border: 1px solid #555; padding: 8px; border-radius: 4px; cursor: pointer; transition: all 0.2s; writing-mode: vertical-rl; text-orientation: mixed; font-size: 11px; font-weight: 500; margin: 16px auto;">
                Control ▶
            </button>
            @* Hidden editor - always rendered for initialization *@
            <div style="position: absolute; visibility: hidden; width: 0; height: 0; overflow: hidden;">
                <StandaloneCodeEditor @ref="_editor"
                                      Id="roadscript-json-editor"
                                      ConstructionOptions="EditorConstructionOptions"
                                      OnDidInit="EditorOnDidInit"
                                      CssClass="h-100" />
            </div>
        }
    </div>

    @* Preview Pane *@
    <div class="preview-pane" style="@PreviewPaneStyle()">
        @if (_data != null)
        {
            <div style="@RoadmapWrapperStyle()">
                <div class="roadmap roadmap-container" style="@RoadmapContainerStyle()">
                @* Header *@
                <div @onclick="@(_isPreviewMode ? null : () => HandleTitleClick())"
                     class="@GetElementClass("title")"
                     style="@TitleContainerStyle()">
                    <h1 style="@TitleStyle()">
                        @_data.Title
                    </h1>
                    <p style="@SubtitleStyle()">
                        @_data.Subtitle
                    </p>
                </div>

                @* Grid *@
                <div style="display: flex; height: calc(100% - 66px);">
                    @* Lane Labels *@
                    <div style="width: 175px; flex-shrink: 0; padding-top: 48px; padding-right: 14px;">
                        @for (int li = 0; li < _data.Lanes.Count; li++)
                        {
                            var lane = _data.Lanes[li];
                            var laneIndex = li;
                            <div @onclick="@(_isPreviewMode ? null : () => HandleElementClick($"lanes[{laneIndex}]", "lane", lane))"
                                 class="@GetElementClass($"lanes[{laneIndex}]")"
                                 style="@LaneLabelWrapStyle(lane)">
                                <div style="display: flex; align-items: flex-start; gap: 12px;">
                                    <div style="@LaneBarStyle(lane.Color)"></div>
                                    <div style="display: flex; flex-direction: column; gap: 6px;">
                                        <span style="@LaneTitleStyle()">
                                            @((MarkupString)lane.Title.Replace("&", "&amp;<br/>"))
                                        </span>
                                        @if (lane.History != null)
                                        {
                                            <div style="display: flex; flex-direction: column; gap: 2px;">
                                                <div style="@HistoryBarContainerStyle()">
                                                    <div style="@HistoryPastStyle(lane.Color, lane.History.PastPct)"></div>
                                                    <div style="@HistoryCurrentStyle(lane.Color, lane.History.PastPct)"></div>
                                                </div>
                                                <div style="display: flex; justify-content: space-between; width: 90px;">
                                                    <span style="font-size: 9px; color: #9ca3af; font-weight: 500;">@lane.History.StartYear</span>
                                                    <span style="font-size: 9px; color: #9ca3af; font-weight: 500;">@lane.History.EndYear</span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @* Timeline *@
                    <div style="flex: 1; display: flex; flex-direction: column;">
                        @* Column Headers *@
                        <div style="@ColumnHeaderContainerStyle()">
                            @for (int i = 0; i < _data.Columns.Count; i++)
                            {
                                var col = _data.Columns[i];
                                var colIndex = i;
                                <div @onclick="@(_isPreviewMode ? null : () => HandleElementClick($"columns[{colIndex}]", "column", col))"
                                     class="@GetElementClass($"columns[{colIndex}]")"
                                     style="@ColumnHeaderStyle(i)">
                                    <span style="@ColumnLabelStyle()">@col.Label</span>
                                    <span style="@ColumnSubStyle()">@col.Sub</span>
                                </div>
                            }
                        </div>

                        @* Milestone Scale Row *@
                        <div style="@MilestoneScaleContainerStyle()">
                            @for (int mi = 0; mi < _data.Milestones.Count; mi++)
                            {
                                var milestone = _data.Milestones[mi];
                                var msIndex = mi;
                                <div @onclick="@(_isPreviewMode ? null : () => HandleElementClick($"milestones[{msIndex}]", "milestone", milestone))"
                                     class="@GetElementClass($"milestones[{msIndex}]")"
                                     style="@MilestoneStyle(milestone.Position)">
                                    <div style="@MilestoneContainerStyle()">
                                        <Icon IconType="@(milestone.Icon ?? "diamond")"
                                              Color="@milestone.Color"
                                              Size="24"
                                              DropShadow="true" />
                                        <span style="@MilestoneLabelStyle(milestone.Color)">
                                            @milestone.Label
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>

                        @* Lanes Container *@
                        <div style="flex: 1; position: relative;">
                            @* Grid Columns Background *@
                            <div style="position: absolute; inset: 0; display: flex; pointer-events: none;">
                                @for (int i = 0; i < _data.Columns.Count; i++)
                                {
                                    <div style="@GridColumnStyle(i)"></div>
                                }
                            </div>

                            @* Lane Rows *@
                            @for (int li = 0; li < _data.Lanes.Count; li++)
                            {
                                var lane = _data.Lanes[li];
                                var laneIdx = li;
                                <div style="@LaneRowStyle(li, lane)">
                                    @for (int ii = 0; ii < lane.Items.Count; ii++)
                                    {
                                        var item = lane.Items[ii];
                                        var itemIdx = ii;
                                        <div @onclick="@(_isPreviewMode ? null : async () => await HandleItemClick(laneIdx, itemIdx, item))"
                                             @onclick:stopPropagation="@(!_isPreviewMode)"
                                             class="@GetElementClass($"lanes[{laneIdx}].items[{itemIdx}]")"
                                             style="@ItemStyle(item, lane.Color)">
                                            <div style="display: flex; align-items: center; justify-content: space-between;">
                                                <h4 style="@ItemTitleStyle()">
                                                    @item.Title
                                                </h4>
                                                @if (!string.IsNullOrEmpty(item.StatusIcon))
                                                {
                                                    <div style="@StatusIconBadgeStyle()">
                                                        <Icon IconType="@item.StatusIcon"
                                                              Color="@(item.StatusColor ?? "#10b981")"
                                                              Size="20"
                                                              DropShadow="true" />
                                                    </div>
                                                }
                                                else if (item.Completed)
                                                {
                                                    @* Backward compatibility: show checkmark for old items *@
                                                    <div style="@CompletedBadgeStyle()">
                                                        ✓
                                                    </div>
                                                }
                                            </div>
                                            <ul style="margin: 0; padding: 0; list-style: none;">
                                                @if (item.Details != null)
                                                {
                                                    @foreach (var detail in item.Details)
                                                    {
                                                        <li style="@DetailItemStyle(detail)">
                                                            <div style="@DetailTextStyle(lane.Color)">
                                                                <span style="@BulletStyle(lane.Color)">•</span>
                                                                @detail.Text
                                                            </div>
                                                            @if (detail.Subs != null && detail.Subs.Count > 0)
                                                            {
                                                                <ul style="margin: 2px 0 4px 0; padding: 0; list-style: none;">
                                                                    @foreach (var sub in detail.Subs)
                                                                    {
                                                                        <li style="@SubBulletStyle()">
                                                                            <span style="@SubBulletDashStyle()">–</span>
                                                                            @sub
                                                                        </li>
                                                                    }
                                                                </ul>
                                                            }
                                                        </li>
                                                    }
                                                }
                                            </ul>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @* Footer Bar - Only visible in Edit Mode *@
            @if (!_isPreviewMode && _activeTab != null)
            {
                <div style="@FooterBarStyle()">
                    <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span style="font-size: 12px; color: @(_isVibeMode ? "#9ca3af" : "#6b7280"); font-weight: 500;">Active Tab:</span>
                            <span style="font-size: 12px; color: @(_isVibeMode ? "#e0e7ff" : "#1f2937"); font-weight: 600;">@_activeTab.Name</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span style="font-size: 12px; color: @(_isVibeMode ? "#9ca3af" : "#6b7280"); font-weight: 500;">Last Modified:</span>
                            <span style="font-size: 12px; color: @(_isVibeMode ? "#e0e7ff" : "#1f2937"); font-weight: 600;">@_activeTab.LastModified.ToLocalTime().ToString("MMM d, h:mm tt")</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span style="font-size: 12px; color: @(_isVibeMode ? "#9ca3af" : "#6b7280"); font-weight: 500;">Columns:</span>
                            <span style="font-size: 12px; color: @(_isVibeMode ? "#667eea" : "#667eea"); font-weight: 600;">@_data.Columns.Count</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span style="font-size: 12px; color: @(_isVibeMode ? "#9ca3af" : "#6b7280"); font-weight: 500;">Lanes:</span>
                            <span style="font-size: 12px; color: @(_isVibeMode ? "#667eea" : "#667eea"); font-weight: 600;">@_data.Lanes.Count</span>
                        </div>
                    </div>
                </div>
            }
            </div>
        }
        else if (_error != null)
        {
            <div style="background: #fee2e2; border: 1px solid #fca5a5; color: #b91c1c; padding: 16px; border-radius: 8px; max-width: 600px;">
                <strong>JSON Error:</strong> @_error
            </div>
        }
    </div>

    @* Property Panel - Mode controls removed, now in Control Center *@
    <PropertyPanel OnPropertyChange="HandlePropertyChange"
                  OnAddElement="HandleAddElement"
                  OnRemoveElement="HandleRemoveElement"
                  OnDuplicateElement="HandleDuplicateElement"
                  OnHidePanel="ToggleProperties"
                  IsCollapsed="@(!_showProperties)" />
</div>

@code {
    private StandaloneCodeEditor? _editor;
    private RoadmapData? _data;
    private string? _error;
    private bool _isUpdating = false;
    private bool _lastUpdateSuccess = false;
    private string _currentJson = "";
    private bool _isVibeMode = false;
    private bool _editorReady = false;
    private bool _isPreviewMode = false;       // Toggle between Edit Mode and Preview Mode
    private bool _showControlPanel = true;     // Show/hide Control Center panel - visible by default
    private bool _showAdvancedSection = false; // Show/hide Advanced JSON editor section - collapsed by default
    private bool _showProperties = true;       // Show/hide properties panel - open by default
    private DotNetObjectReference<Home>? _dotNetRef;

    // Multi-tab session management
    private SessionManager? _sessionManager;
    private TabSession? _activeTab;

    // Default JSON template - Generic boilerplate for easy customization
    private const string DefaultJson = @"{
  ""title"": ""Product Roadmap"",
  ""subtitle"": ""A visual timeline showcasing features and capabilities"",
  ""columns"": [
    { ""label"": ""Week 1"", ""sub"": ""Mon – Fri"" },
    { ""label"": ""February"", ""sub"": ""2026"" },
    { ""label"": ""Q2 2026"", ""sub"": ""Apr – Jun"" },
    { ""label"": ""Phase 4"", ""sub"": ""Launch"" }
  ],
  ""milestones"": [
    { ""position"": 25, ""label"": ""Beta Release"", ""icon"": ""star"", ""color"": ""#667eea"" },
    { ""position"": 75, ""label"": ""Public Launch"", ""icon"": ""flag"", ""color"": ""#27AE60"" }
  ],
  ""lanes"": [
    {
      ""title"": ""Product Development"",
      ""color"": ""#45B69C"",
      ""items"": [
        {
          ""title"": ""Discovery"",
          ""start"": 0,
          ""span"": 0.75,
          ""completed"": true,
          ""details"": [
            { ""text"": ""User research"", ""subs"": [""Interviews"", ""Surveys"", ""Analytics review""] },
            { ""text"": ""Problem validation"" }
          ]
        },
        {
          ""title"": ""Design Sprint"",
          ""start"": 1,
          ""span"": 1,
          ""completed"": true,
          ""details"": [
            { ""text"": ""Wireframes and prototypes"" },
            { ""text"": ""Usability testing"" }
          ]
        },
        {
          ""title"": ""MVP Build"",
          ""start"": 2.25,
          ""span"": 1.75,
          ""details"": [
            { ""text"": ""Core features"", ""subs"": [""Authentication"", ""Dashboard"", ""Data models""] },
            { ""text"": ""API development"" },
            { ""text"": ""Testing and QA"" }
          ]
        }
      ]
    },
    {
      ""title"": ""Platform & Infrastructure"",
      ""color"": ""#4A90D9"",
      ""history"": {
        ""startYear"": 2023,
        ""endYear"": 2027,
        ""pastPct"": 60
      },
      ""items"": [
        {
          ""title"": ""Platform Modernization"",
          ""start"": 0,
          ""span"": 4,
          ""spanning"": true,
          ""details"": [
            { ""text"": ""Infrastructure as code"" },
            { ""text"": ""Performance optimization"", ""subs"": [""Caching strategy"", ""Database tuning""] },
            { ""text"": ""Monitoring and observability"" }
          ]
        },
        {
          ""title"": ""Security Audit"",
          ""start"": 2.5,
          ""span"": 0.75,
          ""details"": [
            { ""text"": ""Penetration testing"" },
            { ""text"": ""Compliance review"" }
          ]
        }
      ]
    },
    {
      ""title"": ""Marketing & Launch"",
      ""color"": ""#9B7ED9"",
      ""items"": [
        {
          ""title"": ""Brand Strategy"",
          ""start"": 0.5,
          ""span"": 1.5,
          ""completed"": true,
          ""details"": [
            { ""text"": ""Market positioning"", ""subs"": [""Competitive analysis"", ""Value proposition""] },
            { ""text"": ""Visual identity"" }
          ]
        },
        {
          ""title"": ""Content Creation"",
          ""start"": 1.5,
          ""span"": 1,
          ""details"": [
            { ""text"": ""Blog posts and tutorials"" },
            { ""text"": ""Video demos"" }
          ]
        },
        {
          ""title"": ""Campaign Launch"",
          ""start"": 3,
          ""span"": 1,
          ""spanning"": true,
          ""details"": [
            { ""text"": ""Social media"", ""subs"": [""Twitter"", ""LinkedIn"", ""YouTube""] },
            { ""text"": ""Email campaigns"" },
            { ""text"": ""PR and partnerships"" }
          ]
        }
      ]
    }
  ]
}";

    private StandaloneEditorConstructionOptions EditorConstructionOptions(StandaloneCodeEditor editor)
    {
        return new StandaloneEditorConstructionOptions
        {
            Language = "json",
            Value = DefaultJson,
            Theme = "vs-dark",
            Minimap = new EditorMinimapOptions { Enabled = false },
            AutomaticLayout = true,
            FontSize = 13,
            LineNumbers = "on",
            ScrollBeyondLastLine = false,
            WordWrap = "on",
            TabSize = 2,
            FormatOnPaste = true,
            FormatOnType = true
        };
    }

    private async Task EditorOnDidInit()
    {
        _editorReady = true;

        // Load or initialize session
        await InitializeSessionAsync();

        // Set editor value
        if (_editor != null && _activeTab != null)
        {
            _currentJson = JsonSerializer.Serialize(_activeTab.Data, new JsonSerializerOptions { WriteIndented = true });
            await _editor.SetValue(_currentJson);
        }

        ParseJson(_currentJson);
        _lastUpdateSuccess = _error == null;
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        // Load or initialize session
        await InitializeSessionAsync();
    }

    private async Task InitializeSessionAsync()
    {
        // Load session from storage
        _sessionManager = await StorageService.LoadSessionAsync();

        if (_sessionManager == null || _sessionManager.Tabs.Count == 0)
        {
            // Create default session with one tab (max 3 tabs)
            _sessionManager = new SessionManager
            {
                ActiveTabId = "tab-1",
                Tabs = new List<TabSession>(),
                MaxTabs = 3
            };

            var defaultData = JsonSerializer.Deserialize<RoadmapData>(DefaultJson, new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true,
                AllowTrailingCommas = true
            });

            StorageService.AddTab(_sessionManager, "Product Roadmap", defaultData);
        }
        else
        {
            // Ensure MaxTabs is set to 3 for existing sessions
            _sessionManager.MaxTabs = 3;
        }

        // Get active tab
        _activeTab = StorageService.GetActiveTab(_sessionManager);
        if (_activeTab != null)
        {
            _data = _activeTab.Data;
            _currentJson = JsonSerializer.Serialize(_data, new JsonSerializerOptions { WriteIndented = true });
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("RoadScriptInterop.setupKeyboardShortcuts", _dotNetRef);
        }
    }

    [JSInvokable]
    public async Task HandleKeyboardShortcut(string action)
    {
        switch (action)
        {
            case "TogglePreview":
                ToggleViewMode();
                break;
            case "ToggleTheme":
                ToggleTheme();
                break;
            case "ClearSelection":
                SelectionState.Clear();
                await InvokeAsync(StateHasChanged);
                break;
        }
    }

    private async Task ExportAsPng()
    {
        try
        {
            var filename = $"roadmap-{DateTime.Now:yyyy-MM-dd}.png";
            await JSRuntime.InvokeVoidAsync("RoadScriptInterop.exportAsPng", ".roadmap-container", filename);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error exporting PNG: {ex.Message}");
        }
    }

    private async Task DownloadJson()
    {
        try
        {
            if (_editor == null || !_editorReady) return;

            var jsonContent = await _editor.GetValue();
            var filename = $"roadmap-{DateTime.Now:yyyy-MM-dd}.json";
            await JSRuntime.InvokeVoidAsync("RoadScriptInterop.downloadJson", jsonContent, filename);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error downloading JSON: {ex.Message}");
        }
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
        JSRuntime.InvokeVoidAsync("RoadScriptInterop.removeKeyboardShortcuts");
    }

    private async Task UpdatePreview()
    {
        if (_editor == null || !_editorReady) return;

        _isUpdating = true;
        StateHasChanged();

        try
        {
            await Task.Delay(50); // Brief delay for visual feedback
            var value = await _editor.GetValue();
            _currentJson = value;
            ParseJson(value);
            _lastUpdateSuccess = _error == null;

            // Save to storage if parsing was successful
            if (_error == null && _sessionManager != null && _activeTab != null)
            {
                _activeTab.Data = _data!;
                _activeTab.LastModified = DateTime.UtcNow;
                await StorageService.SaveSessionAsync(_sessionManager);
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to read editor: {ex.Message}";
            _lastUpdateSuccess = false;
        }
        finally
        {
            _isUpdating = false;
            StateHasChanged();
        }
    }

    private async Task ResetToDefault()
    {
        if (_editor == null || !_editorReady) return;

        try
        {
            await _editor.SetValue(DefaultJson);
            _currentJson = DefaultJson;
            ParseJson(DefaultJson);
            _lastUpdateSuccess = true;

            // Clear storage and create fresh session
            await StorageService.ClearStorageAsync();
            await InitializeSessionAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to reset editor: {ex.Message}";
        }

        StateHasChanged();
    }

    private void ToggleTheme(ChangeEventArgs? e = null)
    {
        _isVibeMode = !_isVibeMode;
