    private async Task HandleTabAdd()
    {
        if (_sessionManager == null) return;

        if (_sessionManager.Tabs.Count >= _sessionManager.MaxTabs)
        {
            Console.WriteLine($"Maximum {_sessionManager.MaxTabs} tabs reached");
            return;
        }

        // Show template selector modal
        _showTemplateSelector = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleTemplateSelect(TemplateService.TemplateType templateType)
    {
        if (_folderManager == null) return;

        // Get the appropriate template
        var templateData = templateType switch
        {
            TemplateService.TemplateType.ScrumSprintCycle => TemplateService.GetScrumSprintCycleTemplate(),
            TemplateService.TemplateType.ProjectTimelines => TemplateService.GetProjectTimelinesTemplate(),
            TemplateService.TemplateType.AnnualRoadmap => TemplateService.GetAnnualRoadmapTemplate(),
            _ => TemplateService.GetScrumSprintCycleTemplate()
        };

        // Check if we're creating a new folder or adding a tab to existing folder
        if (_isCreatingNewFolder && !string.IsNullOrWhiteSpace(_pendingFolderName))
        {
            // Create new folder with selected template
            var newFolder = StorageService.AddFolder(_folderManager, _pendingFolderName, templateData);
            _activeFolder = newFolder;
            _sessionManager = newFolder.SessionManager;
            _activeTab = StorageService.GetActiveTab(_sessionManager);

            if (_activeTab != null)
            {
                _data = _activeTab.Data;
                _currentJson = JsonSerializer.Serialize(_data, new JsonSerializerOptions { WriteIndented = true });

                // Update editor
                if (_editor != null && _editorReady)
                {
                    await _editor.SetValue(_currentJson);
                }
            }

            // Reset folder creation state
            _isCreatingNewFolder = false;
            _pendingFolderName = null;
        }
        else if (_sessionManager != null)
        {
            // Add new tab to existing folder
            var newTab = StorageService.AddTab(_sessionManager, templateData.Title, templateData);
            _sessionManager.ActiveTabId = newTab.Id;
            _activeTab = newTab;
            _data = newTab.Data;
            _currentJson = JsonSerializer.Serialize(_data, new JsonSerializerOptions { WriteIndented = true });

            // Update editor
            if (_editor != null && _editorReady)
            {
                await _editor.SetValue(_currentJson);
            }

            // Update active folder's last modified time
            if (_activeFolder != null)
            {
                _activeFolder.LastModified = DateTime.UtcNow;
            }
        }

        // Save folder manager
        if (_folderManager != null)
        {
            await StorageService.SaveFolderManagerAsync(_folderManager);
        }

        // Close template selector
        _showTemplateSelector = false;
        SelectionState.Clear();
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleTabDelete(string tabId)
    {
        if (_sessionManager == null || _sessionManager.Tabs.Count <= 1 || _folderManager == null) return;

        StorageService.RemoveTab(_sessionManager, tabId);

        // Switch to first available tab
        if (_sessionManager.Tabs.Count > 0)
        {
            _sessionManager.ActiveTabId = _sessionManager.Tabs[0].Id;
            _activeTab = _sessionManager.Tabs[0];
            _data = _activeTab.Data;
            _currentJson = JsonSerializer.Serialize(_data, new JsonSerializerOptions { WriteIndented = true });

            // Update editor
            if (_editor != null && _editorReady)
            {
                await _editor.SetValue(_currentJson);
            }
        }

        // Update active folder's last modified time
        if (_activeFolder != null)
        {
            _activeFolder.LastModified = DateTime.UtcNow;
        }

        // Save folder manager
        if (_folderManager != null)
        {
            await StorageService.SaveFolderManagerAsync(_folderManager);
        }
        SelectionState.Clear();
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleCollapsedTabDelete()
    {
        if (_activeTab == null || _sessionManager == null || _folderManager == null || _activeFolder == null) return;

        // Check if this is the last tab in the folder
        bool isLastTab = _sessionManager.Tabs.Count == 1;

        // Show appropriate confirmation dialog
        string confirmMessage = isLastTab
            ? $"Delete folder '{_activeFolder.Name}' and its last roadmap '{_activeTab.Name}'?"
            : $"Delete roadmap tab '{_activeTab.Name}'?";

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", confirmMessage);
        if (!confirmed) return;

        if (isLastTab)
        {
            // Delete the entire folder (last tab)
            StorageService.RemoveFolder(_folderManager, _activeFolder.Id);

            // Check if any folders remain
            if (_folderManager.Folders.Count == 0)
            {
                // No folders left - show template selector as fail-safe
                _activeFolder = null;
                _sessionManager = null;
                _activeTab = null;
                _data = null;
                _currentJson = null;
                _showTemplateSelector = true;
                _isCreatingNewFolder = true;
                _pendingFolderName = "Folder 1";
            }
            else
            {
                // Switch to another folder
                _activeFolder = StorageService.GetActiveFolder(_folderManager);
                if (_activeFolder != null)
                {
                    _sessionManager = _activeFolder.SessionManager;
                    _activeTab = StorageService.GetActiveTab(_sessionManager);

                    if (_activeTab != null)
                    {
                        _data = _activeTab.Data;
                        _currentJson = JsonSerializer.Serialize(_data, new JsonSerializerOptions { WriteIndented = true });

                        // Update editor
                        if (_editor != null && _editorReady)
                        {
                            await _editor.SetValue(_currentJson);
                        }
                    }
                }
            }

            // Save folder manager
            await StorageService.SaveFolderManagerAsync(_folderManager);
        }
        else
        {
            // Just delete the tab normally
            await HandleTabDelete(_activeTab.Id);
        }

        SelectionState.Clear();
        await InvokeAsync(StateHasChanged);
    }

