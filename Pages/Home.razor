    /// <summary>
    /// Debounced save with semaphore protection to prevent race conditions
    /// </summary>
    private async Task DebouncedSave()
    {
        // Cancel any pending save
        _saveCancellation?.Cancel();
        _saveCancellation = new CancellationTokenSource();

        try
        {
            // Wait 500ms before saving (debounce)
            await Task.Delay(500, _saveCancellation.Token);

            // Acquire lock to prevent concurrent saves
            await _saveLock.WaitAsync(_saveCancellation.Token);
            try
            {
                if (_folderManager != null)
                {
                    await StorageService.SaveFolderManagerAsync(_folderManager);
                    _lastSaveTime = DateTime.UtcNow;
                    _hasUnsavedJsonChanges = false;
                }
            }
            finally
            {
                _saveLock.Release();
            }
        }
        catch (TaskCanceledException)
        {
            // Debounce was cancelled, this is expected
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error during debounced save: {ex.Message}");
        }
    }

    /// <summary>
    /// Immediate save with semaphore protection (for critical operations)
    /// </summary>
    private async Task SaveState()
    {
        await _saveLock.WaitAsync();
        try
        {
            if (_folderManager != null)
            {
                await StorageService.SaveFolderManagerAsync(_folderManager);
                _lastSaveTime = DateTime.UtcNow;
                _hasUnsavedJsonChanges = false;
            }
        }
        finally
        {
            _saveLock.Release();
        }
    }

