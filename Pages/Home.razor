    private async Task HandlePropertyChange((string JsonPath, string PropertyName, object Value) change)
    {
        try
        {
            // For title, the JsonPath is "title" and the PropertyName is "title" or "subtitle"
            // So we need to use just the PropertyName, not JsonPath.PropertyName
            var propertyPath = change.JsonPath == "title"
                ? change.PropertyName
                : $"{change.JsonPath}.{change.PropertyName}";

            var updatedJson = await EditorInterop.UpdateJsonValue(
                _currentJson,
                propertyPath,
                change.Value
            );

            if (updatedJson != null)
            {
                // Store current selection to refresh it after parsing
                var selectedPath = SelectionState.SelectedPath;
                var selectedType = SelectionState.ElementType;

                // Update current JSON and parse it
                _currentJson = updatedJson;
                ParseJson(updatedJson);

                // Refresh selection with new object instance from parsed data
                if (selectedPath != null && selectedType != null && _data != null)
                {
                    var refreshedElement = GetElementByPath(selectedPath, selectedType);
                    if (refreshedElement != null)
                    {
                        SelectionState.Select(selectedPath, selectedType, refreshedElement);
                    }
                }

                // Update editor if it's available
                if (_editor != null)
                {
                    await _editor.SetValue(updatedJson);
                }

                // Save to storage after property change
                if (_error == null && _sessionManager != null && _activeTab != null)
                {
                    _activeTab.Data = _data!;
                    _activeTab.LastModified = DateTime.UtcNow;
                    if (_folderManager != null)
                {
                    await StorageService.SaveFolderManagerAsync(_folderManager);
                }
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating property: {ex.Message}");
        }
    }

    private async Task HandleAddElement((string ElementType, string JsonPath) args)
    {
        try
        {
            if (_data == null) return;

            var (elementType, jsonPath) = args;

            switch (elementType)
            {
                case "lane":
                    // Add a new lane after the current one
                    var laneIndex = ExtractIndexFromPath(jsonPath, "lanes");
                    var newLane = new Lane
                    {
                        Title = "New Lane",
                        Color = "#667eea",
                        Items = new List<Item>
                        {
                            new Item
                            {
                                Title = "New Item",
                                Start = 0,
                                Span = 1,
                                Details = new List<Detail>()
                            }
                        }
                    };
                    _data.Lanes.Insert(laneIndex + 1, newLane);
                    break;

                case "item":
                    // Add a new item to the current lane
                    int itemLaneIndex;
                    int itemIndex;

                    if (jsonPath.Contains(".items["))
                    {
                        // Adding from another item
                        var itemPath = jsonPath.Split(".items[")[0];
                        itemLaneIndex = ExtractIndexFromPath(itemPath, "lanes");
                        itemIndex = ExtractIndexFromPath(jsonPath, "items");
                    }
                    else
                    {
                        // Adding from lane (no items in path)
                        itemLaneIndex = ExtractIndexFromPath(jsonPath, "lanes");
                        itemIndex = -1; // Add at the end
                    }

                    var newItem = new Item
                    {
                        Title = "New Item",
                        Start = 0,
                        Span = 1,
                        Details = new List<Detail>()
                    };

                    if (itemIndex >= 0)
                    {
                        _data.Lanes[itemLaneIndex].Items.Insert(itemIndex + 1, newItem);
                    }
                    else
                    {
                        _data.Lanes[itemLaneIndex].Items.Add(newItem);
                    }
                    break;

                case "column":
                    // Add a new column after the current one
                    var columnIndex = ExtractIndexFromPath(jsonPath, "columns");
                    var newColumn = new Column
                    {
                        Label = "New Column",
                        Sub = ""
                    };
                    _data.Columns.Insert(columnIndex + 1, newColumn);
                    break;

                case "milestone":
                    // Add a new milestone after the current one
                    var milestoneIndex = ExtractIndexFromPath(jsonPath, "milestones");
                    var newMilestone = new Milestone
                    {
                        Label = "New Milestone",
                        Position = 50,
                        Icon = "diamond",
                        Color = "#667eea"
                    };
                    _data.Milestones.Insert(milestoneIndex + 1, newMilestone);
                    break;

                case "moveLaneUp":
                    // Move lane up in the list
                    var moveUpIndex = ExtractIndexFromPath(jsonPath, "lanes");
                    if (moveUpIndex > 0)
                    {
                        var lane = _data.Lanes[moveUpIndex];
                        _data.Lanes.RemoveAt(moveUpIndex);
                        _data.Lanes.Insert(moveUpIndex - 1, lane);

                        // Update the selection to follow the lane
                        var newPath = $"lanes[{moveUpIndex - 1}]";
                        SelectionState.Select(newPath, "lane", lane);
                    }
                    break;

                case "moveLaneDown":
                    // Move lane down in the list
                    var moveDownIndex = ExtractIndexFromPath(jsonPath, "lanes");
                    if (moveDownIndex < _data.Lanes.Count - 1)
                    {
                        var lane = _data.Lanes[moveDownIndex];
                        _data.Lanes.RemoveAt(moveDownIndex);
                        _data.Lanes.Insert(moveDownIndex + 1, lane);

                        // Update the selection to follow the lane
                        var newPath = $"lanes[{moveDownIndex + 1}]";
                        SelectionState.Select(newPath, "lane", lane);
                    }
                    break;
            }

            // Serialize and update - parse JSON first, then update editor
            var updatedJson = JsonSerializer.Serialize(_data, new JsonSerializerOptions { WriteIndented = true });

            // Update current JSON and parse it FIRST
            _currentJson = updatedJson;
            ParseJson(updatedJson);

            // Then update editor if available
            if (_editor != null)
            {
                await _editor.SetValue(updatedJson);
            }

            // Save to storage
            if (_error == null && _sessionManager != null && _activeTab != null)
            {
                _activeTab.Data = _data;
                _activeTab.LastModified = DateTime.UtcNow;
                if (_folderManager != null)
                {
                    await StorageService.SaveFolderManagerAsync(_folderManager);
                }
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error adding element: {ex.Message}");
        }
    }

    private async Task HandleRemoveElement((string ElementType, string JsonPath) args)
    {
        try
        {
            if (_data == null) return;

            var (elementType, jsonPath) = args;

            switch (elementType)
            {
                case "lane":
                    var laneIndex = ExtractIndexFromPath(jsonPath, "lanes");
                    if (_data.Lanes.Count > 1 && laneIndex < _data.Lanes.Count)
                    {
                        _data.Lanes.RemoveAt(laneIndex);
                    }
                    break;

                case "item":
                    var itemPath = jsonPath.Split(".items[")[0];
                    var itemLaneIndex = ExtractIndexFromPath(itemPath, "lanes");
                    var itemIndex = ExtractIndexFromPath(jsonPath, "items");
                    if (_data.Lanes[itemLaneIndex].Items.Count > 0 && itemIndex < _data.Lanes[itemLaneIndex].Items.Count)
                    {
                        _data.Lanes[itemLaneIndex].Items.RemoveAt(itemIndex);
                    }
                    break;

                case "column":
                    var columnIndex = ExtractIndexFromPath(jsonPath, "columns");
                    if (_data.Columns.Count > 1 && columnIndex < _data.Columns.Count)
                    {
                        _data.Columns.RemoveAt(columnIndex);
                    }
                    break;

                case "milestone":
                    var milestoneIndex = ExtractIndexFromPath(jsonPath, "milestones");
                    if (_data.Milestones.Count > 0 && milestoneIndex < _data.Milestones.Count)
                    {
                        _data.Milestones.RemoveAt(milestoneIndex);
                    }
                    break;
            }

            // Serialize and update - parse JSON first, then update editor
            var updatedJson = JsonSerializer.Serialize(_data, new JsonSerializerOptions { WriteIndented = true });

            // Update current JSON and parse it FIRST
            _currentJson = updatedJson;
            ParseJson(updatedJson);

            // Clear selection
            SelectionState.Clear();

            // Then update editor if available
            if (_editor != null)
            {
                await _editor.SetValue(updatedJson);
            }

            // Save to storage
            if (_error == null && _sessionManager != null && _activeTab != null)
            {
                _activeTab.Data = _data;
                _activeTab.LastModified = DateTime.UtcNow;
                if (_folderManager != null)
                {
                    await StorageService.SaveFolderManagerAsync(_folderManager);
                }
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error removing element: {ex.Message}");
        }
    }

    private int ExtractIndexFromPath(string jsonPath, string arrayName)
    {
        // Extract index from path like "lanes[2]" or "lanes[2].items[1]"
        var pattern = $@"{arrayName}\[(\d+)\]";
        var match = System.Text.RegularExpressions.Regex.Match(jsonPath, pattern);
        return match.Success ? int.Parse(match.Groups[1].Value) : 0;
    }

    private object? GetElementByPath(string jsonPath, string elementType)
    {
        // Retrieve the element from _data based on the JSON path and type
        if (_data == null) return null;

        try
        {
            return elementType switch
            {
                "item" => GetItemByPath(jsonPath),
                "lane" => GetLaneByPath(jsonPath),
                "column" => GetColumnByPath(jsonPath),
                "milestone" => GetMilestoneByPath(jsonPath),
                "title" => _data,
                _ => null
            };
        }
        catch
        {
            return null;
        }
    }

    private Item? GetItemByPath(string jsonPath)
    {
        var laneIndex = ExtractIndexFromPath(jsonPath, "lanes");
        var itemIndex = ExtractIndexFromPath(jsonPath, "items");
        if (laneIndex < _data!.Lanes.Count && itemIndex < _data.Lanes[laneIndex].Items.Count)
        {
            return _data.Lanes[laneIndex].Items[itemIndex];
        }
        return null;
    }

    private Lane? GetLaneByPath(string jsonPath)
    {
        var laneIndex = ExtractIndexFromPath(jsonPath, "lanes");
        if (laneIndex < _data!.Lanes.Count)
        {
            return _data.Lanes[laneIndex];
        }
        return null;
    }

    private Column? GetColumnByPath(string jsonPath)
    {
        var columnIndex = ExtractIndexFromPath(jsonPath, "columns");
        if (columnIndex < _data!.Columns.Count)
        {
            return _data.Columns[columnIndex];
        }
        return null;
    }

    private Milestone? GetMilestoneByPath(string jsonPath)
    {
        var milestoneIndex = ExtractIndexFromPath(jsonPath, "milestones");
        if (milestoneIndex < _data!.Milestones.Count)
        {
            return _data.Milestones[milestoneIndex];
        }
        return null;
    }

    private async Task HandleDuplicateElement((string ElementType, string JsonPath) args)
    {
        try
        {
            if (_data == null) return;

            var (elementType, jsonPath) = args;

            switch (elementType)
            {
                case "column":
                    var columnIndex = ExtractIndexFromPath(jsonPath, "columns");
                    if (columnIndex < _data.Columns.Count)
                    {
                        var originalColumn = _data.Columns[columnIndex];
                        var duplicatedColumn = StorageService.DeepClone(originalColumn);
                        duplicatedColumn.Label = $"{originalColumn.Label} (Copy)";
                        _data.Columns.Insert(columnIndex + 1, duplicatedColumn);
                    }
                    break;

                case "lane":
                    var laneIndex = ExtractIndexFromPath(jsonPath, "lanes");
                    if (laneIndex < _data.Lanes.Count)
                    {
                        var originalLane = _data.Lanes[laneIndex];
                        var duplicatedLane = StorageService.DeepClone(originalLane);
                        duplicatedLane.Title = $"{originalLane.Title} (Copy)";
                        _data.Lanes.Insert(laneIndex + 1, duplicatedLane);
                    }
                    break;

                case "item":
                    int itemLaneIndex;
                    int itemIndex;

                    if (jsonPath.Contains(".items["))
                    {
                        var itemPath = jsonPath.Split(".items[")[0];
                        itemLaneIndex = ExtractIndexFromPath(itemPath, "lanes");
                        itemIndex = ExtractIndexFromPath(jsonPath, "items");
                    }
                    else
                    {
                        itemLaneIndex = ExtractIndexFromPath(jsonPath, "lanes");
                        itemIndex = -1;
                    }

                    if (itemLaneIndex < _data.Lanes.Count && itemIndex >= 0 && itemIndex < _data.Lanes[itemLaneIndex].Items.Count)
                    {
                        var originalItem = _data.Lanes[itemLaneIndex].Items[itemIndex];
                        var duplicatedItem = StorageService.DeepClone(originalItem);
                        duplicatedItem.Title = $"{originalItem.Title} (Copy)";
                        _data.Lanes[itemLaneIndex].Items.Insert(itemIndex + 1, duplicatedItem);
                    }
                    break;

                case "milestone":
                    var milestoneIndex = ExtractIndexFromPath(jsonPath, "milestones");
                    if (milestoneIndex < _data.Milestones.Count)
                    {
                        var originalMilestone = _data.Milestones[milestoneIndex];
                        var duplicatedMilestone = StorageService.DeepClone(originalMilestone);
                        duplicatedMilestone.Label = $"{originalMilestone.Label} (Copy)";
                        // Offset position by 5% so it doesn't overlap
                        duplicatedMilestone.Position = Math.Min(originalMilestone.Position + 5, 100);
                        _data.Milestones.Insert(milestoneIndex + 1, duplicatedMilestone);
                    }
                    break;
            }

            // Serialize and update - parse JSON first, then update editor
            var updatedJson = JsonSerializer.Serialize(_data, new JsonSerializerOptions { WriteIndented = true });

            // Update current JSON and parse it FIRST
            _currentJson = updatedJson;
            ParseJson(updatedJson);

            // Then update editor if available
            if (_editor != null)
            {
                await _editor.SetValue(updatedJson);
            }

            // Save to storage
            if (_error == null && _sessionManager != null && _activeTab != null)
            {
                _activeTab.Data = _data;
                _activeTab.LastModified = DateTime.UtcNow;
                if (_folderManager != null)
                {
                    await StorageService.SaveFolderManagerAsync(_folderManager);
                }
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error duplicating element: {ex.Message}");
        }
    }

