    private int _movingMilestoneIndex = -1;
    private double _milestoneMoveStartX = 0;
    private double _milestoneMoveOriginalStart = 0;

    // Property to get all roadmaps across all folders, organized by folder
    private List<RoadmapReference> AllRoadmapsAcrossFolders
    {
        get
        {
            var roadmaps = new List<RoadmapReference>();

            if (_folderManager?.Folders == null) return roadmaps;

            foreach (var folder in _folderManager.Folders)
            {
                if (folder.SessionManager?.Tabs == null) continue;

                foreach (var tab in folder.SessionManager.Tabs)
                {
                    roadmaps.Add(new RoadmapReference
                    {
                        FolderId = folder.Id,
                        FolderName = folder.Name,
                        TabId = tab.Id,
                        TabName = tab.Name,
                        IsCurrentFolder = folder.Id == _activeFolder?.Id,
                        IsCurrentTab = tab.Id == _activeTab?.Id
                    });
                }
            }

            // Sort: current folder first, then alphabetically by folder name, then by tab name
            return roadmaps
                .OrderByDescending(r => r.IsCurrentFolder)
                .ThenBy(r => r.FolderName)
                .ThenBy(r => r.TabName)
                .ToList();
        }
    }

