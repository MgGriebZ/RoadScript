@* Icon Component - Renders SVG icons for milestones and item status *@

<div style="@ContainerStyle()">
    @((MarkupString)GetIconSvg())
</div>

@code {
    [Parameter]
    public string IconType { get; set; } = "diamond";

    [Parameter]
    public string Color { get; set; } = "#667eea";

    [Parameter]
    public int Size { get; set; } = 24;

    [Parameter]
    public bool DropShadow { get; set; } = true;

    private string ContainerStyle()
    {
        return $"display: inline-flex; align-items: center; justify-content: center; width: {Size}px; height: {Size}px;";
    }

    private string GetIconSvg()
    {
        var shadowFilter = DropShadow ? "filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));" : "";
        var viewBoxSize = 24; // Standard viewBox

        return IconType?.ToLower() switch
        {
            // === STATUS/STATE ICONS (8) ===
            "check" => $"<svg width='{Size}' height='{Size}' viewBox='0 0 {viewBoxSize} {viewBoxSize}' fill='none' stroke='{Color}' stroke-width='3' style='{shadowFilter}'><path d='M20 6L9 17l-5-5'/></svg>",

            "pause" => $"<svg width='{Size}' height='{Size}' viewBox='0 0 {viewBoxSize} {viewBoxSize}' fill='{Color}' style='{shadowFilter}'><path d='M6 4h4v16H6V4zm8 0h4v16h-4V4z'/></svg>",

            "x-mark" => $"<svg width='{Size}' height='{Size}' viewBox='0 0 {viewBoxSize} {viewBoxSize}' fill='{Color}' style='{shadowFilter}'><path d='M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z'/></svg>",

