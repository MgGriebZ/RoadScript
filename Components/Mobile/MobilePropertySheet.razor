@inject ResponsiveService ResponsiveService
@inject SelectionState SelectionState
@implements IDisposable

<MobileBottomDrawer IsOpen="@IsPropertySheetOpen"
                    IsOpenChanged="@HandlePropertySheetOpenChanged"
                    Title="@GetPropertySheetTitle()"
                    ShowFooter="false">
    @if (SelectionState.SelectedElement != null)
    {
        <div style="padding-bottom: 20px;">
            <!-- Quick Actions Row -->
            <div style="display: flex; gap: 8px; margin-bottom: 16px; padding: 0 4px;">
                <button @onclick="DuplicateElement"
                        class="touch-ripple"
                        style="flex: 1; padding: 12px; background: #2a2a3e; color: #e0e7ff; border: none; border-radius: 8px; font-size: 14px; font-weight: 500; display: flex; align-items: center; justify-content: center; gap: 6px; cursor: pointer;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                    </svg>
                    Duplicate
                </button>

                <button @onclick="DeleteElement"
                        class="touch-ripple"
                        style="flex: 1; padding: 12px; background: #ef4444; color: white; border: none; border-radius: 8px; font-size: 14px; font-weight: 500; display: flex; align-items: center; justify-content: center; gap: 6px; cursor: pointer;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    </svg>
                    Delete
                </button>
            </div>

            <!-- Property Editors (rendered based on selection type) -->
            @if (SelectionState.SelectedElement is Item item && SelectionState.SelectedPath != null)
            {
                <ItemProperties Item="@item"
                               JsonPath="@SelectionState.SelectedPath"
                               ColumnCount="@ColumnCount"
                               ItemIndex="@ItemIndex"
                               ItemCount="@ItemCount"
                               LaneIndex="@LaneIndex"
                               LaneCount="@LaneCount"
                               AvailableRoadmaps="@AvailableRoadmaps"
                               OnChange="HandlePropertyChange"
                               OnAdd="HandleAddElement"
                               OnRemove="HandleRemoveElement"
                               OnDuplicate="HandleDuplicateElement"
                               OnMoveItem="HandleMoveItem"
                               OnMoveLane="HandleMoveLane" />
            }
            else if (SelectionState.SelectedElement is Lane lane && SelectionState.SelectedPath != null)
            {
                <LaneProperties Lane="@lane"
                               JsonPath="@SelectionState.SelectedPath"
                               AvailableRoadmaps="@AvailableRoadmaps"
                               OnChange="HandlePropertyChange"
                               OnAdd="HandleAddElement"
                               OnRemove="HandleRemoveElement"
                               OnDuplicate="HandleDuplicateElement" />
            }
            else if (SelectionState.SelectedElement is Column column && SelectionState.SelectedPath != null)
            {
                <ColumnProperties Column="@column"
                                 JsonPath="@SelectionState.SelectedPath"
                                 OnChange="HandlePropertyChange"
                                 OnAdd="HandleAddElement"
                                 OnRemove="HandleRemoveElement"
                                 OnDuplicate="HandleDuplicateElement" />
            }
        </div>
    }
    else
    {
        <div style="text-align: center; padding: 40px 20px; color: #9ca3af;">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin: 0 auto 16px;">
                <path d="M9 11l3 3L22 4"></path>
                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
            </svg>
            <p style="font-size: 15px; margin: 0;">Tap an element to edit its properties</p>
        </div>
    }
</MobileBottomDrawer>

@code {
    /// <summary>
    /// Whether the property sheet is open
    /// </summary>
    [Parameter]
    public bool IsPropertySheetOpen { get; set; }

    /// <summary>
    /// Callback when property sheet open state changes
    /// </summary>
    [Parameter]
    public EventCallback<bool> IsPropertySheetOpenChanged { get; set; }

    /// <summary>
    /// The roadmap data being edited
    /// </summary>
    [Parameter]
    public RoadmapData? Data { get; set; }

    /// <summary>
    /// Callback when an element should be duplicated
    /// </summary>
    [Parameter]
    public EventCallback OnDuplicateElement { get; set; }

    /// <summary>
    /// Callback when an element should be deleted
    /// </summary>
    [Parameter]
    public EventCallback OnDeleteElement { get; set; }

    [Parameter]
    public EventCallback<(string JsonPath, string PropertyName, object Value)> OnPropertyChange { get; set; }

    [Parameter]
    public EventCallback<(string ElementType, string JsonPath)> OnAddElement { get; set; }

    [Parameter]
    public EventCallback<(string ElementType, string JsonPath)> OnRemoveElement { get; set; }

    [Parameter]
    public EventCallback<(string Direction, string JsonPath)> OnMoveItem { get; set; }

    [Parameter]
    public EventCallback<(string Direction, string JsonPath)> OnMoveLane { get; set; }

    [Parameter]
    public List<RoadmapReference> AvailableRoadmaps { get; set; } = new();

    [Parameter]
    public int ColumnCount { get; set; } = 4;

    [Parameter]
    public int LaneCount { get; set; } = 1;

    [Parameter]
    public int ItemIndex { get; set; }

    [Parameter]
    public int ItemCount { get; set; } = 1;

    [Parameter]
    public int LaneIndex { get; set; }

    protected override void OnInitialized()
    {
        // Subscribe to selection changes to auto-open property sheet on mobile
        SelectionState.OnSelectionChanged += HandleSelectionChanged;
    }

    private void HandleSelectionChanged()
    {
        if (ResponsiveService.IsMobileOrTablet() && SelectionState.SelectedElement != null)
        {
            // Auto-open property sheet when element is selected on mobile
            IsPropertySheetOpen = true;
            IsPropertySheetOpenChanged.InvokeAsync(true);
            StateHasChanged();
        }
    }

    private async Task HandlePropertySheetOpenChanged(bool isOpen)
    {
        IsPropertySheetOpen = isOpen;
        await IsPropertySheetOpenChanged.InvokeAsync(isOpen);

        // Clear selection when closing property sheet
        if (!isOpen)
        {
            SelectionState.Clear();
        }
    }

    private string GetPropertySheetTitle()
    {
        if (SelectionState.SelectedElement == null)
            return "Properties";

        return SelectionState.SelectedElement switch
        {
            Item item => $"Edit: {item.Title ?? "Item"}",
            Lane lane => $"Edit: {lane.Title ?? "Lane"}",
            Column column => $"Edit: {column.Label ?? "Column"}",
            _ => "Properties"
        };
    }

    // Adapter methods — bridge from component-level types to parent callback types

    private async Task HandlePropertyChange((string PropertyName, object Value) change)
    {
        if (OnPropertyChange.HasDelegate && SelectionState.SelectedPath != null)
            await OnPropertyChange.InvokeAsync((SelectionState.SelectedPath, change.PropertyName, change.Value));
    }

    private async Task HandleAddElement(string elementType)
    {
        if (OnAddElement.HasDelegate && SelectionState.SelectedPath != null)
            await OnAddElement.InvokeAsync((elementType, SelectionState.SelectedPath));
    }

    private async Task HandleRemoveElement(string elementType)
    {
        if (OnRemoveElement.HasDelegate && SelectionState.SelectedPath != null)
            await OnRemoveElement.InvokeAsync((elementType, SelectionState.SelectedPath));
    }

    private async Task HandleDuplicateElement(string elementType)
    {
        await DuplicateElement();
    }

    private async Task HandleMoveItem((string Direction, string JsonPath) args)
    {
        if (OnMoveItem.HasDelegate)
            await OnMoveItem.InvokeAsync(args);
    }

    private async Task HandleMoveLane((string Direction, string JsonPath) args)
    {
        if (OnMoveLane.HasDelegate)
            await OnMoveLane.InvokeAsync(args);
    }

    private async Task DuplicateElement()
    {
        await OnDuplicateElement.InvokeAsync();
    }

    private async Task DeleteElement()
    {
        await OnDeleteElement.InvokeAsync();
        // Close property sheet after deletion
        IsPropertySheetOpen = false;
        await IsPropertySheetOpenChanged.InvokeAsync(false);
    }

    public void Dispose()
    {
        SelectionState.OnSelectionChanged -= HandleSelectionChanged;
    }
}
