@inject ResponsiveService ResponsiveService

<div class="mobile-bottom-nav">
    <button class="mobile-bottom-nav-item @(!IsPreviewMode ? "active" : "")" @onclick="HandleViewToggle">
        @if (IsPreviewMode)
        {
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
            </svg>
        }
        else
        {
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
            </svg>
        }
        <span>@(IsPreviewMode ? "Edit" : "View")</span>
    </button>

    <button class="mobile-bottom-nav-item" @onclick="HandleAddItem">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="16"></line>
            <line x1="8" y1="12" x2="16" y2="12"></line>
        </svg>
        <span>Add</span>
    </button>

    <button class="mobile-bottom-nav-item" @onclick="HandleHome">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        <span>Home</span>
    </button>

    <button class="mobile-bottom-nav-item" @onclick="HandleTheme">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
        </svg>
        <span>Theme</span>
    </button>

    <button class="mobile-bottom-nav-item" @onclick="HandleMenuOpen">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <span>Menu</span>
    </button>
</div>

@code {
    [Parameter]
    public bool IsPreviewMode { get; set; }

    [Parameter]
    public EventCallback OnViewToggle { get; set; }

    [Parameter]
    public EventCallback OnAddItem { get; set; }

    [Parameter]
    public EventCallback OnHome { get; set; }

    [Parameter]
    public EventCallback OnTheme { get; set; }

    [Parameter]
    public EventCallback OnMenuOpen { get; set; }

    private async Task HandleViewToggle() => await OnViewToggle.InvokeAsync();
    private async Task HandleAddItem() => await OnAddItem.InvokeAsync();
    private async Task HandleHome() => await OnHome.InvokeAsync();
    private async Task HandleTheme() => await OnTheme.InvokeAsync();
    private async Task HandleMenuOpen() => await OnMenuOpen.InvokeAsync();
}
