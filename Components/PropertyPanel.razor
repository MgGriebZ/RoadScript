@inject SelectionState SelectionState
@implements IDisposable

@if (IsCollapsed)
{
    <div style="width: 60px; flex-shrink: 0; background: #1e1e2f; border-left: 1px solid #3a3a4e; display: flex; flex-direction: column; align-items: center; padding: 12px 0;">
        <button @onclick="HandleExpandPanel"
                title="Expand Properties Panel"
                class="cc-icon-btn"
                style="background: linear-gradient(135deg, #764ba2 0%, #667eea 100%); color: #fff; border: none; width: 44px; height: 44px; border-radius: 8px; font-size: 22px; cursor: pointer; transition: all 0.2s; box-shadow: 0 2px 8px rgba(118, 75, 162, 0.3); display: flex; align-items: center; justify-content: center;">
            ◀
        </button>
    </div>
}
else
{
<div class="property-panel" style="@PanelStyle()">
    @if (SelectionState.IsSelected)
    {
        <div style="background: #2a2a3e; padding: 12px 16px; border-bottom: 1px solid #3a3a4e; display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; flex-direction: column; gap: 2px;">
                <span style="font-weight: 700; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; font-size: 14px;">
                    Properties
                </span>
                <span style="font-size: 11px; color: #666; font-weight: 400;">@GetElementTypeLabel()</span>
            </div>
            <button @onclick="SwitchToJsonEditor"
                    title="Switch to JSON Editor Mode"
                    style="background: linear-gradient(135deg, #00D9FF 0%, #00B8D4 100%); color: #fff; border: none; padding: 10px 18px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.2s; box-shadow: 0 2px 8px rgba(0, 217, 255, 0.3);"
                    type="button">
                JSON Editor
            </button>
        </div>

        <div style="padding: 16px; overflow-y: auto; flex: 1;">
            @if (SelectionState.ElementType == "item" && SelectionState.SelectedElement is Item item && SelectionState.SelectedPath != null)
            {
                <ItemProperties Item="@item"
                               JsonPath="@SelectionState.SelectedPath"
                               ColumnCount="@ColumnCount"
                               ItemIndex="@GetItemIndex()"
                               ItemCount="@GetItemCount()"
                               LaneIndex="@GetLaneIndex()"
                               LaneCount="@LaneCount"
                               AvailableRoadmaps="@AvailableRoadmaps"
                               OnChange="HandlePropertyChange"
                               OnAdd="HandleAddElement"
                               OnRemove="HandleRemoveElement"
                               OnDuplicate="HandleDuplicateElement"
                               OnMoveItem="HandleMoveItem"
                               OnMoveLane="HandleMoveLane" />
            }
            else if (SelectionState.ElementType == "lane" && SelectionState.SelectedElement is Lane lane && SelectionState.SelectedPath != null)
            {
                <LaneProperties Lane="@lane"
                               JsonPath="@SelectionState.SelectedPath"
                               OnChange="HandlePropertyChange"
                               OnAdd="HandleAddElement"
                               OnRemove="HandleRemoveElement"
                               OnDuplicate="HandleDuplicateElement" />
            }
            else if (SelectionState.ElementType == "column" && SelectionState.SelectedElement is Column column && SelectionState.SelectedPath != null)
            {
                <ColumnProperties Column="@column"
                                 JsonPath="@SelectionState.SelectedPath"
                                 OnChange="HandlePropertyChange"
                                 OnAdd="HandleAddElement"
                                 OnRemove="HandleRemoveElement"
                                 OnDuplicate="HandleDuplicateElement" />
            }
            else if (SelectionState.ElementType == "milestone" && SelectionState.SelectedElement is Milestone milestone && SelectionState.SelectedPath != null)
            {
                <MilestoneProperties Milestone="@milestone"
                                    JsonPath="@SelectionState.SelectedPath"
                                    OnChange="HandlePropertyChange"
                                    OnAdd="HandleAddElement"
                                    OnRemove="HandleRemoveElement"
                                    OnDuplicate="HandleDuplicateElement"
                                    ColumnCount="@ColumnCount" />
            }
            else if (SelectionState.ElementType == "title" && SelectionState.SelectedElement is RoadmapData roadmapData && SelectionState.SelectedPath != null)
            {
                <TitleProperties Title="@roadmapData.Title"
                                Subtitle="@roadmapData.Subtitle"
                                JsonPath="@SelectionState.SelectedPath"
                                OnChange="HandlePropertyChange"
                                OnAdd="HandleAddElement" />
            }
        </div>
    }
    else
    {
        <div style="background: #2a2a3e; padding: 12px 16px; border-bottom: 1px solid #3a3a4e; display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; flex-direction: column; gap: 2px;">
                <span style="font-weight: 700; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; font-size: 14px;">
                    Properties
                </span>
                <span style="font-size: 11px; color: #666; font-weight: 400;">Select an element to edit</span>
            </div>
            <button @onclick="SwitchToJsonEditor"
                    title="Switch to JSON Editor Mode"
                    style="background: linear-gradient(135deg, #00D9FF 0%, #00B8D4 100%); color: #fff; border: none; padding: 10px 18px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.2s; box-shadow: 0 2px 8px rgba(0, 217, 255, 0.3);"
                    type="button">
                JSON Editor
            </button>
        </div>
        <div style="display: flex; flex-direction: column; flex: 1; color: #e0e7ff; padding: 20px; overflow-y: auto;">

            @* Roadmap Overview Section *@
            <div style="margin-bottom: 24px;">
                <h3 style="font-size: 13px; font-weight: 600; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.5px; margin: 0 0 12px 0;">📊 Current Structure</h3>
                <div style="display: flex; flex-direction: column; gap: 8px; background: rgba(102, 126, 234, 0.1); border-radius: 8px; padding: 12px; border: 1px solid rgba(102, 126, 234, 0.2);">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="color: #a5b4fc; font-size: 13px;">Columns</span>
                        <span style="color: #fff; font-weight: 600; font-size: 14px;">@ColumnCount</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="color: #a5b4fc; font-size: 13px;">Swim Lanes</span>
                        <span style="color: #fff; font-weight: 600; font-size: 14px;">@LaneCount</span>
                    </div>
                    @if (MilestoneCount > 0)
                    {
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="color: #a5b4fc; font-size: 13px;">Milestones</span>
                            <span style="color: #fff; font-weight: 600; font-size: 14px;">@MilestoneCount</span>
                        </div>
                    }
                </div>
            </div>

            @* Quick Add Section *@
            <div style="margin-bottom: 24px;">
                <h3 style="font-size: 13px; font-weight: 600; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.5px; margin: 0 0 12px 0;">⚡ Quick Add</h3>
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <button @onclick="AddSwimLane"
                            class="cc-icon-btn"
                            style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; border: none; padding: 12px 16px; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.2s; box-shadow: 0 2px 6px rgba(102, 126, 234, 0.3); display: flex; align-items: center; gap: 8px; justify-content: center;">
                        <span style="font-size: 18px;">🏊</span>
                        Add Swim Lane
                    </button>
                    <button @onclick="AddColumn"
                            class="cc-icon-btn"
                            style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: #fff; border: none; padding: 12px 16px; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.2s; box-shadow: 0 2px 6px rgba(16, 185, 129, 0.3); display: flex; align-items: center; gap: 8px; justify-content: center;">
                        <span style="font-size: 18px;">📅</span>
                        Add Column
                    </button>
                    <button @onclick="AddMilestone"
                            class="cc-icon-btn"
                            style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: #fff; border: none; padding: 12px 16px; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.2s; box-shadow: 0 2px 6px rgba(245, 158, 11, 0.3); display: flex; align-items: center; gap: 8px; justify-content: center;">
                        <span style="font-size: 18px;">🎯</span>
                        Add Milestone
                    </button>
                </div>
            </div>

            @* Edit Title Section *@
            <div style="margin-bottom: 24px;">
                <h3 style="font-size: 13px; font-weight: 600; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.5px; margin: 0 0 12px 0;">✏️ Edit Roadmap</h3>
                <button @onclick="SelectTitle"
                        class="cc-icon-btn"
                        style="background: rgba(139, 92, 246, 0.15); color: #c4b5fd; border: 1px solid rgba(139, 92, 246, 0.3); padding: 12px 16px; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; gap: 8px; justify-content: center; width: 100%;">
                    <span style="font-size: 18px;">📝</span>
                    Edit Title & Subtitle
                </button>
            </div>

            <div style="height: 1px; background: linear-gradient(90deg, transparent, #3a3a4e, transparent); margin: 8px 0;"></div>

            @* Helpful Tips Section *@
            <div style="margin-top: 16px;">
                <div style="background: rgba(0, 217, 255, 0.05); border-left: 3px solid #00D9FF; padding: 12px; border-radius: 4px;">
                    <div style="font-size: 12px; color: #a5b4fc; line-height: 1.6;">
                        <div style="font-weight: 600; margin-bottom: 8px; color: #00D9FF;">💡 Quick Tip</div>
                        <div style="margin-bottom: 6px;">Click any roadmap element to edit its detailed properties</div>
                        <div style="margin-bottom: 6px; opacity: 0.8;">Press <code style="background: rgba(102, 126, 234, 0.2); padding: 2px 6px; border-radius: 3px; font-size: 11px;">Esc</code> to clear selection</div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
}

@code {
    [Parameter]
    public EventCallback<(string JsonPath, string PropertyName, object Value)> OnPropertyChange { get; set; }

    [Parameter]
    public EventCallback<(string ElementType, string JsonPath)> OnAddElement { get; set; }

    [Parameter]
    public EventCallback<(string ElementType, string JsonPath)> OnRemoveElement { get; set; }

    [Parameter]
    public EventCallback<(string ElementType, string JsonPath)> OnDuplicateElement { get; set; }

    [Parameter]
    public EventCallback<(string Direction, string JsonPath)> OnMoveItem { get; set; }

    [Parameter]
    public EventCallback<(string Direction, string JsonPath)> OnMoveLane { get; set; }

    [Parameter]
    public EventCallback OnHidePanel { get; set; }

    [Parameter]
    public EventCallback OnToggleJsonEditor { get; set; }

    [Parameter]
    public bool IsCollapsed { get; set; }

    [Parameter]
    public int ColumnCount { get; set; } = 4;

    [Parameter]
    public int LaneCount { get; set; } = 1;

    [Parameter]
    public int MilestoneCount { get; set; } = 0;

    [Parameter]
    public EventCallback OnSelectTitle { get; set; }

    [Parameter]
    public List<TabSession>? AvailableRoadmaps { get; set; }

    [Parameter]
    public int ItemCount { get; set; } = 1;

    [Parameter]
    public int ItemIndex { get; set; } = 0;

    [Parameter]
    public int LaneIndex { get; set; } = 0;

    protected override void OnInitialized()
    {
        SelectionState.OnSelectionChanged += StateHasChanged;
    }

    public void Dispose()
    {
        SelectionState.OnSelectionChanged -= StateHasChanged;
    }

    private string PanelStyle()
    {
        return "width: 27%; min-width: 320px; max-width: 450px; background: #1e1e2f; border-left: 1px solid #3a3a4e; display: flex; flex-direction: column; transition: all 0.3s ease; height: 100%;";
    }

    private string GetElementTypeLabel() => SelectionState.ElementType switch
    {
        "item" => "Item",
        "lane" => "Lane",
        "column" => "Column",
        "milestone" => "Milestone",
        "title" => "Title",
        "detail" => "Detail",
        _ => "Element"
    };

    private async Task HidePanel()
    {
        if (OnHidePanel.HasDelegate)
        {
            await OnHidePanel.InvokeAsync();
        }
    }

    private async Task HandlePropertyChange((string PropertyName, object Value) change)
    {
        if (OnPropertyChange.HasDelegate && SelectionState.SelectedPath != null)
        {
            await OnPropertyChange.InvokeAsync((SelectionState.SelectedPath, change.PropertyName, change.Value));
        }
    }

    private async Task HandleAddElement(string elementType)
    {
        if (OnAddElement.HasDelegate && SelectionState.SelectedPath != null)
        {
            await OnAddElement.InvokeAsync((elementType, SelectionState.SelectedPath));
        }
    }

    private async Task HandleRemoveElement(string elementType)
    {
        if (OnRemoveElement.HasDelegate && SelectionState.SelectedPath != null)
        {
            await OnRemoveElement.InvokeAsync((elementType, SelectionState.SelectedPath));
        }
    }

    private async Task HandleDuplicateElement(string elementType)
    {
        if (OnDuplicateElement.HasDelegate && SelectionState.SelectedPath != null)
        {
            await OnDuplicateElement.InvokeAsync((elementType, SelectionState.SelectedPath));
        }
    }

    private async Task HandleMoveItem((string Direction, string JsonPath) args)
    {
        if (OnMoveItem.HasDelegate)
        {
            await OnMoveItem.InvokeAsync(args);
        }
    }

    private async Task HandleMoveLane((string Direction, string JsonPath) args)
    {
        if (OnMoveLane.HasDelegate)
        {
            await OnMoveLane.InvokeAsync(args);
        }
    }

    private int GetItemIndex() => ItemIndex;
    private int GetItemCount() => ItemCount;
    private int GetLaneIndex() => LaneIndex;

    private async Task HandleExpandPanel()
    {
        if (OnHidePanel.HasDelegate)
        {
            await OnHidePanel.InvokeAsync();
        }
    }

    private async Task SwitchToJsonEditor()
    {
        if (OnToggleJsonEditor.HasDelegate)
        {
            await OnToggleJsonEditor.InvokeAsync();
        }
    }

    // Quick action handlers for default dashboard
    private async Task AddSwimLane()
    {
        if (OnAddElement.HasDelegate)
        {
            await OnAddElement.InvokeAsync(("lane", "lanes"));
        }
    }

    private async Task AddColumn()
    {
        if (OnAddElement.HasDelegate)
        {
            await OnAddElement.InvokeAsync(("column", "columns"));
        }
    }

    private async Task AddMilestone()
    {
        if (OnAddElement.HasDelegate)
        {
            await OnAddElement.InvokeAsync(("milestone", "milestones"));
        }
    }

    private async Task SelectTitle()
    {
        if (OnSelectTitle.HasDelegate)
        {
            await OnSelectTitle.InvokeAsync();
        }
    }
}
