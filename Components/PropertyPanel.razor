@inject SelectionState SelectionState
@implements IDisposable

@if (IsCollapsed)
{
    @* Collapsed Properties Panel *@
    <div style="width: 80px; flex-shrink: 0; background: #1e1e2f; border-left: 1px solid #3a3a4e; display: flex; flex-direction: column; align-items: center; padding: 16px 8px; gap: 12px;">
        <div style="font-weight: 700; color: #667eea; font-size: 12px; letter-spacing: 0.5px; writing-mode: vertical-rl; text-orientation: mixed; margin-bottom: 8px;">
            RoadScript
        </div>

        <button @onclick="HandleTogglePreview"
                title="@(IsPreviewMode ? "Switch to Edit Mode" : "Switch to Preview Mode")"
                style="@GetCollapsedButtonStyle()">
            @(IsPreviewMode ? "📝" : "👁️")
        </button>

        <button @onclick="HandleExportPng"
                title="Export as PNG"
                style="@GetCollapsedButtonStyle()">
            📷
        </button>

        <button @onclick="HandleExpandPanel"
                title="Expand Properties Panel"
                style="@GetCollapsedButtonStyle()">
            ◀
        </button>

        <button @onclick="HandleToggleTheme"
                style="@GetCollapsedThemeToggleStyle()"
                title="Toggle between Lite and Vibe modes">
            @(IsVibeMode ? "🌙" : "☀️")
        </button>
    </div>
}
else
{
<div class="property-panel" style="@PanelStyle()">
    @if (SelectionState.IsSelected)
    {
        <div style="background: #2a2a3e; padding: 12px 16px; border-bottom: 1px solid #3a3a4e; display: flex; flex-direction: column; gap: 12px;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div style="display: flex; flex-direction: column; gap: 2px;">
                    <span style="font-weight: 700; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; font-size: 14px;">
                        RoadScript
                    </span>
                    <span style="font-size: 11px; color: #666; font-weight: 400;">@GetElementTypeLabel() Properties</span>
                </div>
                <div style="display: flex; gap: 8px; align-items: center;">
                    <button @onclick="ClosePanel" style="background: transparent; border: none; color: #999; cursor: pointer; font-size: 18px; padding: 0; width: 24px; height: 24px;" type="button">
                        ×
                    </button>
                    <button @onclick="HidePanel" style="background: #3c3c3c; color: #ccc; border: 1px solid #555; padding: 4px 10px; border-radius: 4px; font-size: 11px; font-weight: 500; cursor: pointer; transition: all 0.2s;" type="button">
                        Hide ▶
                    </button>
                </div>
            </div>
            <div style="display: flex; gap: 8px; flex-wrap: wrap; padding-top: 8px; border-top: 1px solid #3a3a4e;">
                <button @onclick="HandleTogglePreview"
                        title="@(IsPreviewMode ? "Switch to Edit Mode" : "Switch to Preview Mode")"
                        style="@GetExpandedActionButtonStyle()">
                    @(IsPreviewMode ? "📝 Edit" : "👁️ Preview")
                </button>
                <button @onclick="HandleExportPng"
                        title="Export as PNG"
                        style="@GetExpandedActionButtonStyle()">
                    📷 Export PNG
                </button>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 8px; border-top: 1px solid #3a3a4e;">
                <span style="font-size: 12px; color: #888;">@(IsVibeMode ? "Vibe" : "Lite")</span>
                <button @onclick="HandleToggleTheme"
                        style="@GetThemeToggleStyle()"
                        title="Toggle between Lite and Vibe modes">
                    <div style="@GetThemeToggleIndicatorStyle()"></div>
                </button>
            </div>
        </div>

        <div style="padding: 16px; overflow-y: auto; flex: 1;">
            @if (SelectionState.ElementType == "item" && SelectionState.SelectedElement is Item item && SelectionState.SelectedPath != null)
            {
                <ItemProperties Item="@item"
                               JsonPath="@SelectionState.SelectedPath"
                               OnChange="HandlePropertyChange"
                               OnAdd="HandleAddElement"
                               OnRemove="HandleRemoveElement" />
            }
            else if (SelectionState.ElementType == "lane" && SelectionState.SelectedElement is Lane lane && SelectionState.SelectedPath != null)
            {
                <LaneProperties Lane="@lane"
                               JsonPath="@SelectionState.SelectedPath"
                               OnChange="HandlePropertyChange"
                               OnAdd="HandleAddElement"
                               OnRemove="HandleRemoveElement" />
            }
            else if (SelectionState.ElementType == "column" && SelectionState.SelectedElement is Column column && SelectionState.SelectedPath != null)
            {
                <ColumnProperties Column="@column"
                                 JsonPath="@SelectionState.SelectedPath"
                                 OnChange="HandlePropertyChange"
                                 OnAdd="HandleAddElement"
                                 OnRemove="HandleRemoveElement" />
            }
            else if (SelectionState.ElementType == "milestone" && SelectionState.SelectedElement is Milestone milestone && SelectionState.SelectedPath != null)
            {
                <MilestoneProperties Milestone="@milestone"
                                    JsonPath="@SelectionState.SelectedPath"
                                    OnChange="HandlePropertyChange"
                                    OnAdd="HandleAddElement"
                                    OnRemove="HandleRemoveElement" />
            }
            else if (SelectionState.ElementType == "title" && SelectionState.SelectedElement is RoadmapData roadmapData && SelectionState.SelectedPath != null)
            {
                <TitleProperties Title="@roadmapData.Title"
                                Subtitle="@roadmapData.Subtitle"
                                JsonPath="@SelectionState.SelectedPath"
                                OnChange="HandlePropertyChange" />
            }
        </div>
    }
    else
    {
        <div style="background: #2a2a3e; padding: 12px 16px; border-bottom: 1px solid #3a3a4e; display: flex; flex-direction: column; gap: 12px;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div style="display: flex; flex-direction: column; gap: 2px;">
                    <span style="font-weight: 700; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; font-size: 14px;">
                        RoadScript
                    </span>
                    <span style="font-size: 11px; color: #666; font-weight: 400;">Properties Panel</span>
                </div>
                <button @onclick="HidePanel" style="background: #3c3c3c; color: #ccc; border: 1px solid #555; padding: 4px 10px; border-radius: 4px; font-size: 11px; font-weight: 500; cursor: pointer; transition: all 0.2s;" type="button">
                    Hide ▶
                </button>
            </div>
            <div style="display: flex; gap: 8px; flex-wrap: wrap; padding-top: 8px; border-top: 1px solid #3a3a4e;">
                <button @onclick="HandleTogglePreview"
                        title="@(IsPreviewMode ? "Switch to Edit Mode" : "Switch to Preview Mode")"
                        style="@GetExpandedActionButtonStyle()">
                    @(IsPreviewMode ? "📝 Edit" : "👁️ Preview")
                </button>
                <button @onclick="HandleExportPng"
                        title="Export as PNG"
                        style="@GetExpandedActionButtonStyle()">
                    📷 Export PNG
                </button>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 8px; border-top: 1px solid #3a3a4e;">
                <span style="font-size: 12px; color: #888;">@(IsVibeMode ? "Vibe" : "Lite")</span>
                <button @onclick="HandleToggleTheme"
                        style="@GetThemeToggleStyle()"
                        title="Toggle between Lite and Vibe modes">
                    <div style="@GetThemeToggleIndicatorStyle()"></div>
                </button>
            </div>
        </div>
        <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; flex: 1; color: #666; padding: 24px; text-align: center;">
            <div style="font-size: 48px; margin-bottom: 12px; opacity: 0.3;">📝</div>
            <p style="margin: 0; font-size: 14px; line-height: 1.6;">
                Click any roadmap element to edit its properties
            </p>
            <div style="font-size: 12px; color: #555; margin-top: 16px; line-height: 1.5;">
                <div style="margin-bottom: 8px;">• Click items to edit title, position, and details</div>
                <div style="margin-bottom: 8px;">• Click lanes to change color and history</div>
                <div style="margin-bottom: 8px;">• Click columns to edit labels</div>
                <div>• Click milestones to adjust position</div>
            </div>
        </div>
    }
</div>
}

@code {
    [Parameter]
    public EventCallback<(string JsonPath, string PropertyName, object Value)> OnPropertyChange { get; set; }

    [Parameter]
    public EventCallback<(string ElementType, string JsonPath)> OnAddElement { get; set; }

    [Parameter]
    public EventCallback<(string ElementType, string JsonPath)> OnRemoveElement { get; set; }

    [Parameter]
    public EventCallback OnHidePanel { get; set; }

    [Parameter]
    public bool IsVibeMode { get; set; }

    [Parameter]
    public EventCallback OnToggleTheme { get; set; }

    [Parameter]
    public bool IsCollapsed { get; set; }

    [Parameter]
    public bool IsPreviewMode { get; set; }

    [Parameter]
    public EventCallback OnTogglePreview { get; set; }

    [Parameter]
    public EventCallback OnExportPng { get; set; }

    protected override void OnInitialized()
    {
        SelectionState.OnSelectionChanged += StateHasChanged;
    }

    public void Dispose()
    {
        SelectionState.OnSelectionChanged -= StateHasChanged;
    }

    private string PanelStyle()
    {
        return "width: 27%; min-width: 320px; max-width: 450px; background: #1e1e2f; border-left: 1px solid #3a3a4e; display: flex; flex-direction: column; transition: all 0.3s ease; height: 100%;";
    }

    private string GetElementTypeLabel()
    {
        return SelectionState.ElementType switch
        {
            "item" => "Item",
            "lane" => "Lane",
            "column" => "Column",
            "milestone" => "Milestone",
            "title" => "Title",
            "detail" => "Detail",
            _ => "Element"
        };
    }

    private void ClosePanel()
    {
        SelectionState.Clear();
    }

    private async Task HidePanel()
    {
        if (OnHidePanel.HasDelegate)
        {
            await OnHidePanel.InvokeAsync();
        }
    }

    private async Task HandlePropertyChange((string PropertyName, object Value) change)
    {
        if (OnPropertyChange.HasDelegate && SelectionState.SelectedPath != null)
        {
            await OnPropertyChange.InvokeAsync((SelectionState.SelectedPath, change.PropertyName, change.Value));
        }
    }

    private async Task HandleAddElement(string elementType)
    {
        if (OnAddElement.HasDelegate && SelectionState.SelectedPath != null)
        {
            await OnAddElement.InvokeAsync((elementType, SelectionState.SelectedPath));
        }
    }

    private async Task HandleRemoveElement(string elementType)
    {
        if (OnRemoveElement.HasDelegate && SelectionState.SelectedPath != null)
        {
            await OnRemoveElement.InvokeAsync((elementType, SelectionState.SelectedPath));
        }
    }

    private async Task HandleToggleTheme()
    {
        if (OnToggleTheme.HasDelegate)
        {
            await OnToggleTheme.InvokeAsync();
        }
    }

    private async Task HandleExpandPanel()
    {
        if (OnHidePanel.HasDelegate)
        {
            await OnHidePanel.InvokeAsync();
        }
    }

    private string GetThemeToggleStyle() =>
        IsVibeMode
            ? "width: 50px; height: 24px; border-radius: 12px; border: none; cursor: pointer; " +
              "background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); " +
              "padding: 2px; transition: all 0.3s ease; position: relative; box-shadow: 0 0 10px rgba(102, 126, 234, 0.5);"
            : "width: 50px; height: 24px; border-radius: 12px; border: 1px solid #555; cursor: pointer; " +
              "background: #3c3c3c; padding: 2px; transition: all 0.3s ease; position: relative;";

    private string GetThemeToggleIndicatorStyle() =>
        IsVibeMode
            ? "width: 18px; height: 18px; border-radius: 50%; background: #fff; " +
              "transition: all 0.3s ease; transform: translateX(26px); box-shadow: 0 0 8px rgba(255, 255, 255, 0.8);"
            : "width: 18px; height: 18px; border-radius: 50%; background: #ccc; " +
              "transition: all 0.3s ease; transform: translateX(0);";

    private string GetCollapsedThemeToggleStyle() =>
        IsVibeMode
            ? "background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; border: none; padding: 12px; border-radius: 6px; cursor: pointer; font-size: 18px; transition: all 0.2s; box-shadow: 0 0 10px rgba(102, 126, 234, 0.5);"
            : "background: #3c3c3c; color: #ccc; border: 1px solid #555; padding: 12px; border-radius: 6px; cursor: pointer; font-size: 18px; transition: all 0.2s;";

    private string GetCollapsedButtonStyle() =>
        "background: #3c3c3c; color: #ccc; border: 1px solid #555; padding: 12px; border-radius: 6px; cursor: pointer; font-size: 18px; transition: all 0.2s; hover:background: #4a4a4a;";

    private string GetExpandedActionButtonStyle() =>
        "flex: 1; min-width: 140px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; border: none; padding: 10px 16px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.2s; box-shadow: 0 2px 6px rgba(102, 126, 234, 0.3); hover:box-shadow: 0 4px 12px rgba(102, 126, 234, 0.5);";

    private async Task HandleTogglePreview()
    {
        if (OnTogglePreview.HasDelegate)
        {
            await OnTogglePreview.InvokeAsync();
        }
    }

    private async Task HandleExportPng()
    {
        if (OnExportPng.HasDelegate)
        {
            await OnExportPng.InvokeAsync();
        }
    }
}
