@using RoadScript.Models

<div class="property-editor">
    @* Column Label Input *@
    <div class="form-group">
        <label>Column Label</label>
        <div style="position: relative;">
            <input type="text"
                   value="@Column.Label"
                   @onchange="@(e => OnChange.InvokeAsync(("label", e.Value)))"
                   class="form-control"
                   placeholder="Q1 2026"
                   style="padding-right: 36px;" />
            @if (!string.IsNullOrWhiteSpace(Column.Label))
            {
                <button type="button"
                        @onclick="@(() => ClearField("label"))"
                        @onclick:stopPropagation="true"
                        title="Clear"
                        style="position: absolute; right: 0; top: 50%; transform: translateY(-50%); width: 36px; height: 36px; background: rgba(239, 68, 68, 0.15); border: none; border-left: 1px solid rgba(239, 68, 68, 0.2); border-radius: 0 4px 4px 0; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.2s;">
                    <span style="color: #ef4444; font-size: 16px; font-weight: 600;">✕</span>
                </button>
            }
        </div>
    </div>

    @* Quick Fill Presets for Label - Always Visible *@
    <div class="form-group" style="margin-top: 12px;">
        <label style="font-size: 11px; margin-bottom: 8px; color: #888;">Quick Fill</label>

        @* Days Section *@
        <div style="margin-bottom: 10px;">
            <button type="button"
                    @onclick="@(() => _daysExpanded = !_daysExpanded)"
                    style="width: 100%; padding: 6px 8px; background: rgba(102, 126, 234, 0.1); border: 1px solid rgba(102, 126, 234, 0.3); border-radius: 4px; color: #c7d2fe; cursor: pointer; display: flex; justify-content: space-between; align-items: center; transition: all 0.2s; font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">
                <span>Days</span>
                <span style="font-size: 9px; transition: transform 0.2s; transform: rotate(@(_daysExpanded ? "180deg" : "0deg"));">▼</span>
            </button>

            @if (_daysExpanded)
            {
                <div style="margin-top: 6px; padding: 6px; background: #252538; border-radius: 4px; border: 1px solid #3a3a4e;">
                    <div style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 3px; margin-bottom: 4px;">
                        @foreach (var day in _dayPresets)
                        {
                            <button type="button"
                                    @onclick="@(() => OnChange.InvokeAsync(("label", day.Abbr)))"
                                    title="@day.Abbr"
                                    style="@GetQuickButtonStyle(day.Abbr, Column.Label)">
                                <div style="font-size: 9px; font-weight: 700;">@day.Abbr</div>
                            </button>
                        }
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 3px;">
                        @foreach (var day in _dayPresets)
                        {
                            <button type="button"
                                    @onclick="@(() => OnChange.InvokeAsync(("label", day.Full)))"
                                    title="@day.Full"
                                    style="@GetQuickButtonStyle(day.Full, Column.Label)">
                                <div style="font-size: 8px; font-weight: 600;">@day.Full</div>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>

        @* Months Section *@
        <div style="margin-bottom: 10px;">
            <button type="button"
                    @onclick="@(() => _monthsExpanded = !_monthsExpanded)"
                    style="width: 100%; padding: 6px 8px; background: rgba(102, 126, 234, 0.1); border: 1px solid rgba(102, 126, 234, 0.3); border-radius: 4px; color: #c7d2fe; cursor: pointer; display: flex; justify-content: space-between; align-items: center; transition: all 0.2s; font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">
                <span>Months</span>
                <span style="font-size: 9px; transition: transform 0.2s; transform: rotate(@(_monthsExpanded ? "180deg" : "0deg"));">▼</span>
            </button>

            @if (_monthsExpanded)
            {
                <div style="margin-top: 6px; padding: 6px; background: #252538; border-radius: 4px; border: 1px solid #3a3a4e;">
                    <div style="display: grid; grid-template-columns: repeat(6, 1fr); gap: 3px; margin-bottom: 4px;">
                        @foreach (var month in _monthPresets)
                        {
                            <button type="button"
                                    @onclick="@(() => OnChange.InvokeAsync(("label", month.Abbr)))"
                                    title="@month.Abbr"
                                    style="@GetQuickButtonStyle(month.Abbr, Column.Label)">
                                <div style="font-size: 9px; font-weight: 700;">@month.Abbr</div>
                            </button>
                        }
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(6, 1fr); gap: 3px;">
                        @foreach (var month in _monthPresets)
                        {
                            <button type="button"
                                    @onclick="@(() => OnChange.InvokeAsync(("label", month.Full)))"
                                    title="@month.Full"
                                    style="@GetQuickButtonStyle(month.Full, Column.Label)">
                                <div style="font-size: 8px; font-weight: 600;">@month.Full</div>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>

        @* More Options Section *@
        <div style="margin-bottom: 10px;">
            <button type="button"
                    @onclick="@(() => _moreExpanded = !_moreExpanded)"
                    style="width: 100%; padding: 6px 8px; background: rgba(102, 126, 234, 0.1); border: 1px solid rgba(102, 126, 234, 0.3); border-radius: 4px; color: #c7d2fe; cursor: pointer; display: flex; justify-content: space-between; align-items: center; transition: all 0.2s; font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">
                <span>More Options</span>
                <span style="font-size: 9px; transition: transform 0.2s; transform: rotate(@(_moreExpanded ? "180deg" : "0deg"));">▼</span>
            </button>

            @if (_moreExpanded)
            {
                <div style="margin-top: 6px; padding: 6px; background: #252538; border-radius: 4px; border: 1px solid #3a3a4e;">
                    <div style="font-size: 9px; color: #888; margin-bottom: 4px; font-weight: 600;">Quarters</div>
                    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 3px; margin-bottom: 8px;">
                        @foreach (var quarter in _quarterPresets)
                        {
                            <button type="button"
                                    @onclick="@(() => OnChange.InvokeAsync(("label", quarter)))"
                                    title="@quarter"
                                    style="@GetQuickButtonStyle(quarter, Column.Label)">
                                <div style="font-size: 9px; font-weight: 700;">@quarter</div>
                            </button>
                        }
                    </div>

                    <div style="font-size: 9px; color: #888; margin-bottom: 4px; font-weight: 600;">Years</div>
                    <div style="display: grid; grid-template-columns: repeat(5, 1fr); gap: 3px; margin-bottom: 8px;">
                        @foreach (var year in _yearPresets)
                        {
                            <button type="button"
                                    @onclick="@(() => OnChange.InvokeAsync(("label", year)))"
                                    title="@year"
                                    style="@GetQuickButtonStyle(year, Column.Label)">
                                <div style="font-size: 9px; font-weight: 700;">@year</div>
                            </button>
                        }
                    </div>

                    <div style="font-size: 9px; color: #888; margin-bottom: 4px; font-weight: 600;">Hours</div>
                    <div style="display: grid; grid-template-columns: repeat(6, 1fr); gap: 3px;">
                        @foreach (var hour in _hourPresets)
                        {
                            <button type="button"
                                    @onclick="@(() => OnChange.InvokeAsync(("label", hour)))"
                                    title="@hour"
                                    style="@GetQuickButtonStyle(hour, Column.Label)">
                                <div style="font-size: 8px; font-weight: 600;">@hour</div>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>

        @* Date Picker *@
        <div style="display: flex; gap: 6px;">
            <button type="button"
                    @onclick="HandleTodayLabel"
                    title="Insert today's date"
                    style="flex: 1; height: 32px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: #fff; border: none; border-radius: 4px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 11px; font-weight: 600; box-shadow: 0 2px 4px rgba(16, 185, 129, 0.4);">
                <Icon IconType="calendar" Color="#fff" Size="12" />
                <span>Today</span>
            </button>
            <input type="date"
                   @onchange="@HandleDateSelectLabel"
                   class="form-control"
                   style="flex: 1; height: 32px; font-size: 11px; background: #252538; border: 1px solid #667eea; color: #ffffff; color-scheme: dark; border-radius: 4px; padding: 0 6px;" />
        </div>
    </div>

    @* Sub-Label Input *@
    <div class="form-group" style="margin-top: 16px; padding-top: 16px; border-top: 1px solid #3a3a4e;">
        <label>Sub-Label</label>
        <div style="position: relative;">
            <input type="text"
                   value="@Column.Sub"
                   @onchange="@(e => OnChange.InvokeAsync(("sub", e.Value)))"
                   class="form-control"
                   placeholder="Jan - Mar"
                   style="padding-right: 36px;" />
            @if (!string.IsNullOrWhiteSpace(Column.Sub))
            {
                <button type="button"
                        @onclick="@(() => ClearField("sub"))"
                        @onclick:stopPropagation="true"
                        title="Clear"
                        style="position: absolute; right: 0; top: 50%; transform: translateY(-50%); width: 36px; height: 36px; background: rgba(239, 68, 68, 0.15); border: none; border-left: 1px solid rgba(239, 68, 68, 0.2); border-radius: 0 4px 4px 0; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.2s;">
                    <span style="color: #ef4444; font-size: 16px; font-weight: 600;">✕</span>
                </button>
            }
        </div>

        @* Quick year button for sublabel *@
        <button type="button"
                @onclick="@(() => OnChange.InvokeAsync(("sub", DateTime.Now.Year.ToString())))"
                title="Insert current year"
                style="width: 100%; height: 32px; margin-top: 6px; background: #667eea; color: #fff; border: none; border-radius: 4px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 11px; font-weight: 600; box-shadow: 0 2px 4px rgba(102, 126, 234, 0.3);">
            <Icon IconType="calendar" Color="#fff" Size="12" />
            <span>@DateTime.Now.Year</span>
        </button>
    </div>

    @* Column Icon Section *@
    <div class="form-group" style="margin-top: 16px; padding-top: 16px; border-top: 1px solid #3a3a4e;">
        <label style="font-size: 11px; margin-bottom: 8px; color: #888;">Column Icon</label>

        @* Large Icon Preview Button *@
        <div style="position: relative;">
            <button type="button"
                    @onclick="ToggleColumnIconPicker"
                    title="Click to @(_columnIconPickerExpanded ? "hide" : "choose") column icon"
                    style="width: 100%; min-height: 80px; background: #252538; border: 1px solid #3a3a4e; border-radius: 6px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; padding: 16px; position: relative;">
                @if (!string.IsNullOrEmpty(Column.Icon))
                {
                    <Icon IconType="@Column.Icon"
                          Color="@(Column.Color ?? "#667eea")"
                          Size="36"
                          DropShadow="true" />
                }
                else
                {
                    <span style="font-size: 36px; opacity: 0.3; color: #fff;">✦</span>
                }

                <span style="position: absolute; bottom: 8px; right: 8px; font-size: 12px; color: #666; transition: transform 0.2s; transform: rotate(@(_columnIconPickerExpanded ? "180deg" : "0deg"));">▼</span>
            </button>

            @if (!string.IsNullOrEmpty(Column.Icon))
            {
                <button type="button"
                        @onclick="ClearColumnIcon"
                        @onclick:stopPropagation="true"
                        title="Clear icon"
                        style="position: absolute; top: 6px; right: 6px; width: 24px; height: 24px; background: rgba(0,0,0,0.6); border: 1px solid #555; border-radius: 4px; cursor: pointer; display: flex; align-items: center; justify-content: center; color: #ef4444; font-size: 14px; font-weight: 600; transition: all 0.2s; z-index: 1;">
                    ✕
                </button>
            }
        </div>

        @if (_columnIconPickerExpanded)
        {
            <div style="background: #252538; padding: 12px; border-radius: 6px; border: 1px solid #3a3a4e; margin-top: 8px;">
                <IconPicker SelectedIcon="@(Column.Icon ?? "")"
                           Color="@(Column.Color ?? "#667eea")"
                           OnIconSelected="HandleColumnIconSelectedAndCollapse"
                           ShowCategories="true"
                           ColumnsPerRow="5" />

                <div style="margin-top: 12px;">
                    <label style="font-size: 11px; margin-bottom: 8px;">Icon Color</label>

                    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin-bottom: 10px;">
                        @foreach (var preset in _colorPresets)
                        {
                            <button type="button"
                                    @onclick="@(() => OnChange.InvokeAsync(("color", preset.Value)))"
                                    title="@preset.Name"
                                    style="@GetPresetColorButtonStyle(preset.Value, Column.Color)">
                                <span style="width: 100%; height: 100%; display: block; border-radius: 3px; background: @preset.Value;"></span>
                            </button>
                        }
                    </div>

                    <div style="display: flex; align-items: center; gap: 8px;">
                        <input type="color"
                               value="@(Column.Color ?? "#667eea")"
                               @onchange="@(e => OnChange.InvokeAsync(("color", e.Value)))"
                               style="width: 40px; height: 32px; border: 1px solid #3a3a4e; border-radius: 4px; cursor: pointer; background: #2a2a3e;" />
                        <input type="text"
                               value="@(Column.Color ?? "#667eea")"
                               @onchange="@(e => OnChange.InvokeAsync(("color", e.Value)))"
                               class="form-control"
                               placeholder="#667eea"
                               style="flex: 1; font-size: 12px;" />
                    </div>
                </div>
            </div>
        }
    </div>

    @* Column Management Section *@
    <div class="form-group" style="margin-top: 24px; padding-top: 16px; border-top: 1px solid #3a3a4e;">
        <label style="margin-bottom: 12px; font-weight: 600; color: #e0e7ff;">Column Management</label>

        <div style="display: flex; gap: 6px; margin-bottom: 12px;">
            <button @onclick="AddColumn"
                    type="button"
                    title="Add new column"
                    style="flex: 1; height: 44px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: #fff; border: none; border-radius: 6px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 13px; font-weight: 600; box-shadow: 0 2px 6px rgba(16, 185, 129, 0.3);">
                <span style="font-size: 18px;">+</span> Column
            </button>

            <button @onclick="DuplicateColumn"
                    type="button"
                    title="Duplicate this column"
                    style="width: 44px; height: 44px; background: #667eea; color: #fff; border: none; border-radius: 6px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0; box-shadow: 0 2px 6px rgba(102, 126, 234, 0.3);">
                ♻️
            </button>

            <button @onclick="RemoveColumn"
                    type="button"
                    title="Remove this column"
                    style="width: 44px; height: 44px; background: linear-gradient(135deg, rgba(239, 68, 68, 0.2) 0%, rgba(220, 38, 38, 0.1) 100%); color: #ef4444; border: 2px solid #ef4444; border-radius: 6px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0;">
                🗑️
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Column Column { get; set; } = null!;

    [Parameter, EditorRequired]
    public string JsonPath { get; set; } = "";

    [Parameter]
    public EventCallback<(string PropertyName, object Value)> OnChange { get; set; }

    [Parameter]
    public EventCallback<string> OnAdd { get; set; }

    [Parameter]
    public EventCallback<string> OnRemove { get; set; }

    [Parameter]
    public EventCallback<string> OnDuplicate { get; set; }

    private bool _daysExpanded = true;
    private bool _monthsExpanded = false;
    private bool _moreExpanded = false;
    private bool _columnIconPickerExpanded = false;

    private record Preset(string Abbr, string Full);

    private readonly List<Preset> _dayPresets = new()
    {
        new Preset("Mon", "Monday"),
        new Preset("Tue", "Tuesday"),
        new Preset("Wed", "Wednesday"),
        new Preset("Thu", "Thursday"),
        new Preset("Fri", "Friday"),
        new Preset("Sat", "Saturday"),
        new Preset("Sun", "Sunday")
    };

    private readonly List<Preset> _monthPresets = new()
    {
        new Preset("Jan", "January"),
        new Preset("Feb", "February"),
        new Preset("Mar", "March"),
        new Preset("Apr", "April"),
        new Preset("May", "May"),
        new Preset("Jun", "June"),
        new Preset("Jul", "July"),
        new Preset("Aug", "August"),
        new Preset("Sep", "September"),
        new Preset("Oct", "October"),
        new Preset("Nov", "November"),
        new Preset("Dec", "December")
    };

    private readonly List<string> _quarterPresets = new() { "Q1", "Q2", "Q3", "Q4" };
    private readonly List<string> _yearPresets = new() { "2024", "2025", "2026", "2027", "2028" };
    private readonly List<string> _hourPresets = new()
    {
        "12AM", "1AM", "2AM", "3AM", "4AM", "5AM",
        "6AM", "7AM", "8AM", "9AM", "10AM", "11AM",
        "12PM", "1PM", "2PM", "3PM", "4PM", "5PM",
        "6PM", "7PM", "8PM", "9PM", "10PM", "11PM"
    };

    private async Task ClearField(string field)
    {
        if (field == "label")
        {
            await OnChange.InvokeAsync(("label", ""));
        }
        else if (field == "sub")
        {
            await OnChange.InvokeAsync(("sub", ""));
        }
    }

    private async Task HandleTodayLabel()
    {
        var today = DateTime.Now.ToString("MM/dd/yyyy");
        await OnChange.InvokeAsync(("label", today));
    }

    private async Task HandleDateSelectLabel(ChangeEventArgs e)
    {
        var dateValue = e.Value?.ToString();
        if (!string.IsNullOrEmpty(dateValue) && DateTime.TryParse(dateValue, out var date))
        {
            var formattedDate = date.ToString("MM/dd/yyyy");
            await OnChange.InvokeAsync(("label", formattedDate));
        }
    }

    private void AddColumn()
    {
        OnAdd.InvokeAsync("column");
    }

    private void DuplicateColumn()
    {
        OnDuplicate.InvokeAsync("column");
    }

    private void RemoveColumn()
    {
        OnRemove.InvokeAsync("column");
    }

    private void ToggleColumnIconPicker()
    {
        _columnIconPickerExpanded = !_columnIconPickerExpanded;
    }

    private async Task HandleColumnIconSelectedAndCollapse(string iconValue)
    {
        Column.Icon = iconValue;
        await OnChange.InvokeAsync(("icon", iconValue));
        _columnIconPickerExpanded = false;
        StateHasChanged();
    }

    private async Task ClearColumnIcon()
    {
        Column.Icon = null;
        await OnChange.InvokeAsync(("icon", null!));
        StateHasChanged();
    }

    private record ColorPreset(string Name, string Value);

    private readonly List<ColorPreset> _colorPresets = new()
    {
        new ColorPreset("Teal", "#45B69C"),
        new ColorPreset("Coral", "#F88379"),
        new ColorPreset("Lav", "#9999ff"),
        new ColorPreset("Orange", "#D4652F"),
        new ColorPreset("Blue", "#87CEEB"),
        new ColorPreset("Mustard", "#E6B800"),
        new ColorPreset("Brown", "#4A2C1A"),
        new ColorPreset("Sage", "#B7C4B7"),
        new ColorPreset("Red", "#EF4444"),
        new ColorPreset("Indigo", "#6366F1"),
        new ColorPreset("Dark Blue", "#1E3A8A"),
        new ColorPreset("Pink", "#EC4899")
    };

    private string GetPresetColorButtonStyle(string presetColor, string? currentColor)
    {
        var isSelected = presetColor.Equals(currentColor, StringComparison.OrdinalIgnoreCase);
        var border = isSelected
            ? "border: 2px solid #667eea; box-shadow: 0 0 0 2px rgba(102, 126, 234, 0.3);"
            : "border: 1.5px solid rgba(255, 255, 255, 0.2);";

        return $"width: 100%; height: 32px; padding: 2px; cursor: pointer; border-radius: 4px; " +
               $"background: #1a1a2e; transition: all 0.2s; {border}";
    }

    private string GetQuickButtonStyle(string value, string? currentValue)
    {
        var isActive = value.Equals(currentValue, StringComparison.OrdinalIgnoreCase);

        var bg = isActive
            ? "background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);"
            : "background: #1a1a2e;";

        var border = isActive
            ? "border: 2px solid #667eea; box-shadow: 0 0 6px rgba(102, 126, 234, 0.5);"
            : "border: 1px solid #3a3a4e;";

        var color = isActive ? "#fff" : "#ccc";

        return $"width: 100%; height: 24px; {bg} color: {color}; {border} " +
               "border-radius: 3px; cursor: pointer; transition: all 0.2s; " +
               "display: flex; align-items: center; justify-content: center; " +
               "font-weight: 600;";
    }
}
