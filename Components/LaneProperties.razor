@using RoadScript.Models

<style>
    /* Hide number input spinner arrows */
    input[type="number"]::-webkit-inner-spin-button,
    input[type="number"]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
    input[type="number"] {
        -moz-appearance: textfield;
    }
</style>

<div class="property-editor">
    <div class="form-group">
        <label>Lane Title</label>
        <input type="text"
               value="@Lane.Title"
               @onchange="@(e => OnChange.InvokeAsync(("title", e.Value)))"
               class="form-control"
               placeholder="Team Name" />
        <div style="font-size: 11px; color: #888; margin-top: 4px;">
            Use "&amp;" to add line breaks in the title
        </div>
    </div>

    <div class="form-group">
        <label style="font-size: 11px; margin-bottom: 8px; color: #888;">Lane Icon</label>

        @* Large Icon Preview Button *@
        <div style="position: relative;">
            <button type="button"
                    @onclick="ToggleLaneIconPicker"
                    title="Click to @(_laneIconPickerExpanded ? "hide" : "choose") lane icon"
                    style="width: 100%; min-height: 80px; background: #252538; border: 1px solid #3a3a4e; border-radius: 6px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; padding: 16px; position: relative;">
                @if (!string.IsNullOrEmpty(Lane.Icon))
                {
                    <Icon IconType="@Lane.Icon"
                          Color="@Lane.Color"
                          Size="36"
                          DropShadow="true" />
                }
                else
                {
                    @* Placeholder for empty state *@
                    <span style="font-size: 36px; opacity: 0.3;">✦</span>
                }

                @* Dropdown indicator in bottom right *@
                <span style="position: absolute; bottom: 8px; right: 8px; font-size: 12px; color: #666; transition: transform 0.2s; transform: rotate(@(_laneIconPickerExpanded ? "180deg" : "0deg"));">▼</span>
            </button>

            @* Clear button overlay in top right corner *@
            @if (!string.IsNullOrEmpty(Lane.Icon))
            {
                <button type="button"
                        @onclick="ClearLaneIcon"
                        @onclick:stopPropagation="true"
                        title="Clear icon"
                        style="position: absolute; top: 6px; right: 6px; width: 24px; height: 24px; background: rgba(0,0,0,0.6); border: 1px solid #555; border-radius: 4px; cursor: pointer; display: flex; align-items: center; justify-content: center; color: #ef4444; font-size: 14px; font-weight: 600; transition: all 0.2s; z-index: 1;">
                    ✕
                </button>
            }
        </div>

        @if (_laneIconPickerExpanded)
        {
            <div style="background: #252538; padding: 12px; border-radius: 6px; border: 1px solid #3a3a4e; margin-top: 8px;">
                <IconPicker SelectedIcon="@(Lane.Icon ?? "")"
                           Color="@Lane.Color"
                           OnIconSelected="HandleLaneIconSelectedAndCollapse"
                           ShowCategories="true"
                           ColumnsPerRow="5" />
            </div>
        }
    </div>

    <div class="form-group">
        <label style="margin-bottom: 8px;">Color</label>

        @* Preset Color Options *@
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin-bottom: 10px;">
            @foreach (var preset in _colorPresets)
            {
                <button type="button"
                        @onclick="@(() => OnChange.InvokeAsync(("color", preset.Value)))"
                        title="@preset.Name"
                        style="@GetPresetColorButtonStyle(preset.Value, Lane.Color)">
                    <span style="width: 100%; height: 100%; display: block; border-radius: 3px; background: @preset.Value;"></span>
                </button>
            }
        </div>

        <div style="display: flex; align-items: center; gap: 8px;">
            <input type="color"
                   value="@Lane.Color"
                   @onchange="@(e => OnChange.InvokeAsync(("color", e.Value)))"
                   style="width: 60px; height: 40px; border: 1px solid #3a3a4e; border-radius: 4px; cursor: pointer; background: #2a2a3e; padding: 2px;" />
            <input type="text"
                   value="@Lane.Color"
                   @onchange="@(e => OnChange.InvokeAsync(("color", e.Value)))"
                   class="form-control"
                   placeholder="#45B69C"
                   pattern="^#[0-9A-Fa-f]{6}$" />
        </div>
    </div>

    <div class="form-group">
        <label style="margin-bottom: 8px;">Lane Height</label>

        @* Lane Height Buttons with inline editable value *@
        <div style="display: flex; align-items: center; gap: 4px; margin-bottom: 8px;">
            <button type="button"
                    @onclick="@(() => AdjustHeight(-0.5))"
                    title="Decrease height (-0.5)"
                    style="width: 44px; min-height: 32px; background: #252538; color: #ccc; border: 1px solid #3a3a4e; border-radius: 4px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; padding: 2px; flex-shrink: 0;">
                <div style="font-size: 14px; line-height: 1;">◀</div>
            </button>

            @* Editable Numeric Value *@
            <input type="number"
                   value="@(Lane.Height ?? 1.0)"
                   @onchange="@(e => OnChange.InvokeAsync(("height", double.Parse(e.Value?.ToString() ?? "1.0"))))"
                   style="flex: 1; min-width: 60px; text-align: center; background: #1a1a2e; border: 1px solid #667eea; border-radius: 4px; padding: 6px 4px; font-weight: 600; color: #667eea; font-size: 13px;"
                   step="0.25"
                   min="0.5"
                   max="3.0" />

            <button type="button"
                    @onclick="@(() => ResetHeightToDefault())"
                    title="Reset to default height (1.0)"
                    style="width: 44px; min-height: 32px; background: #252538; color: #ccc; border: 1px solid #3a3a4e; border-radius: 4px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; padding: 2px; flex-shrink: 0;">
                <div style="font-size: 16px; font-weight: 600;">↻</div>
            </button>

            <button type="button"
                    @onclick="@(() => AdjustHeight(0.5))"
                    title="Increase height (+0.5)"
                    style="width: 44px; min-height: 32px; background: #252538; color: #ccc; border: 1px solid #3a3a4e; border-radius: 4px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; padding: 2px; flex-shrink: 0;">
                <div style="font-size: 14px; line-height: 1;">▶</div>
            </button>
        </div>
        <div style="font-size: 11px; color: #888; text-align: center;">
            Range: 0.5x to 3.0x (1.0 = default)
        </div>
    </div>

    @if (Lane.History != null)
    {
        <div class="form-group">
            <label style="margin-bottom: 12px;">History Timeline</label>

            <div class="form-row">
                <div class="form-group" style="flex: 1;">
                    <label style="font-size: 11px;">Start Label</label>
                    <input type="text"
                           value="@Lane.History.Start"
                           @onchange="@(e => UpdateHistory("start", e.Value?.ToString()))"
                           class="form-control"
                           placeholder="e.g., 2024, Q1, Jan" />
                </div>

                <div class="form-group" style="flex: 1; margin-left: 12px;">
                    <label style="font-size: 11px;">End Label</label>
                    <input type="text"
                           value="@Lane.History.End"
                           @onchange="@(e => UpdateHistory("end", e.Value?.ToString()))"
                           class="form-control"
                           placeholder="e.g., 2026, Q4, Dec" />
                </div>
            </div>

            @* Full-width Icon Selectors Row *@
            <div style="margin-top: 12px; display: flex; gap: 8px;">
                <button type="button"
                        @onclick="ToggleStartIconPicker"
                        title="@(_startIconPickerExpanded ? "Hide start icon selector" : "Add icon to start label")"
                        style="flex: 1; min-height: 44px; background: @(_startIconPickerExpanded ? "#1a1a2e" : "#252538"); border: 1px solid @(_startIconPickerExpanded ? "#667eea" : "#3a3a4e"); border-radius: 4px; cursor: pointer; transition: all 0.2s; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 8px; gap: 4px;">
                    @if (!string.IsNullOrEmpty(Lane.History.StartIcon))
                    {
                        <Icon IconType="@Lane.History.StartIcon" Color="@Lane.Color" Size="20" DropShadow="true" />
                    }
                    else
                    {
                        <span style="font-size: 18px; opacity: 0.3;">✦</span>
                    }
                    <span style="font-size: 10px; color: #888;">Start Icon</span>
                </button>

                <button type="button"
                        @onclick="ToggleEndIconPicker"
                        title="@(_endIconPickerExpanded ? "Hide end icon selector" : "Add icon to end label")"
                        style="flex: 1; min-height: 44px; background: @(_endIconPickerExpanded ? "#1a1a2e" : "#252538"); border: 1px solid @(_endIconPickerExpanded ? "#667eea" : "#3a3a4e"); border-radius: 4px; cursor: pointer; transition: all 0.2s; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 8px; gap: 4px;">
                    @if (!string.IsNullOrEmpty(Lane.History.EndIcon))
                    {
                        <Icon IconType="@Lane.History.EndIcon" Color="@Lane.Color" Size="20" DropShadow="true" />
                    }
                    else
                    {
                        <span style="font-size: 18px; opacity: 0.3;">✦</span>
                    }
                    <span style="font-size: 10px; color: #888;">End Icon</span>
                </button>
            </div>

            @* Full-Width Icon Picker (shows only one at a time) *@
            @if (_startIconPickerExpanded)
            {
                <div style="background: #1a1a2e; padding: 12px; border-radius: 4px; border: 1px solid #667eea; margin-top: 8px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                        <span style="font-size: 11px; font-weight: 600; color: #667eea;">Start Icon</span>
                        @if (!string.IsNullOrEmpty(Lane.History.StartIcon))
                        {
                            <button type="button"
                                    @onclick="@(() => { UpdateHistory("startIcon", null!); _startIconPickerExpanded = false; })"
                                    title="Clear start icon"
                                    style="background: #3c3c3c; color: #ef4444; border: 1px solid #555; padding: 4px 8px; border-radius: 4px; font-size: 11px; cursor: pointer;">
                                Clear
                            </button>
                        }
                    </div>
                    <IconPicker SelectedIcon="@(Lane.History.StartIcon ?? "")"
                               Color="@Lane.Color"
                               OnIconSelected="@(icon => { UpdateHistory("startIcon", icon); _startIconPickerExpanded = false; })"
                               ShowCategories="false"
                               ColumnsPerRow="6" />
                </div>
            }
            else if (_endIconPickerExpanded)
            {
                <div style="background: #1a1a2e; padding: 12px; border-radius: 4px; border: 1px solid #667eea; margin-top: 8px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                        <span style="font-size: 11px; font-weight: 600; color: #667eea;">End Icon</span>
                        @if (!string.IsNullOrEmpty(Lane.History.EndIcon))
                        {
                            <button type="button"
                                    @onclick="@(() => { UpdateHistory("endIcon", null!); _endIconPickerExpanded = false; })"
                                    title="Clear end icon"
                                    style="background: #3c3c3c; color: #ef4444; border: 1px solid #555; padding: 4px 8px; border-radius: 4px; font-size: 11px; cursor: pointer;">
                                Clear
                            </button>
                        }
                    </div>
                    <IconPicker SelectedIcon="@(Lane.History.EndIcon ?? "")"
                               Color="@Lane.Color"
                               OnIconSelected="@(icon => { UpdateHistory("endIcon", icon); _endIconPickerExpanded = false; })"
                               ShowCategories="false"
                               ColumnsPerRow="6" />
                </div>
            }

            <div class="form-group" style="margin-top: 8px;">
                <label style="font-size: 11px; margin-bottom: 8px;">Progress Origin</label>
                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 8px;">
                    <button type="button"
                            @onclick="@(() => UpdateHistory("progressOrigin", "left"))"
                            title="Start from Left"
                            style="@GetOriginButtonStyle("left")">
                        <div style="font-size: 10px; font-weight: 600; margin-bottom: 2px;">Left</div>
                        <div style="font-size: 18px;">◀━</div>
                    </button>
                    <button type="button"
                            @onclick="@(() => UpdateHistory("progressOrigin", "middle"))"
                            title="Start from Center"
                            style="@GetOriginButtonStyle("middle")">
                        <div style="font-size: 10px; font-weight: 600; margin-bottom: 2px;">Center</div>
                        <div style="font-size: 18px;">━●━</div>
                    </button>
                    <button type="button"
                            @onclick="@(() => UpdateHistory("progressOrigin", "right"))"
                            title="Start from Right"
                            style="@GetOriginButtonStyle("right")">
                        <div style="font-size: 10px; font-weight: 600; margin-bottom: 2px;">Right</div>
                        <div style="font-size: 18px;">━▶</div>
                    </button>
                </div>
                <div style="font-size: 11px; color: #888;">
                    Where the progress percentage begins from
                </div>
            </div>

            <div class="form-group" style="margin-top: 8px;">
                <label style="font-size: 11px;">Past Percentage</label>
                <input type="range"
                       value="@Lane.History.Percent"
                       @onchange="@(e => UpdateHistory("pastPct", int.Parse(e.Value?.ToString() ?? "50")))"
                       min="0"
                       max="100"
                       step="1"
                       class="form-range" />
                <div style="display: flex; justify-content: space-between; font-size: 11px; color: #888; margin-top: 4px;">
                    <span>0%</span>
                    <span style="font-weight: 600; color: #667eea;">@Lane.History.Percent%</span>
                    <span>100%</span>
                </div>
            </div>

            <button @onclick="RemoveHistory" class="btn-danger" type="button" style="margin-top: 12px;">
                Remove History
            </button>
        </div>
    }
    else
    {
        <div class="form-group">
            <button @onclick="AddHistory" class="btn-add" type="button">
                + Add History Timeline
            </button>
        </div>
    }

    @* Lane Management Section *@
    <div class="form-group" style="margin-top: 24px; padding-top: 16px; border-top: 1px solid #3a3a4e;">
        <label style="margin-bottom: 12px; font-weight: 600; color: #e0e7ff;">Lane Management</label>

        @* Inline Lane Controls: UP | ADD | DUPE | DOWN | TRASH *@
        <div style="display: flex; gap: 6px; margin-bottom: 12px;">
            <button @onclick="MoveLaneUp"
                    type="button"
                    title="Move lane up"
                    style="width: 44px; height: 44px; background: #3c3c3c; color: #ccc; border: 1px solid #555; border-radius: 6px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0;">
                ↑
            </button>

            <button @onclick="AddLane"
                    type="button"
                    title="Add new lane"
                    style="flex: 1; height: 44px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: #fff; border: none; border-radius: 6px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 13px; font-weight: 600; box-shadow: 0 2px 6px rgba(16, 185, 129, 0.3);">
                <span style="font-size: 18px;">+</span> Lane
            </button>

            <button @onclick="DuplicateLane"
                    type="button"
                    title="Duplicate this lane"
                    style="width: 44px; height: 44px; background: #667eea; color: #fff; border: none; border-radius: 6px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0; box-shadow: 0 2px 6px rgba(102, 126, 234, 0.3);">
                ♻️
            </button>

            <button @onclick="MoveLaneDown"
                    type="button"
                    title="Move lane down"
                    style="width: 44px; height: 44px; background: #3c3c3c; color: #ccc; border: 1px solid #555; border-radius: 6px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0;">
                ↓
            </button>

            <button @onclick="RemoveLane"
                    type="button"
                    title="Remove this lane"
                    style="width: 44px; height: 44px; background: linear-gradient(135deg, rgba(239, 68, 68, 0.2) 0%, rgba(220, 38, 38, 0.1) 100%); color: #ef4444; border: 2px solid #ef4444; border-radius: 6px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0;">
                🗑️
            </button>
        </div>

        @* Styled Add Item Button *@
        <button @onclick="AddItem"
                type="button"
                title="Add new item to this lane"
                style="width: 100%; height: 48px; background: linear-gradient(135deg, rgba(69, 182, 156, 0.2) 0%, rgba(69, 182, 156, 0.1) 100%); color: #45B69C; border: 1px solid rgba(69, 182, 156, 0.4); border-radius: 6px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 14px; font-weight: 600; box-shadow: 0 2px 4px rgba(69, 182, 156, 0.2);">
            <span style="font-size: 20px;">+</span> Add Item to This Lane
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Lane Lane { get; set; } = null!;

    [Parameter, EditorRequired]
    public string JsonPath { get; set; } = "";

    [Parameter]
    public EventCallback<(string PropertyName, object Value)> OnChange { get; set; }

    [Parameter]
    public EventCallback<string> OnAdd { get; set; }

    [Parameter]
    public EventCallback<string> OnRemove { get; set; }

    [Parameter]
    public EventCallback<string> OnDuplicate { get; set; }

    private bool _laneIconPickerExpanded = false;
    private bool _startIconPickerExpanded = false;
    private bool _endIconPickerExpanded = false;

    private void ToggleLaneIconPicker()
    {
        _laneIconPickerExpanded = !_laneIconPickerExpanded;
    }

    private void ToggleStartIconPicker()
    {
        _startIconPickerExpanded = !_startIconPickerExpanded;
        if (_startIconPickerExpanded)
        {
            _endIconPickerExpanded = false; // Hide end picker when showing start
        }
    }

    private void ToggleEndIconPicker()
    {
        _endIconPickerExpanded = !_endIconPickerExpanded;
        if (_endIconPickerExpanded)
        {
            _startIconPickerExpanded = false; // Hide start picker when showing end
        }
    }

    private async Task HandleLaneIconSelectedAndCollapse(string iconValue)
    {
        Lane.Icon = iconValue;
        await OnChange.InvokeAsync(("icon", iconValue));
        _laneIconPickerExpanded = false;
        StateHasChanged();
    }

    private async Task ClearLaneIcon()
    {
        Lane.Icon = null;
        await OnChange.InvokeAsync(("icon", null!));
        StateHasChanged();
    }

    private record ColorPreset(string Name, string Value);

    private readonly List<ColorPreset> _colorPresets = new()
    {
        new ColorPreset("Teal", "#45B69C"),
        new ColorPreset("Coral", "#F88379"),
        new ColorPreset("Lav", "#9999ff"),
        new ColorPreset("Orange", "#D4652F"),
        new ColorPreset("Blue", "#87CEEB"),
        new ColorPreset("Mustard", "#E6B800"),
        new ColorPreset("Brown", "#4A2C1A"),
        new ColorPreset("Sage", "#B7C4B7"),
        new ColorPreset("Red", "#EF4444"),
        new ColorPreset("Indigo", "#6366F1"),
        new ColorPreset("Dark Blue", "#1E3A8A"),
        new ColorPreset("Pink", "#EC4899")
    };

    private string GetPresetColorButtonStyle(string presetColor, string currentColor)
    {
        var isSelected = presetColor.Equals(currentColor, StringComparison.OrdinalIgnoreCase);
        var border = isSelected
            ? "border: 2px solid #667eea; box-shadow: 0 0 0 2px rgba(102, 126, 234, 0.3);"
            : "border: 1.5px solid rgba(255, 255, 255, 0.2);";

        return $"width: 100%; height: 32px; padding: 2px; cursor: pointer; border-radius: 4px; " +
               $"background: #1a1a2e; transition: all 0.2s; {border}";
    }

    private string GetOriginButtonStyle(string origin)
    {
        var currentOrigin = Lane.History?.Origin ?? "left";
        var isSelected = origin.Equals(currentOrigin, StringComparison.OrdinalIgnoreCase);

        var background = isSelected
            ? "background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff;"
            : "background: #252538; color: #888;";

        var border = isSelected
            ? "border: 1px solid #667eea;"
            : "border: 1px solid #3a3a4e;";

        return $"width: 100%; min-height: 60px; padding: 8px; cursor: pointer; border-radius: 4px; " +
               $"transition: all 0.2s; display: flex; flex-direction: column; align-items: center; " +
               $"justify-content: center; {background} {border}";
    }

    private void UpdateHistory(string propertyName, object? value)
    {
        if (Lane.History != null)
        {
            switch (propertyName.ToLower())
            {
                case "start":
                    Lane.History.Start = value?.ToString();
                    break;
                case "starticon":
                    Lane.History.StartIcon = value?.ToString();
                    break;
                case "end":
                    Lane.History.End = value?.ToString();
                    break;
                case "endicon":
                    Lane.History.EndIcon = value?.ToString();
                    break;
                case "progressorigin":
                    Lane.History.Origin = value?.ToString() ?? "left";
                    break;
                case "pastpct":
                    Lane.History.Percent = (int)value!;
                    break;
            }
            OnChange.InvokeAsync(("history", Lane.History));
        }
    }

    private void AddHistory()
    {
        Lane.History = new History
        {
            Start = "2025",
            End = "2026",
            Percent = 80,
            Origin = "left"
        };
        OnChange.InvokeAsync(("history", Lane.History));
    }

    private void RemoveHistory()
    {
        Lane.History = null;
        OnChange.InvokeAsync(("history", null!));
    }

    private void AddItem()
    {
        OnAdd.InvokeAsync("item");
    }

    private void AddLane()
    {
        OnAdd.InvokeAsync("lane");
    }

    private void DuplicateLane()
    {
        OnDuplicate.InvokeAsync("lane");
    }

    private void RemoveLane()
    {
        OnRemove.InvokeAsync("lane");
    }

    private void MoveLaneUp()
    {
        OnAdd.InvokeAsync("moveLaneUp");
    }

    private void MoveLaneDown()
    {
        OnAdd.InvokeAsync("moveLaneDown");
    }

    // Lane Height Button Methods
    private void AdjustHeight(double delta)
    {
        var currentHeight = Lane.Height ?? 1.0;
        var newHeight = currentHeight + delta;
        // Clamp to valid range (0.5 to 3.0)
        newHeight = Math.Max(0.5, Math.Min(newHeight, 3.0));
        // Round to 2 decimal places
        newHeight = Math.Round(newHeight, 2);
        OnChange.InvokeAsync(("height", newHeight));
    }

    private void ResetHeightToDefault()
    {
        // Reset height to default value of 1.0
        OnChange.InvokeAsync(("height", 1.0));
    }
}
