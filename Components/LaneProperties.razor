@using RoadScript.Models

<div class="property-editor">
    <div class="form-group">
        <label>Lane Title</label>
        <input type="text"
               value="@Lane.Title"
               @onchange="@(e => OnChange.InvokeAsync(("title", e.Value)))"
               class="form-control"
               placeholder="Team Name" />
        <div style="font-size: 11px; color: #888; margin-top: 4px;">
            Use "&amp;" to add line breaks in the title
        </div>
    </div>

    <div class="form-group">
        <label style="margin-bottom: 8px;">Color</label>

        @* Preset Color Options *@
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin-bottom: 10px;">
            @foreach (var preset in _colorPresets)
            {
                <button type="button"
                        @onclick="@(() => OnChange.InvokeAsync(("color", preset.Value)))"
                        title="@preset.Name"
                        style="@GetPresetColorButtonStyle(preset.Value, Lane.Color)">
                    <span style="width: 100%; height: 100%; display: block; border-radius: 3px; background: @preset.Value;"></span>
                </button>
            }
        </div>

        <div style="display: flex; align-items: center; gap: 8px;">
            <input type="color"
                   value="@Lane.Color"
                   @onchange="@(e => OnChange.InvokeAsync(("color", e.Value)))"
                   style="width: 60px; height: 40px; border: 1px solid #3a3a4e; border-radius: 4px; cursor: pointer; background: #2a2a3e; padding: 2px;" />
            <input type="text"
                   value="@Lane.Color"
                   @onchange="@(e => OnChange.InvokeAsync(("color", e.Value)))"
                   class="form-control"
                   placeholder="#45B69C"
                   pattern="^#[0-9A-Fa-f]{6}$" />
        </div>
    </div>

    <div class="form-group">
        <label>Lane Height</label>
        <input type="range"
               value="@(Lane.Height ?? 1.0)"
               @onchange="@(e => OnChange.InvokeAsync(("height", double.Parse(e.Value?.ToString() ?? "1.0"))))"
               min="0.5"
               max="3.0"
               step="0.25"
               class="form-range" />
        <div style="display: flex; justify-content: space-between; font-size: 11px; color: #888; margin-top: 4px;">
            <span>0.5x</span>
            <span style="font-weight: 600; color: #667eea;">@((Lane.Height ?? 1.0).ToString("F2"))x</span>
            <span>3.0x</span>
        </div>
        <div style="font-size: 11px; color: #888; margin-top: 4px;">
            Adjust the vertical height of this lane (1.0 = default)
        </div>
    </div>

    @if (Lane.History != null)
    {
        <div class="form-group">
            <label style="margin-bottom: 12px;">History Timeline</label>

            <div class="form-row">
                <div class="form-group" style="flex: 1;">
                    <label style="font-size: 11px;">Start Year</label>
                    <input type="number"
                           value="@Lane.History.StartYear"
                           @onchange="@(e => UpdateHistory("startYear", int.Parse(e.Value?.ToString() ?? "2020")))"
                           class="form-control"
                           min="2000"
                           max="2100" />
                </div>

                <div class="form-group" style="flex: 1; margin-left: 12px;">
                    <label style="font-size: 11px;">End Year</label>
                    <input type="number"
                           value="@Lane.History.EndYear"
                           @onchange="@(e => UpdateHistory("endYear", int.Parse(e.Value?.ToString() ?? "2026")))"
                           class="form-control"
                           min="2000"
                           max="2100" />
                </div>
            </div>

            <div class="form-group" style="margin-top: 8px;">
                <label style="font-size: 11px;">Past Percentage</label>
                <input type="range"
                       value="@Lane.History.PastPct"
                       @onchange="@(e => UpdateHistory("pastPct", int.Parse(e.Value?.ToString() ?? "50")))"
                       min="0"
                       max="100"
                       step="1"
                       class="form-range" />
                <div style="display: flex; justify-content: space-between; font-size: 11px; color: #888; margin-top: 4px;">
                    <span>0%</span>
                    <span style="font-weight: 600; color: #667eea;">@Lane.History.PastPct%</span>
                    <span>100%</span>
                </div>
            </div>

            <button @onclick="RemoveHistory" class="btn-danger" type="button" style="margin-top: 12px;">
                Remove History
            </button>
        </div>
    }
    else
    {
        <div class="form-group">
            <button @onclick="AddHistory" class="btn-add" type="button">
                + Add History Timeline
            </button>
        </div>
    }

    @* Lane Management Section *@
    <div class="form-group" style="margin-top: 24px; padding-top: 16px; border-top: 1px solid #3a3a4e;">
        <label style="margin-bottom: 12px; font-weight: 600; color: #e0e7ff;">Lane Management</label>

        @* Lane Reordering *@
        <div style="display: flex; gap: 8px; margin-bottom: 12px;">
            <button @onclick="MoveLaneUp" type="button" style="flex: 1; background: #3c3c3c; color: #ccc; border: 1px solid #555; padding: 8px 16px; border-radius: 4px; font-size: 13px; font-weight: 500; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 6px;">
                <span style="font-size: 16px;">↑</span> Move Up
            </button>
            <button @onclick="MoveLaneDown" type="button" style="flex: 1; background: #3c3c3c; color: #ccc; border: 1px solid #555; padding: 8px 16px; border-radius: 4px; font-size: 13px; font-weight: 500; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 6px;">
                <span style="font-size: 16px;">↓</span> Move Down
            </button>
        </div>

        <button @onclick="AddItem" class="btn-add" type="button" style="width: 100%; margin-bottom: 8px;">
            + Add Item to This Lane
        </button>

        <button @onclick="AddLane" class="btn-add" type="button" style="width: 100%; margin-bottom: 8px;">
            + Add New Lane
        </button>

        <button @onclick="DuplicateLane" type="button" style="width: 100%; margin-bottom: 8px; background: #667eea; color: #fff; border: none; padding: 8px 16px; border-radius: 4px; font-size: 13px; font-weight: 500; cursor: pointer; transition: all 0.2s;">
            📋 Duplicate This Lane
        </button>

        <button @onclick="RemoveLane" class="btn-danger" type="button" style="width: 100%;">
            Remove This Lane
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Lane Lane { get; set; } = null!;

    [Parameter, EditorRequired]
    public string JsonPath { get; set; } = "";

    [Parameter]
    public EventCallback<(string PropertyName, object Value)> OnChange { get; set; }

    [Parameter]
    public EventCallback<string> OnAdd { get; set; }

    [Parameter]
    public EventCallback<string> OnRemove { get; set; }

    [Parameter]
    public EventCallback<string> OnDuplicate { get; set; }

    private record ColorPreset(string Name, string Value);

    private readonly List<ColorPreset> _colorPresets = new()
    {
        new ColorPreset("Teal", "#45B69C"),
        new ColorPreset("Coral", "#F88379"),
        new ColorPreset("Lav", "#9999ff"),
        new ColorPreset("Orange", "#D4652F"),
        new ColorPreset("Blue", "#87CEEB"),
        new ColorPreset("Mustard", "#E6B800"),
        new ColorPreset("Brown", "#4A2C1A"),
        new ColorPreset("Sage", "#B7C4B7")
    };

    private string GetPresetColorButtonStyle(string presetColor, string currentColor)
    {
        var isSelected = presetColor.Equals(currentColor, StringComparison.OrdinalIgnoreCase);
        var border = isSelected
            ? "border: 2px solid #667eea; box-shadow: 0 0 0 2px rgba(102, 126, 234, 0.3);"
            : "border: 1.5px solid rgba(255, 255, 255, 0.2);";

        return $"width: 100%; height: 32px; padding: 2px; cursor: pointer; border-radius: 4px; " +
               $"background: #1a1a2e; transition: all 0.2s; {border}";
    }

    private void UpdateHistory(string propertyName, object value)
    {
        if (Lane.History != null)
        {
            switch (propertyName.ToLower())
            {
                case "startyear":
                    Lane.History.StartYear = (int)value;
                    break;
                case "endyear":
                    Lane.History.EndYear = (int)value;
                    break;
                case "pastpct":
                    Lane.History.PastPct = (int)value;
                    break;
            }
            OnChange.InvokeAsync(("history", Lane.History));
        }
    }

    private void AddHistory()
    {
        Lane.History = new History
        {
            StartYear = 2020,
            EndYear = 2026,
            PastPct = 80
        };
        OnChange.InvokeAsync(("history", Lane.History));
    }

    private void RemoveHistory()
    {
        Lane.History = null;
        OnChange.InvokeAsync(("history", null!));
    }

    private void AddItem()
    {
        OnAdd.InvokeAsync("item");
    }

    private void AddLane()
    {
        OnAdd.InvokeAsync("lane");
    }

    private void DuplicateLane()
    {
        OnDuplicate.InvokeAsync("lane");
    }

    private void RemoveLane()
    {
        OnRemove.InvokeAsync("lane");
    }

    private void MoveLaneUp()
    {
        OnAdd.InvokeAsync("moveLaneUp");
    }

    private void MoveLaneDown()
    {
        OnAdd.InvokeAsync("moveLaneDown");
    }
}
