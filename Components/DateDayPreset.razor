@using Microsoft.JSInterop

@* This component renders an expandable dropdown with day presets and date picker *@
@if (IsExpanded)
{
    <div style="position: absolute; top: 100%; left: 0; right: 0; margin-top: 4px; z-index: 1000; background: #1e1e2e; border: 2px solid #667eea; border-radius: 8px; padding: 10px; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6); max-height: 480px; overflow-y: auto;">

        @* Target Field Toggle - NEW *@
        <div style="margin-bottom: 10px; padding-bottom: 8px; border-bottom: 1px solid #3a3a4e;">
            <div style="font-size: 9px; color: #888; margin-bottom: 6px; text-transform: uppercase; font-weight: 600;">Apply To</div>
            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px;">
                <button type="button"
                        @onclick="@(() => SetTargetField("label"))"
                        @onclick:stopPropagation="true"
                        style="@GetTargetButtonStyle("label")">
                    <div style="font-size: 10px; font-weight: 700;">Label</div>
                </button>
                <button type="button"
                        @onclick="@(() => SetTargetField("sub"))"
                        @onclick:stopPropagation="true"
                        style="@GetTargetButtonStyle("sub")">
                    <div style="font-size: 10px; font-weight: 700;">Sublabel</div>
                </button>
                <button type="button"
                        @onclick="@(() => SetTargetField("both"))"
                        @onclick:stopPropagation="true"
                        style="@GetTargetButtonStyle("both")">
                    <div style="font-size: 10px; font-weight: 700;">Both</div>
                </button>
            </div>
        </div>

        @* Day Presets - Abbreviated and Full *@
        <div style="margin-bottom: 8px;">
            <div style="font-size: 9px; color: #888; margin-bottom: 4px; text-transform: uppercase; font-weight: 600;">Days (Abbreviated)</div>
            <div style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; margin-bottom: 4px;">
                @foreach (var day in _dayPresets)
                {
                    <button type="button"
                            @onclick="@(() => HandlePresetSelect(day.Abbr))"
                            @onclick:stopPropagation="true"
                            title="@day.Abbr"
                            style="@GetPresetButtonStyle(day.Abbr)">
                        <div style="font-size: 10px; font-weight: 700;">@day.Abbr</div>
                    </button>
                }
            </div>

            <div style="font-size: 9px; color: #888; margin-bottom: 4px; text-transform: uppercase; font-weight: 600;">Days (Full)</div>
            <div style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px;">
                @foreach (var day in _dayPresets)
                {
                    <button type="button"
                            @onclick="@(() => HandlePresetSelect(day.Full))"
                            @onclick:stopPropagation="true"
                            title="@day.Full"
                            style="@GetPresetButtonStyle(day.Full, true)">
                        <div style="font-size: 9px; font-weight: 600;">@day.Full</div>
                    </button>
                }
            </div>
        </div>

        @* Month Presets - Abbreviated and Full *@
        <div style="margin-bottom: 8px; padding-top: 8px; border-top: 1px solid #3a3a4e;">
            <div style="font-size: 9px; color: #888; margin-bottom: 4px; text-transform: uppercase; font-weight: 600;">Months (Abbreviated)</div>
            <div style="display: grid; grid-template-columns: repeat(6, 1fr); gap: 4px; margin-bottom: 4px;">
                @foreach (var month in _monthPresets)
                {
                    <button type="button"
                            @onclick="@(() => HandlePresetSelect(month.Abbr))"
                            @onclick:stopPropagation="true"
                            title="@month.Abbr"
                            style="@GetPresetButtonStyle(month.Abbr)">
                        <div style="font-size: 10px; font-weight: 700;">@month.Abbr</div>
                    </button>
                }
            </div>

            <div style="font-size: 9px; color: #888; margin-bottom: 4px; text-transform: uppercase; font-weight: 600;">Months (Full)</div>
            <div style="display: grid; grid-template-columns: repeat(6, 1fr); gap: 4px;">
                @foreach (var month in _monthPresets)
                {
                    <button type="button"
                            @onclick="@(() => HandlePresetSelect(month.Full))"
                            @onclick:stopPropagation="true"
                            title="@month.Full"
                            style="@GetPresetButtonStyle(month.Full, true)">
                        <div style="font-size: 9px; font-weight: 600;">@month.Full</div>
                    </button>
                }
            </div>
        </div>

        @* Quarters - NEW *@
        <div style="margin-bottom: 8px; padding-top: 8px; border-top: 1px solid #3a3a4e;">
            <div style="font-size: 9px; color: #888; margin-bottom: 4px; text-transform: uppercase; font-weight: 600;">Quarters</div>
            <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px;">
                @foreach (var quarter in _quarterPresets)
                {
                    <button type="button"
                            @onclick="@(() => HandlePresetSelect(quarter))"
                            @onclick:stopPropagation="true"
                            title="@quarter"
                            style="@GetPresetButtonStyle(quarter)">
                        <div style="font-size: 10px; font-weight: 700;">@quarter</div>
                    </button>
                }
            </div>
        </div>

        @* Years - NEW *@
        <div style="margin-bottom: 8px; padding-top: 8px; border-top: 1px solid #3a3a4e;">
            <div style="font-size: 9px; color: #888; margin-bottom: 4px; text-transform: uppercase; font-weight: 600;">Years</div>
            <div style="display: grid; grid-template-columns: repeat(5, 1fr); gap: 4px;">
                @foreach (var year in _yearPresets)
                {
                    <button type="button"
                            @onclick="@(() => HandlePresetSelect(year))"
                            @onclick:stopPropagation="true"
                            title="@year"
                            style="@GetPresetButtonStyle(year)">
                        <div style="font-size: 10px; font-weight: 700;">@year</div>
                    </button>
                }
            </div>
        </div>

        @* Hourly Presets *@
        <div style="margin-bottom: 8px; padding-top: 8px; border-top: 1px solid #3a3a4e;">
            <div style="font-size: 9px; color: #888; margin-bottom: 4px; text-transform: uppercase; font-weight: 600;">Hours</div>
            <div style="display: grid; grid-template-columns: repeat(6, 1fr); gap: 4px;">
                @foreach (var hour in _hourPresets)
                {
                    <button type="button"
                            @onclick="@(() => HandlePresetSelect(hour))"
                            @onclick:stopPropagation="true"
                            title="@hour"
                            style="@GetPresetButtonStyle(hour)">
                        <div style="font-size: 10px; font-weight: 600;">@hour</div>
                    </button>
                }
            </div>
        </div>

        @* Bottom Row: Today + Date Picker *@
        <div style="display: flex; gap: 8px; padding-top: 8px; border-top: 1px solid #3a3a4e;">
            @* Today Button *@
            <button type="button"
                    @onclick="HandleTodaySelect"
                    @onclick:stopPropagation="true"
                    title="Insert today's date"
                    style="flex: 1; height: 40px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: #fff; border: none; border-radius: 6px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 13px; font-weight: 600; box-shadow: 0 2px 6px rgba(16, 185, 129, 0.4);">
                <Icon IconType="calendar" Color="#fff" Size="16" />
                <span>Today</span>
            </button>

            @* Date Picker *@
            <input type="date"
                   @onchange="@HandleDateSelect"
                   @onclick:stopPropagation="true"
                   class="form-control"
                   style="flex: 1; height: 40px; font-size: 13px; background: #252538; border: 1px solid #667eea; color: #ffffff; color-scheme: dark;" />
        </div>
    </div>
}

@code {
    [Parameter]
    public string CurrentValue { get; set; } = "";

    [Parameter]
    public bool IsExpanded { get; set; } = false;

    [Parameter]
    public EventCallback<string> OnValueChange { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public string FieldType { get; set; } = "label"; // "label", "sub", or "both"

    private string _targetField = "label"; // Internal state for target field

    private record Preset(string Abbr, string Full);

    private readonly List<Preset> _dayPresets = new()
    {
        new Preset("Mon", "Monday"),
        new Preset("Tue", "Tuesday"),
        new Preset("Wed", "Wednesday"),
        new Preset("Thu", "Thursday"),
        new Preset("Fri", "Friday"),
        new Preset("Sat", "Saturday"),
        new Preset("Sun", "Sunday")
    };

    private readonly List<Preset> _monthPresets = new()
    {
        new Preset("Jan", "January"),
        new Preset("Feb", "February"),
        new Preset("Mar", "March"),
        new Preset("Apr", "April"),
        new Preset("May", "May"),
        new Preset("Jun", "June"),
        new Preset("Jul", "July"),
        new Preset("Aug", "August"),
        new Preset("Sep", "September"),
        new Preset("Oct", "October"),
        new Preset("Nov", "November"),
        new Preset("Dec", "December")
    };

    private readonly List<string> _quarterPresets = new()
    {
        "Q1", "Q2", "Q3", "Q4"
    };

    private readonly List<string> _yearPresets = new()
    {
        "2024", "2025", "2026", "2027", "2028"
    };

    private readonly List<string> _hourPresets = new()
    {
        "12AM", "1AM", "2AM", "3AM", "4AM", "5AM",
        "6AM", "7AM", "8AM", "9AM", "10AM", "11AM",
        "12PM", "1PM", "2PM", "3PM", "4PM", "5PM",
        "6PM", "7PM", "8PM", "9PM", "10PM", "11PM"
    };

    protected override void OnParametersSet()
    {
        _targetField = FieldType;
    }

    private void SetTargetField(string field)
    {
        _targetField = field;
        StateHasChanged();
    }

    private async Task HandlePresetSelect(string value)
    {
        await OnValueChange.InvokeAsync(value);
        await OnClose.InvokeAsync();
    }

    private async Task HandleTodaySelect()
    {
        var today = DateTime.Now.ToString("MM/dd/yyyy");
        await OnValueChange.InvokeAsync(today);
        await OnClose.InvokeAsync();
    }

    private async Task HandleDateSelect(ChangeEventArgs e)
    {
        var dateValue = e.Value?.ToString();
        if (!string.IsNullOrEmpty(dateValue) && DateTime.TryParse(dateValue, out var date))
        {
            var formattedDate = date.ToString("MM/dd/yyyy");
            await OnValueChange.InvokeAsync(formattedDate);
            await OnClose.InvokeAsync();
        }
    }

    private string GetTargetButtonStyle(string target)
    {
        var isActive = _targetField == target;
        var bg = isActive
            ? "background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);"
            : "background: #252538;";

        var border = isActive
            ? "border: 2px solid #667eea; box-shadow: 0 0 8px rgba(102, 126, 234, 0.5);"
            : "border: 1px solid #3a3a4e;";

        var color = isActive ? "#fff" : "#ccc";

        return $"width: 100%; height: 28px; {bg} color: {color}; {border} " +
               "border-radius: 4px; cursor: pointer; transition: all 0.2s; " +
               "display: flex; align-items: center; justify-content: center;";
    }

    private string GetPresetButtonStyle(string text, bool isFullName = false)
    {
        // Check if this preset matches the current value
        var isActive = CurrentValue?.Equals(text, StringComparison.OrdinalIgnoreCase) == true;

        var bg = isActive
            ? "background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);"
            : "background: #252538;";

        var border = isActive
            ? "border: 2px solid #667eea; box-shadow: 0 0 8px rgba(102, 126, 234, 0.5);"
            : "border: 1px solid #3a3a4e;";

        var color = isActive ? "#fff" : "#ccc";
        var height = isFullName ? "26px" : "28px";

        return $"width: 100%; height: {height}; {bg} color: {color}; {border} " +
               "border-radius: 4px; cursor: pointer; transition: all 0.2s; " +
               "display: flex; align-items: center; justify-content: center; " +
               "font-weight: 600;";
    }
}
