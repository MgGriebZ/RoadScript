@using Microsoft.JSInterop

@* This component renders an expandable dropdown with day presets and date picker *@
@if (IsExpanded)
{
    <div style="position: absolute; top: 100%; left: 0; right: 0; margin-top: 4px; z-index: 1000; background: #1e1e2e; border: 2px solid #667eea; border-radius: 8px; padding: 12px; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);">

        @* Days Section *@
        <div style="margin-bottom: 10px;">
            <button type="button"
                    @onclick="@(() => _daysExpanded = !_daysExpanded)"
                    @onclick:stopPropagation="true"
                    style="width: 100%; padding: 8px; background: rgba(102, 126, 234, 0.1); border: 1px solid rgba(102, 126, 234, 0.3); border-radius: 4px; color: #c7d2fe; cursor: pointer; display: flex; justify-content: space-between; align-items: center; transition: all 0.2s;">
                <span style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Days of Week</span>
                <span style="font-size: 10px; transition: transform 0.2s; transform: rotate(@(_daysExpanded ? "180deg" : "0deg"));">▼</span>
            </button>

            @if (_daysExpanded)
            {
                <div style="margin-top: 8px;">
                    <div style="font-size: 9px; color: #888; margin-bottom: 4px; font-weight: 600;">Abbreviated</div>
                    <div style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; margin-bottom: 6px;">
                        @foreach (var day in _dayPresets)
                        {
                            <button type="button"
                                    @onclick="@(() => HandlePresetSelect(day.Abbr))"
                                    @onclick:stopPropagation="true"
                                    title="@day.Abbr"
                                    style="@GetPresetButtonStyle(day.Abbr)">
                                <div style="font-size: 10px; font-weight: 700;">@day.Abbr</div>
                            </button>
                        }
                    </div>

                    <div style="font-size: 9px; color: #888; margin-bottom: 4px; font-weight: 600;">Full Name</div>
                    <div style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px;">
                        @foreach (var day in _dayPresets)
                        {
                            <button type="button"
                                    @onclick="@(() => HandlePresetSelect(day.Full))"
                                    @onclick:stopPropagation="true"
                                    title="@day.Full"
                                    style="@GetPresetButtonStyle(day.Full)">
                                <div style="font-size: 9px; font-weight: 600;">@day.Full</div>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>

        @* Months Section *@
        <div style="margin-bottom: 10px;">
            <button type="button"
                    @onclick="@(() => _monthsExpanded = !_monthsExpanded)"
                    @onclick:stopPropagation="true"
                    style="width: 100%; padding: 8px; background: rgba(102, 126, 234, 0.1); border: 1px solid rgba(102, 126, 234, 0.3); border-radius: 4px; color: #c7d2fe; cursor: pointer; display: flex; justify-content: space-between; align-items: center; transition: all 0.2s;">
                <span style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Months</span>
                <span style="font-size: 10px; transition: transform 0.2s; transform: rotate(@(_monthsExpanded ? "180deg" : "0deg"));">▼</span>
            </button>

            @if (_monthsExpanded)
            {
                <div style="margin-top: 8px;">
                    <div style="font-size: 9px; color: #888; margin-bottom: 4px; font-weight: 600;">Abbreviated</div>
                    <div style="display: grid; grid-template-columns: repeat(6, 1fr); gap: 4px; margin-bottom: 6px;">
                        @foreach (var month in _monthPresets)
                        {
                            <button type="button"
                                    @onclick="@(() => HandlePresetSelect(month.Abbr))"
                                    @onclick:stopPropagation="true"
                                    title="@month.Abbr"
                                    style="@GetPresetButtonStyle(month.Abbr)">
                                <div style="font-size: 10px; font-weight: 700;">@month.Abbr</div>
                            </button>
                        }
                    </div>

                    <div style="font-size: 9px; color: #888; margin-bottom: 4px; font-weight: 600;">Full Name</div>
                    <div style="display: grid; grid-template-columns: repeat(6, 1fr); gap: 4px;">
                        @foreach (var month in _monthPresets)
                        {
                            <button type="button"
                                    @onclick="@(() => HandlePresetSelect(month.Full))"
                                    @onclick:stopPropagation="true"
                                    title="@month.Full"
                                    style="@GetPresetButtonStyle(month.Full)">
                                <div style="font-size: 9px; font-weight: 600;">@month.Full</div>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>

        @* Additional Options *@
        <div style="margin-bottom: 10px;">
            <button type="button"
                    @onclick="@(() => _moreExpanded = !_moreExpanded)"
                    @onclick:stopPropagation="true"
                    style="width: 100%; padding: 8px; background: rgba(102, 126, 234, 0.1); border: 1px solid rgba(102, 126, 234, 0.3); border-radius: 4px; color: #c7d2fe; cursor: pointer; display: flex; justify-content: space-between; align-items: center; transition: all 0.2s;">
                <span style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">More Options</span>
                <span style="font-size: 10px; transition: transform 0.2s; transform: rotate(@(_moreExpanded ? "180deg" : "0deg"));">▼</span>
            </button>

            @if (_moreExpanded)
            {
                <div style="margin-top: 8px;">
                    <div style="font-size: 9px; color: #888; margin-bottom: 4px; font-weight: 600;">Quarters</div>
                    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; margin-bottom: 8px;">
                        @foreach (var quarter in _quarterPresets)
                        {
                            <button type="button"
                                    @onclick="@(() => HandlePresetSelect(quarter))"
                                    @onclick:stopPropagation="true"
                                    title="@quarter"
                                    style="@GetPresetButtonStyle(quarter)">
                                <div style="font-size: 10px; font-weight: 700;">@quarter</div>
                            </button>
                        }
                    </div>

                    <div style="font-size: 9px; color: #888; margin-bottom: 4px; font-weight: 600;">Years</div>
                    <div style="display: grid; grid-template-columns: repeat(5, 1fr); gap: 4px; margin-bottom: 8px;">
                        @foreach (var year in _yearPresets)
                        {
                            <button type="button"
                                    @onclick="@(() => HandlePresetSelect(year))"
                                    @onclick:stopPropagation="true"
                                    title="@year"
                                    style="@GetPresetButtonStyle(year)">
                                <div style="font-size: 10px; font-weight: 700;">@year</div>
                            </button>
                        }
                    </div>

                    <div style="font-size: 9px; color: #888; margin-bottom: 4px; font-weight: 600;">Hours (12AM - 11PM)</div>
                    <div style="display: grid; grid-template-columns: repeat(6, 1fr); gap: 4px;">
                        @foreach (var hour in _hourPresets)
                        {
                            <button type="button"
                                    @onclick="@(() => HandlePresetSelect(hour))"
                                    @onclick:stopPropagation="true"
                                    title="@hour"
                                    style="@GetPresetButtonStyle(hour)">
                                <div style="font-size: 10px; font-weight: 600;">@hour</div>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>

        @* Date Picker Row *@
        <div style="display: flex; gap: 8px; padding-top: 10px; border-top: 1px solid #3a3a4e;">
            <button type="button"
                    @onclick="HandleTodaySelect"
                    @onclick:stopPropagation="true"
                    title="Insert today's date"
                    style="flex: 1; height: 36px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: #fff; border: none; border-radius: 4px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 12px; font-weight: 600; box-shadow: 0 2px 6px rgba(16, 185, 129, 0.4);">
                <Icon IconType="calendar" Color="#fff" Size="14" />
                <span>Today</span>
            </button>

            <input type="date"
                   @onchange="@HandleDateSelect"
                   @onclick:stopPropagation="true"
                   class="form-control"
                   style="flex: 1; height: 36px; font-size: 12px; background: #252538; border: 1px solid #667eea; color: #ffffff; color-scheme: dark; border-radius: 4px; padding: 0 8px;" />
        </div>
    </div>
}

@code {
    [Parameter]
    public string CurrentValue { get; set; } = "";

    [Parameter]
    public bool IsExpanded { get; set; } = false;

    [Parameter]
    public EventCallback<string> OnValueChange { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private bool _daysExpanded = true;
    private bool _monthsExpanded = false;
    private bool _moreExpanded = false;

    private record Preset(string Abbr, string Full);

    private readonly List<Preset> _dayPresets = new()
    {
        new Preset("Mon", "Monday"),
        new Preset("Tue", "Tuesday"),
        new Preset("Wed", "Wednesday"),
        new Preset("Thu", "Thursday"),
        new Preset("Fri", "Friday"),
        new Preset("Sat", "Saturday"),
        new Preset("Sun", "Sunday")
    };

    private readonly List<Preset> _monthPresets = new()
    {
        new Preset("Jan", "January"),
        new Preset("Feb", "February"),
        new Preset("Mar", "March"),
        new Preset("Apr", "April"),
        new Preset("May", "May"),
        new Preset("Jun", "June"),
        new Preset("Jul", "July"),
        new Preset("Aug", "August"),
        new Preset("Sep", "September"),
        new Preset("Oct", "October"),
        new Preset("Nov", "November"),
        new Preset("Dec", "December")
    };

    private readonly List<string> _quarterPresets = new()
    {
        "Q1", "Q2", "Q3", "Q4"
    };

    private readonly List<string> _yearPresets = new()
    {
        "2024", "2025", "2026", "2027", "2028"
    };

    private readonly List<string> _hourPresets = new()
    {
        "12AM", "1AM", "2AM", "3AM", "4AM", "5AM",
        "6AM", "7AM", "8AM", "9AM", "10AM", "11AM",
        "12PM", "1PM", "2PM", "3PM", "4PM", "5PM",
        "6PM", "7PM", "8PM", "9PM", "10PM", "11PM"
    };

    private async Task HandlePresetSelect(string value)
    {
        await OnValueChange.InvokeAsync(value);
        await OnClose.InvokeAsync();
    }

    private async Task HandleTodaySelect()
    {
        var today = DateTime.Now.ToString("MM/dd/yyyy");
        await OnValueChange.InvokeAsync(today);
        await OnClose.InvokeAsync();
    }

    private async Task HandleDateSelect(ChangeEventArgs e)
    {
        var dateValue = e.Value?.ToString();
        if (!string.IsNullOrEmpty(dateValue) && DateTime.TryParse(dateValue, out var date))
        {
            var formattedDate = date.ToString("MM/dd/yyyy");
            await OnValueChange.InvokeAsync(formattedDate);
            await OnClose.InvokeAsync();
        }
    }

    private string GetPresetButtonStyle(string text)
    {
        var isActive = CurrentValue?.Equals(text, StringComparison.OrdinalIgnoreCase) == true;

        var bg = isActive
            ? "background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);"
            : "background: #252538;";

        var border = isActive
            ? "border: 2px solid #667eea; box-shadow: 0 0 8px rgba(102, 126, 234, 0.5);"
            : "border: 1px solid #3a3a4e;";

        var color = isActive ? "#fff" : "#ccc";

        return $"width: 100%; height: 26px; {bg} color: {color}; {border} " +
               "border-radius: 4px; cursor: pointer; transition: all 0.2s; " +
               "display: flex; align-items: center; justify-content: center; " +
               "font-weight: 600;";
    }
}
