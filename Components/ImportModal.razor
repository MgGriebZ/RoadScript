@using RoadScript.Models
@using RoadScript.Services
@inject IJSRuntime JSRuntime

<div class="import-modal-overlay @(IsVisible ? "visible" : "")" @onclick="Close">
    <div class="import-modal-content" @onclick:stopPropagation="true">
        <div class="import-modal-header">
            <h3>Import Roadmap</h3>
            <button class="close-button" @onclick="Close">×</button>
        </div>

        <div class="import-modal-body">
            @if (ActiveData != null)
            {
                <div class="import-preview">
                    <div class="import-preview-header">
                        <h4>@ActiveData.Title</h4>
                        @if (!string.IsNullOrEmpty(ActiveData.Subtitle))
                        {
                            <p>@ActiveData.Subtitle</p>
                        }
                    </div>

                    <div class="import-stats">
                        <div class="import-stat">
                            <div class="import-stat-value">@ActiveData.Columns.Count</div>
                            <div class="import-stat-label">Columns</div>
                        </div>
                        <div class="import-stat">
                            <div class="import-stat-value">@ActiveData.Lanes.Count</div>
                            <div class="import-stat-label">Lanes</div>
                        </div>
                        <div class="import-stat">
                            <div class="import-stat-value">@GetTotalItems()</div>
                            <div class="import-stat-label">Items</div>
                        </div>
                        @if (ActiveData.Milestones?.Count > 0)
                        {
                            <div class="import-stat">
                                <div class="import-stat-value">@ActiveData.Milestones.Count</div>
                                <div class="import-stat-label">Milestones</div>
                            </div>
                        }
                    </div>
                </div>

                <div class="import-folder-select">
                    <label>Save to Folder:</label>
                    <select @bind="SelectedFolderId" @bind:after="OnFolderChanged" class="import-folder-dropdown">
                        @foreach (var folder in AvailableFolders)
                        {
                            var isFull = folder.SessionManager.Tabs.Count >= folder.SessionManager.MaxTabs;
                            <option value="@folder.Id" disabled="@isFull">
                                @folder.Icon @folder.Name (@folder.SessionManager.Tabs.Count/@folder.SessionManager.MaxTabs tabs) @(isFull ? "FULL" : "")
                            </option>
                        }
                    </select>
                    @if (IsSelectedFolderFull())
                    {
                        <div class="import-folder-full-warning">
                            <span>⚠️ This folder is full. Please select a different folder.</span>
                        </div>
                    }
                </div>

                <div class="import-name-input">
                    <label>Roadmap Name:</label>
                    <input type="text"
                           @bind="RoadmapName"
                           class="import-name-field"
                           placeholder="Enter roadmap name..." />
                </div>

                <div class="import-actions">
                    <button @onclick="ImportRoadmap"
                            class="btn-import-primary"
                            disabled="@(_isImporting || IsSelectedFolderFull() || string.IsNullOrWhiteSpace(RoadmapName))">
                        @if (_isImporting)
                        {
                            <span>⏳ Importing...</span>
                        }
                        else
                        {
                            <span>✨ Import Roadmap</span>
                        }
                    </button>
                    <button @onclick="Close" class="btn-import-secondary" disabled="@_isImporting">
                        Cancel
                    </button>
                </div>
            }
            else
            {
                <div class="import-url-section">
                    <label class="import-url-label">Paste a share link:</label>
                    <div class="import-url-row">
                        <input type="text"
                               class="import-url-input @(!string.IsNullOrEmpty(_urlParseError) ? "import-url-input-error" : "")"
                               placeholder="https://…#share/…"
                               @bind="_urlInput"
                               @bind:event="oninput"
                               @onkeydown="HandleUrlKeyDown"
                               disabled="@_isParsing" />
                        <button class="btn-parse-url"
                                @onclick="ParseUrl"
                                disabled="@(string.IsNullOrWhiteSpace(_urlInput) || _isParsing)">
                            @if (_isParsing)
                            {
                                <span class="import-parse-spinner"></span>
                            }
                            else
                            {
                                <span>Load</span>
                            }
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(_urlParseError))
                    {
                        <div class="import-url-error">@_urlParseError</div>
                    }
                </div>

                <div class="import-divider-or">
                    <span>or</span>
                </div>

                <button class="btn-import-file" @onclick="TriggerFileImport">
                    Import from JSON File
                </button>

                <div class="import-actions" style="margin-top: 16px;">
                    <button @onclick="Close" class="btn-import-secondary" style="width: 100%;">
                        Cancel
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public RoadmapData? RoadmapData { get; set; }
    [Parameter] public List<Folder> AvailableFolders { get; set; } = new();
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<(string FolderId, string RoadmapName, RoadmapData Data)> OnImport { get; set; }
    [Parameter] public EventCallback OnImportFromFile { get; set; }

    private string SelectedFolderId { get; set; } = "";
    private string RoadmapName { get; set; } = "";
    private bool _isImporting = false;
    private bool _isParsing = false;
    private string _urlInput = "";
    private string _urlParseError = "";
    private RoadmapData? _locallyParsedData;
    private bool _wasVisible = false;

    private RoadmapData? ActiveData => RoadmapData ?? _locallyParsedData;

    protected override void OnParametersSet()
    {
        if (IsVisible && !_wasVisible)
        {
            _isImporting = false;
            _isParsing = false;
            _urlInput = "";
            _urlParseError = "";
            _locallyParsedData = null;
            RoadmapName = RoadmapData?.Title ?? "";

            if (AvailableFolders.Count > 0)
            {
                var available = AvailableFolders.FirstOrDefault(f => f.SessionManager.Tabs.Count < f.SessionManager.MaxTabs);
                SelectedFolderId = available?.Id ?? AvailableFolders[0].Id;
            }
        }
        _wasVisible = IsVisible;
    }

    private int GetTotalItems()
    {
        return ActiveData?.Lanes.Sum(l => l.Items?.Count ?? 0) ?? 0;
    }

    private bool IsSelectedFolderFull()
    {
        var folder = AvailableFolders.FirstOrDefault(f => f.Id == SelectedFolderId);
        return folder != null && folder.SessionManager.Tabs.Count >= folder.SessionManager.MaxTabs;
    }

    private void OnFolderChanged() => StateHasChanged();

    private async Task Close()
    {
        if (!_isImporting)
        {
            RoadmapName = "";
            _isImporting = false;
            await OnClose.InvokeAsync();
        }
    }

    private async Task ImportRoadmap()
    {
        var data = ActiveData;
        if (_isImporting || data == null || string.IsNullOrWhiteSpace(RoadmapName) || string.IsNullOrWhiteSpace(SelectedFolderId))
            return;

        if (IsSelectedFolderFull()) return;

        _isImporting = true;
        StateHasChanged();

        try
        {
            await OnImport.InvokeAsync((SelectedFolderId, RoadmapName.Trim(), data));
            RoadmapName = "";
            _locallyParsedData = null;
            _isImporting = false;
        }
        catch
        {
            _isImporting = false;
            throw;
        }
    }

    private async Task ParseUrl()
    {
        if (string.IsNullOrWhiteSpace(_urlInput)) return;

        _isParsing = true;
        _urlParseError = "";
        StateHasChanged();
        await Task.Yield();

        var shareCode = ExtractShareCode(_urlInput.Trim());
        var parsed = ShareService.ParseShareUrl(shareCode);

        _isParsing = false;

        if (parsed != null)
        {
            _locallyParsedData = parsed;
            RoadmapName = parsed.Title ?? "Imported Roadmap";
            if (AvailableFolders.Count > 0 && string.IsNullOrEmpty(SelectedFolderId))
            {
                var available = AvailableFolders.FirstOrDefault(f => f.SessionManager.Tabs.Count < f.SessionManager.MaxTabs);
                SelectedFolderId = available?.Id ?? AvailableFolders[0].Id;
            }
        }
        else
        {
            _urlParseError = "Could not read that link — please check the URL and try again.";
        }

        StateHasChanged();
    }

    private async Task HandleUrlKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ParseUrl();
    }

    private async Task TriggerFileImport()
    {
        await OnImportFromFile.InvokeAsync();
    }

    private static string ExtractShareCode(string input)
    {
        if (input.Contains("#share/"))
            return input[(input.IndexOf("#share/") + 7)..];
        if (input.Contains("#share="))
            return input[(input.IndexOf("#share=") + 7)..];
        if (input.Contains("share="))
            return input[(input.IndexOf("share=") + 6)..];
        return input;
    }
}

<style>
    .import-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(4px);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 2000;
    }

    .import-modal-overlay.visible {
        display: flex;
    }

    .import-modal-content {
        background: #1e1e1e;
        border: 1px solid #444;
        border-radius: 12px;
        width: 90%;
        max-width: 500px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    }

    .import-modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 24px;
        border-bottom: 1px solid #333;
    }

    .import-modal-header h3 {
        margin: 0;
        color: #ffffff;
        font-size: 20px;
        font-weight: 600;
    }

    .close-button {
        background: none;
        border: none;
        color: #999;
        font-size: 32px;
        cursor: pointer;
        padding: 0;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
        transition: color 0.2s;
    }

    .close-button:hover {
        color: #ffffff;
    }

    .import-modal-body {
        padding: 24px;
    }

    .import-preview {
        background: #252525;
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .import-preview-header h4 {
        margin: 0 0 8px 0;
        color: #ffffff;
        font-size: 18px;
        font-weight: 600;
    }

    .import-preview-header p {
        margin: 0;
        color: #999;
        font-size: 14px;
    }

    .import-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(70px, 1fr));
        gap: 16px;
        margin-top: 16px;
    }

    .import-stat {
        text-align: center;
    }

    .import-stat-value {
        font-size: 24px;
        font-weight: 700;
        color: #667eea;
        margin-bottom: 4px;
    }

    .import-stat-label {
        font-size: 11px;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .import-folder-select,
    .import-name-input {
        margin-bottom: 16px;
    }

    .import-folder-select label,
    .import-name-input label {
        display: block;
        font-size: 12px;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
        font-weight: 600;
    }

    .import-folder-dropdown,
    .import-name-field {
        width: 100%;
        padding: 12px;
        background: #2a2a2a;
        border: 1px solid #444;
        border-radius: 6px;
        color: #ffffff;
        font-size: 14px;
    }

    .import-folder-dropdown:focus,
    .import-name-field:focus {
        outline: none;
        border-color: #667eea;
    }

    .import-folder-full-warning {
        margin-top: 8px;
        padding: 8px;
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.3);
        border-radius: 4px;
    }

    .import-folder-full-warning span {
        color: #fca5a5;
        font-size: 12px;
    }

    .import-actions {
        display: flex;
        gap: 12px;
    }

    .btn-import-primary {
        flex: 1;
        padding: 14px 24px;
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
    }

    .btn-import-primary:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(16, 185, 129, 0.4);
    }

    .btn-import-primary:active:not(:disabled) {
        transform: translateY(0);
    }

    .btn-import-primary:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .btn-import-secondary {
        flex: 1;
        padding: 14px 24px;
        background: #2a2a2a;
        color: #fff;
        border: 1px solid #444;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-import-secondary:hover {
        background: #333;
        border-color: #667eea;
    }

    /* URL input mode */
    .import-url-section {
        margin-bottom: 4px;
    }

    .import-url-label {
        display: block;
        font-size: 12px;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 10px;
        font-weight: 600;
    }

    .import-url-row {
        display: flex;
        gap: 8px;
    }

    .import-url-input {
        flex: 1;
        padding: 12px 14px;
        background: #2a2a2a;
        border: 1px solid #444;
        border-radius: 6px;
        color: #ffffff;
        font-size: 14px;
        font-family: inherit;
        outline: none;
        transition: border-color 0.2s;
        min-width: 0;
    }

    .import-url-input:focus {
        border-color: #667eea;
    }

    .import-url-input.import-url-input-error {
        border-color: rgba(239, 68, 68, 0.6);
    }

    .import-url-input::placeholder {
        color: #555;
    }

    .btn-parse-url {
        padding: 12px 18px;
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: #fff;
        border: none;
        border-radius: 6px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        white-space: nowrap;
        display: flex;
        align-items: center;
        gap: 6px;
        min-width: 64px;
        justify-content: center;
    }

    .btn-parse-url:hover:not(:disabled) {
        opacity: 0.9;
        transform: translateY(-1px);
    }

    .btn-parse-url:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }

    .import-parse-spinner {
        width: 14px;
        height: 14px;
        border: 2px solid rgba(255,255,255,0.3);
        border-top-color: #fff;
        border-radius: 50%;
        animation: import-spin 0.7s linear infinite;
        display: inline-block;
    }

    .import-url-error {
        margin-top: 8px;
        padding: 8px 12px;
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.3);
        border-radius: 6px;
        color: #fca5a5;
        font-size: 13px;
    }

    .import-divider-or {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 20px 0;
        color: #555;
        font-size: 13px;
    }

    .import-divider-or::before,
    .import-divider-or::after {
        content: '';
        flex: 1;
        height: 1px;
        background: #333;
    }

    .btn-import-file {
        width: 100%;
        padding: 12px;
        background: #252525;
        border: 1px dashed #444;
        border-radius: 8px;
        color: #aaa;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
        font-family: inherit;
    }

    .btn-import-file:hover {
        background: #2a2a2a;
        border-color: #667eea;
        color: #c4b5fd;
    }

    @keyframes import-spin {
        to { transform: rotate(360deg); }
    }
</style>
