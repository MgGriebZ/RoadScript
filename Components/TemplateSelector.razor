@using RoadScript.Services
@using RoadScript.Components
@using static RoadScript.Services.TemplateService

<div class="template-selector-overlay @(IsVisible ? "visible" : "")" @onclick="@(() => OnClose.InvokeAsync())">
    <div class="template-selector-content" @onclick:stopPropagation="true">
        <div class="template-selector-header">
            <h3>Choose a Roadmap Template</h3>
            <button class="close-button" @onclick="@(() => OnClose.InvokeAsync())">×</button>
        </div>

        <div class="template-options">
            <div class="template-card">
                <div @onclick="@(() => HandleTemplateSelect(TemplateType.ScrumSprintCycle))" style="display: flex; align-items: center; gap: 12px; cursor: pointer;">
                    <div class="template-icon" style="background: linear-gradient(135deg, rgba(153, 153, 255, 0.15) 0%, rgba(153, 153, 255, 0.05) 100%);">
                        <Icon IconType="calendar" Size="40" Color="#9999ff" />
                    </div>
                    <div class="template-info">
                        <h4>Daily Planning</h4>
                        <p>Weekly planning template with columns for Monday through Friday plus weekend. Single swim lane for organizing daily tasks and activities.</p>
                    </div>
                </div>
                <button @onclick="@(() => ToggleExamples(TemplateType.ScrumSprintCycle))" @onclick:stopPropagation="true" class="example-toggle">
                    @(IsExampleExpanded(TemplateType.ScrumSprintCycle) ? "▼" : "▶") Example
                </button>
                @if (IsExampleExpanded(TemplateType.ScrumSprintCycle))
                {
                    <div class="example-content">
                        @GetExampleContent(TemplateType.ScrumSprintCycle)
                    </div>
                }
            </div>

            <div class="template-card">
                <div @onclick="@(() => HandleTemplateSelect(TemplateType.ProjectTimelines))" style="display: flex; align-items: center; gap: 12px; cursor: pointer;">
                    <div class="template-icon" style="background: linear-gradient(135deg, rgba(135, 206, 235, 0.15) 0%, rgba(135, 206, 235, 0.05) 100%);">
                        <Icon IconType="rocket" Size="40" Color="#87CEEB" />
                    </div>
                    <div class="template-info">
                        <h4>Projects</h4>
                        <p>Multi-year project tracking with current year plus quarterly breakdown for next year. Features two swim lanes for organizing work in progress and completed items.</p>
                    </div>
                </div>
                <button @onclick="@(() => ToggleExamples(TemplateType.ProjectTimelines))" @onclick:stopPropagation="true" class="example-toggle">
                    @(IsExampleExpanded(TemplateType.ProjectTimelines) ? "▼" : "▶") Example
                </button>
                @if (IsExampleExpanded(TemplateType.ProjectTimelines))
                {
                    <div class="example-content">
                        @GetExampleContent(TemplateType.ProjectTimelines)
                    </div>
                }
            </div>

            <div class="template-card">
                <div @onclick="@(() => HandleTemplateSelect(TemplateType.AnnualRoadmap))" style="display: flex; align-items: center; gap: 12px; cursor: pointer;">
                    <div class="template-icon" style="background: linear-gradient(135deg, rgba(69, 182, 156, 0.15) 0%, rgba(69, 182, 156, 0.05) 100%);">
                        <Icon IconType="flag" Size="40" Color="#45B69C" />
                    </div>
                    <div class="template-info">
                        <h4>Milestones</h4>
                        <p>Annual milestone tracking with monthly columns spanning the entire year. Single swim lane for organizing tasks and key events throughout the year.</p>
                    </div>
                </div>
                <button @onclick="@(() => ToggleExamples(TemplateType.AnnualRoadmap))" @onclick:stopPropagation="true" class="example-toggle">
                    @(IsExampleExpanded(TemplateType.AnnualRoadmap) ? "▼" : "▶") Example
                </button>
                @if (IsExampleExpanded(TemplateType.AnnualRoadmap))
                {
                    <div class="example-content">
                        @GetExampleContent(TemplateType.AnnualRoadmap)
                    </div>
                }
            </div>

            <div class="template-card">
                <div @onclick="@(() => HandleTemplateSelect(TemplateType.Retrospective))" style="display: flex; align-items: center; gap: 12px; cursor: pointer;">
                    <div class="template-icon" style="background: linear-gradient(135deg, rgba(230, 184, 0, 0.15) 0%, rgba(230, 184, 0, 0.05) 100%);">
                        <Icon IconType="pause" Size="40" Color="#E6B800" />
                    </div>
                    <div class="template-info">
                        <h4>Retro</h4>
                        <p>Retrospective feedback template with five columns: Went Well, Needs Work, Kudos, Improve, and Advice. Single swim lane for organizing personal reflections and feedback for others.</p>
                    </div>
                </div>
                <button @onclick="@(() => ToggleExamples(TemplateType.Retrospective))" @onclick:stopPropagation="true" class="example-toggle">
                    @(IsExampleExpanded(TemplateType.Retrospective) ? "▼" : "▶") Example
                </button>
                @if (IsExampleExpanded(TemplateType.Retrospective))
                {
                    <div class="example-content">
                        @GetExampleContent(TemplateType.Retrospective)
                    </div>
                }
            </div>

            <div class="template-card">
                <div @onclick="@(() => HandleTemplateSelect(TemplateType.ScrumBoard))" style="display: flex; align-items: center; gap: 12px; cursor: pointer;">
                    <div class="template-icon" style="background: linear-gradient(135deg, rgba(248, 131, 121, 0.15) 0%, rgba(248, 131, 121, 0.05) 100%);">
                        <Icon IconType="target" Size="40" Color="#F88379" />
                    </div>
                    <div class="template-info">
                        <h4>Flows</h4>
                        <p>Hourly flow tracking from morning through evening. Features two swim lanes (TODO and backlog) for organizing tasks throughout the day.</p>
                    </div>
                </div>
                <button @onclick="@(() => ToggleExamples(TemplateType.ScrumBoard))" @onclick:stopPropagation="true" class="example-toggle">
                    @(IsExampleExpanded(TemplateType.ScrumBoard) ? "▼" : "▶") Example
                </button>
                @if (IsExampleExpanded(TemplateType.ScrumBoard))
                {
                    <div class="example-content">
                        @GetExampleContent(TemplateType.ScrumBoard)
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<TemplateType> OnTemplateSelect { get; set; }

    private Dictionary<TemplateType, bool> _expandedExamples = new();
    private bool _previousVisibility = false;

    protected override void OnParametersSet()
    {
        // Reset expanded examples when modal is opened
        if (IsVisible && !_previousVisibility)
        {
            _expandedExamples.Clear();
        }
        _previousVisibility = IsVisible;
    }

    private async Task HandleTemplateSelect(TemplateType templateType)
    {
        await OnTemplateSelect.InvokeAsync(templateType);
        // Note: Parent HandleTemplateSelect already closes the modal and refreshes state
    }

    private void ToggleExamples(TemplateType templateType)
    {
        if (_expandedExamples.ContainsKey(templateType))
        {
            _expandedExamples[templateType] = !_expandedExamples[templateType];
        }
        else
        {
            _expandedExamples[templateType] = true;
        }
    }

    private bool IsExampleExpanded(TemplateType templateType)
    {
        return _expandedExamples.ContainsKey(templateType) && _expandedExamples[templateType];
    }

    private string GetExampleContent(TemplateType templateType)
    {
        return templateType switch
        {
            TemplateType.ScrumSprintCycle => "Example: Use for weekly task planning. Add items like 'Team meeting Monday 9am', 'Code review Wednesday afternoon', 'Deploy to staging Friday', or 'Weekend reading: technical docs'.",
            TemplateType.ProjectTimelines => "Example: Track projects like 'Mobile App v2.0' (In-Progress, starting Q2 2026), 'API Migration' (Completed, finished in 2025), or 'New Feature Launch' (In-Progress, spanning Q3-Q4 2026).",
            TemplateType.AnnualRoadmap => "Example: Plan annual milestones like 'Q1 Product Launch' (March), 'Team Expansion' (June-July), 'Major Release v3.0' (September), or 'Year-End Review' (December).",
            TemplateType.Retrospective => "Example: After a sprint, document 'Went Well: Successfully deployed new feature' (For Self), 'Needs Work: Better time estimation' (For Self), 'Kudos: Thanks to Sarah for debugging help' (To Others), 'Advice: Consider pair programming for complex tasks' (To Others).",
            TemplateType.ScrumBoard => "Example: Plan your day with tasks like 'Morning: Team standup' (TODO), '10am: Code review' (TODO), '2pm: Client meeting' (TODO), 'Afternoon: Documentation' (backlog), 'Evening: Learning new framework' (backlog).",
            _ => ""
        };
    }
}

<style>
    .template-selector-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(4px);
        display: none;
        z-index: 2500;
    }

    .template-selector-overlay.visible {
        display: block;
    }

    .template-selector-content {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: #1e1e1e;
        border: 1px solid #444;
        border-radius: 12px;
        padding: 20px;
        max-width: 90vw;
        max-height: 85vh;
        width: auto;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
        display: flex;
        flex-direction: column;
    }

    .template-selector-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .template-selector-header h3 {
        margin: 0;
        color: #ffffff;
        font-size: 20px;
        font-weight: 600;
    }

    .close-button {
        background: none;
        border: none;
        color: #999;
        font-size: 32px;
        cursor: pointer;
        padding: 0;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
        transition: color 0.2s;
    }

    .close-button:hover {
        color: #ffffff;
    }

    .template-options {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 12px;
        overflow-y: auto;
        max-height: calc(85vh - 100px);
        padding-right: 4px;
    }

    @media (min-width: 1200px) {
        .template-options {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 768px) {
        .template-options {
            grid-template-columns: 1fr;
        }
    }

    .template-card {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 14px;
        background: #2a2a2a;
        border: 2px solid #444;
        border-radius: 8px;
        transition: all 0.2s;
    }

    .template-card:hover {
        background: #333;
        border-color: #667eea;
        transform: scale(1.02);
    }

    .example-toggle {
        align-self: flex-start;
        background: none;
        border: 1px solid #555;
        color: #999;
        padding: 3px 8px;
        border-radius: 4px;
        cursor: pointer;
        font-size: 11px;
        transition: all 0.2s;
        margin-left: 76px;
    }

    .example-toggle:hover {
        background: #3c3c3c;
        color: #ccc;
        border-color: #667eea;
    }

    .example-content {
        margin-left: 76px;
        padding: 10px;
        background: #1e1e1e;
        border-left: 3px solid #667eea;
        border-radius: 4px;
        color: #ccc;
        font-size: 12px;
        line-height: 1.5;
    }

    .template-icon {
        flex-shrink: 0;
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #1e1e1e;
        border-radius: 8px;
        border: 2px solid #444;
    }

    .template-card:hover .template-icon {
        border-color: #667eea;
    }

    .template-info {
        flex: 1;
    }

    .template-info h4 {
        margin: 0 0 6px 0;
        color: #ffffff;
        font-size: 16px;
        font-weight: 600;
    }

    .template-info p {
        margin: 0;
        color: #999;
        font-size: 13px;
        line-height: 1.4;
    }
</style>
