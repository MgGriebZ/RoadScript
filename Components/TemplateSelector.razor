@using RoadScript.Services
@using RoadScript.Components
@using static RoadScript.Services.TemplateService

@* Template Selector - Modal for choosing roadmap template *@

<div class="template-selector-overlay @(IsVisible ? "visible" : "")" @onclick="@(() => OnClose.InvokeAsync())">
    <div class="template-selector-content" @onclick:stopPropagation="true">
        <div class="template-selector-header">
            <h3>Choose a Roadmap Template</h3>
            <button class="close-button" @onclick="@(() => OnClose.InvokeAsync())">×</button>
        </div>

        <div class="template-options">
            @* Daily Planning *@
            <div class="template-card" @onclick="@(() => HandleTemplateSelect(TemplateType.ScrumSprintCycle))">
                <div class="template-icon" style="background: linear-gradient(135deg, rgba(153, 153, 255, 0.15) 0%, rgba(153, 153, 255, 0.05) 100%);">
                    <Icon IconType="calendar" Size="56" Color="#9999ff" />
                </div>
                <div class="template-info">
                    <h4>Daily Planning</h4>
                    <p>A quick daily-like view representing something close to an outlook calendar. This template uses typical sprint meetings in an agile Scrum development team. It has a few larger items that are good for adding quick notes or details to re-occurring meetings or projects.</p>
                </div>
            </div>

            @* Project Timelines *@
            <div class="template-card" @onclick="@(() => HandleTemplateSelect(TemplateType.ProjectTimelines))">
                <div class="template-icon" style="background: linear-gradient(135deg, rgba(135, 206, 235, 0.15) 0%, rgba(135, 206, 235, 0.05) 100%);">
                    <Icon IconType="rocket" Size="56" Color="#87CEEB" />
                </div>
                <div class="template-info">
                    <h4>Project Timelines</h4>
                    <p>High-level product level tracking which represents larger scales of time. This template uses mggriebz personal portfolio of products including details of core features, deployment dates and easy to adjust roadmap settings.</p>
                </div>
            </div>

            @* Milestone Map *@
            <div class="template-card" @onclick="@(() => HandleTemplateSelect(TemplateType.AnnualRoadmap))">
                <div class="template-icon" style="background: linear-gradient(135deg, rgba(69, 182, 156, 0.15) 0%, rgba(69, 182, 156, 0.05) 100%);">
                    <Icon IconType="flag" Size="56" Color="#45B69C" />
                </div>
                <div class="template-info">
                    <h4>Milestone Map</h4>
                    <p>Hyper detailed target and milestone event tracking. This template uses several columns to represent hourly development cycles with Claude credit token resets and PR merges that track a product lifecycle. It utilizes the expansive icon list and milestone features to help define specific targets/goals.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<TemplateType> OnTemplateSelect { get; set; }

    private async Task HandleTemplateSelect(TemplateType templateType)
    {
        await OnTemplateSelect.InvokeAsync(templateType);
        await OnClose.InvokeAsync();
    }
}

<style>
    .template-selector-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(4px);
        display: none;
        z-index: 1000;
    }

    .template-selector-overlay.visible {
        display: block;
    }

    .template-selector-content {
        position: absolute;
        top: 20px;
        left: 20px;
        background: #1e1e1e;
        border: 1px solid #444;
        border-radius: 12px;
        padding: 24px;
        max-width: 700px;
        width: auto;
        min-width: 650px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    }

    .template-selector-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .template-selector-header h3 {
        margin: 0;
        color: #ffffff;
        font-size: 20px;
        font-weight: 600;
    }

    .close-button {
        background: none;
        border: none;
        color: #999;
        font-size: 32px;
        cursor: pointer;
        padding: 0;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
        transition: color 0.2s;
    }

    .close-button:hover {
        color: #ffffff;
    }

    .template-options {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .template-card {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 20px;
        background: #2a2a2a;
        border: 2px solid #444;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.2s;
    }

    .template-card:hover {
        background: #333;
        border-color: #667eea;
        transform: translateX(4px);
    }

    .template-icon {
        flex-shrink: 0;
        width: 80px;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #1e1e1e;
        border-radius: 12px;
        border: 2px solid #444;
    }

    .template-card:hover .template-icon {
        border-color: #667eea;
    }

    .template-info {
        flex: 1;
    }

    .template-info h4 {
        margin: 0 0 8px 0;
        color: #ffffff;
        font-size: 18px;
        font-weight: 600;
    }

    .template-info p {
        margin: 0;
        color: #999;
        font-size: 14px;
        line-height: 1.5;
    }
</style>
