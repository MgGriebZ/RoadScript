@using RoadScript.Models

<div class="property-editor">
    <div class="form-group">
        <label>Milestone Label</label>
        <input type="text"
               value="@Milestone.Label"
               @onchange="@(e => OnChange.InvokeAsync(("label", e.Value)))"
               class="form-control"
               placeholder="Launch Date" />
    </div>

    <div class="form-group">
        <label>Color</label>
        <div style="display: flex; align-items: center; gap: 12px;">
            <input type="color"
                   value="@Milestone.Color"
                   @onchange="@(e => OnChange.InvokeAsync(("color", e.Value)))"
                   style="width: 60px; height: 40px; border: 1px solid #3a3a4e; border-radius: 4px; cursor: pointer; background: #2a2a3e; padding: 2px;" />
            <input type="text"
                   value="@Milestone.Color"
                   @onchange="@(e => OnChange.InvokeAsync(("color", e.Value)))"
                   class="form-control"
                   placeholder="#667eea"
                   style="flex: 1;" />
        </div>
    </div>

    <div class="form-group">
        <label>Icon</label>
        <div style="background: #252538; padding: 12px; border-radius: 6px; border: 1px solid #3a3a4e;">
            <IconPicker SelectedIcon="@(Milestone.Icon ?? "diamond")"
                       Color="@Milestone.Color"
                       OnIconSelected="HandleIconSelected"
                       ShowCategories="true"
                       ColumnsPerRow="5" />
        </div>
    </div>

    <div class="form-group">
        <label>Position (%)</label>
        <input type="number"
               value="@Milestone.Position"
               @onchange="@(e => OnChange.InvokeAsync(("position", double.Parse(e.Value?.ToString() ?? "0"))))"
               class="form-control"
               step="0.1"
               min="0"
               max="100" />
    </div>

    <div class="form-group">
        <label>Position Slider</label>
        <input type="range"
               value="@Milestone.Position"
               @onchange="@(e => OnChange.InvokeAsync(("position", double.Parse(e.Value?.ToString() ?? "0"))))"
               min="0"
               max="100"
               step="0.5"
               class="form-range" />
        <div style="display: flex; justify-content: space-between; font-size: 11px; color: #888; margin-top: 4px;">
            <span>0%</span>
            <span style="font-weight: 600; color: #667eea;">@Milestone.Position.ToString("F1")%</span>
            <span>100%</span>
        </div>
    </div>

    <div style="margin-top: 16px; padding: 12px; background: rgba(102, 126, 234, 0.1); border-radius: 6px; font-size: 12px; color: #9ca3af;">
        <strong>Tip:</strong> Position is a percentage across the entire timeline (0% = start, 100% = end).
    </div>

    @* Milestone Management Section *@
    <div class="form-group" style="margin-top: 24px; padding-top: 16px; border-top: 1px solid #3a3a4e;">
        <label style="margin-bottom: 12px; font-weight: 600; color: #e0e7ff;">Milestone Management</label>

        <button @onclick="AddMilestone" class="btn-add" type="button" style="width: 100%; margin-bottom: 8px;">
            + Add New Milestone
        </button>

        <button @onclick="DuplicateMilestone" type="button" style="width: 100%; margin-bottom: 8px; background: #667eea; color: #fff; border: none; padding: 8px 16px; border-radius: 4px; font-size: 13px; font-weight: 500; cursor: pointer; transition: all 0.2s;">
            📋 Duplicate This Milestone
        </button>

        <button @onclick="RemoveMilestone" class="btn-danger" type="button" style="width: 100%;">
            Remove This Milestone
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Milestone Milestone { get; set; } = null!;

    [Parameter, EditorRequired]
    public string JsonPath { get; set; } = "";

    [Parameter]
    public EventCallback<(string PropertyName, object Value)> OnChange { get; set; }

    [Parameter]
    public EventCallback<string> OnAdd { get; set; }

    [Parameter]
    public EventCallback<string> OnRemove { get; set; }

    [Parameter]
    public EventCallback<string> OnDuplicate { get; set; }

    private async Task HandleIconSelected(string iconValue)
    {
        // Update the milestone directly to ensure immediate UI update
        Milestone.Icon = iconValue;
        await OnChange.InvokeAsync(("icon", iconValue));
        StateHasChanged(); // Force re-render to show selected icon immediately
    }

    private void AddMilestone()
    {
        OnAdd.InvokeAsync("milestone");
    }

    private void DuplicateMilestone()
    {
        OnDuplicate.InvokeAsync("milestone");
    }

    private void RemoveMilestone()
    {
        OnRemove.InvokeAsync("milestone");
    }
}
