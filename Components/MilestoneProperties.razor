@using RoadScript.Models

<style>
    /* Hide number input spinner arrows */
    input[type="number"]::-webkit-inner-spin-button,
    input[type="number"]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
    input[type="number"] {
        -moz-appearance: textfield;
    }
</style>

<div class="property-editor">
    <div class="form-group">
        <label>Milestone Title</label>
        <input type="text"
               value="@Milestone.Title"
               @onchange="@(e => OnChange.InvokeAsync(("title", e.Value)))"
               class="form-control"
               placeholder="Launch Date" />
    </div>

    <div class="form-group">
        <label style="margin-bottom: 8px;">Color</label>

        @* Preset Color Options *@
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin-bottom: 10px;">
            @foreach (var preset in _colorPresets)
            {
                <button type="button"
                        @onclick="@(() => OnChange.InvokeAsync(("color", preset.Value)))"
                        title="@preset.Name"
                        style="@GetPresetColorButtonStyle(preset.Value, Milestone.Color)">
                    <span style="width: 100%; height: 100%; display: block; border-radius: 3px; background: @preset.Value;"></span>
                </button>
            }
        </div>

        <div style="display: flex; align-items: center; gap: 12px;">
            <input type="color"
                   value="@Milestone.Color"
                   @onchange="@(e => OnChange.InvokeAsync(("color", e.Value)))"
                   style="width: 60px; height: 40px; border: 1px solid #3a3a4e; border-radius: 4px; cursor: pointer; background: #2a2a3e; padding: 2px;" />
            <input type="text"
                   value="@Milestone.Color"
                   @onchange="@(e => OnChange.InvokeAsync(("color", e.Value)))"
                   class="form-control"
                   placeholder="#667eea"
                   style="flex: 1;" />
        </div>
    </div>

    <div class="form-group">
        <label style="font-size: 11px; margin-bottom: 8px; color: #888;">Icon</label>

        @* Large Icon Preview Button - Similar to Display Options *@
        <div style="position: relative;">
            <button type="button"
                    @onclick="ToggleMilestoneIconPicker"
                    title="Click to @(_milestoneIconPickerExpanded ? "hide" : "choose") milestone icon"
                    style="width: 100%; min-height: 80px; background: #252538; border: 1px solid #3a3a4e; border-radius: 6px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; padding: 16px; position: relative;">
                @if (!string.IsNullOrEmpty(Milestone.Icon))
                {
                    <Icon IconType="@Milestone.Icon"
                          Color="@Milestone.Color"
                          Size="36"
                          DropShadow="true" />
                }
                else
                {
                    @* Placeholder for empty state *@
                    <span style="font-size: 36px; opacity: 0.3;">◆</span>
                }

                @* Dropdown indicator in bottom right *@
                <span style="position: absolute; bottom: 8px; right: 8px; font-size: 12px; color: #666; transition: transform 0.2s; transform: rotate(@(_milestoneIconPickerExpanded ? "180deg" : "0deg"));">▼</span>
            </button>

            @* Clear button overlay in top right corner *@
            @if (!string.IsNullOrEmpty(Milestone.Icon))
            {
                <button type="button"
                        @onclick="ClearIcon"
                        @onclick:stopPropagation="true"
                        title="Clear icon"
                        style="position: absolute; top: 6px; right: 6px; width: 24px; height: 24px; background: rgba(0,0,0,0.6); border: 1px solid #555; border-radius: 4px; cursor: pointer; display: flex; align-items: center; justify-content: center; color: #ef4444; font-size: 14px; font-weight: 600; transition: all 0.2s; z-index: 1;">
                    ✕
                </button>
            }
        </div>

        @if (_milestoneIconPickerExpanded)
        {
            <div style="background: #252538; padding: 12px; border-radius: 6px; border: 1px solid #3a3a4e; margin-top: 8px;">
                <IconPicker SelectedIcon="@(Milestone.Icon ?? "diamond")"
                           Color="@Milestone.Color"
                           OnIconSelected="HandleIconSelectedAndCollapse"
                           ShowCategories="true"
                           ColumnsPerRow="5" />
            </div>
        }
    </div>

    <div class="form-group">
        <label style="margin-bottom: 8px;">Start Position</label>

        @* Quick Position Buttons with inline editable value *@
        <div style="display: flex; align-items: center; gap: 4px; margin-bottom: 12px;">
            <button type="button"
                    @onclick="@(() => JumpToStart())"
                    title="Jump to Start (0%)"
                    style="width: 38px; min-height: 32px; background: #252538; color: #ccc; border: 1px solid #3a3a4e; border-radius: 4px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; font-weight: 500; padding: 2px; flex-shrink: 0;">
                <div style="font-size: 9px; font-weight: 600;">⏮</div>
            </button>
            <button type="button"
                    @onclick="@(() => AdjustPosition(-GetColumnPercentage()))"
                    title="Big Down (-1 column)"
                    style="width: 32px; min-height: 32px; background: #252538; color: #ccc; border: 1px solid #3a3a4e; border-radius: 4px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; padding: 2px; flex-shrink: 0;">
                <div style="font-size: 16px; line-height: 1;">⏪</div>
            </button>
            <button type="button"
                    @onclick="@(() => AdjustPosition(-0.25))"
                    title="Little Down (-0.25%)"
                    style="width: 32px; min-height: 32px; background: #252538; color: #ccc; border: 1px solid #3a3a4e; border-radius: 4px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; padding: 2px; flex-shrink: 0;">
                <div style="font-size: 14px; line-height: 1;">◀</div>
            </button>

            @* Editable Numeric Value *@
            <input type="number"
                   value="@Milestone.Start"
                   @onchange="@(e => OnChange.InvokeAsync(("start", double.Parse(e.Value?.ToString() ?? "0"))))"
                   style="flex: 1; min-width: 55px; text-align: center; background: #1a1a2e; border: 1px solid #667eea; border-radius: 4px; padding: 6px 4px; font-weight: 600; color: #667eea; font-size: 13px;"
                   step="0.5"
                   min="0"
                   max="100" />

            <button type="button"
                    @onclick="@(() => AdjustPosition(0.25))"
                    title="Little Up (+0.25%)"
                    style="width: 32px; min-height: 32px; background: #252538; color: #ccc; border: 1px solid #3a3a4e; border-radius: 4px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; padding: 2px; flex-shrink: 0;">
                <div style="font-size: 14px; line-height: 1;">▶</div>
            </button>
            <button type="button"
                    @onclick="@(() => AdjustPosition(GetColumnPercentage()))"
                    title="Big Up (+1 column)"
                    style="width: 32px; min-height: 32px; background: #252538; color: #ccc; border: 1px solid #3a3a4e; border-radius: 4px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; padding: 2px; flex-shrink: 0;">
                <div style="font-size: 16px; line-height: 1;">⏩</div>
            </button>
            <button type="button"
                    @onclick="@(() => JumpToEnd())"
                    title="Jump to End (100%)"
                    style="width: 38px; min-height: 32px; background: #252538; color: #ccc; border: 1px solid #3a3a4e; border-radius: 4px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; font-weight: 500; padding: 2px; flex-shrink: 0;">
                <div style="font-size: 9px; font-weight: 600;">⏭</div>
            </button>
        </div>

        <input type="range"
               value="@Milestone.Start"
               @onchange="@(e => OnChange.InvokeAsync(("start", double.Parse(e.Value?.ToString() ?? "0"))))"
               min="0"
               max="100"
               step="0.5"
               class="form-range" />
        <div style="display: flex; justify-content: space-between; font-size: 11px; color: #888; margin-top: 4px;">
            <span>0%</span>
            <span>100%</span>
        </div>
    </div>

    <div style="margin-top: 16px; padding: 12px; background: rgba(102, 126, 234, 0.1); border-radius: 6px; font-size: 12px; color: #9ca3af;">
        <strong>Tip:</strong> Position is a percentage across the entire timeline (0% = start, 100% = end).
    </div>

    @* Milestone Management Section *@
    <div class="form-group" style="margin-top: 24px; padding-top: 16px; border-top: 1px solid #3a3a4e;">
        <label style="margin-bottom: 12px; font-weight: 600; color: #e0e7ff;">Milestone Management</label>

        <button @onclick="AddMilestone" class="btn-add" type="button" style="width: 100%; margin-bottom: 8px;">
            + Add New Milestone
        </button>

        <button @onclick="DuplicateMilestone" type="button" style="width: 100%; margin-bottom: 8px; background: #667eea; color: #fff; border: none; padding: 8px 16px; border-radius: 4px; font-size: 13px; font-weight: 500; cursor: pointer; transition: all 0.2s;">
            📋 Duplicate This Milestone
        </button>

        <button @onclick="RemoveMilestone" class="btn-danger" type="button" style="width: 100%;">
            Remove This Milestone
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Milestone Milestone { get; set; } = null!;

    [Parameter, EditorRequired]
    public string JsonPath { get; set; } = "";

    [Parameter]
    public EventCallback<(string PropertyName, object Value)> OnChange { get; set; }

    [Parameter]
    public EventCallback<string> OnAdd { get; set; }

    [Parameter]
    public EventCallback<string> OnRemove { get; set; }

    [Parameter]
    public EventCallback<string> OnDuplicate { get; set; }

    [Parameter]
    public int ColumnCount { get; set; } = 4;

    private bool _milestoneIconPickerExpanded = false;

    private void ToggleMilestoneIconPicker()
    {
        _milestoneIconPickerExpanded = !_milestoneIconPickerExpanded;
    }

    private record ColorPreset(string Name, string Value);

    private readonly List<ColorPreset> _colorPresets = new()
    {
        new ColorPreset("Teal", "#45B69C"),
        new ColorPreset("Coral", "#F88379"),
        new ColorPreset("Lav", "#9999ff"),
        new ColorPreset("Orange", "#D4652F"),
        new ColorPreset("Blue", "#87CEEB"),
        new ColorPreset("Mustard", "#E6B800"),
        new ColorPreset("Brown", "#4A2C1A"),
        new ColorPreset("Sage", "#B7C4B7"),
        new ColorPreset("Red", "#EF4444"),
        new ColorPreset("Indigo", "#6366F1"),
        new ColorPreset("Dark Blue", "#1E3A8A"),
        new ColorPreset("Pink", "#EC4899")
    };

    private string GetPresetColorButtonStyle(string presetColor, string currentColor)
    {
        var isSelected = presetColor.Equals(currentColor, StringComparison.OrdinalIgnoreCase);
        var border = isSelected
            ? "border: 2px solid #667eea; box-shadow: 0 0 0 2px rgba(102, 126, 234, 0.3);"
            : "border: 1.5px solid rgba(255, 255, 255, 0.2);";

        return $"width: 100%; height: 32px; padding: 2px; cursor: pointer; border-radius: 4px; " +
               $"background: #1a1a2e; transition: all 0.2s; {border}";
    }

    private async Task HandleIconSelectedAndCollapse(string iconValue)
    {
        // Update the milestone directly to ensure immediate UI update
        Milestone.Icon = iconValue;
        await OnChange.InvokeAsync(("icon", iconValue));
        _milestoneIconPickerExpanded = false; // Auto-collapse on selection
        StateHasChanged(); // Force re-render to show selected icon immediately
    }

    private async Task ClearIcon()
    {
        Milestone.Icon = null;
        await OnChange.InvokeAsync(("icon", null!));
        StateHasChanged();
    }

    private void AddMilestone()
    {
        OnAdd.InvokeAsync("milestone");
    }

    private void DuplicateMilestone()
    {
        OnDuplicate.InvokeAsync("milestone");
    }

    private void RemoveMilestone()
    {
        OnRemove.InvokeAsync("milestone");
    }

    // Quick Position Button Methods
    private void JumpToStart()
    {
        OnChange.InvokeAsync(("start", 0.0));
    }

    private void JumpToEnd()
    {
        OnChange.InvokeAsync(("start", 100.0));
    }

    private double GetColumnPercentage()
    {
        // Calculate percentage width of one column
        return ColumnCount > 0 ? 100.0 / ColumnCount : 25.0;
    }

    private void AdjustPosition(double delta)
    {
        var newPos = Milestone.Start + delta;
        // Clamp to valid range (0-100)
        newPos = Math.Max(0, Math.Min(newPos, 100));
        // Round to 2 decimal places to avoid floating point precision issues
        newPos = Math.Round(newPos, 2);
        OnChange.InvokeAsync(("start", newPos));
    }

    private string GetQuickButtonStyle()
    {
        return "width: 100%; min-height: 36px; background: #252538; color: #ccc; border: 1px solid #3a3a4e; " +
               "border-radius: 4px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; " +
               "justify-content: center; font-weight: 500; padding: 4px;";
    }
}
