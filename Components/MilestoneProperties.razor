@using RoadScript.Models

<div class="property-editor">
    <div class="form-group">
        <label>Milestone Label</label>
        <input type="text"
               value="@Milestone.Label"
               @onchange="@(e => OnChange.InvokeAsync(("label", e.Value)))"
               class="form-control"
               placeholder="Launch Date" />
    </div>

    <div class="form-group">
        <label>Icon</label>
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 8px;">
            @foreach (var icon in _availableIcons)
            {
                <button type="button"
                        @onclick="@(() => OnChange.InvokeAsync(("icon", icon.Value)))"
                        style="@GetIconButtonStyle(icon.Value)"
                        title="@icon.Name">
                    @((MarkupString)GetIconPreview(icon.Value))
                    <span style="font-size: 10px; margin-top: 4px;">@icon.Name</span>
                </button>
            }
        </div>
    </div>

    <div class="form-group">
        <label>Position (%)</label>
        <input type="number"
               value="@Milestone.Position"
               @onchange="@(e => OnChange.InvokeAsync(("position", double.Parse(e.Value?.ToString() ?? "0"))))"
               class="form-control"
               step="0.1"
               min="0"
               max="100" />
    </div>

    <div class="form-group">
        <label>Position Slider</label>
        <input type="range"
               value="@Milestone.Position"
               @onchange="@(e => OnChange.InvokeAsync(("position", double.Parse(e.Value?.ToString() ?? "0"))))"
               min="0"
               max="100"
               step="0.5"
               class="form-range" />
        <div style="display: flex; justify-content: space-between; font-size: 11px; color: #888; margin-top: 4px;">
            <span>0%</span>
            <span style="font-weight: 600; color: #667eea;">@Milestone.Position.ToString("F1")%</span>
            <span>100%</span>
        </div>
    </div>

    <div style="margin-top: 16px; padding: 12px; background: rgba(102, 126, 234, 0.1); border-radius: 6px; font-size: 12px; color: #9ca3af;">
        <strong>Tip:</strong> Position is a percentage across the entire timeline (0% = start, 100% = end).
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Milestone Milestone { get; set; } = null!;

    [Parameter, EditorRequired]
    public string JsonPath { get; set; } = "";

    [Parameter]
    public EventCallback<(string PropertyName, object Value)> OnChange { get; set; }

    private readonly List<(string Name, string Value)> _availableIcons = new()
    {
        ("Diamond", "diamond"),
        ("Star", "star"),
        ("Flag", "flag"),
        ("Check", "check"),
        ("Circle", "circle")
    };

    private string GetIconButtonStyle(string iconValue)
    {
        var isSelected = Milestone.Icon == iconValue || (string.IsNullOrEmpty(Milestone.Icon) && iconValue == "diamond");
        var baseStyle = "display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 12px 8px; border-radius: 6px; cursor: pointer; transition: all 0.2s; border: 2px solid ";

        if (isSelected)
        {
            return baseStyle + "#667eea; background: rgba(102, 126, 234, 0.15); color: #e0e7ff;";
        }
        return baseStyle + "#3a3a4e; background: #2a2a3e; color: #9ca3af;";
    }

    private string GetIconPreview(string iconType)
    {
        var color = "#d1d5db";
        return iconType.ToLower() switch
        {
            "star" => $"<svg width='20' height='20' viewBox='0 0 24 24' fill='{color}'><path d='M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z'/></svg>",
            "flag" => $"<svg width='20' height='20' viewBox='0 0 24 24' fill='{color}'><path d='M14.4 6L14 4H5v17h2v-7h5.6l.4 2h7V6z'/></svg>",
            "check" => $"<svg width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='{color}' stroke-width='3'><path d='M20 6L9 17l-5-5'/></svg>",
            "circle" => $"<svg width='16' height='16' viewBox='0 0 24 24' fill='{color}'><circle cx='12' cy='12' r='10'/></svg>",
            "diamond" => $"<div style='width: 16px; height: 16px; background: {color}; transform: rotate(45deg);'></div>",
            _ => $"<div style='width: 16px; height: 16px; background: {color}; transform: rotate(45deg);'></div>"
        };
    }
}
