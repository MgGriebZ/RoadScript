@inject ThemeService ThemeService
@using RoadScript.Models

@{
    var hasTitleText = !string.IsNullOrWhiteSpace(Title);
    var hasSubtitleText = !string.IsNullOrWhiteSpace(Subtitle);
    var hasTitleContent = hasTitleText || hasSubtitleText;
    var titlePadding = hasTitleContent ? "padding: 8px 12px;" : "padding: 8px 12px; min-height: 58px;";
}

<div class="@GetElementClass() roadmap-title-container"
     style="@(ThemeService.TitleContainerStyle() + " " + titlePadding)">

    @* Centered Title and Subtitle *@
    <div class="title-content-center">
        @if (hasTitleText)
        {
            <div style="display: flex; align-items: center; justify-content: center; gap: 12px;">
                <div @onclick="@(IsPreviewMode ? null : () => OnTitleClick.InvokeAsync())"
                     style="@(IsPreviewMode ? "" : "cursor: pointer;")">
                    <h1 style="@ThemeService.TitleStyle()">@Title</h1>
                </div>

                @if (!string.IsNullOrEmpty(LinkedRoadmapId) && !IsPreviewMode)
                {
                    var linkedTab = SessionManager?.Tabs.FirstOrDefault(t => t.Id == LinkedRoadmapId);
                    <span @onclick="@(() => OnRoadmapLinkClick.InvokeAsync(LinkedRoadmapId))"
                          @onclick:stopPropagation="true"
                          style="font-size: 20px; cursor: pointer; opacity: 0.6;
                                 transition: opacity 0.2s, transform 0.2s;
                                 filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));
                                 display: flex; align-items: center; justify-content: center;"
                          onmouseover="this.style.opacity='1'; this.style.transform='scale(1.2)';"
                          onmouseout="this.style.opacity='0.6'; this.style.transform='scale(1)';"
                          title="Linked to: @(linkedTab?.Name ?? "Unknown roadmap")">
                        🔗
                    </span>
                }
            </div>
        }

        @if (hasSubtitleText)
        {
            <div @onclick="@(IsPreviewMode ? null : () => OnTitleClick.InvokeAsync())"
                 style="margin-top: 6px; @(IsPreviewMode ? "" : "cursor: pointer;")">
                <p style="@ThemeService.SubtitleStyle()">@Subtitle</p>
            </div>
        }
    </div>
</div>

@code {
    /// <summary>
    /// The title text to display
    /// </summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>
    /// The subtitle text to display
    /// </summary>
    [Parameter]
    public string? Subtitle { get; set; }

    /// <summary>
    /// The linked roadmap ID
    /// </summary>
    [Parameter]
    public string? LinkedRoadmapId { get; set; }

    /// <summary>
    /// The session manager for accessing available roadmaps
    /// </summary>
    [Parameter]
    public SessionManager? SessionManager { get; set; }

    /// <summary>
    /// Whether the component is in preview mode (disables editing)
    /// </summary>
    [Parameter]
    public bool IsPreviewMode { get; set; }

    /// <summary>
    /// Whether vibe mode is enabled for styling
    /// </summary>
    [Parameter]
    public bool IsVibeMode { get; set; }

    /// <summary>
    /// Callback fired when the title or subtitle is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnTitleClick { get; set; }

    /// <summary>
    /// Callback fired when a roadmap link icon is clicked
    /// </summary>
    [Parameter]
    public EventCallback<string> OnRoadmapLinkClick { get; set; }

    /// <summary>
    /// Determines CSS classes based on preview mode
    /// </summary>
    private string GetElementClass()
    {
        if (IsPreviewMode) return "";
        return "clickable-element";
    }
}
