@using RoadScript.Models
@using RoadScript.Services
@inject ThemeService ThemeService
@inject SelectionState SelectionState

<div style="flex: 1; display: flex; flex-direction: column;">
    @* Column Headers *@
    <div style="@ThemeService.ColumnHeaderContainerStyle()">
        @for (int i = 0; i < Data.Columns.Count; i++)
        {
            var col = Data.Columns[i];
            var colIndex = i;
            var colIsNull = IsColumnEmpty(i);
            var hasTitle = !string.IsNullOrWhiteSpace(col.Label);
            var hasSub = !string.IsNullOrWhiteSpace(col.Sub);
            var hasIcon = !string.IsNullOrEmpty(col.Icon);
            <div @onclick="@(IsPreviewMode || colIsNull ? null : () => OnColumnClick.InvokeAsync(new ColumnClickEventArgs { Index = colIndex, Column = col }))"
                 class="@(colIsNull ? "" : GetElementClass($"columns[{colIndex}]"))"
                 style="@ThemeService.ColumnHeaderStyle(i, colIsNull)">
                @if (!colIsNull)
                {
                    @if (hasIcon && hasTitle)
                    {
                        @* Icon inline with title *@
                        <div style="display: flex; align-items: center; gap: 6px; margin-bottom: 2px;">
                            <Icon IconType="@col.Icon" Color="@(col.Color ?? "#667eea")" Size="14" DropShadow="true" />
                            <span style="@ThemeService.ColumnLabelStyle()">@col.Label</span>
                        </div>
                        @if (hasSub)
                        {
                            <span style="@ThemeService.ColumnSubStyle()">@col.Sub</span>
                        }
                    }
                    else if (hasIcon && !hasTitle)
                    {
                        @* Large centered icon (no title) *@
                        <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; height: 100%;">
                            <Icon IconType="@col.Icon" Color="@(col.Color ?? "#667eea")" Size="@(hasSub ? 24 : 28)" DropShadow="true" />
                            @if (hasSub)
                            {
                                <span style="@ThemeService.ColumnSubStyle()">@col.Sub</span>
                            }
                        </div>
                    }
                    else
                    {
                        @* Text only *@
                        @if (hasTitle)
                        {
                            <span style="@ThemeService.ColumnLabelStyle()">@col.Label</span>
                        }
                        @if (hasSub)
                        {
                            <span style="@ThemeService.ColumnSubStyle()">@col.Sub</span>
                        }
                    }
                }
            </div>
        }
    </div>

    @* Milestone Scale - conditionally rendered only when global milestones exist *@
    @{
        var globalMilestones = Data.Milestones?.Where(m => m.LaneIndex == null).ToList()
                              ?? new List<Milestone>();
    }
    @if (globalMilestones.Count > 0)
    {
        <div style="@ThemeService.MilestoneScaleContainerStyle()">
            @foreach (var milestone in globalMilestones)
            {
                var msIndex = Data.Milestones!.IndexOf(milestone);
                <div id="@($"milestone-{msIndex}")"
                     @onclick="@(IsPreviewMode ? null : () => OnMilestoneClick.InvokeAsync(new MilestoneClickEventArgs { Index = msIndex, Milestone = milestone }))"
                     @onclick:stopPropagation="@(!IsPreviewMode)"
                     class="@GetElementClass($"milestones[{msIndex}]")"
                     style="@ThemeService.MilestoneStyle(milestone.Start)">
                    <div style="@ThemeService.MilestoneContainerStyle()">
                        <Icon IconType="@(milestone.Icon ?? "diamond")"
                              Color="@milestone.Color"
                              Size="24"
                              DropShadow="true" />
                        @if (!string.IsNullOrWhiteSpace(milestone.Title))
                        {
                            <span style="@ThemeService.MilestoneLabelStyle(milestone.Color)">
                                @milestone.Title
                            </span>
                        }
                    </div>
                </div>
            }
        </div>
    }

    @* Grid with lanes and items *@
    <div style="flex: 1; position: relative;">
        <div style="position: absolute; inset: 0; display: flex; pointer-events: none;">
            @for (int i = 0; i < Data.Columns.Count; i++)
            {
                <div style="@GridColumnStyle(i, IsColumnEmpty(i))"></div>
            }
        </div>

        @for (int li = 0; li < Data.Lanes.Count; li++)
        {
            var lane = Data.Lanes[li];
            var laneIdx = li;
            <div style="@LaneRowStyle(li, lane)" data-lane-index="@laneIdx">
                @* In-lane milestones: rendered above items via z-index *@
                @if (Data.Milestones != null)
                {
                    @foreach (var inLaneMilestone in Data.Milestones.Where(m => m.LaneIndex == laneIdx))
                    {
                        var ilMsIndex = Data.Milestones.IndexOf(inLaneMilestone);
                        <div id="@($"milestone-{ilMsIndex}")"
                             @onclick="@(IsPreviewMode ? null : () => OnMilestoneClick.InvokeAsync(new MilestoneClickEventArgs { Index = ilMsIndex, Milestone = inLaneMilestone }))"
                             @onclick:stopPropagation="@(!IsPreviewMode)"
                             class="@GetElementClass($"milestones[{ilMsIndex}]")"
                             style="@ThemeService.InLaneMilestoneStyle(inLaneMilestone)">
                            <div style="@ThemeService.InLaneMilestoneContainerStyle()">
                                <Icon IconType="@(inLaneMilestone.Icon ?? "diamond")"
                                      Color="@inLaneMilestone.Color"
                                      Size="24"
                                      DropShadow="true" />
                                @if (!string.IsNullOrWhiteSpace(inLaneMilestone.Title))
                                {
                                    <span style="@ThemeService.MilestoneLabelStyle(inLaneMilestone.Color)">
                                        @inLaneMilestone.Title
                                    </span>
                                }
                            </div>
                        </div>
                    }
                }
                @for (int ii = 0; ii < lane.Items.Count; ii++)
                {
                    var item = lane.Items[ii];
                    var itemIdx = ii;

                    @if (!(IsPreviewMode && item.Hidden))
                    {
                        <div id="@($"item-{laneIdx}-{itemIdx}")"
                             @onclick="@(IsPreviewMode ? null : () => OnItemClick.InvokeAsync(new ItemClickEventArgs { LaneIndex = laneIdx, ItemIndex = itemIdx, Item = item }))"
                             @onclick:stopPropagation="@(!IsPreviewMode)"
                             class="@GetElementClass($"lanes[{laneIdx}].items[{itemIdx}]") roadmap-item-resizable"
                             style="@ItemStyle(item, lane, itemIdx)"
                             data-lane-index="@laneIdx"
                             data-item-index="@itemIdx">
                        @{
                            var hasDescription = RoadScript.Services.MarkdownRenderer.HasContent(item.Description);
                            var hasSubContent = RoadScript.Services.MarkdownRenderer.HasSubContent(item.Description);
                            // Backward compat: check legacy details if no description yet
                            var hasLegacyDetails = !hasDescription && item.Details != null && item.Details.Count > 0;
                            var hasDetails = hasDescription || hasLegacyDetails;
                            var hasSubs = hasSubContent || (hasLegacyDetails && item.Details!.Any(d => d.Subs != null && d.Subs.Count > 0));
                            var hasTitle = !string.IsNullOrWhiteSpace(item.Title);
                        }
                        <div style="@ThemeService.ItemHeaderStyle(hasDetails, hasSubs, hasTitle, item.Length, item.Color ?? lane.Color)">
                            @if (!string.IsNullOrEmpty(item.Icon))
                            {
                                <Icon IconType="@item.Icon"
                                      Color="@(item.Color ?? "#10b981")"
                                      Size="@ThemeService.GetIconSize(hasDetails, hasSubs, hasTitle)"
                                      DropShadow="true" />
                            }
                            @if (hasTitle)
                            {
                                <h4 style="@ThemeService.ItemTitleStyle(hasDetails, hasSubs)">
                                    @item.Title
                                </h4>
                            }
                            @if (!string.IsNullOrEmpty(item.LinkedRoadmapId))
                            {
                                var linkedTab = SessionManager?.Tabs.FirstOrDefault(t => t.Id == item.LinkedRoadmapId);
                                <span @onclick="@(() => OnRoadmapLinkClick.InvokeAsync(item.LinkedRoadmapId))"
                                      @onclick:stopPropagation="true"
                                      style="margin-left: auto; font-size: 14px; cursor: pointer; opacity: 0.9; transition: opacity 0.2s, transform 0.2s;"
                                      onmouseover="this.style.opacity='1'; this.style.transform='scale(1.15)';"
                                      onmouseout="this.style.opacity='0.9'; this.style.transform='scale(1)';"
                                      title="Linked to: @(linkedTab?.Name ?? "Unknown roadmap")">
                                    🔗
                                </span>
                            }
                            @if (item.Hidden && !IsPreviewMode)
                            {
                                <span style="margin-left: auto; font-size: 16px; opacity: 0.5;" title="Hidden in preview mode">👁</span>
                            }
                        </div>
                        @if (hasDescription)
                        {
                            <div style="margin: 0; padding: 0;">
                                @((MarkupString)RoadScript.Services.MarkdownRenderer.RenderToHtml(item.Description, lane.Color))
                            </div>
                        }
                        else if (hasLegacyDetails)
                        {
                            @* Backward compat: render legacy details until migrated *@
                            <ul style="margin: 0; padding: 0; list-style: none;">
                                @foreach (var detail in item.Details!)
                                {
                                    <li style="@ThemeService.DetailItemStyle(detail)">
                                        <div style="@ThemeService.DetailTextStyle(lane.Color)">
                                            <span style="@ThemeService.BulletStyle(lane.Color)">•</span>
                                            @detail.Text
                                        </div>
                                        @if (detail.Subs != null && detail.Subs.Count > 0)
                                        {
                                            <ul style="margin: 2px 0 4px 0; padding: 0; list-style: none;">
                                                @foreach (var sub in detail.Subs)
                                                {
                                                    <li style="@ThemeService.SubBulletStyle()">
                                                        <span style="@ThemeService.SubBulletDashStyle()">–</span>
                                                        @sub
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                    }
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public RoadmapData Data { get; set; } = null!;
    [Parameter] public bool IsPreviewMode { get; set; }
    [Parameter] public List<RoadmapReference>? AvailableRoadmaps { get; set; }
    [Parameter] public SessionManager? SessionManager { get; set; }

    [Parameter] public EventCallback<ColumnClickEventArgs> OnColumnClick { get; set; }
    [Parameter] public EventCallback<MilestoneClickEventArgs> OnMilestoneClick { get; set; }
    [Parameter] public EventCallback<ItemClickEventArgs> OnItemClick { get; set; }
    [Parameter] public EventCallback<string> OnRoadmapLinkClick { get; set; }

    // Returns true when a column has no visible content — used to suppress its rendering.
    private bool IsColumnEmpty(int index)
    {
        if (index < 0 || index >= Data.Columns.Count) return false;
        var col = Data.Columns[index];
        return string.IsNullOrWhiteSpace(col.Label) &&
               string.IsNullOrWhiteSpace(col.Sub) &&
               string.IsNullOrEmpty(col.Icon);
    }

    private string GetElementClass(string jsonPath)
    {
        if (IsPreviewMode) return "";

        var baseClass = "clickable-element";
        if (SelectionState.SelectedPath == jsonPath)
        {
            baseClass += " selected-element";
        }
        return baseClass;
    }

    private string GridColumnStyle(int index, bool isNull = false)
    {
        return ThemeService.GridColumnStyle(index, Data.Columns.Count, isNull);
    }

    private string LaneRowStyle(int index, Lane lane)
    {
        return ThemeService.LaneRowStyle(index, lane, Data.Lanes.Count, Data);
    }

    private string ItemStyle(Item item, Lane lane, int itemIdx)
    {
        return ThemeService.ItemStyle(item, lane, itemIdx, Data.Columns.Count, Data);
    }
}
