@using RoadScript.Models

<div class="property-editor">
    <div class="form-group">
        <label>Title</label>
        <input type="text"
               value="@Item.Title"
               @onchange="@(e => OnChange.InvokeAsync(("title", e.Value)))"
               class="form-control" />
    </div>

    <div class="form-row">
        <div class="form-group" style="flex: 1;">
            <label>Start Position</label>
            <input type="number"
                   value="@Item.Start"
                   @onchange="@(e => OnChange.InvokeAsync(("start", double.Parse(e.Value?.ToString() ?? "0"))))"
                   class="form-control"
                   step="0.25"
                   min="0" />
        </div>

        <div class="form-group" style="flex: 1; margin-left: 12px;">
            <label>Span</label>
            <input type="number"
                   value="@Item.Span"
                   @onchange="@(e => OnChange.InvokeAsync(("span", double.Parse(e.Value?.ToString() ?? "1"))))"
                   class="form-control"
                   step="0.25"
                   min="0.25" />
        </div>
    </div>

    <div class="form-group">
        <label>Position Slider</label>
        <input type="range"
               value="@Item.Start"
               @onchange="@(e => OnChange.InvokeAsync(("start", double.Parse(e.Value?.ToString() ?? "0"))))"
               min="0"
               max="@GetMaxPosition()"
               step="0.25"
               class="form-range" />
        <div style="display: flex; justify-content: space-between; font-size: 11px; color: #888; margin-top: 4px;">
            <span>Start</span>
            <span>End</span>
        </div>
    </div>

    <div class="form-group">
        <label style="display: flex; align-items: center; cursor: pointer;">
            <input type="checkbox"
                   checked="@Item.Spanning"
                   @onchange="@(e => OnChange.InvokeAsync(("spanning", (bool)(e.Value ?? false))))"
                   style="margin-right: 8px; cursor: pointer;" />
            Spanning (dashed border)
        </label>
    </div>

    <div class="form-group">
        <label style="margin-bottom: 12px;">Status Icon</label>
        <div style="background: #252538; padding: 12px; border-radius: 6px; border: 1px solid #3a3a4e;">
            @if (!string.IsNullOrEmpty(Item.StatusIcon))
            {
                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                    <Icon IconType="@Item.StatusIcon"
                          Color="@(Item.StatusColor ?? "#667eea")"
                          Size="24"
                          DropShadow="true" />
                    <span style="color: #d1d5db;">@Item.StatusIcon</span>
                    <button @onclick="ClearStatusIcon" type="button" class="btn-remove" style="margin-left: auto;">Clear</button>
                </div>
            }

            <IconPicker SelectedIcon="@(Item.StatusIcon ?? "")"
                       Color="@(Item.StatusColor ?? "#667eea")"
                       OnIconSelected="HandleStatusIconSelected"
                       ShowCategories="true"
                       ColumnsPerRow="5" />

            <div style="margin-top: 12px;">
                <label style="font-size: 11px; margin-bottom: 4px;">Status Color</label>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <input type="color"
                           value="@(Item.StatusColor ?? "#667eea")"
                           @onchange="@(e => OnChange.InvokeAsync(("statusColor", e.Value)))"
                           style="width: 40px; height: 32px; border: 1px solid #3a3a4e; border-radius: 4px; cursor: pointer; background: #2a2a3e;" />
                    <input type="text"
                           value="@(Item.StatusColor ?? "#667eea")"
                           @onchange="@(e => OnChange.InvokeAsync(("statusColor", e.Value)))"
                           class="form-control"
                           placeholder="#667eea"
                           style="flex: 1; font-size: 12px;" />
                </div>
            </div>
        </div>
        <div style="font-size: 11px; color: #888; margin-top: 4px;">
            Choose an icon and color to represent item status (replaces the old checkmark)
        </div>
    </div>

    <div class="form-group">
        <label style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <span>Details</span>
            <button @onclick="AddDetail" class="btn-add" type="button">+ Add Detail</button>
        </label>

        @if (Item.Details != null && Item.Details.Count > 0)
        {
            @for (int i = 0; i < Item.Details.Count; i++)
            {
                var index = i;
                var detail = Item.Details[i];
                <div style="background: #252538; padding: 12px; border-radius: 6px; margin-bottom: 12px; border: 1px solid #3a3a4e;">
                    <div class="detail-item">
                        <input type="text"
                               value="@detail.Text"
                               @onchange="@(e => UpdateDetailText(index, e.Value?.ToString() ?? ""))"
                               class="form-control"
                               placeholder="Detail text"
                               style="flex: 1;" />
                        <button @onclick="() => RemoveDetail(index)" class="btn-remove" type="button">×</button>
                    </div>

                    @* Sub-bullets section *@
                    <div style="margin-top: 10px; padding-left: 8px;">
                        <label style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                            <span style="font-size: 11px; color: #888;">Sub-items</span>
                            <button @onclick="() => AddSubBullet(index)" class="btn-add" type="button" style="font-size: 11px; padding: 4px 10px;">+ Add Sub</button>
                        </label>

                        @if (detail.Subs != null && detail.Subs.Count > 0)
                        {
                            @for (int j = 0; j < detail.Subs.Count; j++)
                            {
                                var subIndex = j;
                                var sub = detail.Subs[j];
                                <div style="display: flex; gap: 6px; align-items: center; margin-bottom: 6px;">
                                    <span style="color: #666; font-size: 12px;">–</span>
                                    <input type="text"
                                           value="@sub"
                                           @onchange="@(e => UpdateSubBullet(index, subIndex, e.Value?.ToString() ?? ""))"
                                           class="form-control"
                                           placeholder="Sub-item text"
                                           style="font-size: 12px; padding: 6px 10px;" />
                                    <button @onclick="() => RemoveSubBullet(index, subIndex)"
                                            class="btn-remove"
                                            type="button"
                                            style="width: 24px; height: 24px; font-size: 14px;">×</button>
                                </div>
                            }
                        }
                        else
                        {
                            <div style="color: #555; font-size: 11px; font-style: italic; padding-left: 8px;">No sub-items</div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div style="color: #666; font-size: 12px; font-style: italic;">No details added yet</div>
        }
    </div>

    @* Item Management Section *@
    <div class="form-group" style="margin-top: 24px; padding-top: 16px; border-top: 1px solid #3a3a4e;">
        <label style="margin-bottom: 12px; font-weight: 600; color: #e0e7ff;">Item Management</label>

        <button @onclick="AddItem" class="btn-add" type="button" style="width: 100%; margin-bottom: 8px;">
            + Add New Item
        </button>

        <button @onclick="DuplicateItem" type="button" style="width: 100%; margin-bottom: 8px; background: #667eea; color: #fff; border: none; padding: 8px 16px; border-radius: 4px; font-size: 13px; font-weight: 500; cursor: pointer; transition: all 0.2s;">
            📋 Duplicate This Item
        </button>

        <button @onclick="RemoveItem" class="btn-danger" type="button" style="width: 100%;">
            Remove This Item
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Item Item { get; set; } = null!;

    [Parameter, EditorRequired]
    public string JsonPath { get; set; } = "";

    [Parameter]
    public EventCallback<(string PropertyName, object Value)> OnChange { get; set; }

    [Parameter]
    public EventCallback<string> OnAdd { get; set; }

    [Parameter]
    public EventCallback<string> OnRemove { get; set; }

    [Parameter]
    public EventCallback<string> OnDuplicate { get; set; }

    private double GetMaxPosition()
    {
        // Assume 4 columns for now, can be made dynamic later
        return 4.0;
    }

    private void AddDetail()
    {
        Item.Details ??= new List<Detail>();
        Item.Details.Add(new Detail { Text = "New detail", Subs = new List<string>() });
        OnChange.InvokeAsync(("details", Item.Details));
    }

    private void RemoveDetail(int index)
    {
        if (Item.Details != null && index < Item.Details.Count)
        {
            Item.Details.RemoveAt(index);
            OnChange.InvokeAsync(("details", Item.Details));
        }
    }

    private void UpdateDetailText(int index, string text)
    {
        if (Item.Details != null && index < Item.Details.Count)
        {
            Item.Details[index].Text = text;
            OnChange.InvokeAsync(("details", Item.Details));
        }
    }

    private void AddSubBullet(int detailIndex)
    {
        if (Item.Details != null && detailIndex < Item.Details.Count)
        {
            Item.Details[detailIndex].Subs ??= new List<string>();
            Item.Details[detailIndex].Subs.Add("New sub-item");
            OnChange.InvokeAsync(("details", Item.Details));
        }
    }

    private void RemoveSubBullet(int detailIndex, int subIndex)
    {
        if (Item.Details != null && detailIndex < Item.Details.Count &&
            Item.Details[detailIndex].Subs != null && subIndex < Item.Details[detailIndex].Subs.Count)
        {
            Item.Details[detailIndex].Subs.RemoveAt(subIndex);
            OnChange.InvokeAsync(("details", Item.Details));
        }
    }

    private void UpdateSubBullet(int detailIndex, int subIndex, string text)
    {
        if (Item.Details != null && detailIndex < Item.Details.Count &&
            Item.Details[detailIndex].Subs != null && subIndex < Item.Details[detailIndex].Subs.Count)
        {
            Item.Details[detailIndex].Subs[subIndex] = text;
            OnChange.InvokeAsync(("details", Item.Details));
        }
    }

    private void AddItem()
    {
        OnAdd.InvokeAsync("item");
    }

    private void DuplicateItem()
    {
        OnDuplicate.InvokeAsync("item");
    }

    private void RemoveItem()
    {
        OnRemove.InvokeAsync("item");
    }

    private async Task HandleStatusIconSelected(string iconValue)
    {
        await OnChange.InvokeAsync(("statusIcon", iconValue));
    }

    private async Task ClearStatusIcon()
    {
        await OnChange.InvokeAsync(("statusIcon", ""));
    }
}
