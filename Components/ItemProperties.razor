@using RoadScript.Models

<style>
    /* Hide number input spinner arrows */
    input[type="number"]::-webkit-inner-spin-button,
    input[type="number"]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
    input[type="number"] {
        -moz-appearance: textfield;
    }
</style>

<div class="property-editor">
    <div class="form-group">
        <label>Title</label>
        <input type="text"
               value="@Item.Title"
               @onchange="@(e => OnChange.InvokeAsync(("title", e.Value)))"
               class="form-control" />
    </div>

    <div class="form-group">
        <label style="margin-bottom: 8px;">Length</label>

        @* Quick Span Buttons with inline editable value *@
        <div style="display: flex; align-items: center; gap: 4px; margin-bottom: 12px;">
            <button type="button"
                    @onclick="@(() => ResetSpanToDefault())"
                    title="Reset span to default (2 columns)"
                    style="width: 38px; min-height: 32px; background: #252538; color: #ccc; border: 1px solid #3a3a4e; border-radius: 4px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; font-weight: 500; padding: 2px; flex-shrink: 0;">
                <div style="font-size: 16px; font-weight: 600;">↻</div>
            </button>
            <button type="button"
                    @onclick="@(() => AdjustSpan(-1.0))"
                    title="Big Down (-1 column)"
                    style="width: 32px; min-height: 32px; background: #252538; color: #ccc; border: 1px solid #3a3a4e; border-radius: 4px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; padding: 2px; flex-shrink: 0;">
                <div style="font-size: 16px; line-height: 1;">⏪</div>
            </button>
            <button type="button"
                    @onclick="@(() => AdjustSpan(-0.25))"
                    title="Little Down (-0.25)"
                    style="width: 32px; min-height: 32px; background: #252538; color: #ccc; border: 1px solid #3a3a4e; border-radius: 4px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; padding: 2px; flex-shrink: 0;">
                <div style="font-size: 14px; line-height: 1;">◀</div>
            </button>

            @* Editable Numeric Value *@
            <input type="number"
                   value="@Item.Length"
                   @onchange="@(e => OnChange.InvokeAsync(("length", double.Parse(e.Value?.ToString() ?? "0.25"))))"
                   style="flex: 1; min-width: 55px; text-align: center; background: #1a1a2e; border: 1px solid #667eea; border-radius: 4px; padding: 6px 4px; font-weight: 600; color: #667eea; font-size: 13px;"
                   step="0.25"
                   min="0.25"
                   max="@GetMaxPosition()" />

            <button type="button"
                    @onclick="@(() => AdjustSpan(0.25))"
                    title="Little Up (+0.25)"
                    style="width: 32px; min-height: 32px; background: #252538; color: #ccc; border: 1px solid #3a3a4e; border-radius: 4px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; padding: 2px; flex-shrink: 0;">
                <div style="font-size: 14px; line-height: 1;">▶</div>
            </button>
            <button type="button"
                    @onclick="@(() => AdjustSpan(1.0))"
                    title="Big Up (+1 column)"
                    style="width: 32px; min-height: 32px; background: #252538; color: #ccc; border: 1px solid #3a3a4e; border-radius: 4px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; padding: 2px; flex-shrink: 0;">
                <div style="font-size: 16px; line-height: 1;">⏩</div>
            </button>
            <button type="button"
                    @onclick="@(() => SetSpanToEnd())"
                    title="Fit to End"
                    style="width: 38px; min-height: 32px; background: #252538; color: #ccc; border: 1px solid #3a3a4e; border-radius: 4px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; font-weight: 500; padding: 2px; flex-shrink: 0;">
                <div style="font-size: 9px; font-weight: 600;">⏭</div>
            </button>
        </div>
    </div>

    <div class="form-group">
        <label style="margin-bottom: 8px;">Position</label>

        @* Quick Position Buttons with inline editable value *@
        <div style="display: flex; align-items: center; gap: 4px; margin-bottom: 12px;">
            <button type="button"
                    @onclick="@(() => JumpToStart())"
                    title="Jump to Start (0)"
                    style="width: 38px; min-height: 32px; background: #252538; color: #ccc; border: 1px solid #3a3a4e; border-radius: 4px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; font-weight: 500; padding: 2px; flex-shrink: 0;">
                <div style="font-size: 9px; font-weight: 600;">⏮</div>
            </button>
            <button type="button"
                    @onclick="@(() => AdjustPosition(-1.0))"
                    title="Big Down (-1 column)"
                    style="width: 32px; min-height: 32px; background: #252538; color: #ccc; border: 1px solid #3a3a4e; border-radius: 4px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; padding: 2px; flex-shrink: 0;">
                <div style="font-size: 16px; line-height: 1;">⏪</div>
            </button>
            <button type="button"
                    @onclick="@(() => AdjustPosition(-0.25))"
                    title="Little Down (-0.25)"
                    style="width: 32px; min-height: 32px; background: #252538; color: #ccc; border: 1px solid #3a3a4e; border-radius: 4px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; padding: 2px; flex-shrink: 0;">
                <div style="font-size: 14px; line-height: 1;">◀</div>
            </button>

            @* Editable Numeric Value *@
            <input type="number"
                   value="@Item.Start"
                   @onchange="@(e => OnChange.InvokeAsync(("start", double.Parse(e.Value?.ToString() ?? "0"))))"
                   style="flex: 1; min-width: 55px; text-align: center; background: #1a1a2e; border: 1px solid #667eea; border-radius: 4px; padding: 6px 4px; font-weight: 600; color: #667eea; font-size: 13px;"
                   step="0.25"
                   min="0"
                   max="@GetMaxPosition()" />

            <button type="button"
                    @onclick="@(() => AdjustPosition(0.25))"
                    title="Little Up (+0.25)"
                    style="width: 32px; min-height: 32px; background: #252538; color: #ccc; border: 1px solid #3a3a4e; border-radius: 4px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; padding: 2px; flex-shrink: 0;">
                <div style="font-size: 14px; line-height: 1;">▶</div>
            </button>
            <button type="button"
                    @onclick="@(() => AdjustPosition(1.0))"
                    title="Big Up (+1 column)"
                    style="width: 32px; min-height: 32px; background: #252538; color: #ccc; border: 1px solid #3a3a4e; border-radius: 4px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; padding: 2px; flex-shrink: 0;">
                <div style="font-size: 16px; line-height: 1;">⏩</div>
            </button>
            <button type="button"
                    @onclick="@(() => JumpToEnd())"
                    title="Jump to End (max position based on span)"
                    style="width: 38px; min-height: 32px; background: #252538; color: #ccc; border: 1px solid #3a3a4e; border-radius: 4px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; font-weight: 500; padding: 2px; flex-shrink: 0;">
                <div style="font-size: 9px; font-weight: 600;">⏭</div>
            </button>
        </div>

        <input type="range"
               value="@Item.Start"
               @onchange="@(e => OnChange.InvokeAsync(("start", double.Parse(e.Value?.ToString() ?? "0"))))"
               min="0"
               max="@GetMaxPosition()"
               step="0.25"
               class="form-range" />
        <div style="display: flex; justify-content: space-between; font-size: 11px; color: #888; margin-top: 4px;">
            <span>Start</span>
            <span>End</span>
        </div>
    </div>

    @* Item Display Options - Icon-based toggles *@
    <div class="form-group">
        <label style="font-size: 11px; margin-bottom: 8px; color: #888;">Display Options</label>
        <div style="display: flex; gap: 8px;">
            @* Spanning Toggle *@
            <button type="button"
                    @onclick="@(() => OnChange.InvokeAsync(("spanning", !Item.Spanning)))"
                    title="Spanning: Dashed border for ongoing work"
                    style="@GetToggleButtonStyle(Item.Spanning)">
                <span style="font-size: 24px;">⋯⋯</span>
            </button>

            @* Greyed Out Toggle *@
            <button type="button"
                    @onclick="@(() => OnChange.InvokeAsync(("greyed", !Item.Greyed)))"
                    title="Greyed Out: Reduced opacity with grey shadow"
                    style="@GetToggleButtonStyle(Item.Greyed)">
                <span style="font-size: 24px;">◐</span>
            </button>

            @* Hidden Toggle *@
            <button type="button"
                    @onclick="@(() => OnChange.InvokeAsync(("hidden", !Item.Hidden)))"
                    title="Hidden: Hide in preview/export mode only"
                    style="@GetToggleButtonStyle(Item.Hidden)">
                <span style="font-size: 24px;">👁</span>
            </button>
        </div>
    </div>

    @* Roadmap Linking *@
    @if (AvailableRoadmaps != null && AvailableRoadmaps.Count > 1)
    {
        <div class="form-group">
            <label style="font-size: 11px; margin-bottom: 8px; color: #888;">Linked Roadmap</label>
            <select value="@(Item.LinkedRoadmapId ?? "")"
                    @onchange="@(e => OnChange.InvokeAsync(("linkedRoadmapId", string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString())))"
                    class="form-control"
                    style="background: #252538; color: #e0e7ff; border: 1px solid #3a3a4e; border-radius: 6px; padding: 8px 12px; font-size: 13px;">
                <option value="">None</option>
                @foreach (var roadmap in AvailableRoadmaps)
                {
                    if (roadmap.IsCurrentTab)
                    {
                        continue; // Skip current roadmap to prevent self-linking
                    }
                    <option value="@roadmap.FullId">
                        @if (roadmap.IsCurrentFolder)
                        {
                            <text>  🔗 @roadmap.TabName</text>
                        }
                        else
                        {
                            <text>📁 @roadmap.FolderName → @roadmap.TabName</text>
                        }
                    </option>
                }
            </select>
            @if (!string.IsNullOrEmpty(Item.LinkedRoadmapId))
            {
                <div style="margin-top: 6px; padding: 8px; background: rgba(102, 126, 234, 0.1); border: 1px solid rgba(102, 126, 234, 0.3); border-radius: 4px; font-size: 11px; color: #a5b4fc;">
                    🔗 Click the link icon on the item to navigate
                </div>
            }
        </div>
    }

    <div class="form-group">
        <label style="font-size: 11px; margin-bottom: 8px; color: #888;">Status Icon</label>

        @* Large Icon Preview Button - Similar to Display Options *@
        <div style="position: relative;">
            <button type="button"
                    @onclick="ToggleStatusIconPicker"
                    title="Click to @(_statusIconPickerExpanded ? "hide" : "choose") status icon"
                    style="width: 100%; min-height: 80px; background: #252538; border: 1px solid #3a3a4e; border-radius: 6px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; padding: 16px; position: relative;">
                @if (!string.IsNullOrEmpty(Item.Icon))
                {
                    <Icon IconType="@Item.Icon"
                          Color="@(Item.Color ?? "#667eea")"
                          Size="36"
                          DropShadow="true" />
                }
                else
                {
                    @* Placeholder for empty state *@
                    <span style="font-size: 36px; opacity: 0.3; color: #fff;">✦</span>
                }

                @* Dropdown indicator in bottom right *@
                <span style="position: absolute; bottom: 8px; right: 8px; font-size: 12px; color: #666; transition: transform 0.2s; transform: rotate(@(_statusIconPickerExpanded ? "180deg" : "0deg"));">▼</span>
            </button>

            @* Clear button overlay in top right corner *@
            @if (!string.IsNullOrEmpty(Item.Icon))
            {
                <button @onclick="ClearStatusIcon"
                        @onclick:stopPropagation="true"
                        type="button"
                        title="Clear icon"
                        style="position: absolute; top: 6px; right: 6px; width: 24px; height: 24px; background: rgba(0,0,0,0.6); border: 1px solid #555; border-radius: 4px; cursor: pointer; display: flex; align-items: center; justify-content: center; color: #ef4444; font-size: 14px; font-weight: 600; transition: all 0.2s; z-index: 1;">
                    ✕
                </button>
            }
        </div>

        @if (_statusIconPickerExpanded)
        {
            <div style="background: #252538; padding: 12px; border-radius: 6px; border: 1px solid #3a3a4e; margin-top: 8px;">
                <IconPicker SelectedIcon="@(Item.Icon ?? "")"
                           Color="@(Item.Color ?? "#667eea")"
                           OnIconSelected="HandleStatusIconSelectedAndCollapse"
                           ShowCategories="true"
                           ColumnsPerRow="5" />

                <div style="margin-top: 12px;">
                    <label style="font-size: 11px; margin-bottom: 8px;">Status Color</label>

                    @* Preset Color Options *@
                    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin-bottom: 10px;">
                        @foreach (var preset in _colorPresets)
                        {
                            <button type="button"
                                    @onclick="@(() => OnChange.InvokeAsync(("color", preset.Value)))"
                                    title="@preset.Name"
                                    style="@GetPresetColorButtonStyle(preset.Value, Item.Color)">
                                <span style="width: 100%; height: 100%; display: block; border-radius: 3px; background: @preset.Value;"></span>
                            </button>
                        }
                    </div>

                    <div style="display: flex; align-items: center; gap: 8px;">
                        <input type="color"
                               value="@(Item.Color ?? "#667eea")"
                               @onchange="@(e => OnChange.InvokeAsync(("color", e.Value)))"
                               style="width: 40px; height: 32px; border: 1px solid #3a3a4e; border-radius: 4px; cursor: pointer; background: #2a2a3e;" />
                        <input type="text"
                               value="@(Item.Color ?? "#667eea")"
                               @onchange="@(e => OnChange.InvokeAsync(("color", e.Value)))"
                               class="form-control"
                               placeholder="#667eea"
                               style="flex: 1; font-size: 12px;" />
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="form-group">
        <label style="margin-bottom: 12px; font-weight: 600; color: #e0e7ff;">Details</label>

        @if (Item.Details != null && Item.Details.Count > 0)
        {
            @for (int i = 0; i < Item.Details.Count; i++)
            {
                var index = i;
                var detail = Item.Details[i];
                <div style="background: #252538; padding: 12px; border-radius: 6px; margin-bottom: 12px; border: 1px solid #3a3a4e;">
                    <div style="display: flex; gap: 8px; align-items: center; margin-bottom: 10px;">
                        <input type="text"
                               value="@detail.Text"
                               @onchange="@(e => UpdateDetailText(index, e.Value?.ToString() ?? ""))"
                               class="form-control"
                               placeholder="Detail text"
                               style="flex: 1;" />
                        <button @onclick="() => RemoveDetail(index)"
                                type="button"
                                title="Remove detail"
                                style="width: 36px; height: 36px; background: linear-gradient(135deg, rgba(239, 68, 68, 0.2) 0%, rgba(220, 38, 38, 0.1) 100%); color: #ef4444; border: 2px solid #ef4444; border-radius: 6px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0;">
                            🗑️
                        </button>
                    </div>

                    @* Sub-bullets section *@
                    <div style="margin-top: 10px; padding-left: 8px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                            <span style="font-size: 11px; color: #888; font-weight: 600;">Sub-items</span>
                            <button @onclick="() => AddSubBullet(index)"
                                    type="button"
                                    title="Add sub-item"
                                    style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; border: none; padding: 4px 12px; border-radius: 4px; font-size: 11px; font-weight: 600; cursor: pointer; transition: all 0.2s; box-shadow: 0 2px 4px rgba(102, 126, 234, 0.3);">
                                + Sub
                            </button>
                        </div>

                        @if (detail.Subs != null && detail.Subs.Count > 0)
                        {
                            @for (int j = 0; j < detail.Subs.Count; j++)
                            {
                                var subIndex = j;
                                var sub = detail.Subs[j];
                                <div style="display: flex; gap: 6px; align-items: center; margin-bottom: 6px;">
                                    <span style="color: #666; font-size: 12px;">–</span>
                                    <input type="text"
                                           value="@sub"
                                           @onchange="@(e => UpdateSubBullet(index, subIndex, e.Value?.ToString() ?? ""))"
                                           class="form-control"
                                           placeholder="Sub-item text"
                                           style="font-size: 12px; padding: 6px 10px; flex: 1;" />
                                    <button @onclick="() => RemoveSubBullet(index, subIndex)"
                                            type="button"
                                            title="Remove sub-item"
                                            style="width: 28px; height: 28px; background: rgba(239, 68, 68, 0.15); color: #ef4444; border: 1px solid #ef4444; border-radius: 4px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0; font-weight: 700;">
                                        ×
                                    </button>
                                </div>
                            }
                        }
                        else
                        {
                            <div style="color: #555; font-size: 11px; font-style: italic; padding-left: 8px;">No sub-items</div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div style="color: #666; font-size: 12px; font-style: italic; padding: 12px; text-align: center; background: #1a1a2e; border-radius: 6px; border: 1px solid #3a3a4e;">No details added yet</div>
        }

        @* Large Add Detail Button *@
        <button @onclick="AddDetail"
                type="button"
                title="Add new detail to this item"
                style="width: 100%; height: 48px; background: linear-gradient(135deg, rgba(102, 126, 234, 0.2) 0%, rgba(118, 75, 162, 0.1) 100%); color: #a5b4fc; border: 1px solid rgba(102, 126, 234, 0.4); border-radius: 6px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 14px; font-weight: 600; box-shadow: 0 2px 4px rgba(102, 126, 234, 0.2); margin-top: 12px;">
            <span style="font-size: 20px;">+</span> Add Detail
        </button>
    </div>

    @* Item Management Section *@
    <div class="form-group" style="margin-top: 24px; padding-top: 16px; border-top: 1px solid #3a3a4e;">
        <label style="margin-bottom: 12px; font-weight: 600; color: #e0e7ff;">Item Management</label>

        @* Inline Item Controls: UP | ADD | DUPE | [Position Text] | DOWN | TRASH *@
        <div style="display: flex; gap: 6px; align-items: center; margin-bottom: 12px;">
            <button @onclick="MoveItemUp"
                    disabled="@(ItemIndex == 0)"
                    type="button"
                    title="Move item up"
                    style="@GetInlineUpDownButtonStyle(ItemIndex > 0)">
                ↑
            </button>

            <button @onclick="AddItem"
                    type="button"
                    title="Add new item"
                    style="width: 52px; height: 44px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: #fff; border: none; border-radius: 6px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0; box-shadow: 0 2px 6px rgba(16, 185, 129, 0.3);">
                +
            </button>

            <button @onclick="DuplicateItem"
                    type="button"
                    title="Duplicate this item"
                    style="width: 44px; height: 44px; background: #667eea; color: #fff; border: none; border-radius: 6px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0; box-shadow: 0 2px 6px rgba(102, 126, 234, 0.3);">
                ♻️
            </button>

            @* Position Indicator (inline, flexible width) *@
            <div style="flex: 1; background: #252538; border: 1px solid #3a3a4e; border-radius: 6px; padding: 6px 8px; text-align: center; min-width: 60px;">
                <div style="font-size: 10px; color: #888; line-height: 1;">Position</div>
                <div style="font-size: 13px; font-weight: 600; color: #667eea; line-height: 1.2; margin-top: 2px;">@(ItemIndex + 1)<span style="color: #666; font-weight: 400; font-size: 11px;"> of </span>@ItemCount</div>
            </div>

            <button @onclick="MoveItemDown"
                    disabled="@(ItemIndex >= ItemCount - 1)"
                    type="button"
                    title="Move item down"
                    style="@GetInlineUpDownButtonStyle(ItemIndex < ItemCount - 1)">
                ↓
            </button>

            <button @onclick="RemoveItem"
                    type="button"
                    title="Remove this item"
                    style="width: 44px; height: 44px; background: linear-gradient(135deg, rgba(239, 68, 68, 0.2) 0%, rgba(220, 38, 38, 0.1) 100%); color: #ef4444; border: 2px solid #ef4444; border-radius: 6px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0;">
                🗑️
            </button>
        </div>

        @* Jump Between Lanes Section *@
        <div style="background: #1a1a2e; border: 1px solid #3a3a4e; border-radius: 6px; padding: 10px; margin-bottom: 0;">
            <div style="font-size: 11px; color: #888; margin-bottom: 8px; text-align: center;">Jump to Lane</div>
            <div style="display: flex; gap: 6px;">
                <button @onclick="MoveLaneUp"
                        disabled="@(LaneIndex == 0)"
                        type="button"
                        title="Move to lane above"
                        style="@GetLaneJumpButtonStyle(LaneIndex > 0)">
                    <span style="font-size: 16px;">⬆️</span>
                </button>
                <button @onclick="MoveLaneDown"
                        disabled="@(LaneIndex >= LaneCount - 1)"
                        type="button"
                        title="Move to lane below"
                        style="@GetLaneJumpButtonStyle(LaneIndex < LaneCount - 1)">
                    <span style="font-size: 16px;">⬇️</span>
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Item Item { get; set; } = null!;

    [Parameter, EditorRequired]
    public string JsonPath { get; set; } = "";

    [Parameter]
    public EventCallback<(string PropertyName, object Value)> OnChange { get; set; }

    [Parameter]
    public EventCallback<string> OnAdd { get; set; }

    [Parameter]
    public EventCallback<string> OnRemove { get; set; }

    [Parameter]
    public EventCallback<string> OnDuplicate { get; set; }

    [Parameter]
    public EventCallback<(string Direction, string JsonPath)> OnMoveItem { get; set; }

    [Parameter]
    public EventCallback<(string Direction, string JsonPath)> OnMoveLane { get; set; }

    [Parameter]
    public int ColumnCount { get; set; } = 4;

    [Parameter]
    public int ItemIndex { get; set; } = 0;

    [Parameter]
    public int ItemCount { get; set; } = 1;

    [Parameter]
    public int LaneIndex { get; set; } = 0;

    [Parameter]
    public int LaneCount { get; set; } = 1;

    [Parameter]
    public List<RoadmapReference>? AvailableRoadmaps { get; set; }

    private bool _statusIconPickerExpanded = false;

    private void ToggleStatusIconPicker()
    {
        _statusIconPickerExpanded = !_statusIconPickerExpanded;
    }

    private record ColorPreset(string Name, string Value);

    private readonly List<ColorPreset> _colorPresets = new()
    {
        new ColorPreset("Teal", "#45B69C"),
        new ColorPreset("Coral", "#F88379"),
        new ColorPreset("Lav", "#9999ff"),
        new ColorPreset("Orange", "#D4652F"),
        new ColorPreset("Blue", "#87CEEB"),
