@using RoadScript.Models

<div class="property-editor">
    <div class="form-group">
        <label>Title</label>
        <input type="text"
               value="@Item.Title"
               @onchange="@(e => OnChange.InvokeAsync(("title", e.Value)))"
               class="form-control" />
    </div>

    <div class="form-row">
        <div class="form-group" style="flex: 1;">
            <label>Start Position</label>
            <input type="number"
                   value="@Item.Start"
                   @onchange="@(e => OnChange.InvokeAsync(("start", double.Parse(e.Value?.ToString() ?? "0"))))"
                   class="form-control"
                   step="0.25"
                   min="0" />
        </div>

        <div class="form-group" style="flex: 1; margin-left: 12px;">
            <label style="display: flex; justify-content: space-between; align-items: center;">
                <span>Span</span>
                <label style="display: flex; align-items: center; cursor: pointer; font-size: 11px; font-weight: normal; color: #888;">
                    <input type="checkbox"
                           checked="@IsFitToEnd()"
                           @onchange="@HandleFitToEndToggle"
                           style="margin-right: 4px; cursor: pointer;" />
                    Fit to End
                </label>
            </label>
            <input type="number"
                   value="@Item.Span"
                   @onchange="@(e => OnChange.InvokeAsync(("span", double.Parse(e.Value?.ToString() ?? "1"))))"
                   class="form-control"
                   step="0.25"
                   min="0.25" />
        </div>
    </div>

    <div class="form-group">
        <label style="margin-bottom: 8px;">Position Slider</label>

        @* Quick Position Buttons *@
        <div style="display: grid; grid-template-columns: repeat(6, 1fr); gap: 6px; margin-bottom: 12px;">
            <button type="button"
                    @onclick="@(() => JumpToStart())"
                    title="Jump to Start (0)"
                    style="@GetQuickButtonStyle()">
                <div style="font-size: 10px; font-weight: 600;">⏮ Start</div>
            </button>
            <button type="button"
                    @onclick="@(() => AdjustPosition(-1.0))"
                    title="Big Down (-1 column)"
                    style="@GetQuickButtonStyle()">
                <div style="font-size: 18px; line-height: 1;">⏪</div>
            </button>
            <button type="button"
                    @onclick="@(() => AdjustPosition(-0.25))"
                    title="Little Down (-0.25)"
                    style="@GetQuickButtonStyle()">
                <div style="font-size: 16px; line-height: 1;">◀</div>
            </button>
            <button type="button"
                    @onclick="@(() => AdjustPosition(0.25))"
                    title="Little Up (+0.25)"
                    style="@GetQuickButtonStyle()">
                <div style="font-size: 16px; line-height: 1;">▶</div>
            </button>
            <button type="button"
                    @onclick="@(() => AdjustPosition(1.0))"
                    title="Big Up (+1 column)"
                    style="@GetQuickButtonStyle()">
                <div style="font-size: 18px; line-height: 1;">⏩</div>
            </button>
            <button type="button"
                    @onclick="@(() => JumpToEnd())"
                    title="Jump to End (max position based on span)"
                    style="@GetQuickButtonStyle()">
                <div style="font-size: 10px; font-weight: 600;">End ⏭</div>
            </button>
        </div>

        <input type="range"
               value="@Item.Start"
               @onchange="@(e => OnChange.InvokeAsync(("start", double.Parse(e.Value?.ToString() ?? "0"))))"
               min="0"
               max="@GetMaxPosition()"
               step="0.25"
               class="form-range" />
        <div style="display: flex; justify-content: space-between; font-size: 11px; color: #888; margin-top: 4px;">
            <span>Start</span>
            <span>End</span>
        </div>
    </div>

    @* Item Display Options - Icon-based toggles *@
    <div class="form-group">
        <label style="font-size: 11px; margin-bottom: 8px; color: #888;">Display Options</label>
        <div style="display: flex; gap: 8px;">
            @* Spanning Toggle *@
            <button type="button"
                    @onclick="@(() => OnChange.InvokeAsync(("spanning", !Item.Spanning)))"
                    title="Spanning: Dashed border for ongoing work"
                    style="@GetToggleButtonStyle(Item.Spanning)">
                <span style="font-size: 24px;">⋯⋯</span>
            </button>

            @* Greyed Out Toggle *@
            <button type="button"
                    @onclick="@(() => OnChange.InvokeAsync(("greyedOut", !Item.GreyedOut)))"
                    title="Greyed Out: Reduced opacity with grey shadow"
                    style="@GetToggleButtonStyle(Item.GreyedOut)">
                <span style="font-size: 24px;">◐</span>
            </button>

            @* Hidden Toggle *@
            <button type="button"
                    @onclick="@(() => OnChange.InvokeAsync(("hidden", !Item.Hidden)))"
                    title="Hidden: Hide in preview/export mode only"
                    style="@GetToggleButtonStyle(Item.Hidden)">
                <span style="font-size: 24px;">👁</span>
            </button>
        </div>
    </div>

    <div class="form-group">
        <label style="font-size: 11px; margin-bottom: 8px; color: #888;">Status Icon</label>

        @* Large Icon Preview Button - Similar to Display Options *@
        <div style="position: relative;">
            <button type="button"
                    @onclick="ToggleStatusIconPicker"
                    title="Click to @(_statusIconPickerExpanded ? "hide" : "choose") status icon"
                    style="width: 100%; min-height: 80px; background: #252538; border: 1px solid #3a3a4e; border-radius: 6px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; padding: 16px; position: relative;">
                @if (!string.IsNullOrEmpty(Item.StatusIcon))
                {
                    <Icon IconType="@Item.StatusIcon"
                          Color="@(Item.StatusColor ?? "#667eea")"
                          Size="36"
                          DropShadow="true" />
                }
                else
                {
                    @* Placeholder for empty state *@
                    <span style="font-size: 36px; opacity: 0.3;">✦</span>
                }

                @* Dropdown indicator in bottom right *@
                <span style="position: absolute; bottom: 8px; right: 8px; font-size: 12px; color: #666; transition: transform 0.2s; transform: rotate(@(_statusIconPickerExpanded ? "180deg" : "0deg"));">▼</span>
            </button>

            @* Clear button overlay in top right corner *@
            @if (!string.IsNullOrEmpty(Item.StatusIcon))
            {
                <button @onclick="ClearStatusIcon"
                        @onclick:stopPropagation="true"
                        type="button"
                        title="Clear icon"
                        style="position: absolute; top: 6px; right: 6px; width: 24px; height: 24px; background: rgba(0,0,0,0.6); border: 1px solid #555; border-radius: 4px; cursor: pointer; display: flex; align-items: center; justify-content: center; color: #ef4444; font-size: 14px; font-weight: 600; transition: all 0.2s; z-index: 1;">
                    ✕
                </button>
            }
        </div>

        @if (_statusIconPickerExpanded)
        {
            <div style="background: #252538; padding: 12px; border-radius: 6px; border: 1px solid #3a3a4e; margin-top: 8px;">
                <IconPicker SelectedIcon="@(Item.StatusIcon ?? "")"
                           Color="@(Item.StatusColor ?? "#667eea")"
                           OnIconSelected="HandleStatusIconSelectedAndCollapse"
                           ShowCategories="true"
                           ColumnsPerRow="5" />

                <div style="margin-top: 12px;">
                    <label style="font-size: 11px; margin-bottom: 8px;">Status Color</label>

                    @* Preset Color Options *@
                    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin-bottom: 10px;">
                        @foreach (var preset in _colorPresets)
                        {
                            <button type="button"
                                    @onclick="@(() => OnChange.InvokeAsync(("statusColor", preset.Value)))"
                                    title="@preset.Name"
                                    style="@GetPresetColorButtonStyle(preset.Value, Item.StatusColor)">
                                <span style="width: 100%; height: 100%; display: block; border-radius: 3px; background: @preset.Value;"></span>
                            </button>
                        }
                    </div>

                    <div style="display: flex; align-items: center; gap: 8px;">
                        <input type="color"
                               value="@(Item.StatusColor ?? "#667eea")"
                               @onchange="@(e => OnChange.InvokeAsync(("statusColor", e.Value)))"
                               style="width: 40px; height: 32px; border: 1px solid #3a3a4e; border-radius: 4px; cursor: pointer; background: #2a2a3e;" />
                        <input type="text"
                               value="@(Item.StatusColor ?? "#667eea")"
                               @onchange="@(e => OnChange.InvokeAsync(("statusColor", e.Value)))"
                               class="form-control"
                               placeholder="#667eea"
                               style="flex: 1; font-size: 12px;" />
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="form-group">
        <label style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <span>Details</span>
            <button @onclick="AddDetail" class="btn-add" type="button">+ Add Detail</button>
        </label>

        @if (Item.Details != null && Item.Details.Count > 0)
        {
            @for (int i = 0; i < Item.Details.Count; i++)
            {
                var index = i;
                var detail = Item.Details[i];
                <div style="background: #252538; padding: 12px; border-radius: 6px; margin-bottom: 12px; border: 1px solid #3a3a4e;">
                    <div class="detail-item">
                        <input type="text"
                               value="@detail.Text"
                               @onchange="@(e => UpdateDetailText(index, e.Value?.ToString() ?? ""))"
                               class="form-control"
                               placeholder="Detail text"
                               style="flex: 1;" />
                        <button @onclick="() => RemoveDetail(index)" class="btn-remove" type="button">×</button>
                    </div>

                    @* Sub-bullets section *@
                    <div style="margin-top: 10px; padding-left: 8px;">
                        <label style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                            <span style="font-size: 11px; color: #888;">Sub-items</span>
                            <button @onclick="() => AddSubBullet(index)" class="btn-add" type="button" style="font-size: 11px; padding: 4px 10px;">+ Add Sub</button>
                        </label>

                        @if (detail.Subs != null && detail.Subs.Count > 0)
                        {
                            @for (int j = 0; j < detail.Subs.Count; j++)
                            {
                                var subIndex = j;
                                var sub = detail.Subs[j];
                                <div style="display: flex; gap: 6px; align-items: center; margin-bottom: 6px;">
                                    <span style="color: #666; font-size: 12px;">–</span>
                                    <input type="text"
                                           value="@sub"
                                           @onchange="@(e => UpdateSubBullet(index, subIndex, e.Value?.ToString() ?? ""))"
                                           class="form-control"
                                           placeholder="Sub-item text"
                                           style="font-size: 12px; padding: 6px 10px;" />
                                    <button @onclick="() => RemoveSubBullet(index, subIndex)"
                                            class="btn-remove"
                                            type="button"
                                            style="width: 24px; height: 24px; font-size: 14px;">×</button>
                                </div>
                            }
                        }
                        else
                        {
                            <div style="color: #555; font-size: 11px; font-style: italic; padding-left: 8px;">No sub-items</div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div style="color: #666; font-size: 12px; font-style: italic;">No details added yet</div>
        }
    </div>

    @* Item Management Section *@
    <div class="form-group" style="margin-top: 24px; padding-top: 16px; border-top: 1px solid #3a3a4e;">
        <label style="margin-bottom: 12px; font-weight: 600; color: #e0e7ff;">Item Management</label>

        <button @onclick="AddItem" class="btn-add" type="button" style="width: 100%; margin-bottom: 8px;">
            + Add New Item
        </button>

        <button @onclick="DuplicateItem" type="button" style="width: 100%; margin-bottom: 8px; background: #667eea; color: #fff; border: none; padding: 8px 16px; border-radius: 4px; font-size: 13px; font-weight: 500; cursor: pointer; transition: all 0.2s;">
            📋 Duplicate This Item
        </button>

        <button @onclick="RemoveItem" class="btn-danger" type="button" style="width: 100%;">
            Remove This Item
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Item Item { get; set; } = null!;

    [Parameter, EditorRequired]
    public string JsonPath { get; set; } = "";

    [Parameter]
    public EventCallback<(string PropertyName, object Value)> OnChange { get; set; }

    [Parameter]
    public EventCallback<string> OnAdd { get; set; }

    [Parameter]
    public EventCallback<string> OnRemove { get; set; }

    [Parameter]
    public EventCallback<string> OnDuplicate { get; set; }

    [Parameter]
    public int ColumnCount { get; set; } = 4;

    private bool _statusIconPickerExpanded = false;

    private void ToggleStatusIconPicker()
    {
        _statusIconPickerExpanded = !_statusIconPickerExpanded;
    }

    private record ColorPreset(string Name, string Value);

    private readonly List<ColorPreset> _colorPresets = new()
    {
        new ColorPreset("Teal", "#45B69C"),
        new ColorPreset("Coral", "#F88379"),
        new ColorPreset("Lav", "#9999ff"),
        new ColorPreset("Orange", "#D4652F"),
        new ColorPreset("Blue", "#87CEEB"),
        new ColorPreset("Mustard", "#E6B800"),
        new ColorPreset("Brown", "#4A2C1A"),
        new ColorPreset("Sage", "#B7C4B7"),
        new ColorPreset("Red", "#EF4444"),
        new ColorPreset("Indigo", "#6366F1"),
        new ColorPreset("Dark Blue", "#1E3A8A"),
        new ColorPreset("Pink", "#EC4899")
    };

    private string GetPresetColorButtonStyle(string presetColor, string? currentColor)
    {
        var isSelected = presetColor.Equals(currentColor, StringComparison.OrdinalIgnoreCase);
        var border = isSelected
            ? "border: 2px solid #667eea; box-shadow: 0 0 0 2px rgba(102, 126, 234, 0.3);"
            : "border: 1.5px solid rgba(255, 255, 255, 0.2);";

        return $"width: 100%; height: 32px; padding: 2px; cursor: pointer; border-radius: 4px; " +
               $"background: #1a1a2e; transition: all 0.2s; {border}";
    }

    private string GetToggleButtonStyle(bool isActive)
    {
        var background = isActive
            ? "background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; border: 1px solid #667eea;"
            : "background: #252538; color: #888; border: 1px solid #3a3a4e;";

        return $"flex: 1; display: flex; align-items: center; justify-content: center; " +
               $"padding: 14px 8px; border-radius: 6px; cursor: pointer; transition: all 0.2s; {background}";
    }

    private async Task HandleStatusIconSelectedAndCollapse(string iconValue)
    {
        // Update the item
        Item.StatusIcon = iconValue;
        await OnChange.InvokeAsync(("statusIcon", iconValue));

        // Collapse the picker
        _statusIconPickerExpanded = false;

        StateHasChanged();
    }

    private double GetMaxPosition()
    {
        return (double)ColumnCount;
    }

    private bool IsFitToEnd()
    {
        // Check if the current span fits exactly to the end
        var maxSpan = GetMaxPosition() - Item.Start;
        return Math.Abs(Item.Span - maxSpan) < 0.01; // Use small epsilon for floating point comparison
    }

    // Quick Position Button Methods
    private void JumpToStart()
    {
        OnChange.InvokeAsync(("start", 0.0));
    }

    private void JumpToEnd()
    {
        // Calculate max position considering the item's span
        var maxPos = Math.Max(0, GetMaxPosition() - Item.Span);
        OnChange.InvokeAsync(("start", maxPos));
    }

    private void AdjustPosition(double delta)
    {
        var newPos = Item.Start + delta;
        // Clamp to valid range
        newPos = Math.Max(0, Math.Min(newPos, GetMaxPosition() - Item.Span));
        // Round to 2 decimal places to avoid floating point precision issues
        newPos = Math.Round(newPos, 2);
        OnChange.InvokeAsync(("start", newPos));
    }

    private string GetQuickButtonStyle()
    {
        return "width: 100%; min-height: 36px; background: #252538; color: #ccc; border: 1px solid #3a3a4e; " +
               "border-radius: 4px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; " +
               "justify-content: center; font-weight: 500; padding: 4px;";
    }

    private async Task HandleFitToEndToggle(ChangeEventArgs e)
    {
        var isChecked = (bool)(e.Value ?? false);
        if (isChecked)
        {
            // Calculate span to fit to end
            var maxSpan = GetMaxPosition() - Item.Start;
            await OnChange.InvokeAsync(("span", maxSpan));
        }
        // If unchecked, do nothing - user can manually adjust
    }

    private void AddDetail()
    {
        Item.Details ??= new List<Detail>();
        Item.Details.Add(new Detail { Text = "New detail", Subs = new List<string>() });
        OnChange.InvokeAsync(("details", Item.Details));
    }

    private void RemoveDetail(int index)
    {
        if (Item.Details != null && index < Item.Details.Count)
        {
            Item.Details.RemoveAt(index);
            OnChange.InvokeAsync(("details", Item.Details));
        }
    }

    private void UpdateDetailText(int index, string text)
    {
        if (Item.Details != null && index < Item.Details.Count)
        {
            Item.Details[index].Text = text;
            OnChange.InvokeAsync(("details", Item.Details));
        }
    }

    private void AddSubBullet(int detailIndex)
    {
        if (Item.Details != null && detailIndex < Item.Details.Count)
        {
            Item.Details[detailIndex].Subs ??= new List<string>();
            Item.Details[detailIndex].Subs.Add("New sub-item");
            OnChange.InvokeAsync(("details", Item.Details));
        }
    }

    private void RemoveSubBullet(int detailIndex, int subIndex)
    {
        if (Item.Details != null && detailIndex < Item.Details.Count &&
            Item.Details[detailIndex].Subs != null && subIndex < Item.Details[detailIndex].Subs.Count)
        {
            Item.Details[detailIndex].Subs.RemoveAt(subIndex);
            OnChange.InvokeAsync(("details", Item.Details));
        }
    }

    private void UpdateSubBullet(int detailIndex, int subIndex, string text)
    {
        if (Item.Details != null && detailIndex < Item.Details.Count &&
            Item.Details[detailIndex].Subs != null && subIndex < Item.Details[detailIndex].Subs.Count)
        {
            Item.Details[detailIndex].Subs[subIndex] = text;
            OnChange.InvokeAsync(("details", Item.Details));
        }
    }

    private void AddItem()
    {
        OnAdd.InvokeAsync("item");
    }

    private void DuplicateItem()
    {
        OnDuplicate.InvokeAsync("item");
    }

    private void RemoveItem()
    {
        OnRemove.InvokeAsync("item");
    }

    private async Task HandleStatusIconSelected(string iconValue)
    {
        // Update the item directly to ensure immediate UI update
        Item.StatusIcon = iconValue;
        await OnChange.InvokeAsync(("statusIcon", iconValue));
        StateHasChanged(); // Force re-render to show selected icon immediately
    }

    private async Task ClearStatusIcon()
    {
        // Update the item directly to ensure immediate UI update
        Item.StatusIcon = "";
        await OnChange.InvokeAsync(("statusIcon", ""));
        StateHasChanged(); // Force re-render
    }
}
