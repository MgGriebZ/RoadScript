@using RoadScript.Models
@using RoadScript.Services
@inject ThemeService ThemeService

@if (!IsPreviewMode && ActiveTab != null && Data != null)
{
    <div style="@FooterBarStyle()">
        <div style="display: flex; align-items: center; justify-content: center; gap: 16px; flex-wrap: wrap;">
            @* Status info *@
            <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="font-size: 12px; color: @(IsVibeMode ? "#9ca3af" : "#6b7280"); font-weight: 500;">Active Tab:</span>
                    <span style="font-size: 12px; color: @(IsVibeMode ? "#e0e7ff" : "#1f2937"); font-weight: 600;">@ActiveTab.Name</span>
                </div>
                <div style="height: 16px; width: 1px; background: @(IsVibeMode ? "#3a3a4e" : "#d1d5db");"></div>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="font-size: 12px; color: @(IsVibeMode ? "#9ca3af" : "#6b7280"); font-weight: 500;">Last Modified:</span>
                    <span style="font-size: 12px; color: @(IsVibeMode ? "#e0e7ff" : "#1f2937"); font-weight: 600;">@ActiveTab.LastModified.ToLocalTime().ToString("MMM d, h:mm tt")</span>
                </div>
                <div style="height: 16px; width: 1px; background: @(IsVibeMode ? "#3a3a4e" : "#d1d5db");"></div>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="font-size: 12px; color: @(IsVibeMode ? "#9ca3af" : "#6b7280"); font-weight: 500;">Columns:</span>
                    <span style="font-size: 12px; color: @(IsVibeMode ? "#667eea" : "#667eea"); font-weight: 600;">@Data.Columns.Count</span>
                </div>
                <div style="height: 16px; width: 1px; background: @(IsVibeMode ? "#3a3a4e" : "#d1d5db");"></div>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="font-size: 12px; color: @(IsVibeMode ? "#9ca3af" : "#6b7280"); font-weight: 500;">Lanes:</span>
                    <span style="font-size: 12px; color: @(IsVibeMode ? "#667eea" : "#667eea"); font-weight: 600;">@Data.Lanes.Count</span>
                </div>
            </div>

            @* Divider *@
            <div style="height: 16px; width: 1px; background: @(IsVibeMode ? "#3a3a4e" : "#d1d5db");"></div>

            @* Action buttons *@
            <div class="footer-action-buttons" style="display: flex; align-items: center; gap: 8px;">
                <a href="https://github.com/MgGriebZ/RoadScript"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="footer-button"
                   style="display: flex; align-items: center; gap: 6px; padding: 6px 10px; background: @(IsVibeMode ? "rgba(102, 126, 234, 0.15)" : "rgba(0, 0, 0, 0.05)"); border-radius: 6px; text-decoration: none; transition: all 0.2s; cursor: pointer;"
                   title="View on GitHub"
                   onmouseover="this.style.background='@(IsVibeMode ? "rgba(102, 126, 234, 0.25)" : "rgba(0, 0, 0, 0.08)")'"
                   onmouseout="this.style.background='@(IsVibeMode ? "rgba(102, 126, 234, 0.15)" : "rgba(0, 0, 0, 0.05)")'">
                    <Icon IconType="github" Size="14" Color="@(IsVibeMode ? "#c7d2fe" : "#374151")" />
                    <span class="footer-button-label" style="font-size: 11px; font-weight: 600; color: @(IsVibeMode ? "#c7d2fe" : "#374151"); text-transform: uppercase; letter-spacing: 0.3px;">Repo</span>
                </a>
                <div @onclick="@(() => OnShareClick.InvokeAsync())"
                     class="footer-button"
                     style="display: flex; align-items: center; gap: 6px; padding: 6px 10px; background: @(IsVibeMode ? "rgba(102, 126, 234, 0.15)" : "rgba(0, 0, 0, 0.05)"); border-radius: 6px; transition: all 0.2s; cursor: pointer;"
                     title="Share this roadmap"
                     onmouseover="this.style.background='@(IsVibeMode ? "rgba(102, 126, 234, 0.25)" : "rgba(0, 0, 0, 0.08)")'"
                     onmouseout="this.style.background='@(IsVibeMode ? "rgba(102, 126, 234, 0.15)" : "rgba(0, 0, 0, 0.05)")'">
                    <Icon IconType="globe" Size="14" Color="@(IsVibeMode ? "#c7d2fe" : "#374151")" />
                    <span class="footer-button-label" style="font-size: 11px; font-weight: 600; color: @(IsVibeMode ? "#c7d2fe" : "#374151"); text-transform: uppercase; letter-spacing: 0.3px;">Share</span>
                </div>
                <div @onclick="@(() => OnImportClick.InvokeAsync())"
                     class="footer-button"
                     style="display: flex; align-items: center; gap: 6px; padding: 6px 10px; background: @(IsVibeMode ? "rgba(16, 185, 129, 0.15)" : "rgba(16, 185, 129, 0.08)"); border-radius: 6px; transition: all 0.2s; cursor: pointer;"
                     title="Import roadmap or session data"
                     onmouseover="this.style.background='@(IsVibeMode ? "rgba(16, 185, 129, 0.25)" : "rgba(16, 185, 129, 0.12)")'"
                     onmouseout="this.style.background='@(IsVibeMode ? "rgba(16, 185, 129, 0.15)" : "rgba(16, 185, 129, 0.08)")'">
                    <Icon IconType="download" Size="14" Color="@(IsVibeMode ? "#6ee7b7" : "#059669")" />
                    <span class="footer-button-label" style="font-size: 11px; font-weight: 600; color: @(IsVibeMode ? "#6ee7b7" : "#059669"); text-transform: uppercase; letter-spacing: 0.3px;">Import</span>
                </div>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>
    /// The active tab session containing name and last modified information.
    /// </summary>
    [Parameter]
    public TabSession? ActiveTab { get; set; }

    /// <summary>
    /// The roadmap data containing columns and lanes information.
    /// </summary>
    [Parameter]
    public RoadmapData? Data { get; set; }

    /// <summary>
    /// Indicates whether the application is in vibe mode (dark theme).
    /// </summary>
    [Parameter]
    public bool IsVibeMode { get; set; }

    /// <summary>
    /// Indicates whether the roadmap is in preview mode. When true, footer is hidden.
    /// </summary>
    [Parameter]
    public bool IsPreviewMode { get; set; }

    /// <summary>
    /// Callback fired when the share button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnShareClick { get; set; }

    /// <summary>
    /// Callback fired when the import button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnImportClick { get; set; }

    /// <summary>
    /// Generates the CSS style string for the footer bar based on the current theme.
    /// </summary>
    private string FooterBarStyle()
    {
        if (IsVibeMode)
        {
            return "background: rgba(30, 30, 46, 0.98); padding: 10px 24px; border-top: 1px solid #3a3a4e; " +
                   "width: 100%; flex-shrink: 0;";
        }
        return "background: rgba(248, 249, 250, 0.98); padding: 10px 24px; border-top: 1px solid #d1d5db; " +
               "width: 100%; flex-shrink: 0;";
    }
}
