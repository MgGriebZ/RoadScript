@using RoadScript.Models
@using RoadScript.Services
@inject ThemeService ThemeService

@if (!IsPreviewMode && ActiveTab != null && Data != null)
{
    <div style="@FooterBarStyle()">
        <div style="display: flex; align-items: center; justify-content: center; gap: 16px; flex-wrap: wrap;">
            @* Status info *@
            <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="font-size: 12px; color: #6b7280; font-weight: 500;">Active Tab:</span>
                    <span style="font-size: 12px; color: #1f2937; font-weight: 600;">@ActiveTab.Name</span>
                </div>
                <div style="height: 16px; width: 1px; background: #d1d5db;"></div>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="font-size: 12px; color: #6b7280; font-weight: 500;">Last Modified:</span>
                    <span style="font-size: 12px; color: #1f2937; font-weight: 600;">@ActiveTab.LastModified.ToLocalTime().ToString("MMM d, h:mm tt")</span>
                </div>
                <div style="height: 16px; width: 1px; background: #d1d5db;"></div>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="font-size: 12px; color: #6b7280; font-weight: 500;">Columns:</span>
                    <span style="font-size: 12px; color: #4f46e5; font-weight: 600;">@Data.Columns.Count</span>
                </div>
                <div style="height: 16px; width: 1px; background: #d1d5db;"></div>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="font-size: 12px; color: #6b7280; font-weight: 500;">Lanes:</span>
                    <span style="font-size: 12px; color: #4f46e5; font-weight: 600;">@Data.Lanes.Count</span>
                </div>
            </div>

            @* Divider *@
            <div style="height: 16px; width: 1px; background: #d1d5db;"></div>

            @* Action buttons *@
            <div class="footer-action-buttons" style="display: flex; align-items: center; gap: 8px;">
                <button type="button" @onclick="@(() => OnHomeClick.InvokeAsync())"
                        class="footer-button"
                        style="display: flex; align-items: center; gap: 6px; padding: 6px 10px; background: rgba(99, 102, 241, 0.1); border-radius: 6px; transition: all 0.2s; cursor: pointer; border: 1px solid rgba(99, 102, 241, 0.2); font-family: inherit;"
                        title="Show the RoadScript welcome page. Your roadmaps stay as they are."
                        aria-label="Home: show the RoadScript welcome page"
                        onmouseover="this.style.background='rgba(99, 102, 241, 0.15)'"
                        onmouseout="this.style.background='rgba(99, 102, 241, 0.1)'">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5L12 4l9 7.5"></path><path d="M5.5 10v10h13V10"></path><path d="M10 20v-5.5h4V20"></path></svg>
                    <span class="footer-button-label" style="font-size: 11px; font-weight: 600; color: #4f46e5; text-transform: uppercase; letter-spacing: 0.3px;">Home</span>
                </button>
                <a href="https://github.com/MgGriebZ/RoadScript"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="footer-button"
                   style="display: flex; align-items: center; gap: 6px; padding: 6px 10px; background: rgba(99, 102, 241, 0.1); border-radius: 6px; text-decoration: none; transition: all 0.2s; cursor: pointer; border: 1px solid rgba(99, 102, 241, 0.2);"
                   title="View on GitHub"
                   onmouseover="this.style.background='rgba(99, 102, 241, 0.15)'"
                   onmouseout="this.style.background='rgba(99, 102, 241, 0.1)'">
                    <Icon IconType="github" Size="14" Color="#6366f1" />
                    <span class="footer-button-label" style="font-size: 11px; font-weight: 600; color: #4f46e5; text-transform: uppercase; letter-spacing: 0.3px;">Repo</span>
                </a>
                <button type="button" @onclick="@(() => OnShareClick.InvokeAsync())"
                        class="footer-button"
                        style="display: flex; align-items: center; gap: 6px; padding: 6px 10px; background: rgba(99, 102, 241, 0.1); border-radius: 6px; transition: all 0.2s; cursor: pointer; border: 1px solid rgba(99, 102, 241, 0.2); font-family: inherit;"
                        title="Share this roadmap"
                        onmouseover="this.style.background='rgba(99, 102, 241, 0.15)'"
                        onmouseout="this.style.background='rgba(99, 102, 241, 0.1)'">
                    <Icon IconType="globe" Size="14" Color="#6366f1" />
                    <span class="footer-button-label" style="font-size: 11px; font-weight: 600; color: #4f46e5; text-transform: uppercase; letter-spacing: 0.3px;">Share</span>
                </button>
                <button type="button" @onclick="@(() => OnImportClick.InvokeAsync())"
                        class="footer-button"
                        style="display: flex; align-items: center; gap: 6px; padding: 6px 10px; background: rgba(16, 185, 129, 0.1); border-radius: 6px; transition: all 0.2s; cursor: pointer; border: 1px solid rgba(16, 185, 129, 0.2); font-family: inherit;"
                        title="Import roadmap or session data"
                        onmouseover="this.style.background='rgba(16, 185, 129, 0.15)'"
                        onmouseout="this.style.background='rgba(16, 185, 129, 0.1)'">
                    <Icon IconType="download" Size="14" Color="#10b981" />
                    <span class="footer-button-label" style="font-size: 11px; font-weight: 600; color: #047857; text-transform: uppercase; letter-spacing: 0.3px;">Import</span>
                </button>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>
    /// The active tab session containing name and last modified information.
    /// </summary>
    [Parameter]
    public TabSession? ActiveTab { get; set; }

    /// <summary>
    /// The roadmap data containing columns and lanes information.
    /// </summary>
    [Parameter]
    public RoadmapData? Data { get; set; }

    /// <summary>
    /// Indicates whether the roadmap is in preview mode. When true, footer is hidden.
    /// </summary>
    [Parameter]
    public bool IsPreviewMode { get; set; }

    /// <summary>
    /// Callback fired when the share button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnShareClick { get; set; }

    /// <summary>
    /// Callback fired when the import button is clicked
    /// </summary>
    [Parameter]
    public EventCallback OnImportClick { get; set; }

    /// <summary>
    /// Callback fired when the home button is clicked. Shows the welcome page without changing any roadmap.
    /// </summary>
    [Parameter]
    public EventCallback OnHomeClick { get; set; }

    /// <summary>
    /// Generates the CSS style string for the footer bar.
    /// </summary>
    private string FooterBarStyle()
    {
        return "background: #f9fafb; padding: 10px 24px; border-top: 1px solid #e5e7eb; " +
               "width: 100%; flex-shrink: 0;";
    }
}
