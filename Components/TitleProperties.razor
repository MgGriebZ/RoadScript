@using RoadScript.Models

<div class="property-editor">
    <div class="form-group" style="position: relative;">
        <label>Title</label>
        <input type="text"
               value="@Title"
               @onchange="@(e => OnChange.InvokeAsync(("title", e.Value)))"
               class="form-control"
               placeholder="Project Roadmap"
               style="padding-right: 45px;" />
        @if (!string.IsNullOrWhiteSpace(Title))
        {
            <button type="button"
                    @onclick="@(() => ClearField("title"))"
                    @onclick:stopPropagation="true"
                    title="Clear"
                    style="position: absolute; right: 0; top: 50%; transform: translateY(-50%);
                           width: 36px; height: 36px; background: rgba(239, 68, 68, 0.15);
                           border: none; border-left: 1px solid rgba(239, 68, 68, 0.2);
                           border-radius: 0 4px 4px 0; cursor: pointer; display: flex;
                           align-items: center; justify-content: center; transition: all 0.2s;">
                <span style="color: #ef4444; font-size: 16px; font-weight: 600;">✕</span>
            </button>
        }
    </div>

    <div class="form-group" style="position: relative;">
        <label>Subtitle</label>
        <textarea value="@Subtitle"
                  @onchange="@(e => OnChange.InvokeAsync(("subtitle", e.Value)))"
                  class="form-control"
                  placeholder="Customize your timeline and milestones"
                  rows="3"
                  style="resize: vertical; min-height: 72px; padding-right: 45px;">@Subtitle</textarea>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <button type="button"
                    @onclick="@(() => ClearField("subtitle"))"
                    @onclick:stopPropagation="true"
                    title="Clear"
                    style="position: absolute; right: 0; top: 29px;
                           width: 36px; height: 72px; background: rgba(239, 68, 68, 0.15);
                           border: none; border-left: 1px solid rgba(239, 68, 68, 0.2);
                           border-radius: 0 4px 4px 0; cursor: pointer; display: flex;
                           align-items: center; justify-content: center; transition: all 0.2s;">
                <span style="color: #ef4444; font-size: 16px; font-weight: 600;">✕</span>
            </button>
        }
    </div>

    @if (AvailableRoadmaps != null && AvailableRoadmaps.Count > 1)
    {
        <div class="form-group">
            <label style="font-size: 11px; margin-bottom: 8px; color: #888;">Linked Roadmap</label>
            <select value="@(LinkedRoadmapId ?? "")"
                    @onchange="@(e => OnChange.InvokeAsync(("linkedRoadmapId",
                        string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString())))"
                    class="form-control"
                    style="background: #252538; color: #e0e7ff; border: 1px solid #3a3a4e;
                           border-radius: 6px; padding: 8px 12px; font-size: 13px;">
                <option value="">None</option>
                @foreach (var roadmap in AvailableRoadmaps)
                {
                    if (roadmap.IsCurrentTab)
                    {
                        continue; // Skip current roadmap to prevent self-linking
                    }
                    <option value="@roadmap.FullId">
                        @if (roadmap.IsCurrentFolder)
                        {
                            <text>  🔗 @roadmap.TabName</text>
                        }
                        else
                        {
                            <text>📁 @roadmap.FolderName → @roadmap.TabName</text>
                        }
                    </option>
                }
            </select>
            @if (!string.IsNullOrEmpty(LinkedRoadmapId))
            {
                <div style="margin-top: 6px; padding: 8px; background: rgba(102, 126, 234, 0.1);
                           border: 1px solid rgba(102, 126, 234, 0.3); border-radius: 4px;
                           font-size: 11px; color: #a5b4fc;">
                    🔗 Click the link icon on the title to navigate
                </div>
            }
        </div>
    }

    <div style="margin-top: 16px; padding: 12px; background: rgba(102, 126, 234, 0.1); border-radius: 6px; font-size: 12px; color: #9ca3af;">
        <strong>Tip:</strong> The title and subtitle appear at the top of your roadmap.
    </div>

    <div class="form-group" style="margin-top: 24px; padding-top: 16px; border-top: 1px solid #3a3a4e;">
        <label style="margin-bottom: 12px; font-weight: 600; color: #45B69C;">Milestone Management</label>

        <button @onclick="AddMilestone" class="btn-add" type="button" style="width: 100%; background: linear-gradient(135deg, rgba(69, 182, 156, 0.2) 0%, rgba(69, 182, 156, 0.1) 100%); color: #45B69C; border: 1px solid rgba(69, 182, 156, 0.4); padding: 8px 16px; border-radius: 4px; font-size: 13px; font-weight: 500; cursor: pointer; transition: all 0.2s;">
            + Add New Milestone
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    [Parameter, EditorRequired]
    public string Subtitle { get; set; } = "";

    [Parameter]
    public string? LinkedRoadmapId { get; set; }

    [Parameter, EditorRequired]
    public string JsonPath { get; set; } = "";

    [Parameter]
    public List<RoadmapReference>? AvailableRoadmaps { get; set; }

    [Parameter]
    public EventCallback<(string PropertyName, object Value)> OnChange { get; set; }

    [Parameter]
    public EventCallback<string> OnAdd { get; set; }

    private void AddMilestone()
    {
        OnAdd.InvokeAsync("milestone");
    }

    private async Task ClearField(string field)
    {
        if (field == "title")
        {
            await OnChange.InvokeAsync(("title", ""));
        }
        else if (field == "subtitle")
        {
            await OnChange.InvokeAsync(("subtitle", ""));
        }
    }
}
