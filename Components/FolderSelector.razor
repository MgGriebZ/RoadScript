@using RoadScript.Models
@using RoadScript.Components

@* Folder Selector - Honeycomb-style folder picker for managing project folders *@

<div class="folder-selector-overlay @(IsVisible ? "visible" : "")" @onclick="@(() => OnClose.InvokeAsync())">
    <div class="folder-selector-content" @onclick:stopPropagation="true">
        <div class="folder-selector-header">
            <h3>Project Folders</h3>
            <button class="close-button" @onclick="@(() => OnClose.InvokeAsync())">×</button>
        </div>

        <div class="folder-honeycomb">
            @foreach (var folder in Folders)
            {
                <div class="folder-hex @(folder.Id == ActiveFolderId ? "active" : "")"
                     @onclick="@(() => HandleFolderSelect(folder.Id))">
                    <div class="folder-hex-inner" style="background-color: @folder.Color;">
                        <Icon IconType="@folder.Icon" Size="32" Color="#ffffff" />
                        <div class="folder-name">@folder.Name</div>
                        <div class="folder-slots">
                            @for (int i = 0; i < 5; i++)
                            {
                                <span class="slot-dot @(i < folder.SessionManager.Tabs.Count ? "filled" : "empty")"></span>
                            }
                        </div>
                    </div>
                </div>
            }

            @* Add folder button (if under max limit) *@
            @if (Folders.Count < MaxFolders)
            {
                <div class="folder-hex add-folder" @onclick="HandleAddFolder">
                    <div class="folder-hex-inner">
                        <Icon IconType="plus" Size="32" Color="#999999" />
                        <div class="folder-name">Add Folder</div>
                    </div>
                </div>
            }
        </div>

        @if (Folders.Count > 0)
        {
            <div class="folder-actions">
                <button class="btn-rename" @onclick="HandleRenameFolder" disabled="@(ActiveFolderId == null)">
                    Rename Folder
                </button>
                <button class="btn-delete" @onclick="HandleRemoveFolder" disabled="@(Folders.Count <= 1 || ActiveFolderId == null)">
                    Delete Folder
                </button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public List<Folder> Folders { get; set; } = new();
    [Parameter] public string? ActiveFolderId { get; set; }
    [Parameter] public int MaxFolders { get; set; } = 3;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnFolderSelect { get; set; }
    [Parameter] public EventCallback OnAddFolder { get; set; }
    [Parameter] public EventCallback OnRemoveFolder { get; set; }
    [Parameter] public EventCallback OnRenameFolder { get; set; }

    private async Task HandleFolderSelect(string folderId)
    {
        await OnFolderSelect.InvokeAsync(folderId);
    }

    private async Task HandleAddFolder()
    {
        await OnAddFolder.InvokeAsync();
    }

    private async Task HandleRemoveFolder()
    {
        await OnRemoveFolder.InvokeAsync();
    }

    private async Task HandleRenameFolder()
    {
        await OnRenameFolder.InvokeAsync();
    }
}

<style>
    .folder-selector-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(4px);
        display: none;
        z-index: 1000;
    }

    .folder-selector-overlay.visible {
        display: block;
    }

    .folder-selector-content {
        position: absolute;
        top: 20px;
        left: 20px;
        background: #1e1e1e;
        border: 1px solid #444;
        border-radius: 12px;
        padding: 24px;
        max-width: 600px;
        width: auto;
        min-width: 400px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    }

    .folder-selector-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .folder-selector-header h3 {
        margin: 0;
        color: #ffffff;
        font-size: 20px;
        font-weight: 600;
    }

    .close-button {
        background: none;
        border: none;
        color: #999;
        font-size: 32px;
        cursor: pointer;
        padding: 0;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
        transition: color 0.2s;
    }

    .close-button:hover {
        color: #ffffff;
    }

    .folder-honeycomb {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        justify-content: center;
        margin-bottom: 24px;
    }

    .folder-hex {
        width: 140px;
        height: 160px;
        cursor: pointer;
        transition: transform 0.2s;
    }

    .folder-hex:hover {
        transform: scale(1.05);
    }

    .folder-hex.active .folder-hex-inner {
        border: 3px solid #ffffff;
        box-shadow: 0 0 20px rgba(102, 126, 234, 0.5);
    }

    .folder-hex-inner {
        width: 100%;
        height: 100%;
        background: #2a2a2a;
        border: 2px solid #444;
        border-radius: 16px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.2s;
    }

    .folder-hex.add-folder .folder-hex-inner {
        background: #1e1e1e;
        border: 2px dashed #666;
    }

    .folder-hex.add-folder:hover .folder-hex-inner {
        border-color: #999;
        background: #252525;
    }

    .folder-name {
        color: #ffffff;
        font-size: 13px;
        font-weight: 500;
        text-align: center;
        max-width: 100px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .folder-hex.add-folder .folder-name {
        color: #999;
    }

    .folder-slots {
        display: flex;
        gap: 4px;
        margin-top: 8px;
        justify-content: center;
    }

    .slot-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        transition: all 0.2s;
    }

    .slot-dot.filled {
        background: #ffffff;
        box-shadow: 0 0 4px rgba(255, 255, 255, 0.5);
    }

    .slot-dot.empty {
        background: rgba(255, 255, 255, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    .folder-actions {
        display: flex;
        gap: 12px;
        justify-content: center;
    }

    .folder-actions button {
        padding: 10px 20px;
        border: 1px solid #444;
        background: #2a2a2a;
        color: #ffffff;
        border-radius: 8px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 500;
        transition: all 0.2s;
    }

    .folder-actions button:hover:not(:disabled) {
        background: #333;
        border-color: #666;
    }

    .folder-actions button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .btn-rename:hover:not(:disabled) {
        border-color: #667eea;
        color: #667eea;
    }

    .btn-delete:hover:not(:disabled) {
        border-color: #ef4444;
        color: #ef4444;
    }
</style>
