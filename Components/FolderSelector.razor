@using RoadScript.Models
@using RoadScript.Components

<div class="folder-selector-overlay @(IsVisible ? "visible" : "")" @onclick="@(() => OnClose.InvokeAsync())">
    <div class="folder-selector-content" @onclick:stopPropagation="true">
        <div class="folder-selector-header">
            <h3>Project Folders</h3>
            <button class="close-button" @onclick="@(() => OnClose.InvokeAsync())">×</button>
        </div>

        <div class="folder-honeycomb">
            @for (int i = 0; i < Folders.Count; i++)
            {
                var folder = Folders[i];
                var folderNumber = i + 1;
                <div class="folder-hex @(folder.Id == ActiveFolderId ? "active" : "")"
                     @onclick="@(() => HandleFolderSelect(folder.Id))">
                    <div class="folder-hex-inner" style="background-color: @folder.Color;">
                        <div class="folder-header" style="background-color: @folder.Color; padding: 10px 12px; display: flex; align-items: center; justify-content: center; gap: 8px;">
                            <Icon IconType="@(folder.Icon ?? "folder")" Size="16" Color="#ffffff" />
                            <span class="folder-number">@folder.Name</span>
                        </div>
                        <div class="folder-roadmaps">
                            @foreach (var tab in folder.SessionManager.Tabs)
                            {
                                var stats = GetRoadmapStats(tab.Data);
                                var isActive = tab.Id == folder.SessionManager.ActiveTabId;
                                <div class="roadmap-line @(isActive ? "active-roadmap" : "")">
                                    @if (isActive)
                                    {
                                        <span class="active-indicator" style="background-color: @folder.Color;"></span>
                                    }
                                    <span class="roadmap-name">@tab.Name</span>
                                    <span class="roadmap-stats">@stats</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            @if (Folders.Count < MaxFolders)
            {
                <div class="folder-hex add-folder" @onclick="HandleAddFolder">
                    <div class="folder-hex-inner">
                        <Icon IconType="plus" Size="32" Color="#999999" />
                        <div class="folder-name">Add Folder</div>
                    </div>
                </div>
            }
        </div>

        @if (Folders.Count > 0)
        {
            <div class="folder-actions">
                <div class="folder-controls-compact">
                    <div class="folder-name-row">
                        <button class="btn-move-arrow"
                                @onclick="@(() => HandleMoveFolderLeft(ActiveFolderId))"
                                disabled="@(GetActiveFolderIndex() <= 0 || ActiveFolderId == null)"
                                title="Move folder left">
                            ◀
                        </button>

                        <button class="btn-edit-name-inline"
                                @onclick="HandleRenameFolder"
                                disabled="@(ActiveFolderId == null)"
                                title="Click to edit folder name">
                            <Icon IconType="@(GetActiveFolderIcon() ?? "folder")" Size="18" Color="@GetActiveFolderColor()" />
                            <span class="folder-name-text">@(GetActiveFolderName())</span>
                            <Icon IconType="edit" Size="14" Color="#888" />
                        </button>

                        <button class="btn-move-arrow"
                                @onclick="@(() => HandleMoveFolderRight(ActiveFolderId))"
                                disabled="@(GetActiveFolderIndex() >= Folders.Count - 1 || ActiveFolderId == null)"
                                title="Move folder right">
                            ▶
                        </button>
                    </div>

                    <div class="icon-color-row">
                        <div class="inline-control">
                            <label>Icon</label>
                            <button class="btn-icon-large"
                                    @onclick="@(() => _showIconPicker = !_showIconPicker)"
                                    disabled="@(ActiveFolderId == null)"
                                    title="Click to choose icon">
                                <Icon IconType="@(GetActiveFolderIcon() ?? "folder")" Color="@GetActiveFolderColor()" Size="36" />
                            </button>
                        </div>

                        <div class="inline-control" style="flex: 1;">
                            <label>Color</label>
                            <div class="color-grid-inline">
                                @foreach (var preset in _colorPresets)
                                {
                                    <button type="button"
                                            @onclick="@(() => SelectColor(preset.Value))"
                                            disabled="@(ActiveFolderId == null)"
                                            title="@preset.Name"
                                            class="color-swatch-inline @(preset.Value.Equals(GetActiveFolderColor(), StringComparison.OrdinalIgnoreCase) ? "selected" : "")"
                                            style="background: @preset.Value;">
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    @if (_showIconPicker && ActiveFolderId != null)
                    {
                        <div class="expandable-panel">
                            <IconPicker SelectedIcon="@(GetActiveFolderIcon() ?? "folder")"
                                       Color="@GetActiveFolderColor()"
                                       OnIconSelected="HandleIconChange"
                                       ShowCategories="false"
                                       ColumnsPerRow="5" />
                        </div>
                    }
                </div>

                <button class="btn-delete" @onclick="HandleRemoveFolder" disabled="@(Folders.Count <= 1 || ActiveFolderId == null)">
                    <span style="font-size: 18px; margin-right: 8px;">🗑️</span>
                    Delete Folder
                </button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public List<Folder> Folders { get; set; } = new();
    [Parameter] public string? ActiveFolderId { get; set; }
    [Parameter] public int MaxFolders { get; set; } = 3;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnFolderSelect { get; set; }
    [Parameter] public EventCallback OnAddFolder { get; set; }
    [Parameter] public EventCallback OnRemoveFolder { get; set; }
    [Parameter] public EventCallback OnRenameFolder { get; set; }
    [Parameter] public EventCallback<string> OnMoveFolderLeft { get; set; }
    [Parameter] public EventCallback<string> OnMoveFolderRight { get; set; }
    [Parameter] public EventCallback<string> OnColorChange { get; set; }
    [Parameter] public EventCallback<string> OnIconChange { get; set; }

    private bool _showIconPicker = false;

    private async Task HandleFolderSelect(string folderId) => await OnFolderSelect.InvokeAsync(folderId);
    private async Task HandleAddFolder() => await OnAddFolder.InvokeAsync();
    private async Task HandleRemoveFolder() => await OnRemoveFolder.InvokeAsync();
    private async Task HandleRenameFolder() => await OnRenameFolder.InvokeAsync();
    private async Task HandleMoveFolderLeft(string folderId) => await OnMoveFolderLeft.InvokeAsync(folderId);
    private async Task HandleMoveFolderRight(string folderId) => await OnMoveFolderRight.InvokeAsync(folderId);
    private async Task HandleColorChange(string color) => await OnColorChange.InvokeAsync(color);
    private async Task SelectColor(string color) => await HandleColorChange(color);

    private async Task HandleIconChange(string icon)
    {
        await OnIconChange.InvokeAsync(icon);
        _showIconPicker = false;
    }

    private string? GetActiveFolderName()
    {
        if (string.IsNullOrEmpty(ActiveFolderId)) return "No folder selected";
        var folder = Folders.FirstOrDefault(f => f.Id == ActiveFolderId);
        return folder?.Name ?? "Unknown";
    }

    private string? GetActiveFolderIcon()
    {
        if (string.IsNullOrEmpty(ActiveFolderId)) return null;
        var folder = Folders.FirstOrDefault(f => f.Id == ActiveFolderId);
        return folder?.Icon;
    }

    private string GetActiveFolderColor()
    {
        if (string.IsNullOrEmpty(ActiveFolderId)) return "#667eea";
        var folder = Folders.FirstOrDefault(f => f.Id == ActiveFolderId);
        return folder?.Color ?? "#667eea";
    }

    private int GetActiveFolderIndex() => string.IsNullOrEmpty(ActiveFolderId) ? -1 : Folders.FindIndex(f => f.Id == ActiveFolderId);

    private string GetRoadmapStats(RoadmapData data)
    {
        if (data == null) return "0 0 0";
        var columns = data.Columns?.Count ?? 0;
        var lanes = data.Lanes?.Count ?? 0;
        var items = data.Lanes?.Sum(l => l.Items?.Count ?? 0) ?? 0;
        return $"{columns} {lanes} {items}";
    }

    private record ColorPreset(string Name, string Value);

    private readonly List<ColorPreset> _colorPresets = new()
    {
        new ColorPreset("Teal", "#45B69C"),
        new ColorPreset("Coral", "#F88379"),
        new ColorPreset("Lav", "#9999ff"),
        new ColorPreset("Orange", "#D4652F"),
        new ColorPreset("Blue", "#87CEEB"),
        new ColorPreset("Mustard", "#E6B800"),
        new ColorPreset("Brown", "#4A2C1A"),
        new ColorPreset("Sage", "#B7C4B7"),
        new ColorPreset("Red", "#EF4444"),
        new ColorPreset("Indigo", "#6366F1"),
        new ColorPreset("Dark Blue", "#1E3A8A"),
        new ColorPreset("Pink", "#EC4899")
    };
}

<style>
    .folder-selector-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(4px);
        display: none;
        z-index: 1000;
    }

    .folder-selector-overlay.visible {
        display: block;
    }

    .folder-selector-content {
        position: absolute;
        top: 20px;
        left: 20px;
        background: #1e1e1e;
        border: 1px solid #444;
        border-radius: 12px;
        padding: 20px;
        max-width: 680px;
        width: auto;
        min-width: 660px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    }

    .folder-selector-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .folder-selector-header h3 {
        margin: 0;
        color: #ffffff;
        font-size: 20px;
        font-weight: 600;
    }

    .close-button {
        background: none;
        border: none;
        color: #999;
        font-size: 32px;
        cursor: pointer;
        padding: 0;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
        transition: color 0.2s;
    }

    .close-button:hover {
        color: #ffffff;
    }

    .folder-honeycomb {
        display: flex;
        flex-wrap: nowrap;
        gap: 12px;
        justify-content: flex-start;
        margin-bottom: 20px;
    }

    .folder-hex {
        width: 200px;
        height: auto;
        min-height: 160px;
        max-height: 280px;
        cursor: pointer;
        transition: transform 0.2s;
    }

    .folder-hex:hover {
        transform: scale(1.05);
    }

    .folder-hex.active .folder-hex-inner {
        border: 3px solid #ffffff;
        box-shadow: 0 0 20px rgba(102, 126, 234, 0.5);
    }

    .folder-hex-inner {
        width: 100%;
        height: 100%;
        background: #2a2a2a;
        border: 2px solid #444;
        border-radius: 16px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: flex-start;
        overflow: hidden;
        transition: all 0.2s;
    }

    .folder-hex.add-folder .folder-hex-inner {
        background: #1e1e1e;
        border: 2px dashed #666;
        align-items: center;
        justify-content: center;
        gap: 12px;
    }

    .folder-hex.add-folder:hover .folder-hex-inner {
        border-color: #999;
        background: #252525;
    }

    .folder-hex.add-folder .folder-name {
        color: #999;
        font-size: 13px;
        font-weight: 600;
        text-align: center;
    }

    .folder-header {
        width: 100%;
        padding: 10px 12px;
        border-radius: 12px 12px 0 0;
        display: flex;
        align-items: center;
        justify-content: center;
        filter: brightness(1.1);
    }

    .folder-number {
        color: #ffffff;
        font-size: 14px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .folder-roadmaps {
        width: 100%;
        padding: 10px 8px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        max-height: 220px;
        overflow-y: auto;
        background: rgba(0, 0, 0, 0.1);
    }

    .roadmap-line {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 6px;
        padding: 5px 6px;
        background: rgba(0, 0, 0, 0.15);
        border-radius: 4px;
        position: relative;
    }

    .roadmap-line.active-roadmap {
        background: rgba(255, 255, 255, 0.08);
    }

    .active-indicator {
        position: absolute;
        left: -4px;
        width: 3px;
        height: 100%;
        border-radius: 2px;
        opacity: 0.8;
    }

    .roadmap-name {
        color: #ffffff;
        font-size: 12px;
        font-weight: 600;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        flex: 1;
    }

    .roadmap-stats {
        color: rgba(255, 255, 255, 0.7);
        font-size: 11px;
        font-weight: 500;
        font-family: 'Courier New', monospace;
        letter-spacing: 1px;
        white-space: nowrap;
    }

    .folder-hex.add-folder .folder-roadmaps {
        padding: 32px 12px;
        align-items: center;
        justify-content: center;
    }

    .folder-actions {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-top: 20px;
    }

    .folder-controls-compact {
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding: 12px;
        background: #2a2a2a;
        border: 1px solid #444;
        border-radius: 8px;
    }

    .folder-name-row {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-move-arrow {
        width: 36px;
        height: 36px;
        border: 1px solid #555;
        background: #3c3c3c;
        color: #999;
        border-radius: 6px;
        cursor: pointer;
        font-size: 16px;
        font-weight: 700;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .btn-move-arrow:hover:not(:disabled) {
        background: #4a4a4a;
        border-color: #667eea;
        color: #667eea;
    }

    .btn-move-arrow:disabled {
        opacity: 0.3;
        cursor: not-allowed;
    }

    .btn-edit-name-inline {
        flex: 1;
        min-height: 36px;
        padding: 8px 12px;
        background: #1e1e2e;
        border: 1px solid #3a3a4e;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 10px;
        color: #ffffff;
        font-size: 14px;
        font-weight: 600;
    }

    .btn-edit-name-inline:hover:not(:disabled) {
        border-color: #fbbf24;
        background: rgba(251, 191, 36, 0.05);
    }

    .folder-name-text {
        flex: 1;
        text-align: left;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .icon-color-row {
        display: flex;
        gap: 12px;
        align-items: flex-start;
    }

    .inline-control {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .inline-control label {
        font-size: 10px;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
    }

    .btn-icon-large {
        width: 80px;
        height: 80px;
        background: #252538;
        border: 1px solid #3a3a4e;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .btn-icon-large:hover:not(:disabled) {
        border-color: #667eea;
        background: #2a2a3e;
        transform: scale(1.02);
    }

    .btn-icon-large:disabled {
        opacity: 0.3;
        cursor: not-allowed;
    }

    .color-grid-inline {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 4px;
    }

    .color-swatch-inline {
        width: 100%;
        aspect-ratio: 1;
        min-height: 18px;
        border: 2px solid #3a3a4e;
        border-radius: 3px;
        cursor: pointer;
        transition: all 0.2s;
    }

    .color-swatch-inline.selected {
        border-color: #667eea;
        box-shadow: 0 0 0 2px rgba(102, 126, 234, 0.3);
    }

    .color-swatch-inline:hover:not(:disabled) {
        transform: scale(1.05);
        border-color: #ffffff;
    }

    .expandable-panel {
        padding: 12px;
        background: #252538;
        border: 1px solid #3a3a4e;
        border-radius: 6px;
        margin-top: 4px;
    }

    .btn-delete {
        padding: 14px 28px;
        border: 2px solid #ef4444;
        background: linear-gradient(135deg, rgba(239, 68, 68, 0.2) 0%, rgba(220, 38, 38, 0.1) 100%);
        color: #ef4444;
        border-radius: 10px;
        cursor: pointer;
        font-size: 16px;
        font-weight: 700;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .btn-delete:hover:not(:disabled) {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: #ffffff;
        border-color: #dc2626;
        transform: scale(1.05);
        box-shadow: 0 4px 12px rgba(239, 68, 68, 0.4);
    }

    .btn-delete:active:not(:disabled) {
        transform: scale(0.95);
    }

    .btn-delete:disabled {
        opacity: 0.3;
        cursor: not-allowed;
    }
</style>
