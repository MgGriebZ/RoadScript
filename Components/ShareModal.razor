@inject IJSRuntime JSRuntime

<div class="share-modal-overlay @(IsVisible ? "visible" : "")" @onclick="Close">
    <div class="share-modal-content" @onclick:stopPropagation="true">
        <div class="share-modal-header">
            <h3>📤 Share & Export</h3>
            <button class="close-button" @onclick="Close">×</button>
        </div>

        <div class="share-modal-body">
            @* Share This Roadmap Section *@
            <div class="share-section">
                <div class="share-section-header">
                    <div class="share-section-icon">🔗</div>
                    <div>
                        <h4>Share This Roadmap</h4>
                        <p>Generate a shareable link for the current roadmap</p>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="share-error">
                        <div class="share-error-icon">⚠️</div>
                        <div>
                            <div class="share-error-title">Unable to Generate Share Link</div>
                            <div class="share-error-message">@ErrorMessage</div>
                        </div>
                    </div>
                }
                else if (!string.IsNullOrEmpty(ShareUrl))
                {
                    <div class="share-info">
                        <div class="share-info-icon">✨</div>
                        <div class="share-info-text">
                            Anyone with this link can import this roadmap into their own RoadScript.
                            The link contains all the roadmap data - no server needed!
                        </div>
                    </div>

                    @if (RoadmapStats != null)
                    {
                        <div class="roadmap-stats">
                            <div class="roadmap-stat">
                                <div class="roadmap-stat-value">@RoadmapStats.ColumnCount</div>
                                <div class="roadmap-stat-label">Columns</div>
                            </div>
                            <div class="roadmap-stat">
                                <div class="roadmap-stat-value">@RoadmapStats.LaneCount</div>
                                <div class="roadmap-stat-label">Swim Lanes</div>
                            </div>
                            <div class="roadmap-stat">
                                <div class="roadmap-stat-value">@RoadmapStats.ItemCount</div>
                                <div class="roadmap-stat-label">Items</div>
                            </div>
                        </div>
                    }

                    <div class="share-url-actions">
                        <div class="share-url-input-wrapper">
                            <input type="text"
                                   readonly
                                   value="@ShareUrl"
                                   @ref="_urlInput"
                                   class="share-url-input"
                                   @onclick="SelectUrl" />
                            <div class="url-length-hint">@ShareUrl.Length chars @(ShareUrl.Length < 2000 ? "✓" : "⚠")</div>
                        </div>
                        <button @onclick="CopyToClipboard" class="btn-copy-link">
                            @(_copied ? "✓ Copied!" : "📋 Copy Link")
                        </button>
                    </div>
                }
                else
                {
                    <div class="share-loading">
                        <div class="share-spinner"></div>
                        <div>Generating share link...</div>
                    </div>
                }
            </div>

            @* Divider *@
            <div class="share-divider">
                <span>OR</span>
            </div>

            @* Export Session Data Section *@
            <div class="share-section">
                <div class="share-section-header">
                    <div class="share-section-icon">📦</div>
                    <div>
                        <h4>Export Session Data</h4>
                        <p>Download all folders and roadmaps as a JSON file</p>
                    </div>
                </div>

                <div class="export-info">
                    <div class="export-info-icon">💡</div>
                    <div class="export-info-text">
                        Exports your entire session including all folders, roadmaps, and cross-folder links.
                        Perfect for backups or sharing complex multi-roadmap projects.
                    </div>
                </div>

                @if (SessionStats != null)
                {
                    <div class="session-stats">
                        <div class="session-stat">
                            <div class="session-stat-value">@SessionStats.FolderCount</div>
                            <div class="session-stat-label">Folders</div>
                        </div>
                        <div class="session-stat">
                            <div class="session-stat-value">@SessionStats.TotalRoadmaps</div>
                            <div class="session-stat-label">Roadmaps</div>
                        </div>
                        <div class="session-stat">
                            <div class="session-stat-value">@SessionStats.TotalLinks</div>
                            <div class="session-stat-label">Linked Items</div>
                        </div>
                    </div>
                }

                <div class="export-actions">
                    <button @onclick="ExportSessionData" class="btn-export-primary">
                        📥 Download Session Data
                    </button>
                </div>
            </div>

            @if (CurrentRoadmap != null)
            {
                @* Divider *@
                <div class="share-divider">
                    <span>OR</span>
                </div>

                @* Export as Markdown Section *@
                <div class="share-section">
                    <div class="share-section-header">
                        <div class="share-section-icon">📝</div>
                        <div>
                            <h4>Export as Markdown</h4>
                            <p>Copy or download the current roadmap as portable Markdown text</p>
                        </div>
                    </div>

                    <div class="export-actions" style="gap: 10px;">
                        <button @onclick="CopyAsMarkdown" class="btn-export-secondary @(_copiedMd ? "copied" : "")">
                            @(_copiedMd ? "✓ Copied!" : "📋 Copy to Clipboard")
                        </button>
                        <button @onclick="DownloadAsMarkdown" class="btn-export-secondary">
                            📥 Download .md
                        </button>
                    </div>
                </div>

                @* Divider *@
                <div class="share-divider">
                    <span>OR</span>
                </div>

                @* Export as Image Section *@
                <div class="share-section">
                    <div class="share-section-header">
                        <div class="share-section-icon">🖼️</div>
                        <div>
                            <h4>Export as Image</h4>
                            <p>Download the roadmap as a vector SVG file</p>
                        </div>
                    </div>

                    <div class="export-info" style="margin-bottom: 16px;">
                        <div class="export-info-icon">💡</div>
                        <div class="export-info-text">
                            Vector format — opens in any browser, Figma, or modern editor. PNG support coming later.
                        </div>
                    </div>

                    <div class="export-actions">
                        <button @onclick="DownloadAsSvg" class="btn-export-secondary">
                            📥 Download SVG
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public string ShareUrl { get; set; } = "";
    [Parameter] public string ErrorMessage { get; set; } = "";
    [Parameter] public RoadmapStatsModel? RoadmapStats { get; set; }
    [Parameter] public SessionStatsModel? SessionStats { get; set; }
    [Parameter] public RoadmapData? CurrentRoadmap { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnExportSession { get; set; }

    private ElementReference _urlInput;
    private bool _copied = false;
    private bool _copiedMd = false;

    private async Task Close()
    {
        _copied = false;
        _copiedMd = false;
        await OnClose.InvokeAsync();
    }

    private async Task SelectUrl()
    {
        // Select all text in the URL input for easy copying
        if (_urlInput.Id != null)
        {
            await JSRuntime.InvokeVoidAsync("eval", $"document.querySelector('input.share-url-input').select()");
        }
    }

    private async Task CopyToClipboard()
    {
        if (!string.IsNullOrEmpty(ShareUrl))
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", ShareUrl);
            _copied = true;
            StateHasChanged();

            // Reset after 2 seconds
            await Task.Delay(2000);
            _copied = false;
            StateHasChanged();
        }
    }

    private async Task ExportSessionData()
    {
        await OnExportSession.InvokeAsync();
    }

    private async Task CopyAsMarkdown()
    {
        if (CurrentRoadmap == null) return;
        var md = MarkdownExportService.Export(CurrentRoadmap);
        await JSRuntime.InvokeAsync<bool>("RoadScriptInterop.copyToClipboard", md);
        _copiedMd = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copiedMd = false;
        StateHasChanged();
    }

    private async Task DownloadAsMarkdown()
    {
        if (CurrentRoadmap == null) return;
        var md = MarkdownExportService.Export(CurrentRoadmap);
        var filename = MarkdownExportService.SanitizeFilename(CurrentRoadmap.Title) + ".md";
        await JSRuntime.InvokeAsync<bool>("RoadScriptInterop.downloadTextFile", filename, md, "text/markdown");
    }

    private async Task DownloadAsSvg()
    {
        if (CurrentRoadmap == null) return;
        var svg = SvgExportService.Export(CurrentRoadmap);
        var filename = MarkdownExportService.SanitizeFilename(CurrentRoadmap.Title) + ".svg";
        await JSRuntime.InvokeAsync<bool>("RoadScriptInterop.downloadTextFile", filename, svg, "image/svg+xml");
    }

    public class RoadmapStatsModel
    {
        public int ColumnCount { get; set; }
        public int LaneCount { get; set; }
        public int ItemCount { get; set; }
    }

    public class SessionStatsModel
    {
        public int FolderCount { get; set; }
        public int TotalRoadmaps { get; set; }
        public int TotalLinks { get; set; }
    }
}

<style>
    .share-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(4px);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 2000;
    }

    .share-modal-overlay.visible {
        display: flex;
    }

    .share-modal-content {
        background: #1e1e1e;
        border: 1px solid #444;
        border-radius: 12px;
        width: 95%;
        max-width: 920px;
        max-height: calc(100vh - 40px);
        display: flex;
        flex-direction: column;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    }

    .share-modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 24px;
        border-bottom: 1px solid #333;
        flex-shrink: 0;
    }

    .share-modal-header h3 {
        margin: 0;
        color: #ffffff;
        font-size: 20px;
        font-weight: 600;
    }

    .close-button {
        background: none;
        border: none;
        color: #999;
        font-size: 32px;
        cursor: pointer;
        padding: 0;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
        transition: color 0.2s;
    }

    .close-button:hover {
        color: #ffffff;
    }

    .share-modal-body {
        padding: 24px;
        flex: 1;
        overflow-y: auto;
        min-height: 0;
    }

    .share-info {
        display: flex;
        gap: 12px;
        padding: 16px;
        background: rgba(102, 126, 234, 0.1);
        border: 1px solid rgba(102, 126, 234, 0.3);
        border-radius: 8px;
        margin-bottom: 20px;
    }

    .share-info-icon {
        font-size: 24px;
        flex-shrink: 0;
    }

    .share-info-text {
        color: #a5b4fc;
        font-size: 14px;
        line-height: 1.6;
    }

    .share-error {
        display: flex;
        gap: 12px;
        padding: 16px;
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.3);
        border-radius: 8px;
        margin-bottom: 20px;
    }

    .share-error-icon {
        font-size: 24px;
        flex-shrink: 0;
    }

    .share-error-title {
        color: #fca5a5;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 4px;
    }

    .share-error-message {
        color: #fca5a5;
        font-size: 13px;
        opacity: 0.9;
    }

    /* Roadmap stats section - similar to session stats */
    .roadmap-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 20px;
        padding: 16px;
        background: #252525;
        border-radius: 8px;
    }

    .roadmap-stat {
        text-align: center;
    }

    .roadmap-stat-value {
        font-size: 28px;
        font-weight: 700;
        color: #667eea;
        margin-bottom: 6px;
    }

    .roadmap-stat-label {
        font-size: 11px;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* Integrated URL input and copy button */
    .share-url-actions {
        display: flex;
        gap: 12px;
        align-items: stretch;
    }

    .share-url-input-wrapper {
        flex: 1;
        position: relative;
    }

    .share-url-input {
        width: 100%;
        padding: 14px 16px;
        padding-bottom: 32px; /* Space for hint */
        background: #2a2a2a;
        border: 1px solid #444;
        border-radius: 8px;
        color: #00D9FF;
        font-family: 'Courier New', monospace;
        font-size: 13px;
        word-break: break-all;
        cursor: pointer;
        transition: all 0.2s;
        height: 100%;
        box-sizing: border-box;
    }

    .share-url-input:hover {
        border-color: #667eea;
        background: #2d2d2d;
    }

    .share-url-input:focus {
        outline: none;
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }

    .url-length-hint {
        position: absolute;
        bottom: 8px;
        left: 16px;
        font-size: 10px;
        color: #666;
        font-family: system-ui, -apple-system, sans-serif;
    }

    .btn-copy-link {
        padding: 14px 32px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
        white-space: nowrap;
        min-width: 150px;
    }

    .btn-copy-link:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(102, 126, 234, 0.4);
    }

    .btn-copy-link:active {
        transform: translateY(0);
    }

    .share-loading {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px;
        gap: 16px;
        color: #999;
    }

    .share-spinner {
        width: 40px;
        height: 40px;
        border: 3px solid #333;
        border-top-color: #667eea;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    /* New section styles */
    .share-section {
        margin-bottom: 24px;
    }

    .share-section:last-child {
        margin-bottom: 0;
    }

    .share-section-header {
        display: flex;
        gap: 12px;
        align-items: flex-start;
        margin-bottom: 16px;
    }

    .share-section-icon {
        font-size: 28px;
        flex-shrink: 0;
    }

    .share-section-header h4 {
        margin: 0 0 4px 0;
        color: #ffffff;
        font-size: 16px;
        font-weight: 600;
    }

    .share-section-header p {
        margin: 0;
        color: #888;
        font-size: 13px;
        line-height: 1.4;
    }

    .share-divider {
        position: relative;
        text-align: center;
        margin: 32px 0;
        border-top: 1px solid #333;
    }

    .share-divider span {
        position: absolute;
        top: -10px;
        left: 50%;
        transform: translateX(-50%);
        background: #1e1e1e;
        padding: 0 12px;
        color: #666;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .export-info {
        display: flex;
        gap: 12px;
        padding: 16px;
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.3);
        border-radius: 8px;
        margin-bottom: 20px;
    }

    .export-info-icon {
        font-size: 24px;
        flex-shrink: 0;
    }

    .export-info-text {
        color: #6ee7b7;
        font-size: 14px;
        line-height: 1.6;
    }

    .session-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 20px;
        padding: 16px;
        background: #252525;
        border-radius: 8px;
    }

    .session-stat {
        text-align: center;
    }

    .session-stat-value {
        font-size: 28px;
        font-weight: 700;
        color: #10b981;
        margin-bottom: 6px;
    }

    .session-stat-label {
        font-size: 11px;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .export-actions {
        display: flex;
        gap: 12px;
    }

    .btn-export-primary {
        flex: 1;
        padding: 14px 24px;
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
    }

    .btn-export-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(16, 185, 129, 0.4);
    }

    .btn-export-primary:active {
        transform: translateY(0);
    }

    .btn-export-secondary {
        flex: 1;
        padding: 12px 20px;
        background: #2a2a2a;
        color: #ccc;
        border: 1px solid #444;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-export-secondary:hover {
        background: #333;
        border-color: #667eea;
        color: #fff;
    }

    .btn-export-secondary.copied {
        border-color: #10b981;
        color: #10b981;
    }
</style>
